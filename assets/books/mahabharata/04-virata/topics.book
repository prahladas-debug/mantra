{"1":{"hi":"छिपने का स्थान चुनना","kn":"ಅಡಗಿಕೊಳ್ಳಲು ಸ್ಥಳದ ಆಯ್ಕೆ","te":"దాగుకునే చోటును ఎంచుకోవడం","ta":"மறைந்திருக்கும் இடத்தைத் தேர்ந்தெடுத்தல்","ml":"ഒളിച്ചുതാമസിക്കാൻ സ്ഥലം തിരഞ്ഞെടുക്കുന്നു"},"2":{"hi":"भीम और अर्जुन अपने वेश चुनते हैं","kn":"ಭೀಮ ಮತ್ತು ಅರ್ಜುನರು ತಮ್ಮ ವೇಷಗಳನ್ನು ಆಯ್ಕೆಮಾಡುವುದು","te":"భీముడు, అర్జునుడు తమ వేషాలను ఎంచుకుంటారు","ta":"பீமனும் அர்ஜுனனும் தங்கள் வேடங்களைத் தேர்ந்தெடுக்கின்றனர்","ml":"ഭീമനും അർജുനനും വേഷം തിരഞ്ഞെടുക്കുന്നു"},"3":{"hi":"जुड़वाँ भाई और द्रौपदी अपने वेश चुनते हैं","kn":"ನಕುಲ ಸಹದೇವರು ಮತ್ತು ದ್ರೌಪದಿ ತಮ್ಮ ವೇಷಗಳನ್ನು ಆಯ್ಕೆಮಾಡುವುದು","te":"కవల సోదరులు, ద్రౌపది తమ వేషాలను ఎంచుకుంటారు","ta":"இரட்டையர்களும் திரௌபதியும் தங்கள் வேடங்களைத் தேர்ந்தெடுக்கின்றனர்","ml":"ഇരട്ടകളും ദ്രൗപദിയും തങ്ങളുടെ വേഷം തിരഞ്ഞെടുക്കുന്നു"},"4":{"hi":"धौम्य का राजदरबार में रहने पर परामर्श","kn":"ಅರಮನೆಯಲ್ಲಿ ಬದುಕುವ ಬಗ್ಗೆ ಧೌಮ್ಯರ ಸಲಹೆ","te":"రాజసభలో జీవించడం గురించి ధౌమ్యుడి సలహా","ta":"அரண்மனையில் வாழ்வது பற்றி தௌம்யரின் அறிவுரை","ml":"രാജസദസ്സിൽ കഴിയുന്നതിനെക്കുറിച്ച് ധൗമ്യന്റെ ഉപദേശം"},"5":{"hi":"शमी वृक्ष में छिपे शस्त्र","kn":"ಶಮೀ ವೃಕ್ಷದಲ್ಲಿ ಅಡಗಿಸಿಟ್ಟ ಆಯುಧಗಳು","te":"శమీవృక్షంలో దాచిన ఆయుధాలు","ta":"வன்னி மரத்தில் ஆயுதங்களை மறைத்தல்","ml":"ശമീവൃക്ഷത്തിൽ ആയുധങ്ങൾ ഒളിപ്പിക്കുന്നു"},"6":{"hi":"युधिष्ठिर विराट की सेवा में आते हैं","kn":"ಯುಧಿಷ್ಠಿರರು ವಿರಾಟನ ಸೇವೆಗೆ ಸೇರುವುದು","te":"యుధిష్ఠిరుడు విరాటుడి సేవలో చేరతాడు","ta":"விராடனின் சேவையில் யுதிட்டிரன் சேருகிறான்","ml":"യുധിഷ്ഠിരൻ വിരാടന്റെ സേവയിൽ പ്രവേശിക്കുന്നു"},"7":{"hi":"भीम रसोइया बल्लव बनते हैं","kn":"ಭೀಮನು ಬಲ್ಲವ ಎಂಬ ಅಡುಗೆಯವನಾಗುವುದು","te":"భీముడు వంటవాడు బల్లవుడిగా మారతాడు","ta":"பல்லவன் என்ற சமையற்காரனாகிறான் பீமன்","ml":"ഭീമൻ ബല്ലവൻ എന്ന പാചകക്കാരനാകുന്നു"},"8":{"hi":"द्रौपदी सुदेष्णा की दासी बनती है","kn":"ದ್ರೌಪದಿ ಸುದೇಷ್ಣೆಯ ದಾಸಿಯಾಗುವುದು","te":"ద్రౌపది సుదేష్ణ దాసిగా మారుతుంది","ta":"சுதேஷ்ணையின் பணிப்பெண்ணாகிறாள் திரௌபதி","ml":"ദ്രൗപദി സുദേഷ്ണയുടെ ദാസിയാകുന്നു"},"9":{"hi":"सहदेव गोपाल बनते हैं","kn":"ಸಹದೇವನು ಗೊಲ್ಲನಾಗುವುದು","te":"సహదేవుడు గోపాలకుడిగా మారతాడు","ta":"இடையனாகிறான் சகதேவன்","ml":"സഹദേവൻ ഇടയനാകുന്നു"},"10":{"hi":"अर्जुन बृहन्नला बनते हैं","kn":"ಅರ್ಜುನನು ಬೃಹನ್ನಳೆಯಾಗುವುದು","te":"అర్జునుడు బృహన్నలగా మారతాడు","ta":"பிருஹன்னடை ஆகிறான் அர்ஜுனன்","ml":"അർജുനൻ ബൃഹന്നളയാകുന്നു"},"11":{"hi":"नकुल अश्वपाल बनते हैं","kn":"ನಕುಲನು ಕುದುರೆ ಪಾಲಕನಾಗುವುದು","te":"నకులుడు గుర్రాల కాపరిగా మారతాడు","ta":"குதிரை பராமரிப்பாளனாகிறான் நகுலன்","ml":"നകുലൻ കുതിരപ്പാലകനാകുന്നു"},"12":{"hi":"भीम जीमूत से कुश्ती लड़ते हैं","kn":"ಭೀಮನು ಜೀಮೂತನೊಡನೆ ಕುಸ್ತಿಯಾಡುವುದು","te":"భీముడు జీమూతుడితో మల్లయుద్ధం చేస్తాడు","ta":"ஜீமூதனுடன் பீமன் மற்போர் புரிகிறான்","ml":"ഭീമൻ ജീമൂതനുമായി മല്ലയുദ്ധം ചെയ്യുന്നു"},"13":{"hi":"कीचक द्रौपदी को चाहता है","kn":"ದ್ರೌಪದಿಯನ್ನು ಕೀಚಕನು ಬಯಸುವುದು","te":"ద్రౌపదిపై కీచకుడు మోహం పెంచుకుంటాడు","ta":"திரௌபதியை கீசகன் விரும்புகிறான்","ml":"കീചകൻ ദ്രൗപദിയെ മോഹിക്കുന്നു"},"14":{"hi":"सुदेष्णा द्रौपदी को कीचक के पास भेजती है","kn":"ಸುದೇಷ್ಣೆಯು ದ್ರೌಪದಿಯನ್ನು ಕೀಚಕನ ಬಳಿಗೆ ಕಳುಹಿಸುವುದು","te":"కీచకుడి వద్దకు ద్రౌపదిని సుదేష్ణ పంపుతుంది","ta":"கீசகனிடம் திரௌபதியைச் சுதேஷ்ணை அனுப்புகிறாள்","ml":"സുദേഷ്ണ ദ്രൗപദിയെ കീചകന്റെ അടുത്തേക്ക് അയക്കുന്നു"},"15":{"hi":"कीचक सभा में द्रौपदी को लात मारता है","kn":"ಸಭೆಯಲ್ಲಿ ಕೀಚಕನು ದ್ರೌಪದಿಯನ್ನು ಒದೆಯುವುದು","te":"సభలో ద్రౌపదిని కీచకుడు తన్నుతాడు","ta":"சபையில் திரௌபதியை கீசகன் உதைக்கிறான்","ml":"സദസ്സിൽവെച്ച് കീചകൻ ദ്രൗപദിയെ ചവിട്ടുന്നു"},"16":{"hi":"द्रौपदी रात में भीम के पास जाती है","kn":"ರಾತ್ರಿ ದ್ರೌಪದಿಯು ಭೀಮನ ಬಳಿಗೆ ಹೋಗುವುದು","te":"రాత్రివేళ భీముడి వద్దకు ద్రౌపది వెళ్తుంది","ta":"இரவில் பீமனிடம் செல்கிறாள் திரௌபதி","ml":"ദ്രൗപദി രാത്രിയിൽ ഭീമന്റെ അടുത്തേക്ക് പോകുന്നു"},"17":{"hi":"द्रौपदी का विलाप: युधिष्ठिर का पतन","kn":"ದ್ರೌಪದಿಯ ಶೋಕ: ಯುಧಿಷ್ಠಿರನ ಪತನ","te":"ద్రౌపది విలాపం: యుధిష్ఠిరుడి పతనం","ta":"திரௌபதியின் புலம்பல்: யுதிட்டிரனின் வீழ்ச்சி","ml":"ദ്രൗപദിയുടെ വിലാപം: യുധിഷ്ഠിരന്റെ പതനം"},"18":{"hi":"द्रौपदी का विलाप: भीम और अर्जुन","kn":"ದ್ರೌಪದಿಯ ಶೋಕ: ಭೀಮ ಮತ್ತು ಅರ್ಜುನ","te":"ద్రౌపది విలాపం: భీముడు, అర్జునుడు","ta":"திரௌபதியின் புலம்பல்: பீமனும் அர்ஜுனனும்","ml":"ദ്രൗപദിയുടെ വിലാപം: ഭീമനും അർജുനനും"},"19":{"hi":"द्रौपदी का विलाप: अपनी दासता","kn":"ದ್ರೌಪದಿಯ ಶೋಕ: ತನ್ನ ದಾಸ್ಯ","te":"ద్రౌపది విలాపం: తన దాస్యం","ta":"திரௌபதியின் புலம்பல்: தன் அடிமை நிலை","ml":"ദ്രൗപദിയുടെ വിലാപം: സ്വന്തം ദാസ്യജീവിതം"},"20":{"hi":"द्रौपदी कीचक की मृत्यु की माँग करती है","kn":"ಕೀಚಕನ ಮರಣಕ್ಕಾಗಿ ದ್ರೌಪದಿಯ ಆಗ್ರಹ","te":"కీచకుడి మరణాన్ని ద్రౌపది కోరుతుంది","ta":"கீசகனின் மரணத்தை திரௌபதி கோருகிறாள்","ml":"കീചകന്റെ വധം ദ്രൗപദി ആവശ്യപ്പെടുന്നു"},"21":{"hi":"भीम कीचक का वध करते हैं","kn":"ಭೀಮನು ಕೀಚಕನನ್ನು ಕೊಲ್ಲುವುದು","te":"భీముడు కీచకుడిని సంహరిస్తాడు","ta":"கீசகனை பீமன் கொல்கிறான்","ml":"ഭീമൻ കീചകനെ വധിക്കുന്നു"},"22":{"hi":"भीम उपकीचकों का वध करते हैं","kn":"ಭೀಮನು ಉಪಕೀಚಕರನ್ನು ಕೊಲ್ಲುವುದು","te":"భీముడు ఉపకీచకులను సంహరిస్తాడు","ta":"உபகீசகர்களை பீமன் கொல்கிறான்","ml":"ഭീമൻ ഉപകീചകരെ വധിക്കുന്നു"},"23":{"hi":"द्रौपदी का महल लौटना","kn":"ದ್ರೌಪದಿಯು ಅರಮನೆಗೆ ಹಿಂದಿರುಗುವುದು","te":"ద్రౌపది రాజభవనానికి తిరిగి వస్తుంది","ta":"அரண்மனைக்குத் திரௌபதி திரும்புதல்","ml":"ദ്രൗപദി കൊട്ടാരത്തിലേക്ക് മടങ്ങുന്നു"},"24":{"hi":"कौरव गुप्तचर लौटते हैं","kn":"ಕೌರವರ ಗೂಢಚಾರರು ಹಿಂದಿರುಗುವುದು","te":"కౌరవ గూఢచారులు తిరిగి వస్తారు","ta":"கௌரவர்களின் உளவாளிகள் திரும்புகின்றனர்","ml":"കൗരവചാരന്മാർ മടങ്ങിയെത്തുന്നു"},"25":{"hi":"दुर्योधन नई खोज का आदेश देता है","kn":"ದುರ್ಯೋಧನನು ಮತ್ತೆ ಶೋಧಿಸಲು ಆಜ್ಞಾಪಿಸುವುದು","te":"దుర్యోధనుడు కొత్త అన్వేషణకు ఆజ్ఞాపిస్తాడు","ta":"புதிய தேடுதலுக்குத் துரியோதனன் ஆணையிடுகிறான்","ml":"ദുര്യോധനൻ പുതിയ അന്വേഷണത്തിന് ഉത്തരവിടുന്നു"},"26":{"hi":"द्रोण का परामर्श","kn":"ದ್ರೋಣರ ಸಲಹೆ","te":"ద్రోణుడి హితవు","ta":"துரோணரின் ஆலோசனை","ml":"ദ്രോണരുടെ ഉപദേശം"},"27":{"hi":"भीष्म का परामर्श","kn":"ಭೀಷ್ಮರ ಸಲಹೆ","te":"భీష్ముడి హితవు","ta":"பீஷ்மரின் ஆலோசனை","ml":"ഭീഷ്മരുടെ ഉപദേശം"},"28":{"hi":"कृप का परामर्श","kn":"ಕೃಪರ ಸಲಹೆ","te":"కృపుడి హితవు","ta":"கிருபரின் ஆலோசனை","ml":"കൃപരുടെ ഉപദേശം"},"29":{"hi":"सुशर्मा गोधन हरने का प्रस्ताव रखता है","kn":"ಸುಶರ್ಮನು ಗೋಹರಣಕ್ಕೆ ಪ್ರಸ್ತಾಪಿಸುವುದು","te":"పశువుల దొంగతనాన్ని సుశర్మ ప్రతిపాదిస్తాడు","ta":"பசுக்கவர்ச்சிக்குச் சுசர்மன் யோசனை கூறுகிறான்","ml":"സുശർമാവ് പശുമോഷണത്തിന് നിർദേശിക്കുന്നു"},"30":{"hi":"विराट त्रिगर्तों पर चढ़ाई करते हैं","kn":"ತ್ರಿಗರ್ತರ ವಿರುದ್ಧ ವಿರಾಟನು ದಂಡೆತ್ತಿ ಹೋಗುವುದು","te":"త్రిగర్తులపై విరాటుడు దండెత్తుతాడు","ta":"திரிகர்த்தர்களுக்கு எதிராக விராடன் படையெடுக்கிறான்","ml":"വിരാടൻ ത്രിഗർത്തർക്കെതിരെ പടയോട്ടം നടത്തുന്നു"},"31":{"hi":"त्रिगर्तों से युद्ध","kn":"ತ್ರಿಗರ್ತರೊಂದಿಗೆ ಯುದ್ಧ","te":"త్రిగర్తులతో యుద్ధం","ta":"திரிகர்த்தர்களுடனான போர்","ml":"ത്രിഗർത്തരുമായുള്ള യുദ്ധം"},"32":{"hi":"विराट बंदी बनते और मुक्त होते हैं","kn":"ವಿರಾಟನ ಸೆರೆ ಮತ್ತು ಬಿಡುಗಡೆ","te":"విరాటుడు బందీ అవుతాడు; విడిపించబడతాడు","ta":"விராடன் சிறைப்பிடிக்கப்பட்டு மீட்கப்படுகிறான்","ml":"വിരാടൻ ബന്ധനത്തിലാകുന്നു; മോചിപ്പിക്കപ്പെടുന്നു"},"33":{"hi":"कौरव उत्तर दिशा के गोधन पर आक्रमण करते हैं","kn":"ಕೌರವರು ಉತ್ತರ ದಿಕ್ಕಿನ ಗೋವುಗಳನ್ನು ಅಪಹರಿಸುವುದು","te":"కౌరవులు ఉత్తర దిక్కు పశువులను దోచుకుంటారు","ta":"வடக்கு மாட்டுக்கூட்டங்களைக் கௌரவர்கள் கவர்கின்றனர்","ml":"കൗരവർ ഉത്തരദിക്കിലെ പശുക്കളെ കവർച്ച ചെയ്യുന്നു"},"34":{"hi":"बृहन्नला को सारथि बनाने का प्रस्ताव","kn":"ಬೃಹನ್ನಳೆಯನ್ನು ಸಾರಥಿಯಾಗಿ ನೇಮಿಸುವ ಪ್ರಸ್ತಾಪ","te":"సారథిగా బృహన్నలను ప్రతిపాదిస్తారు","ta":"தேரோட்டியாக பிருஹன்னடை பரிந்துரைக்கப்படுகிறான்","ml":"ബൃഹന്നളയെ സാരഥിയായി നിർദേശിക്കുന്നു"},"35":{"hi":"बृहन्नला उत्तर के सारथि बनते हैं","kn":"ಬೃಹನ್ನಳೆಯು ಉತ್ತರನ ಸಾರಥಿಯಾಗುವುದು","te":"బృహన్నల ఉత్తరుడికి సారథి అవుతాడు","ta":"உத்தரனின் தேரோட்டியாகிறான் பிருஹன்னடை","ml":"ബൃഹന്നള ഉത്തരന്റെ സാരഥിയാകുന്നു"},"36":{"hi":"उत्तर घबराता है","kn":"ಉತ್ತರನು ಭಯಭೀತನಾಗುವುದು","te":"ఉత్తరుడు భయాందోళనకు గురవుతాడు","ta":"உத்தரன் பதறுகிறான்","ml":"ഉത്തരൻ പരിഭ്രമിക്കുന്നു"},"37":{"hi":"कौरवों को अर्जुन पर संदेह","kn":"ಅರ್ಜುನನ ಮೇಲೆ ಕೌರವರ ಸಂಶಯ","te":"అర్జునుడిపై కౌరవులకు అనుమానం కలుగుతుంది","ta":"அர்ஜுனன் மீது கௌரவர்களுக்குச் சந்தேகம்","ml":"കൗരവർ അർജുനനെ സംശയിക്കുന്നു"},"38":{"hi":"शमी वृक्ष के शस्त्र","kn":"ಶಮೀ ವೃಕ್ಷದಲ್ಲಿನ ಆಯುಧಗಳು","te":"శమీవృక్షంలోని ఆయుధాలు","ta":"வன்னி மரத்திலுள்ள ஆயுதங்கள்","ml":"ശമീവൃക്ഷത്തിലെ ആയുധങ്ങൾ"},"39":{"hi":"अर्जुन अपना परिचय देते हैं","kn":"ಅರ್ಜುನನು ತನ್ನ ನಿಜರೂಪವನ್ನು ಬಹಿರಂಗಪಡಿಸುವುದು","te":"అర్జునుడు తన నిజ రూపాన్ని వెల్లడిస్తాడు","ta":"அர்ஜுனன் தன்னை வெளிப்படுத்துகிறான்","ml":"അർജുനൻ തന്റെ സ്വത്വം വെളിപ്പെടുത്തുന്നു"},"40":{"hi":"अर्जुन शस्त्र धारण करते हैं","kn":"ಅರ್ಜುನನು ಆಯುಧ ಧರಿಸುವುದು","te":"అర్జునుడు ఆయుధాలు ధరిస్తాడు","ta":"அர்ஜுனன் ஆயுதம் தரித்தல்","ml":"അർജുനൻ ആയുധങ്ങൾ ധരിക്കുന്നു"},"41":{"hi":"अर्जुन का शंख","kn":"ಅರ್ಜುನನ ಶಂಖನಾದ","te":"అర్జునుడి శంఖం","ta":"அர்ஜுனனின் சங்கு","ml":"അർജുനന്റെ ശംഖനാദം"},"42":{"hi":"दुर्योधन दावा करता है कि पांडव पहचान लिए गए","kn":"ಪಾಂಡವರು ಪತ್ತೆಯಾದರೆಂದು ದುರ್ಯೋಧನನ ಹೇಳಿಕೆ","te":"పాండవులు కనిపెట్టబడ్డారని దుర్యోధనుడు అంటాడు","ta":"பாண்டவர்கள் கண்டுபிடிக்கப்பட்டதாக துரியோதனன் கூறுகிறான்","ml":"പാണ്ഡവർ കണ്ടെത്തപ്പെട്ടെന്ന് ദുര്യോധനൻ അവകാശപ്പെടുന്നു"},"43":{"hi":"कर्ण की डींग","kn":"ಕರ್ಣನ ಆತ್ಮಪ್ರಶಂಸೆ","te":"కర్ణుడి గర్వోక్తి","ta":"கர்ணனின் பெருமை பேச்சு","ml":"കർണന്റെ വീമ്പുപറച്ചിൽ"},"44":{"hi":"कृप कर्ण को फटकारते हैं","kn":"ಕರ್ಣನನ್ನು ಕೃಪರು ಖಂಡಿಸುವುದು","te":"కర్ణుడిని కృపుడు మందలిస్తాడు","ta":"கர்ணனைக் கிருபர் கடிந்துகொள்கிறார்","ml":"കൃപർ കർണനെ ശാസിക്കുന്നു"},"45":{"hi":"अश्वत्थामा का उपहास","kn":"ಅಶ್ವತ್ಥಾಮನ ತಿರಸ್ಕಾರ","te":"అశ్వత్థామ ఎగతాళి","ta":"அசுவத்தாமனின் இகழ்ச்சி","ml":"അശ്വത്ഥാമാവിന്റെ പരിഹാസം"},"46":{"hi":"भीष्म योद्धाओं में मेल कराते हैं","kn":"ಭೀಷ್ಮರು ವೀರರನ್ನು ಸಮಾಧಾನಪಡಿಸುವುದು","te":"యోధులను భీష్ముడు సమాధానపరుస్తాడు","ta":"வீரர்களைப் பீஷ்மர் சமாதானப்படுத்துகிறார்","ml":"ഭീഷ്മർ യോദ്ധാക്കളെ അനുനയിപ്പിക്കുന്നു"},"47":{"hi":"भीष्म तेरह वर्षों की गणना करते हैं","kn":"ಭೀಷ್ಮರು ಹದಿಮೂರು ವರ್ಷಗಳನ್ನು ಲೆಕ್ಕಹಾಕುವುದು","te":"భీష్ముడు పదమూడేళ్ళ గడువును లెక్కిస్తాడు","ta":"பதின்மூன்று ஆண்டுகளைப் பீஷ்மர் கணக்கிடுகிறார்","ml":"പതിമൂന്നു വർഷം ഭീഷ്മർ കണക്കുകൂട്ടുന്നു"},"48":{"hi":"अर्जुन गोधन वापस लेते हैं","kn":"ಅರ್ಜುನನು ಗೋವುಗಳನ್ನು ಮರಳಿ ಪಡೆಯುವುದು","te":"అర్జునుడు పశువులను తిరిగి తెచ్చుకుంటాడు","ta":"பசுக்களை அர்ஜுனன் மீட்கிறான்","ml":"അർജുനൻ പശുക്കളെ തിരിച്ചുപിടിക്കുന്നു"},"49":{"hi":"अर्जुन कर्ण के भाई और कर्ण को भगाते हैं","kn":"ಕರ್ಣನ ಸಹೋದರ ಮತ್ತು ಕರ್ಣನನ್ನು ಅರ್ಜುನನು ಓಡಿಸುವುದು","te":"కర్ణుడి సోదరుడిని, కర్ణుడిని అర్జునుడు ఓడిస్తాడు","ta":"கர்ணனின் சகோதரனையும் கர்ணனையும் அர்ஜுனன் வீழ்த்துகிறான்","ml":"കർണന്റെ സഹോദരനെയും കർണനെയും അർജുനൻ തോൽപ്പിക്കുന്നു"},"50":{"hi":"अर्जुन कौरव योद्धाओं के नाम बताते हैं","kn":"ಕೌರವ ವೀರರ ಹೆಸರುಗಳನ್ನು ಅರ್ಜುನನು ಹೇಳುವುದು","te":"కౌరవ యోధులను అర్జునుడు పేర్కొంటాడు","ta":"கௌரவ வீரர்களை அர்ஜுனன் அடையாளம் சொல்கிறான்","ml":"കൗരവ യോദ്ധാക്കളുടെ പേരുകൾ അർജുനൻ പറയുന്നു"},"51":{"hi":"देवता युद्ध देखने एकत्र होते हैं","kn":"ದೇವತೆಗಳು ವೀಕ್ಷಿಸಲು ಸೇರುವುದು","te":"యుద్ధాన్ని చూడటానికి దేవతలు సమకూడతారు","ta":"காண தேவர்கள் கூடுகின்றனர்","ml":"കാണാൻ ദേവന്മാർ ഒത്തുകൂടുന്നു"},"52":{"hi":"अर्जुन कृप को पराजित करते हैं","kn":"ಕೃಪರನ್ನು ಅರ್ಜುನನು ಸೋಲಿಸುವುದು","te":"కృపుడిని అర్జునుడు ఓడిస్తాడు","ta":"கிருபரை அர்ஜுனன் வெல்கிறான்","ml":"അർജുനൻ കൃപരെ തോൽപ്പിക്കുന്നു"},"53":{"hi":"अर्जुन और द्रोण","kn":"ಅರ್ಜುನ ಮತ್ತು ದ್ರೋಣರು","te":"అర్జునుడు, ద్రోణుడు","ta":"அர்ஜுனனும் துரோணரும்","ml":"അർജുനനും ദ്രോണരും"},"54":{"hi":"अर्जुन और अश्वत्थामा","kn":"ಅರ್ಜುನ ಮತ್ತು ಅಶ್ವತ್ಥಾಮ","te":"అర్జునుడు, అశ్వత్థామ","ta":"அர்ஜுனனும் அசுவத்தாமனும்","ml":"അർജുനനും അശ്വത്ഥാമാവും"},"55":{"hi":"अर्जुन कर्ण को पराजित करते हैं","kn":"ಕರ್ಣನನ್ನು ಅರ್ಜುನನು ಸೋಲಿಸುವುದು","te":"కర్ణుడిని అర్జునుడు ఓడిస్తాడు","ta":"கர்ணனை அர்ஜுனன் வெல்கிறான்","ml":"അർജുനൻ കർണനെ തോൽപ്പിക്കുന്നു"},"56":{"hi":"अर्जुन भीष्म की ओर मुड़ते हैं","kn":"ಅರ್ಜುನನು ಭೀಷ್ಮರ ಕಡೆಗೆ ತಿರುಗುವುದು","te":"అర్జునుడు భీష్ముడి వైపు తిరుగుతాడు","ta":"பீஷ்மரை நோக்கி அர்ஜுனன் திரும்புகிறான்","ml":"അർജുനൻ ഭീഷ്മരുടെ നേർക്ക് തിരിയുന്നു"},"57":{"hi":"कौरव एक साथ आक्रमण करते हैं","kn":"ಕೌರವರು ಒಟ್ಟಾಗಿ ಆಕ್ರಮಣ ಮಾಡುವುದು","te":"కౌరవులు కలిసి దాడి చేస్తారు","ta":"கௌரவர்கள் ஒன்றாகத் தாக்குகின்றனர்","ml":"കൗരവർ ഒന്നിച്ചാക്രമിക്കുന്നു"},"58":{"hi":"कौरव सेना बिखर जाती है","kn":"ಕೌರವ ಸೇನೆ ಚದುರಿ ಹೋಗುವುದು","te":"కౌరవ సైన్యం చెల్లాచెదురవుతుంది","ta":"கௌரவப் படை சிதறுகிறது","ml":"കൗരവ സേന ചിതറിപ്പോകുന്നു"},"59":{"hi":"अर्जुन और भीष्म","kn":"ಅರ್ಜುನ ಮತ್ತು ಭೀಷ್ಮರು","te":"అర్జునుడు, భీష్ముడు","ta":"அர்ஜுனனும் பீஷ்மரும்","ml":"അർജുനനും ഭീഷ്മരും"},"60":{"hi":"अर्जुन और दुर्योधन","kn":"ಅರ್ಜುನ ಮತ್ತು ದುರ್ಯೋಧನರು","te":"అర్జునుడు, దుర్యోధనుడు","ta":"அர்ஜுனனும் துரியோதனனும்","ml":"അർജുനനും ദുര്യോധനനും"},"61":{"hi":"कौरव स्तब्ध रह जाते हैं","kn":"ಕೌರವರು ಬೆರಗಾಗಿ ನಿಲ್ಲುವುದು","te":"కౌరవులు నిశ్చేష్టులవుతారు","ta":"கௌரவர்கள் திகைப்படைகின்றனர்","ml":"കൗരവർ സ്തബ്ധരാകുന്നു"},"62":{"hi":"विराट की राजधानी लौटना","kn":"ವಿರಾಟನ ನಗರಕ್ಕೆ ಹಿಂದಿರುಗುವುದು","te":"విరాటుడి నగరానికి తిరుగు ప్రయాణం","ta":"விராடனின் நகருக்குத் திரும்புதல்","ml":"വിരാടന്റെ നഗരത്തിലേക്കുള്ള മടക്കം"},"63":{"hi":"विराट युधिष्ठिर पर प्रहार करते हैं","kn":"ವಿರಾಟನು ಯುಧಿಷ್ಠಿರನನ್ನು ಹೊಡೆಯುವುದು","te":"విరాటుడు యుధిష్ఠిరుడిని కొడతాడు","ta":"யுதிட்டிரனை விராடன் தாக்குகிறான்","ml":"വിരാടൻ യുധിഷ്ഠിരനെ പ്രഹരിക്കുന്നു"},"64":{"hi":"उत्तर श्रेय एक देवपुत्र को देता है","kn":"ದೇವಪುತ್ರನಿಗೆ ಶ್ರೇಯವನ್ನು ನೀಡುವ ಉತ್ತರನು","te":"ఘనత దేవుడి కుమారుడికి ఉత్తరుడు ఇస్తాడు","ta":"வெற்றிப் பெருமையைத் தெய்வ மகனுக்கு உத்தரன் அளிக்கிறான்","ml":"ദേവപുത്രന് വിജയത്തിന്റെ ക്രെഡിറ്റ് ഉത്തരൻ നൽകുന്നു"},"65":{"hi":"पांडव राजसिंहासन ग्रहण करते हैं","kn":"ಪಾಂಡವರು ರಾಜಾಸನಗಳನ್ನು ಅಲಂಕರಿಸುವುದು","te":"పాండవులు రాజాసనాలను అధిష్ఠిస్తారు","ta":"பாண்டவர்கள் அரச இருக்கைகளில் அமர்கின்றனர்","ml":"പാണ്ഡവർ രാജാസനങ്ങൾ ഏറ്റെടുക്കുന്നു"},"66":{"hi":"पांडवों का प्रकट होना","kn":"ಪಾಂಡವರು ಬಹಿರಂಗಗೊಳ್ಳುವುದು","te":"పాండవుల వెల్లడి","ta":"பாண்டவர்கள் வெளிப்படுகின்றனர்","ml":"പാണ്ഡവർ വെളിപ്പെടുന്നു"},"67":{"hi":"अभिमन्यु और उत्तरा का विवाह","kn":"ಅಭಿಮನ್ಯು ಮತ್ತು ಉತ್ತರೆಯ ವಿವಾಹ","te":"అభిమన్యుడు, ఉత్తర వివాహం","ta":"அபிமன்யுவுக்கும் உத்தரைக்கும் திருமணம்","ml":"അഭിമന്യുവിന്റെയും ഉത്തരയുടെയും വിവാഹം"}}