{"1":{"hi":"सेनाएँ कुरुक्षेत्र में एकत्र होती हैं","kn":"ಕುರುಕ್ಷೇತ್ರದಲ್ಲಿ ಸೇನೆಗಳ ಸಮಾವೇಶ","te":"కురుక్షేత్రంలో సైన్యాలు సమకూడతాయి","ta":"குருக்ஷேத்திரத்தில் படைகள் கூடுகின்றன","ml":"കുരുക്ഷേത്രത്തിൽ സേനകൾ അണിനിരക്കുന്നു"},"2":{"hi":"व्यास अपशकुनों की भविष्यवाणी करते हैं","kn":"ವ್ಯಾಸರು ಅಪಶಕುನಗಳನ್ನು ಮುಂತಿಳಿಸುವುದು","te":"శకునాలను వ్యాసుడు ముందే చెబుతాడు","ta":"சகுனங்களை வியாசர் முன்னுரைக்கிறார்","ml":"ദുശ്ശകുനങ്ങളെക്കുറിച്ച് വ്യാസൻ പ്രവചിക്കുന്നു"},"3":{"hi":"युद्ध के और अपशकुन","kn":"ಯುದ್ಧದ ಇನ್ನಷ್ಟು ಅಪಶಕುನಗಳು","te":"యుద్ధానికి సంబంధించిన మరిన్ని శకునాలు","ta":"போரின் மேலும் சகுனங்கள்","ml":"യുദ്ധത്തിന്റെ കൂടുതൽ ദുശ്ശകുനങ്ങൾ"},"4":{"hi":"व्यास भाग्य और आने वाले युद्ध पर","kn":"ವಿಧಿ ಮತ್ತು ಮುಂಬರುವ ಯುದ್ಧದ ಬಗ್ಗೆ ವ್ಯಾಸರು","te":"విధి, రాబోయే యుద్ధం గురించి వ్యాసుడు","ta":"விதியும் வரவிருக்கும் போரும் பற்றி வியாசர்","ml":"വിധിയെക്കുറിച്ചും വരാനിരിക്കുന്ന യുദ്ധത്തെക്കുറിച്ചും വ്യാസൻ"},"5":{"hi":"धृतराष्ट्र पृथ्वी के विषय में पूछते हैं","kn":"ಭೂಮಿಯ ಬಗ್ಗೆ ಧೃತರಾಷ್ಟ್ರನ ಪ್ರಶ್ನೆ","te":"భూమి గురించి ధృతరాష్ట్రుడు అడుగుతాడు","ta":"பூமியைப் பற்றி திருதராஷ்டிரர் கேட்கிறார்","ml":"ഭൂമിയെക്കുറിച്ച് ധൃതരാഷ്ട്രർ ചോദിക്കുന്നു"},"6":{"hi":"नदियाँ, पर्वत और देश","kn":"ನದಿಗಳು, ಪರ್ವತಗಳು ಮತ್ತು ದೇಶಗಳು","te":"నదులు, పర్వతాలు, దేశాలు","ta":"ஆறுகள், மலைகள், நாடுகள்","ml":"നദികൾ, പർവതങ്ങൾ, രാജ്യങ്ങൾ"},"7":{"hi":"जंबूद्वीप और उसके पर्वत","kn":"ಜಂಬೂದ್ವೀಪ ಮತ್ತು ಅದರ ಪರ್ವತಗಳು","te":"జంబూద్వీపం, దాని పర్వతాలు","ta":"ஜம்புத்வீபமும் அதன் மலைகளும்","ml":"ജംബുദ്വീപും അതിലെ പർവതങ്ങളും"},"8":{"hi":"उत्तरी देश और मेरु पर्वत","kn":"ಉತ್ತರ ದೇಶಗಳು ಮತ್ತು ಮೇರು ಪರ್ವತ","te":"ఉత్తర దేశాలు, మేరు పర్వతం","ta":"வடநாடுகளும் மேரு மலையும்","ml":"ഉത്തരദേശങ്ങളും മേരു പർവതവും"},"9":{"hi":"वर्ष और उनके लोग","kn":"ವರ್ಷಗಳು ಮತ್ತು ಅವುಗಳ ಜನರು","te":"వర్షాలు, వాటి ప్రజలు","ta":"வர்ஷங்களும் அங்குள்ள மக்களும்","ml":"വർഷങ്ങളും അവിടത്തെ ജനങ്ങളും"},"10":{"hi":"भारत भूमि","kn":"ಭರತವರ್ಷ","te":"భారతవర్షం","ta":"பாரத வர்ஷம்","ml":"ഭാരതവർഷം"},"11":{"hi":"हरिवर्ष और युग","kn":"ಹರಿವರ್ಷ ಮತ್ತು ಯುಗಗಳು","te":"హరివర్షం, యుగాలు","ta":"ஹரிவர்ஷமும் யுகங்களும்","ml":"ഹരിവർഷവും യുഗങ്ങളും"},"12":{"hi":"शाक द्वीप और अन्य द्वीप","kn":"ಶಾಕದ್ವೀಪ ಮತ್ತು ಇತರ ದ್ವೀಪಗಳು","te":"శాకద్వీపం, ఇతర ద్వీపాలు","ta":"ஷாக தீவும் பிற த்வீபங்களும்","ml":"ശാകദ്വീപും മറ്റു ദ്വീപുകളും"},"13":{"hi":"दूरस्थ द्वीप, राहु और चंद्रमा","kn":"ದೂರದ ದ್ವೀಪಗಳು, ರಾಹು ಮತ್ತು ಚಂದ್ರ","te":"సుదూర ద్వీపాలు, రాహువు, చంద్రుడు","ta":"தொலைதூரத் தீவுகளும் ராகுவும் சந்திரனும்","ml":"വിദൂര ദ്വീപുകളും രാഹുവും ചന്ദ്രനും"},"14":{"hi":"संजय भीष्म के गिरने का समाचार लाते हैं","kn":"ಭೀಷ್ಮರ ಪತನದ ಸುದ್ದಿ ತಂದ ಸಂಜಯ","te":"భీష్ముడి పతనం వార్తను సంజయుడు తెస్తాడు","ta":"பீஷ்மரின் வீழ்ச்சிச் செய்தியை சஞ்சயன் கொண்டு வருகிறான்","ml":"ഭീഷ്മരുടെ പതനവാർത്തയുമായി സഞ്ജയൻ എത്തുന്നു"},"15":{"hi":"धृतराष्ट्र विलाप करते हैं","kn":"ಧೃತರಾಷ್ಟ್ರನ ಶೋಕ","te":"ధృతరాష్ట్రుడి విలాపం","ta":"திருதராஷ்டிரர் புலம்புகிறார்","ml":"ധൃതരാഷ്ട്രർ വിലപിക്കുന്നു"},"16":{"hi":"संजय राजा को उत्तर देते हैं","kn":"ಅರಸನಿಗೆ ಸಂಜಯನ ಉತ್ತರ","te":"రాజుకు సంజయుడి సమాధానం","ta":"மன்னனுக்கு சஞ்சயன் பதிலளிக்கிறான்","ml":"സഞ്ജയൻ രാജാവിന് മറുപടി നൽകുന്നു"},"17":{"hi":"राजा एकत्र होते हैं और युद्ध के नियम","kn":"ರಾಜರ ಸಮಾವೇಶ ಮತ್ತು ಯುದ್ಧದ ನಿಯಮಗಳು","te":"రాజులు సమకూడతారు; యుద్ధ నియమాలు","ta":"மன்னர்கள் கூடுதலும் போர் விதிகளும்","ml":"രാജാക്കന്മാർ ഒത്തുകൂടുന്നു; യുദ്ധനിയമങ്ങൾ"},"18":{"hi":"भीष्म के नेतृत्व में कौरव सेना","kn":"ಭೀಷ್ಮರ ನೇತೃತ್ವದಲ್ಲಿ ಕೌರವ ಸೇನೆ","te":"భీష్ముడి ఆధ్వర్యంలో కౌరవ సైన్యం","ta":"பீஷ்மரின் தலைமையில் கௌரவப் படை","ml":"ഭീഷ്മരുടെ കീഴിൽ കൗരവസേന"},"19":{"hi":"पांडव व्यूह","kn":"ಪಾಂಡವ ವ್ಯೂಹ","te":"పాండవ వ్యూహం","ta":"பாண்டவப் படை அணிவகுப்பு","ml":"പാണ്ഡവ വ്യൂഹം"},"20":{"hi":"पहले किसने हर्ष मनाया","kn":"ಮೊದಲು ಸಂತೋಷಪಟ್ಟವರು ಯಾರು","te":"మొదట ఎవరు సంతోషించారు","ta":"முதலில் மகிழ்ந்தவர் யார்","ml":"ആദ്യം ആനന്ദിച്ചത് ആര്?"},"21":{"hi":"युधिष्ठिर की निराशा","kn":"ಯುಧಿಷ್ಠಿರನ ನಿರಾಶೆ","te":"యుధిష్ఠిరుడి నిరాశ","ta":"யுதிட்டிரனின் துயரம்","ml":"യുധിഷ്ഠിരന്റെ നിരാശ"},"22":{"hi":"पांडव व्यूह और युद्ध की पहली ध्वनियाँ","kn":"ಪಾಂಡವ ವ್ಯೂಹ ಮತ್ತು ಯುದ್ಧದ ಮೊದಲ ಶಬ್ದಗಳು","te":"పాండవ వ్యూహం; యుద్ధ ధ్వనుల ఆరంభం","ta":"பாண்டவப் படை அணிவகுப்பும் போரின் முதல் ஒலிகளும்","ml":"പാണ്ഡവ വ്യൂഹവും യുദ്ധത്തിന്റെ ആദ്യ ശബ്ദങ്ങളും"},"41":{"hi":"युधिष्ठिर बड़ों का आशीर्वाद माँगते हैं","kn":"ಹಿರಿಯರ ಆಶೀರ್ವಾದ ಬೇಡುವ ಯುಧಿಷ್ಠಿರ","te":"పెద్దల ఆశీర్వాదం కోరతాడు యుధిష్ఠిరుడు","ta":"பெரியோர்களின் ஆசியை யுதிட்டிரன் நாடுகிறான்","ml":"യുധിഷ്ഠിരൻ മുതിർന്നവരുടെ അനുഗ്രഹം തേടുന്നു"},"42":{"hi":"दोनों सेनाओं की पहली भिड़ंत","kn":"ಎರಡು ಸೇನೆಗಳ ಮೊದಲ ಮುಖಾಮುಖಿ","te":"రెండు సైన్యాల మొదటి ఘర్షణ","ta":"இரு படைகளின் முதல் மோதல்","ml":"ഇരുസേനകളുടെ ആദ്യ ഏറ്റുമുട്ടൽ"},"43":{"hi":"पहला दिन: प्रातःकाल का युद्ध","kn":"ಮೊದಲ ದಿನ: ಬೆಳಗಿನ ಹೋರಾಟ","te":"మొదటి రోజు: ఉదయం పోరాటం","ta":"முதல் நாள்: காலைப் போர்","ml":"ഒന്നാം ദിനം: രാവിലത്തെ പോരാട്ടം"},"44":{"hi":"पहला दिन: अनियंत्रित संहार","kn":"ಮೊದಲ ದಿನ: ಹತೋಟಿಯಿಲ್ಲದ ಮಾರಣಹೋಮ","te":"మొదటి రోజు: అదుపు లేని మారణకాండ","ta":"முதல் நாள்: கட்டுக்கடங்காத படுகொலை","ml":"ഒന്നാം ദിനം: നിയന്ത്രണമില്ലാത്ത കൂട്ടക്കൊല"},"45":{"hi":"पहला दिन: भीष्म पांडवों को पीछे हटाते हैं","kn":"ಮೊದಲ ದಿನ: ಪಾಂಡವರನ್ನು ಭೀಷ್ಮರು ಹಿಮ್ಮೆಟ್ಟಿಸುವುದು","te":"మొదటి రోజు: పాండవులను భీష్ముడు వెనక్కి తరుముతాడు","ta":"முதல் நாள்: பாண்டவர்களைப் பீஷ்மர் பின்னுக்குத் தள்ளுகிறார்","ml":"ഒന്നാം ദിനം: ഭീഷ്മർ പാണ്ഡവരെ പിന്നോട്ടോടിക്കുന്നു"},"46":{"hi":"युधिष्ठिर का शोक और क्रौंच व्यूह","kn":"ಯುಧಿಷ್ಠಿರನ ದುಃಖ ಮತ್ತು ಕ್ರೌಂಚ ವ್ಯೂಹ","te":"యుధిష్ఠిరుడి దుఃఖం; క్రౌంచ వ్యూహం","ta":"யுதிட்டிரனின் துயரமும் கிரௌஞ்ச வியூகமும்","ml":"യുധിഷ്ഠിരന്റെ ദുഃഖവും ക്രൗഞ്ചവ്യൂഹവും"},"47":{"hi":"दूसरा दिन: दोनों व्यूह","kn":"ಎರಡನೆಯ ದಿನ: ಎರಡು ವ್ಯೂಹಗಳು","te":"రెండవ రోజు: రెండు వ్యూహాలు","ta":"இரண்டாம் நாள்: இரு அணிவகுப்புகள்","ml":"രണ്ടാം ദിനം: ഇരുവ്യൂഹങ്ങൾ"},"48":{"hi":"दूसरा दिन: द्रोण और धृष्टद्युम्न","kn":"ಎರಡನೆಯ ದಿನ: ದ್ರೋಣ ಮತ್ತು ಧೃಷ್ಟದ್ಯುಮ್ನ","te":"రెండవ రోజు: ద్రోణుడు, ధృష్టద్యుమ్నుడు","ta":"இரண்டாம் நாள்: துரோணரும் திருஷ்டத்யும்னனும்","ml":"രണ്ടാം ദിനം: ദ്രോണരും ധൃഷ്ടദ്യുമ്നനും"},"49":{"hi":"द्रोण धृष्टद्युम्न के विरुद्ध","kn":"ಧೃಷ್ಟದ್ಯುಮ್ನನ ವಿರುದ್ಧ ದ್ರೋಣ","te":"ధృష్టద్యుమ్నుడిపై ద్రోణుడు","ta":"திருஷ்டத்யும்னனுக்கு எதிராக துரோணர்","ml":"ദ്രോണർ ധൃഷ്ടദ്യുമ്നനെതിരെ"},"50":{"hi":"भीम कलिंग सेना का नाश करते हैं","kn":"ಕಳಿಂಗ ಸೇನೆಯನ್ನು ಭೀಮನು ನಾಶಗೊಳಿಸುವುದು","te":"కళింగ సైన్యాన్ని భీముడు నాశనం చేస్తాడు","ta":"கலிங்கப் படையை பீமன் அழிக்கிறான்","ml":"ഭീമൻ കലിംഗസേനയെ നശിപ്പിക്കുന്നു"},"51":{"hi":"दूसरा दिन: अर्जुन का पराक्रम","kn":"ಎರಡನೆಯ ದಿನ: ಅರ್ಜುನನ ಪರಾಕ್ರಮ","te":"రెండవ రోజు: అర్జునుడి పరాక్రమం","ta":"இரண்டாம் நாள்: அர்ஜுனனின் வலிமை","ml":"രണ്ടാം ദിനം: അർജുനന്റെ വീര്യം"},"52":{"hi":"तीसरा दिन: गरुड़ और अर्धचंद्र व्यूह","kn":"ಮೂರನೆಯ ದಿನ: ಗರುಡ ಮತ್ತು ಅರ್ಧಚಂದ್ರ ವ್ಯೂಹಗಳು","te":"మూడవ రోజు: గరుడ, అర్ధచంద్ర వ్యూహాలు","ta":"மூன்றாம் நாள்: கருட, அர்த்தசந்திர வியூகங்கள்","ml":"മൂന്നാം ദിനം: ഗരുഡവ്യൂഹവും അർധചന്ദ്രവ്യൂഹവും"},"53":{"hi":"तीसरा दिन: अर्जुन कौरवों को भगाते हैं","kn":"ಮೂರನೆಯ ದಿನ: ಕೌರವರನ್ನು ಅರ್ಜುನನು ಓಡಿಸುವುದು","te":"మూడవ రోజు: అర్జునుడు కౌరవులను ఓడిస్తాడు","ta":"மூன்றாம் நாள்: கௌரவர்களை அர்ஜுனன் விரட்டுகிறான்","ml":"മൂന്നാം ദിനം: അർജുനൻ കൗരവരെ തുരത്തുന്നു"},"54":{"hi":"तीसरा दिन: दुर्योधन भीष्म को फटकारता है","kn":"ಮೂರನೆಯ ದಿನ: ಭೀಷ್ಮರನ್ನು ದುರ್ಯೋಧನನು ಖಂಡಿಸುವುದು","te":"మూడవ రోజు: భీష్ముడిని దుర్యోధనుడు మందలిస్తాడు","ta":"மூன்றாம் நாள்: பீஷ்மரைத் துரியோதனன் கண்டிக்கிறான்","ml":"മൂന്നാം ദിനം: ഭീഷ്മരെ ദുര്യോധനൻ ശാസിക്കുന്നു"},"55":{"hi":"कृष्ण चक्र उठाते हैं","kn":"ಚಕ್ರವನ್ನು ಕೈಗೆತ್ತಿಕೊಳ್ಳುವ ಕೃಷ್ಣ","te":"చక్రాన్ని కృష్ణుడు చేపడతాడు","ta":"சக்கரத்தைக் கையில் எடுக்கிறான் கிருஷ்ணன்","ml":"കൃഷ്ണൻ ചക്രം കയ്യിലെടുക്കുന്നു"},"56":{"hi":"चौथा दिन: अर्जुन भीष्म के विरुद्ध","kn":"ನಾಲ್ಕನೆಯ ದಿನ: ಭೀಷ್ಮರ ವಿರುದ್ಧ ಅರ್ಜುನ","te":"నాలుగవ రోజు: భీష్ముడిపై అర్జునుడు","ta":"நான்காம் நாள்: பீஷ்மருக்கு எதிராக அர்ஜுனன்","ml":"നാലാം ദിനം: അർജുനൻ ഭീഷ്മരെതിരെ"},"57":{"hi":"चौथा दिन: युद्ध में अभिमन्यु","kn":"ನಾಲ್ಕನೆಯ ದಿನ: ಕಾಳಗದಲ್ಲಿ ಅಭಿಮನ್ಯು","te":"నాలుగవ రోజు: యుద్ధంలో అభిమన్యుడు","ta":"நான்காம் நாள்: போரில் அபிமன்யு","ml":"നാലാം ദിനം: അഭിമന്യു പോരാട്ടത്തിൽ"},"58":{"hi":"चौथा दिन: हाथियों के बीच भीम","kn":"ನಾಲ್ಕನೆಯ ದಿನ: ಆನೆಗಳ ನಡುವೆ ಭೀಮ","te":"నాలుగవ రోజు: ఏనుగుల మధ్య భీముడు","ta":"நான்காம் நாள்: யானைகளிடையே பீமன்","ml":"നാലാം ദിനം: ആനകൾക്കിടയിൽ ഭീമൻ"},"59":{"hi":"चौथा दिन: भीम और कौरव भाई","kn":"ನಾಲ್ಕನೆಯ ದಿನ: ಭೀಮ ಮತ್ತು ಕೌರವ ಸೋದರರು","te":"నాలుగవ రోజు: భీముడు, కౌరవ సోదరులు","ta":"நான்காம் நாள்: பீமனும் கௌரவ சகோதரர்களும்","ml":"നാലാം ദിനം: ഭീമനും കൗരവ സഹോദരന്മാരും"},"60":{"hi":"चौथा दिन: दुर्योधन के भाइयों का पतन","kn":"ನಾಲ್ಕನೆಯ ದಿನ: ದುರ್ಯೋಧನನ ಸೋದರರ ಪತನ","te":"నాలుగవ రోజు: దుర్యోధనుడి సోదరులు పడిపోతారు","ta":"நான்காம் நாள்: துரியோதனனின் சகோதரர்கள் வீழ்கின்றனர்","ml":"നാലാം ദിനം: ദുര്യോധനന്റെ സഹോദരന്മാർ വീഴുന്നു"},"61":{"hi":"दुर्योधन का भय और भीष्म की नारायण-स्तुति","kn":"ದುರ್ಯೋಧನನ ಭಯ ಮತ್ತು ನಾರಾಯಣನ ಕುರಿತ ಭೀಷ್ಮರ ಸ್ತೋತ್ರ","te":"దుర్యోధనుడి భయం; నారాయణుడికి భీష్ముడి స్తోత్రం","ta":"துரியோதனனின் அச்சமும் நாராயணரைப் பீஷ்மர் போற்றுதலும்","ml":"ദുര്യോധനന്റെ ഭയവും നാരായണസ്തുതിയും ഭീഷ്മരുടേത്"},"62":{"hi":"नारायण, नर और कृष्ण का जन्म","kn":"ನಾರಾಯಣ, ನರ ಮತ್ತು ಕೃಷ್ಣನ ಜನನ","te":"నారాయణుడు, నరుడు, కృష్ణుడి జననం","ta":"நாராயணர், நரர், கிருஷ்ணனின் பிறப்பு","ml":"നാരായണൻ, നരൻ, കൃഷ്ണന്റെ ജനനം"},"63":{"hi":"वासुदेव की महिमा","kn":"ವಾಸುದೇವನ ಮಹಿಮೆ","te":"వసుదేవుడి మహిమ","ta":"வாசுதேவரின் மகிமை","ml":"വാസുദേവന്റെ മഹിമ"},"64":{"hi":"भीष्म का संधि का परामर्श","kn":"ಸಂಧಿ ಮಾಡಿಕೊಳ್ಳಲು ಭೀಷ್ಮರ ಸಲಹೆ","te":"సంధి చేసుకోమని భీష్ముడి హితవు","ta":"சமாதானம் செய்ய பீஷ்மரின் ஆலோசனை","ml":"സന്ധിയുണ്ടാക്കാൻ ഭീഷ്മരുടെ ഉപദേശം"},"65":{"hi":"पाँचवाँ दिन आरंभ","kn":"ಐದನೆಯ ದಿನ ಆರಂಭ","te":"ఐదవ రోజు ప్రారంభమవుతుంది","ta":"ஐந்தாம் நாள் தொடங்குகிறது","ml":"അഞ്ചാം ദിനം ആരംഭിക്കുന്നു"},"66":{"hi":"पाँचवाँ दिन: भीष्म अपने पुत्रों के लिए लड़ते हैं","kn":"ಐದನೆಯ ದಿನ: ತನ್ನ ಮಕ್ಕಳಿಗಾಗಿ ಭೀಷ್ಮರ ಹೋರಾಟ","te":"ఐదవ రోజు: తన కుమారుల కోసం భీష్ముడు పోరాడతాడు","ta":"ஐந்தாம் நாள்: தன் மகன்களுக்காக பீஷ்மர் போரிடுகிறார்","ml":"അഞ്ചാം ദിനം: തന്റെ പുത്രന്മാർക്കായി ഭീഷ്മർ പോരാടുന്നു"},"67":{"hi":"पाँचवाँ दिन: अर्जुन की गर्जना","kn":"ಐದನೆಯ ದಿನ: ಅರ್ಜುನನ ಸಿಂಹನಾದ","te":"ఐదవ రోజు: అర్జునుడి గర్జన","ta":"ஐந்தாம் நாள்: அர்ஜுனனின் முழக்கம்","ml":"അഞ്ചാം ദിനം: അർജുനന്റെ സിംഹനാദം"},"68":{"hi":"पाँचवाँ दिन: शिखंडी और भीष्म","kn":"ಐದನೆಯ ದಿನ: ಶಿಖಂಡಿ ಮತ್ತು ಭೀಷ್ಮರು","te":"ఐదవ రోజు: శిఖండి, భీష్ముడు","ta":"ஐந்தாம் நாள்: சிகண்டியும் பீஷ்மரும்","ml":"അഞ്ചാം ദിനം: ശിഖണ്ഡിയും ഭീഷ്മരും"},"69":{"hi":"पाँचवाँ दिन: विराट और भीष्म","kn":"ಐದನೆಯ ದಿನ: ವಿರಾಟ ಮತ್ತು ಭೀಷ್ಮರು","te":"ఐదవ రోజు: విరాటుడు, భీష్ముడు","ta":"ஐந்தாம் நாள்: விராடனும் பீஷ்மரும்","ml":"അഞ്ചാം ദിനം: വിരാടനും ഭീഷ്മരും"},"70":{"hi":"पाँचवाँ दिन: सात्यकि का आक्रमण और सायंकाल","kn":"ಐದನೆಯ ದಿನ: ಸಾತ್ಯಕಿಯ ಆಕ್ರಮಣ ಮತ್ತು ಸಂಜೆ","te":"ఐదవ రోజు: సాత్యకి దాడి, సాయంకాలం","ta":"ஐந்தாம் நாள்: சாத்யகியின் தாக்குதலும் மாலைப் பொழுதும்","ml":"അഞ്ചാം ദിനം: സാത്യകിയുടെ ആക്രമണവും സായാഹ്നവും"},"71":{"hi":"छठा दिन: व्यूह","kn":"ಆರನೆಯ ದಿನ: ವ್ಯೂಹಗಳು","te":"ఆరవ రోజు: వ్యూహాలు","ta":"ஆறாம் நாள்: அணிவகுப்புகள்","ml":"ആറാം ദിനം: വ്യൂഹങ്ങൾ"},"72":{"hi":"धृतराष्ट्र अपनी सेना पर विस्मित होते हैं","kn":"ತನ್ನ ಸೇನೆಯನ್ನು ಕಂಡು ಧೃತರಾಷ್ಟ್ರನ ವಿಸ್ಮಯ","te":"తన సైన్యాన్ని చూసి ధృతరాష్ట్రుడు ఆశ్చర్యపోతాడు","ta":"தன் படையைக் கண்டு திருதராஷ்டிரர் வியக்கிறார்","ml":"സ്വന്തം സേനയെക്കുറിച്ച് ധൃതരാഷ്ട്രരുടെ അത്ഭുതം"},"73":{"hi":"छठा दिन: कौरवों के बीच भीम","kn":"ಆರನೆಯ ದಿನ: ಕೌರವರ ನಡುವೆ ಭೀಮ","te":"ఆరవ రోజు: కౌరవుల మధ్య భీముడు","ta":"ஆறாம் நாள்: கௌரவர்களிடையே பீமன்","ml":"ആറാം ദിനം: കൗരവർക്കിടയിൽ ഭീമൻ"},"74":{"hi":"छठा दिन: कौरव राजकुमार भीम के विरुद्ध","kn":"ಆರನೆಯ ದಿನ: ಭೀಮನ ವಿರುದ್ಧ ಕೌರವ ರಾಜಕುಮಾರರು","te":"ఆరవ రోజు: భీముడిపై కౌరవ రాకుమారులు","ta":"ஆறாம் நாள்: பீமனுக்கு எதிராக கௌரவ இளவரசர்கள்","ml":"ആറാം ദിനം: കൗരവ രാജകുമാരന്മാർ ഭീമനെതിരെ"},"75":{"hi":"छठा दिन: भीम की प्रतिज्ञा और दुर्योधन के घाव","kn":"ಆರನೆಯ ದಿನ: ಭೀಮನ ಪ್ರತಿಜ್ಞೆ ಮತ್ತು ದುರ್ಯೋಧನನ ಗಾಯಗಳು","te":"ఆరవ రోజు: భీముడి ప్రతిజ్ఞ, దుర్యోధనుడి గాయాలు","ta":"ஆறாம் நாள்: பீமனின் சபதமும் துரியோதனனின் காயங்களும்","ml":"ആറാം ദിനം: ഭീമന്റെ പ്രതിജ്ഞയും ദുര്യോധനന്റെ മുറിവുകളും"},"76":{"hi":"छठा दिन: मकर व्यूह","kn":"ಆರನೆಯ ದಿನ: ಮಕರ ವ್ಯೂಹ","te":"ఆరవ రోజు: మకర వ్యూహం","ta":"ஆறாம் நாள்: மகர வியூகம்","ml":"ആറാം ദിനം: മകരവ്യൂഹം"},"77":{"hi":"सातवाँ दिन: भीष्म दुर्योधन को ढाढ़स बँधाते हैं","kn":"ಏಳನೆಯ ದಿನ: ದುರ್ಯೋಧನನನ್ನು ಭೀಷ್ಮರು ಸಂತೈಸುವುದು","te":"ఏడవ రోజు: దుర్యోధనుడిని భీష్ముడు ఓదారుస్తాడు","ta":"ஏழாம் நாள்: துரியோதனனுக்கு பீஷ்மர் ஆறுதல் கூறுகிறார்","ml":"ഏഴാം ദിനം: ദുര്യോധനനെ ഭീഷ്മർ ആശ്വസിപ്പിക്കുന്നു"},"78":{"hi":"सातवाँ दिन: विराट और द्रोण का पुत्र","kn":"ಏಳನೆಯ ದಿನ: ವಿರಾಟ ಮತ್ತು ದ್ರೋಣನ ಮಗ","te":"ఏడవ రోజు: విరాటుడు, ద్రోణుడి కుమారుడు","ta":"ஏழாம் நாள்: விராடனும் துரோணரின் மகனும்","ml":"ഏഴാം ദിനം: വിരാടനും ദ്രോണപുത്രനും"},"79":{"hi":"सातवाँ दिन: धृतराष्ट्र और द्वंद्व युद्ध","kn":"ಏಳನೆಯ ದಿನ: ಧೃತರಾಷ್ಟ್ರ ಮತ್ತು ದ್ವಂದ್ವ ಯುದ್ಧಗಳು","te":"ఏడవ రోజు: ధృతరాష్ట్రుడు, ద్వంద్వ పోరాటాలు","ta":"ஏழாம் நாள்: திருதராஷ்டிரனும் தனிப்போர்களும்","ml":"ഏഴാം ദിനം: ധൃതരാഷ്ട്രരും ദ്വന്ദ്വയുദ്ധങ്ങളും"},"80":{"hi":"सातवाँ दिन: युधिष्ठिर और अभिमन्यु","kn":"ಏಳನೆಯ ದಿನ: ಯುಧಿಷ್ಠಿರ ಮತ್ತು ಅಭಿಮನ್ಯು","te":"ఏడవ రోజు: యుధిష్ఠిరుడు, అభిమన్యుడు","ta":"ஏழாம் நாள்: யுதிட்டிரனும் அபிமன்யுவும்","ml":"ഏഴാം ദിനം: യുധിഷ്ഠിരനും അഭിമന്യുവും"},"81":{"hi":"सातवाँ दिन: अर्जुन और भीष्म","kn":"ಏಳನೆಯ ದಿನ: ಅರ್ಜುನ ಮತ್ತು ಭೀಷ್ಮರು","te":"ఏడవ రోజు: అర్జునుడు, భీష్ముడు","ta":"ஏழாம் நாள்: அர்ஜுனனும் பீஷ்மரும்","ml":"ഏഴാം ദിനം: അർജുനനും ഭീഷ്മരും"},"82":{"hi":"सातवाँ दिन: रात्रि-युद्ध का अंत","kn":"ಏಳನೆಯ ದಿನ: ರಾತ್ರಿ ಯುದ್ಧದ ಅಂತ್ಯ","te":"ఏడవ రోజు: రాత్రి యుద్ధం ముగుస్తుంది","ta":"ஏழாம் நாள்: இரவுப் போர் முடிகிறது","ml":"ഏഴാം ദിനം: രാത്രിയുദ്ധം അവസാനിക്കുന്നു"},"83":{"hi":"आठवाँ दिन आरंभ","kn":"ಎಂಟನೆಯ ದಿನ ಆರಂಭ","te":"ఎనిమిదవ రోజు ప్రారంభమవుతుంది","ta":"எட்டாம் நாள் தொடங்குகிறது","ml":"എട്ടാം ദിനം ആരംഭിക്കുന്നു"},"84":{"hi":"आठवाँ दिन: भीष्म प्रज्वलित होते हैं","kn":"ಎಂಟನೆಯ ದಿನ: ಭೀಷ್ಮರ ಆರ್ಭಟ","te":"ఎనిమిదవ రోజు: భీష్ముడు ప్రజ్వలిస్తాడు","ta":"எட்டாம் நாள்: பீஷ்மர் கொழுந்துவிட்டெரிகிறார்","ml":"എട്ടാം ദിനം: ഭീഷ്മർ ജ്വലിക്കുന്നു"},"85":{"hi":"धृतराष्ट्र का विलाप","kn":"ಧೃತರಾಷ್ಟ್ರನ ಶೋಕ","te":"ధృతరాష్ట్రుడి విలాపం","ta":"திருதராஷ்டிரரின் புலம்பல்","ml":"ധൃതരാഷ്ട്രരുടെ വിലാപം"},"86":{"hi":"आठवाँ दिन: शकुनि के पुत्र, इरावान की मृत्यु","kn":"ಎಂಟನೆಯ ದಿನ: ಶಕುನಿಯ ಮಕ್ಕಳು, ಐರಾವಾನನ ಮರಣ","te":"ఎనిమిదవ రోజు: శకుని కుమారులు, ఇరావంతుడి మరణం","ta":"எட்டாம் நாள்: சகுனியின் மகன்கள், இராவானின் மரணம்","ml":"എട്ടാം ദിനം: ശകുനിയുടെ പുത്രന്മാർ; ഇരാവാന്റെ വധം"},"87":{"hi":"घटोत्कच का क्रोध","kn":"ಘಟೋತ್ಕಚನ ಕೋಪ","te":"ఘటోత్కచుడి ఆగ్రహం","ta":"கடோத்கஜனின் ஆவேசம்","ml":"ഘടോത്കചന്റെ രോഷം"},"88":{"hi":"आठवाँ दिन: दुर्योधन और राक्षस","kn":"ಎಂಟನೆಯ ದಿನ: ದುರ್ಯೋಧನ ಮತ್ತು ರಾಕ್ಷಸ","te":"ఎనిమిదవ రోజు: దుర్యోధనుడు, రాక్షసుడు","ta":"எட்டாம் நாள்: துரியோதனனும் அரக்கனும்","ml":"എട്ടാം ദിനം: ദുര്യോധനനും രാക്ഷസനും"},"89":{"hi":"आठवाँ दिन: भीम रणभूमि पहुँचते हैं","kn":"ಎಂಟನೆಯ ದಿನ: ರಣರಂಗ ತಲುಪುವ ಭೀಮ","te":"ఎనిమిదవ రోజు: భీముడు రణరంగానికి చేరుకుంటాడు","ta":"எட்டாம் நாள்: போர்க்களத்தை பீமன் அடைகிறான்","ml":"എട്ടാം ദിനം: ഭീമൻ യുദ്ധഭൂമിയിലെത്തുന്നു"},"90":{"hi":"आठवाँ दिन: दुर्योधन भीम के विरुद्ध","kn":"ಎಂಟನೆಯ ದಿನ: ಭೀಮನ ವಿರುದ್ಧ ದುರ್ಯೋಧನ","te":"ఎనిమిదవ రోజు: భీముడిపై దుర్యోధనుడు","ta":"எட்டாம் நாள்: பீமனுக்கு எதிராக துரியோதனன்","ml":"എട്ടാം ദിനം: ദുര്യോധനൻ ഭീമനെതിരെ"},"91":{"hi":"दुर्योधन भीष्म को समाचार देता है","kn":"ಭೀಷ್ಮರಿಗೆ ದುರ್ಯೋಧನನ ವರದಿ","te":"భీష్ముడికి దుర్యోధనుడు నివేదిస్తాడు","ta":"பீஷ்மரிடம் துரியோதனன் அறிவிக்கிறான்","ml":"ദുര്യോധനൻ ഭീഷ്മരെ വിവരം അറിയിക്കുന്നു"},"92":{"hi":"अर्जुन का शोक और आठवीं रात","kn":"ಅರ್ಜುನನ ದುಃಖ ಮತ್ತು ಎಂಟನೆಯ ರಾತ್ರಿ","te":"అర్జునుడి దుఃఖం, ఎనిమిదవ రాత్రి","ta":"அர்ஜுனனின் துயரமும் எட்டாம் இரவும்","ml":"അർജുനന്റെ ദുഃഖവും എട്ടാം രാത്രിയും"},"93":{"hi":"दुर्योधन की मंत्रणा","kn":"ದುರ್ಯೋಧನನ ಮಂತ್ರಾಲೋಚನೆ","te":"దుర్యోధనుడి మంత్రాంగం","ta":"துரியோதனனின் ஆலோசனைக் கூட்டம்","ml":"ദുര്യോധനന്റെ ആലോചനായോഗം"},"94":{"hi":"भीष्म का उत्तर और शिखंडी को न मारने का निर्णय","kn":"ಶಿಖಂಡಿಯನ್ನು ಕೊಲ್ಲಲು ನಿರಾಕರಿಸಿದ ಭೀಷ್ಮರ ಉತ್ತರ","te":"భీష్ముడి సమాధానం; శిఖండిని వధించడానికి నిరాకరణ","ta":"பீஷ்மரின் பதில்; சிகண்டியைக் கொல்ல அவர் மறுத்தல்","ml":"ഭീഷ്മരുടെ മറുപടിയും ശിഖണ്ഡിയെ വധിക്കാനുള്ള വിസമ്മതവും"},"95":{"hi":"नौवाँ दिन: सेनाएँ निकलती हैं","kn":"ಒಂಬತ್ತನೆಯ ದಿನ: ಸೇನೆಗಳ ಹೊರಡುವಿಕೆ","te":"తొమ్మిదవ రోజు: సైన్యాలు బయలుదేరతాయి","ta":"ஒன்பதாம் நாள்: படைகள் புறப்படுகின்றன","ml":"ഒൻപതാം ദിനം: സേനകൾ പുറപ്പെടുന്നു"},"96":{"hi":"नौवाँ दिन: अभिमन्यु और राक्षस अलंबुष","kn":"ಒಂಬತ್ತನೆಯ ದಿನ: ಅಭಿಮನ್ಯು ಮತ್ತು ರಾಕ್ಷಸ ಅಲಂಬುಷ","te":"తొమ్మిదవ రోజు: అభిమన్యుడు, రాక్షసుడు అలంబుసుడు","ta":"ஒன்பதாம் நாள்: அபிமன்யுவும் அரக்கன் அலம்புஷனும்","ml":"ഒൻപതാം ദിനം: അഭിമന്യുവും രാക്ഷസൻ അലംബുഷനും"},"97":{"hi":"नौवाँ दिन: अभिमन्यु अलंबुष को पराजित करते हैं","kn":"ಒಂಬತ್ತನೆಯ ದಿನ: ಅಲಂಬುಷನನ್ನು ಅಭಿಮನ್ಯು ಸೋಲಿಸುವುದು","te":"తొమ్మిదవ రోజు: అలంబుసుడిని అభిమన్యుడు ఓడిస్తాడు","ta":"ஒன்பதாம் நாள்: அலம்புஷனை அபிமன்யு வெல்கிறான்","ml":"ഒൻപതാം ദിനം: അഭിമന്യു അലംബുഷനെ തോൽപ്പിക്കുന്നു"},"98":{"hi":"नौवाँ दिन: द्रोण अर्जुन के विरुद्ध","kn":"ಒಂಬತ್ತನೆಯ ದಿನ: ಅರ್ಜುನನ ವಿರುದ್ಧ ದ್ರೋಣ","te":"తొమ్మిదవ రోజు: అర్జునుడిపై ద్రోణుడు","ta":"ஒன்பதாம் நாள்: அர்ஜுனனுக்கு எதிராக துரோணர்","ml":"ഒൻപതാം ദിനം: ദ്രോണർ അർജുനനെതിരെ"},"99":{"hi":"नौवाँ दिन: मध्याह्न में भीष्म","kn":"ಒಂಬತ್ತನೆಯ ದಿನ: ಮಧ್ಯಾಹ್ನದಲ್ಲಿ ಭೀಷ್ಮ","te":"తొమ్మిదవ రోజు: మధ్యాహ్నం భీష్ముడు","ta":"ஒன்பதாம் நாள்: நண்பகலில் பீஷ்மர்","ml":"ഒൻപതാം ദിനം: ഉച്ചസമയത്ത് ഭീഷ്മർ"},"100":{"hi":"नौवाँ दिन: अर्जुन और त्रिगर्त","kn":"ಒಂಬತ್ತನೆಯ ದಿನ: ಅರ್ಜುನ ಮತ್ತು ತ್ರಿಗರ್ತರು","te":"తొమ్మిదవ రోజు: అర్జునుడు, త్రిగర్తులు","ta":"ஒன்பதாம் நாள்: அர்ஜுனனும் திரிகர்த்தர்களும்","ml":"ഒൻപതാം ദിനം: അർജുനനും ത്രിഗർത്തരും"},"101":{"hi":"नौवाँ दिन: दुर्योधन शल्य से आग्रह करता है","kn":"ಒಂಬತ್ತನೆಯ ದಿನ: ಶಲ್ಯನನ್ನು ದುರ್ಯೋಧನನು ಒತ್ತಾಯಿಸುವುದು","te":"తొమ్మిదవ రోజు: శల్యుడిని దుర్యోధనుడు ప్రోత్సహిస్తాడు","ta":"ஒன்பதாம் நாள்: சல்லியனை துரியோதனன் தூண்டுகிறான்","ml":"ഒൻപതാം ദിനം: ശല്യനോട് ദുര്യോധനൻ അഭ്യർഥിക്കുന്നു"},"102":{"hi":"नौवाँ दिन: भीष्म अर्जुन और कृष्ण से लड़ते हैं","kn":"ಒಂಬತ್ತನೆಯ ದಿನ: ಅರ್ಜುನ ಮತ್ತು ಕೃಷ್ಣರೊಡನೆ ಭೀಷ್ಮರ ಹೋರಾಟ","te":"తొమ్మిదవ రోజు: అర్జునుడు, కృష్ణులతో భీష్ముడి పోరాటం","ta":"ஒன்பதாம் நாள்: அர்ஜுனனையும் கிருஷ்ணனையும் எதிர்த்து பீஷ்மர் போரிடுகிறார்","ml":"ഒൻപതാം ദിനം: ഭീഷ്മർ അർജുനനോടും കൃഷ്ണനോടും പോരാടുന്നു"},"103":{"hi":"पांडव भीष्म से पूछते हैं कि उन्हें कैसे मारा जाए","kn":"ಭೀಷ್ಮರನ್ನು ಹೇಗೆ ಕೊಲ್ಲಬಹುದೆಂದು ಪಾಂಡವರ ಪ್ರಶ್ನೆ","te":"భీష్ముడిని ఎలా చంపవచ్చో పాండవులు అడుగుతారు","ta":"பீஷ்மர் எவ்வாறு கொல்லப்படுவார் என்று பாண்டவர்கள் கேட்கின்றனர்","ml":"ഭീഷ്മരെ എങ്ങനെ വധിക്കാനാകുമെന്ന് പാണ്ഡവർ ചോദിക്കുന്നു"},"104":{"hi":"दसवाँ दिन: शिखंडी और अर्जुन आगे बढ़ते हैं","kn":"ಹತ್ತನೆಯ ದಿನ: ಶಿಖಂಡಿ ಮತ್ತು ಅರ್ಜುನರ ಮುನ್ನಡೆ","te":"పదవ రోజు: శిఖండి, అర్జునుడు ముందుకు కదులుతారు","ta":"பத்தாம் நாள்: சிகண்டியும் அர்ஜுனனும் முன்னேறுகின்றனர்","ml":"പത്താം ദിനം: ശിഖണ്ഡിയും അർജുനനും മുന്നേറുന്നു"},"105":{"hi":"दसवाँ दिन: शिखंडी के रक्षक","kn":"ಹತ್ತನೆಯ ದಿನ: ಶಿಖಂಡಿಯ ಕಾವಲುಗಾರರು","te":"పదవ రోజు: శిఖండికి కాపలా","ta":"பத்தாம் நாள்: சிகண்டியின் காவலர்கள்","ml":"പത്താം ദിനം: ശിഖണ്ഡിയുടെ അംഗരക്ഷകർ"},"106":{"hi":"दसवाँ दिन: अर्जुन शिखंडी को प्रेरित करते हैं","kn":"ಹತ್ತನೆಯ ದಿನ: ಶಿಖಂಡಿಯನ್ನು ಅರ್ಜುನನು ಪ್ರೋತ್ಸಾಹಿಸುವುದು","te":"పదవ రోజు: శిఖండిని అర్జునుడు ప్రోత్సహిస్తాడు","ta":"பத்தாம் நாள்: சிகண்டியை அர்ஜுனன் தூண்டுகிறான்","ml":"പത്താം ദിനം: അർജുനൻ ശിഖണ്ഡിയെ പ്രോത്സാഹിപ്പിക്കുന്നു"},"107":{"hi":"दसवाँ दिन: भीष्म के चारों ओर द्वंद्व","kn":"ಹತ್ತನೆಯ ದಿನ: ಭೀಷ್ಮರ ಸುತ್ತ ದ್ವಂದ್ವ ಯುದ್ಧಗಳು","te":"పదవ రోజు: భీష్ముడి చుట్టూ ద్వంద్వ పోరాటాలు","ta":"பத்தாம் நாள்: பீஷ்மரைச் சுற்றி தனிப்போர்கள்","ml":"പത്താം ദിനം: ഭീഷ്മരെ ചുറ്റിയുള്ള ദ്വന്ദ്വയുദ്ധങ്ങൾ"},"108":{"hi":"दसवाँ दिन: अपशकुन और भीष्म का तेज","kn":"ಹತ್ತನೆಯ ದಿನ: ಅಪಶಕುನಗಳು ಮತ್ತು ಭೀಷ್ಮರ ಆರ್ಭಟ","te":"పదవ రోజు: అపశకునాలు, భీష్ముడి ప్రజ్వలనం","ta":"பத்தாம் நாள்: கெட்ட சகுனங்களும் பீஷ்மரின் கொழுந்துவிட்டெரியும் வீரமும்","ml":"പത്താം ദിനം: ദുശ്ശകുനങ്ങളും ഭീഷ്മരുടെ ജ്വലനവും"},"109":{"hi":"दसवाँ दिन: दस योद्धाओं के बीच भीम","kn":"ಹತ್ತನೆಯ ದಿನ: ಹತ್ತು ವೀರರ ನಡುವೆ ಭೀಮ","te":"పదవ రోజు: పది మంది యోధుల మధ్య భీముడు","ta":"பத்தாம் நாள்: பத்து வீரர்களிடையே பீமன்","ml":"പത്താം ദിനം: പത്തു യോദ്ധാക്കൾക്കിടയിൽ ഭീമൻ"},"110":{"hi":"दसवाँ दिन: अर्जुन और राजा","kn":"ಹತ್ತನೆಯ ದಿನ: ಅರ್ಜುನ ಮತ್ತು ರಾಜರು","te":"పదవ రోజు: అర్జునుడు, రాజులు","ta":"பத்தாம் நாள்: அர்ஜுனனும் மன்னர்களும்","ml":"പത്താം ദിനം: അർജുനനും രാജാക്കന്മാരും"},"111":{"hi":"दसवाँ दिन: भीष्म को गिराने की योजना","kn":"ಹತ್ತನೆಯ ದಿನ: ಭೀಷ್ಮರನ್ನು ಉರುಳಿಸುವ ಯೋಜನೆ","te":"పదవ రోజు: భీష్ముడిని పడగొట్టే పథకం","ta":"பத்தாம் நாள்: பீஷ்மரை வீழ்த்தும் திட்டம்","ml":"പത്താം ദിനം: ഭീഷ്മരെ വീഴ്ത്താനുള്ള പദ്ധതി"},"112":{"hi":"दसवाँ दिन: भीष्म का महान युद्ध","kn":"ಹತ್ತನೆಯ ದಿನ: ಭೀಷ್ಮರ ಮಹಾಯುದ್ಧ","te":"పదవ రోజు: భీష్ముడి గొప్ప యుద్ధం","ta":"பத்தாம் நாள்: பீஷ்மரின் பெரும் போர்","ml":"പത്താം ദിനം: ഭീഷ്മരുടെ മഹായുദ്ധം"},"113":{"hi":"दसवाँ दिन: भीष्म के चारों ओर संहार","kn":"ಹತ್ತನೆಯ ದಿನ: ಭೀಷ್ಮರ ಸುತ್ತ ಮಾರಣಹೋಮ","te":"పదవ రోజు: భీష్ముడి చుట్టూ మారణకాండ","ta":"பத்தாம் நாள்: பீஷ்மரைச் சுற்றிய படுகொலை","ml":"പത്താം ദിനം: ഭീഷ്മരെ ചുറ്റിയുള്ള കൂട്ടക്കൊല"},"114":{"hi":"भीष्म का पतन","kn":"ಭೀಷ್ಮರ ಪತನ","te":"భీష్ముడి పతనం","ta":"பீஷ்மரின் வீழ்ச்சி","ml":"ഭീഷ്മരുടെ പതനം"},"115":{"hi":"शरशय्या पर भीष्म","kn":"ಬಾಣಶಯ್ಯೆಯಲ್ಲಿ ಭೀಷ್ಮರು","te":"అంపశయ్యపై భీష్ముడు","ta":"அம்புப் படுக்கையில் பீஷ்மர்","ml":"അമ്പുകിടക്കയിൽ ഭീഷ്മർ"},"116":{"hi":"भीष्म संधि का परामर्श देते हैं","kn":"ಸಂಧಿಯ ಸಲಹೆ ನೀಡುವ ಭೀಷ್ಮರು","te":"శాంతి కోరమని భీష్ముడి హితవు","ta":"சமாதானம் பற்றி பீஷ்மர் அறிவுறுத்துகிறார்","ml":"ഭീഷ്മർ സന്ധിക്ക് ഉപദേശിക്കുന്നു"},"117":{"hi":"कर्ण भीष्म से मिलते हैं","kn":"ಭೀಷ್ಮರನ್ನು ಕರ್ಣ ಭೇಟಿಯಾಗುವುದು","te":"భీష్ముడిని కర్ణుడు కలుస్తాడు","ta":"பீஷ்மரைக் கர்ணன் சந்திக்கிறான்","ml":"ഭീഷ്മരെ കർണൻ സന്ദർശിക്കുന്നു"}}