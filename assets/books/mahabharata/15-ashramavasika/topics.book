{"1":{"hi":"पांडव धृतराष्ट्र की सेवा करते हैं","te":"పాండవులు ధృతరాష్ట్రుడికి సేవ చేస్తారు","ml":"പാണ്ഡവർ ധൃതരാഷ്ട്രരെ ശുശ്രൂഷിക്കുന്നു","ta":"பாண்டவர்கள் திருதராஷ்டிரருக்குப் பணிவிடை செய்தல்","kn":"ಪಾಂಡವರು ಧೃತರಾಷ್ಟ್ರನ ಸೇವೆ ಮಾಡುತ್ತಾರೆ"},"2":{"hi":"युधिष्ठिर वृद्ध राजा का सम्मान करते हैं","te":"యుధిష్ఠిరుడు వృద్ధ రాజును గౌరవిస్తాడు","ml":"യുധിഷ്ഠിരൻ വൃദ്ധനായ രാജാവിനെ ആദരിക്കുന്നു","ta":"முதிய மன்னனை யுதிஷ்டிரர் மதித்தல்","kn":"ಯುಧಿಷ್ಠಿರ ವೃದ್ಧ ರಾಜನನ್ನು ಗೌರವಿಸುತ್ತಾನೆ"},"3":{"hi":"वृद्ध राजा संतुष्ट होते हैं","te":"వృద్ధ రాజు సంతృప్తి చెందుతాడు","ml":"വൃദ്ധരാജാവ് സംതൃപ്തനാകുന്നു","ta":"முதிய மன்னன் மனநிறைவு கொள்கிறார்","kn":"ವೃದ್ಧ ರಾಜನಿಗೆ ತೃಪ್ತಿ"},"4":{"hi":"भीम के कड़वे वचन","te":"భీముడి చేదు మాటలు","ml":"ഭീമന്റെ കയ്പേറിയ വാക്കുകൾ","ta":"பீமனின் கடுஞ்சொற்கள்","kn":"ಭೀಮನ ಕಟು ಮಾತುಗಳು"},"5":{"hi":"धृतराष्ट्र का स्वीकारोक्ति","te":"ధృతరాష్ట్రుడి ఒప్పుకోలు","ml":"ധൃതരാഷ്ട്രരുടെ കുറ്റസമ്മതം","ta":"திருதராஷ்டிரரின் ஒப்புதல் வாக்குமூலம்","kn":"ಧೃತರಾಷ್ಟ್ರನ ಒಪ್ಪಿಗೆ"},"6":{"hi":"योजना पर युधिष्ठिर का शोक","te":"ఆ పథకంపై యుధిష్ఠిరుడి దుఃఖం","ml":"പദ്ധതിയിൽ യുധിഷ്ഠിരന്റെ ദുഃഖം","ta":"திட்டம் குறித்து யுதிஷ்டிரரின் துயரம்","kn":"ಯೋಜನೆಯ ಕುರಿತು ಯುಧಿಷ್ಠಿರನ ದುಃಖ"},"7":{"hi":"व्यास आते हैं","te":"వ్యాసుడు వస్తాడు","ml":"വ്യാസൻ എത്തുന്നു","ta":"வியாசர் வருகிறார்","kn":"ವ್ಯಾಸರ ಆಗಮನ"},"8":{"hi":"व्यास युधिष्ठिर को इच्छा पूरी करने को कहते हैं","te":"కోరికను తీర్చమని యుధిష్ఠిరుడికి వ్యాసుడు చెబుతాడు","ml":"ആഗ്രഹം സാധിച്ചുകൊടുക്കാൻ വ്യാസൻ യുധിഷ്ഠിരനോട് പറയുന്നു","ta":"விருப்பத்தை நிறைவேற்றுமாறு யுதிஷ்டிரருக்கு வியாசர் கூறுதல்","kn":"ಆಶಯವನ್ನು ಈಡೇರಿಸುವಂತೆ ವ್ಯಾಸರು ಯುಧಿಷ್ಠಿರನಿಗೆ ಹೇಳುತ್ತಾರೆ"},"9":{"hi":"राज्य की रक्षा पर धृतराष्ट्र का परामर्श","te":"రాజ్య రక్షణపై ధృతరాష్ట్రుడి సలహా","ml":"രാജ്യസംരക്ഷണത്തെക്കുറിച്ചുള്ള ധൃതരാഷ്ട്രരുടെ ഉപദേശം","ta":"அரசைக் காப்பது பற்றி திருதராஷ்டிரரின் அறிவுரை","kn":"ರಾಜ್ಯ ರಕ್ಷಣೆಯ ಕುರಿತು ಧೃತರಾಷ್ಟ್ರನ ಸಲಹೆ"},"10":{"hi":"नीति, गुप्तचर और अधिकारियों पर","te":"చట్టం, గూఢచారులు, అధికారులపై","ml":"നിയമം, ചാരന്മാർ, ഉദ്യോഗസ്ഥർ","ta":"சட்டம், ஒற்றர், அதிகாரிகள் பற்றி","kn":"ನ್ಯಾಯ, ಗೂಢಚಾರರು ಮತ್ತು ಅಧಿಕಾರಿಗಳ ಕುರಿತು"},"11":{"hi":"पड़ोसियों, मित्रों और युद्ध पर","te":"పొరుగు రాజులు, మిత్రులు, యుద్ధంపై","ml":"അയൽരാജ്യങ്ങൾ, സഖ്യങ്ങൾ, യുദ്ധം","ta":"அண்டை நாடுகள், கூட்டாளிகள், போர் பற்றி","kn":"ನೆರೆಯ ರಾಜ್ಯಗಳು, ಮಿತ್ರರು ಮತ್ತು ಯುದ್ಧದ ಕುರಿತು"},"12":{"hi":"संधि, युद्ध और सेना पर","te":"శాంతి, యుద్ధం, సేనపై","ml":"സമാധാനവും യുദ്ധവും, സൈന്യവും","ta":"அமைதி, போர், படை பற்றி","kn":"ಶಾಂತಿ ಮತ್ತು ಯುದ್ಧ, ಸೇನೆಯ ಕುರಿತು"},"13":{"hi":"राजा वन जाने की अनुमति मांगते हैं","te":"అడవికి వెళ్లేందుకు రాజు అనుమతి కోరతాడు","ml":"കാട്ടിലേക്ക് പോകാൻ രാജാവ് അനുമതി ചോദിക്കുന്നു","ta":"காட்டுக்குச் செல்ல மன்னன் அனுமதி கேட்டல்","kn":"ಅರಣ್ಯಕ್ಕೆ ಹೋಗಲು ರಾಜ ಅನುಮತಿ ಕೇಳುತ್ತಾನೆ"},"14":{"hi":"धृतराष्ट्र प्रजा की अनुमति लेते हैं","te":"ప్రజల అనుమతి కోరతాడు ధృతరాష్ట్రుడు","ml":"പ്രജകളുടെ അനുമതി ധൃതരാഷ്ട്രർ ചോദിക്കുന്നു","ta":"குடிமக்களின் அனுமதியைத் திருதராஷ்டிரர் கேட்டல்","kn":"ಪ್ರಜೆಗಳ ಅನುಮತಿಯನ್ನು ಧೃತರಾಷ್ಟ್ರ ಕೇಳುತ್ತಾನೆ"},"15":{"hi":"प्रजा का उत्तर","te":"ప్రజల సమాధానం","ml":"പ്രജകളുടെ മറുപടി","ta":"மக்களின் பதில்","kn":"ಪ್ರಜೆಗಳ ಉತ್ತರ"},"16":{"hi":"एक ब्राह्मण प्रजा की ओर से बोलता है","te":"ప్రజల తరఫున ఒక బ్రాహ్మణుడు మాట్లాడతాడు","ml":"പ്രജകൾക്കായി ഒരു ബ്രാഹ്മണൻ സംസാരിക്കുന്നു","ta":"ஒரு பிராமணர் மக்கள் சார்பில் பேசுதல்","kn":"ಒಬ್ಬ ಬ್ರಾಹ್ಮಣ ಪ್ರಜೆಗಳ ಪರವಾಗಿ ಮಾತನಾಡುತ್ತಾನೆ"},"17":{"hi":"भीम का क्रोध और अर्जुन का उत्तर","te":"భీముడి కోపం, అర్జునుడి సమాధానం","ml":"ഭീമന്റെ കോപവും അർജുനന്റെ മറുപടിയും","ta":"பீமனின் கோபமும் அர்ஜுனனின் பதிலும்","kn":"ಭೀಮನ ಕೋಪ ಮತ್ತು ಅರ್ಜುನನ ಉತ್ತರ"},"18":{"hi":"युधिष्ठिर दान देते हैं","te":"యుధిష్ఠిరుడు బహుమతులు ఇస్తాడు","ml":"യുധിഷ്ഠിരൻ ദാനങ്ങൾ നൽകുന്നു","ta":"யுதிஷ்டிரர் தானங்களை வழங்குதல்","kn":"ಯುಧಿಷ್ಠಿರ ಉಡುಗೊರೆಗಳನ್ನು ನೀಡುತ್ತಾನೆ"},"19":{"hi":"विदुर का समाचार और महादान","te":"విదురుడి నివేదిక, గొప్ప దానం","ml":"വിദുരന്റെ റിപ്പോർട്ടും മഹാദാനവും","ta":"விதுரரின் அறிக்கையும் பெரும் தானமும்","kn":"ವಿದುರನ ವರದಿ ಮತ್ತು ಮಹಾ ದಾನ"},"20":{"hi":"मृतकों के लिए महादान","te":"మృతుల కోసం గొప్ప దానం","ml":"മരിച്ചവർക്കുള്ള മഹാദാനം","ta":"இறந்தோருக்கான பெரும் தானம்","kn":"ಮೃತರಿಗಾಗಿ ಮಹಾ ದಾನ"},"21":{"hi":"वन की ओर प्रस्थान","te":"అడవికి ప్రయాణం","ml":"കാട്ടിലേക്കുള്ള യാത്ര","ta":"காட்டுக்குப் புறப்படுதல்","kn":"ಅರಣ್ಯಕ್ಕೆ ಪ್ರಸ್ಥಾನ"},"22":{"hi":"कुंती का प्रस्थान","te":"కుంతి ప్రయాణం","ml":"കുന്തിയുടെ യാത്ര","ta":"குந்தியின் புறப்பாடு","kn":"ಕುಂತಿಯ ಪ್ರಸ್ಥಾನ"},"23":{"hi":"कुंती का उत्तर","te":"కుంతి సమాధానం","ml":"കുന്തിയുടെ മറുപടി","ta":"குந்தியின் பதில்","kn":"ಕುಂತಿಯ ಉತ್ತರ"},"24":{"hi":"पांडव लौट आते हैं","te":"పాండవులు వెనక్కి తిరుగుతారు","ml":"പാണ്ഡവർ മടങ്ങുന്നു","ta":"பாண்டவர்கள் திரும்புதல்","kn":"ಪಾಂಡವರು ಹಿಂದಿರುಗುತ್ತಾರೆ"},"25":{"hi":"गंगा तट पर आश्रम","te":"గంగ ఒడ్డున ఆశ్రమం","ml":"ഗംഗാതീരത്തെ ആശ്രമം","ta":"கங்கைக் கரையிலுள்ள ஆசிரமம்","kn":"ಗಂಗಾ ತೀರದ ಆಶ್ರಮ"},"26":{"hi":"नारद और ऋषि राजा से मिलने आते हैं","te":"నారదుడు, ఋషులు రాజును సందర్శిస్తారు","ml":"നാരദനും മുനിമാരും രാജാവിനെ സന്ദർശിക്കുന്നു","ta":"நாரதரும் முனிவர்களும் மன்னனைச் சந்தித்தல்","kn":"ನಾರದರು ಮತ್ತು ಋಷಿಗಳು ರಾಜನನ್ನು ಭೇಟಿ ಮಾಡುತ್ತಾರೆ"},"27":{"hi":"नारद के वचन और धृतराष्ट्र का अंत","te":"నారదుడి మాటలు, ధృతరాష్ట్రుడి అంతం","ml":"നാരദന്റെ വാക്കുകളും ധൃതരാഷ്ട്രരുടെ അന്ത്യവും","ta":"நாரதரின் சொற்களும் திருதராஷ்டிரரின் முடிவும்","kn":"ನಾರದರ ಮಾತುಗಳು ಮತ್ತು ಧೃತರಾಷ್ಟ್ರನ ಅಂತ್ಯ"},"28":{"hi":"पांडव माता के लिए व्याकुल होते हैं","te":"తల్లిని చూడాలని పాండవుల ఆరాటం","ml":"പാണ്ഡവർ അമ്മയെ കാണാൻ കൊതിക്കുന്നു","ta":"தங்கள் தாயை பாண்டவர்கள் ஏங்குதல்","kn":"ಪಾಂಡವರು ತಮ್ಮ ತಾಯಿಗಾಗಿ ಹಂಬಲಿಸುತ್ತಾರೆ"},"29":{"hi":"युधिष्ठिर वन जाने का निश्चय करते हैं","te":"అడవికి వెళ్లాలని యుధిష్ఠిరుడి నిర్ణయం","ml":"കാട് സന്ദർശിക്കാൻ യുധിഷ്ഠിരൻ തീരുമാനിക്കുന്നു","ta":"காட்டுக்குச் செல்ல யுதிஷ்டிரர் முடிவு","kn":"ಅರಣ್ಯಕ್ಕೆ ಭೇಟಿ ನೀಡಲು ಯುಧಿಷ್ಠಿರ ನಿರ್ಧರಿಸುತ್ತಾನೆ"},"30":{"hi":"वन की ओर यात्रा","te":"అడవికి ప్రయాణం","ml":"കാട്ടിലേക്കുള്ള യാത്ര","ta":"காட்டை நோக்கிய பயணம்","kn":"ಅರಣ್ಯದ ಕಡೆಗೆ ಪ್ರಯಾಣ"},"31":{"hi":"आश्रम में भेंट","te":"ఆశ్రమంలో కలయిక","ml":"ആശ്രമത്തിലെ കൂടിക്കാഴ്ച","ta":"ஆசிரமத்தில் சந்திப்பு","kn":"ಆಶ್ರಮದಲ್ಲಿ ಭೇಟಿ"},"32":{"hi":"धृतराष्ट्र प्रत्येक के बारे में पूछते हैं","te":"ప్రతి ఒక్కరి గురించి ధృతరాష్ట్రుడు అడుగుతాడు","ml":"ധൃതരാഷ്ട്രർ ഓരോരുത്തരെക്കുറിച്ചും ചോദിക്കുന്നു","ta":"ஒவ்வொருவரைப் பற்றியும் திருதராஷ்டிரர் விசாரித்தல்","kn":"ಧೃತರಾಷ್ಟ್ರ ಪ್ರತಿಯೊಬ್ಬರ ಕುರಿತು ಕೇಳುತ್ತಾನೆ"},"33":{"hi":"विदुर का अंत","te":"విదురుడి అంత్యం","ml":"വിദുരന്റെ അന്ത്യം","ta":"விதுரரின் முடிவு","kn":"ವಿದುರನ ಅಂತ್ಯ"},"34":{"hi":"रात्रि और व्यास का आगमन","te":"రాత్రి, వ్యాసుడి రాక","ml":"രാത്രിയും വ്യാസന്റെ വരവും","ta":"இரவும் வியாசரின் வருகையும்","kn":"ರಾತ್ರಿ ಮತ್ತು ವ್ಯಾಸರ ಆಗಮನ"},"35":{"hi":"व्यास वरदान देते हैं","te":"వ్యాసుడు వరం ఇస్తాడు","ml":"വ്യാസൻ വരം നൽകുന്നു","ta":"வியாசர் வரம் அளித்தல்","kn":"ವ್ಯಾಸರು ವರ ನೀಡುತ್ತಾರೆ"},"36":{"hi":"धृतराष्ट्र की मृत पुत्रों को देखने की इच्छा","te":"చనిపోయిన కుమారులను చూడాలన్న ధృతరాష్ట్రుడి కోరిక","ml":"മരിച്ച പുത്രന്മാരെ കാണാനുള്ള ധൃതരാഷ്ട്രരുടെ ആഗ്രഹം","ta":"இறந்த மகன்களைக் காண திருதராஷ்டிரரின் விருப்பம்","kn":"ಮೃತ ಪುತ್ರರನ್ನು ನೋಡುವ ಧೃತರಾಷ್ಟ್ರನ ಇಚ್ಛೆ"},"37":{"hi":"गांधारी और कुंती की बातचीत","te":"గాంధారి, కుంతి మాట్లాడతారు","ml":"ഗാന്ധാരിയും കുന്തിയും സംസാരിക്കുന്നു","ta":"காந்தாரியும் குந்தியும் பேசுதல்","kn":"ಗಾಂಧಾರಿ ಮತ್ತು ಕುಂತಿ ಮಾತನಾಡುತ್ತಾರೆ"},"38":{"hi":"कुंती कर्ण का रहस्य बताती है","te":"కర్ణుడి రహస్యాన్ని కుంతి ఒప్పుకుంటుంది","ml":"കർണന്റെ രഹസ്യം കുന്തി വെളിപ്പെടുത്തുന്നു","ta":"கர்ணனின் ரகசியத்தைக் குந்தி ஒப்புக்கொள்தல்","kn":"ಕರ್ಣನ ರಹಸ್ಯವನ್ನು ಕುಂತಿ ಒಪ್ಪಿಕೊಳ್ಳುತ್ತಾಳೆ"},"39":{"hi":"व्यास मृतकों के दर्शन का वचन देते हैं","te":"మృతులను చూపిస్తానని వ్యాసుడి వాగ్దానం","ml":"മരിച്ചവരെ കാണിക്കാമെന്ന് വ്യാസൻ വാഗ്ദാനം ചെയ്യുന്നു","ta":"இறந்தோரைக் காட்டுவதாக வியாசர் வாக்களித்தல்","kn":"ಮೃತರ ದರ್ಶನವನ್ನು ವ್ಯಾಸರು ಭರವಸೆ ನೀಡುತ್ತಾರೆ"},"40":{"hi":"व्यास मृतकों को बुलाते हैं","te":"వ్యాసుడు మృతులను పిలుస్తాడు","ml":"വ്യാസൻ മരിച്ചവരെ വിളിക്കുന്നു","ta":"வியாசர் இறந்தோரை அழைத்தல்","kn":"ವ್ಯಾಸರು ಮೃತರನ್ನು ಕರೆಯುತ್ತಾರೆ"},"41":{"hi":"मिलन की रात","te":"కలయిక రాత్రి","ml":"കൂടിക്കാഴ്ചയുടെ രാത്രി","ta":"சந்திப்பின் இரவு","kn":"ಭೇಟಿಯ ರಾತ್ರಿ"},"42":{"hi":"कर्म और कर्मफल","te":"కర్మ, కర్మ ఫలితం","ml":"കർമവും കർമഫലവും","ta":"கர்மமும் செயல்களின் பலனும்","kn":"ಕರ್ಮ ಮತ್ತು ಕರ್ಮಫಲ"},"43":{"hi":"जनमेजय अपने पिता को देखते हैं","te":"జనమేజయుడు తన తండ్రిని చూస్తాడు","ml":"ജനമേജയൻ പിതാവിനെ കാണുന്നു","ta":"தந்தையைக் காணும் ஜனமேஜயன்","kn":"ಜನಮೇಜಯ ತನ್ನ ತಂದೆಯನ್ನು ನೋಡುತ್ತಾನೆ"},"44":{"hi":"पुत्र चले जाते हैं","te":"కుమారులు వెళ్లిపోతారు","ml":"പുത്രന്മാർ മടങ്ങുന്നു","ta":"மகன்கள் புறப்படுதல்","kn":"ಪುತ್ರರು ಹೊರಡುತ್ತಾರೆ"},"45":{"hi":"नारद का आगमन और राजा की तपस्या","te":"నారదుడి సందర్శన, రాజు తపస్సు","ml":"നാരദന്റെ സന്ദർശനവും രാജാവിന്റെ തപസ്സും","ta":"நாரதரின் வருகையும் மன்னனின் தவமும்","kn":"ನಾರದರ ಭೇಟಿ ಮತ್ತು ರಾಜನ ತಪಸ್ಸು"},"46":{"hi":"युधिष्ठिर का शोक","te":"యుధిష్ఠిరుడి దుఃఖం","ml":"യുധിഷ്ഠിരന്റെ ദുഃഖം","ta":"யுதிஷ்டிரரின் துயரம்","kn":"ಯುಧಿಷ್ಠಿರನ ದುಃಖ"},"47":{"hi":"वन की आग में राजा का अंत","te":"అడవిమంటలో రాజు అంతం","ml":"കാട്ടുതീയിൽ രാജാവിന്റെ അന്ത്യം","ta":"காட்டுத் தீயில் மன்னனின் முடிவு","kn":"ಅರಣ್ಯದ ಬೆಂಕಿಯಲ್ಲಿ ರಾಜನ ಅಂತ್ಯ"}}