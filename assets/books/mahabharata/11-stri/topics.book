{"1":{"hi":"धृतराष्ट्र का शोक","te":"ధృతరాష్ట్రుడి దుఃఖం","ta":"திருதராஷ்டிரனின் துயரம்","ml":"ധൃതരാഷ്ട്രരുടെ ദുഃഖം","kn":"ಧೃತರಾಷ್ಟ್ರನ ಶೋಕ"},"2":{"hi":"विदुर राजा को सांत्वना देते हैं","te":"రాజును విదురుడు ఓదార్చుతాడు","ta":"விதுரர் அரசனுக்கு ஆறுதல் கூறுகிறார்","ml":"രാജാവിനെ വിദുരൻ ആശ്വസിപ്പിക്കുന്നു","kn":"ವಿದುರ ರಾಜನನ್ನು ಸಂತೈಸುತ್ತಾನೆ"},"3":{"hi":"विदुर का मृत्यु और पुनर्जन्म पर उपदेश","te":"మరణం, పునర్జన్మపై విదురుడు","ta":"மரணமும் மறுபிறவியும் பற்றி விதுரர்","ml":"മരണത്തെയും പുനർജന്മത്തെയും കുറിച്ച് വിദുരൻ","kn":"ಮರಣ ಮತ್ತು ಪುನರ್ಜನ್ಮದ ಕುರಿತು ವಿದುರ"},"4":{"hi":"संसार का वन","te":"సంసార అరణ్యం","ta":"சம்சாரம் என்னும் காடு","ml":"സംസാരമെന്ന കാട്ടുവഴി","kn":"ಸಂಸಾರದ ಅರಣ್ಯ"},"5":{"hi":"कुएं में पड़े मनुष्य का दृष्टांत","te":"బావిలో మనిషి ఉపమానం","ta":"கிணற்றில் இருந்த மனிதனின் உவமை","ml":"കിണറ്റിലെ മനുഷ്യന്റെ ഉപമ","kn":"ಬಾವಿಯಲ್ಲಿರುವ ಮನುಷ್ಯನ ಉಪಮೆ"},"6":{"hi":"दृष्टांत का अर्थ","te":"ఉపమానం యొక్క అర్థం","ta":"அந்த உவமையின் பொருள்","ml":"ഉപമയുടെ അർത്ഥം","kn":"ಉಪಮೆಯ ಅರ್ಥ"},"7":{"hi":"शरीर रूपी रथ","te":"శరీరమనే రథం","ta":"உடலெனும் தேர்","ml":"ശരീരമാകുന്ന രഥം","kn":"ದೇಹವೆಂಬ ರಥ"},"8":{"hi":"व्यास धृतराष्ट्र को सांत्वना देते हैं","te":"ధృతరాష్ట్రుడిని వ్యాసుడు ఓదార్చుతాడు","ta":"வியாசர் திருதராஷ்டிரனுக்கு ஆறுதல் கூறுகிறார்","ml":"ധൃതരാഷ്ട്രരെ വ്യാസൻ ആശ്വസിപ്പിക്കുന്നു","kn":"ವ್ಯಾಸರು ಧೃತರಾಷ್ಟ್ರನನ್ನು ಸಂತೈಸುತ್ತಾರೆ"},"9":{"hi":"हस्तिनापुर की स्त्रियां विलाप करती हैं","te":"హస్తినాపుర స్త్రీలు విలపిస్తారు","ta":"அஸ்தினாபுரத்துப் பெண்கள் புலம்புகின்றனர்","ml":"ഹസ്തിനാപുരത്തിലെ സ്ത്രീകൾ വിലപിക്കുന്നു","kn":"ಹಸ್ತಿನಾಪುರದ ಸ್ತ್ರೀಯರು ರೋದಿಸುತ್ತಾರೆ"},"10":{"hi":"कृप आदि राजसी शोभायात्रा से मिलते हैं","te":"రాజ పరివారాన్ని కృపుడు ఇతరులు కలుస్తారు","ta":"கிருபரும் மற்றவர்களும் அரச ஊர்வலத்தைச் சந்திக்கின்றனர்","ml":"കൃപരും മറ്റുള്ളവരും രാജഘോഷയാത്രയെ കണ്ടുമുട്ടുന്നു","kn":"ಕೃಪ ಮತ್ತು ಇತರರು ರಾಜ ಮೆರವಣಿಗೆಯನ್ನು ಎದುರಿಸುತ್ತಾರೆ"},"11":{"hi":"पांडव धृतराष्ट्र से मिलते हैं","te":"పాండవులు ధృతరాష్ట్రుడిని కలుస్తారు","ta":"பாண்டவர்கள் திருதராஷ்டிரனைச் சந்திக்கின்றனர்","ml":"പാണ്ഡവർ ധൃതരാഷ്ട്രരെ കാണുന്നു","kn":"ಪಾಂಡವರು ಧೃತರಾಷ್ಟ್ರನನ್ನು ಭೇಟಿಯಾಗುತ್ತಾರೆ"},"12":{"hi":"धृतराष्ट्र का पश्चात्ताप","te":"ధృతరాష్ట్రుడి పశ్చాత్తాపం","ta":"திருதராஷ்டிரனின் மனவருத்தம்","ml":"ധൃതരാഷ്ട്രരുടെ പശ്ചാത്താപം","kn":"ಧೃತರಾಷ್ಟ್ರನ ಪಶ್ಚಾತ್ತಾಪ"},"13":{"hi":"व्यास और कृष्ण गांधारी को रोकते हैं","te":"గాంధారిని వ్యాసుడు, కృష్ణుడు ఆపుతారు","ta":"வியாசரும் கிருஷ்ணனும் காந்தாரியைத் தடுக்கின்றனர்","ml":"ഗാന്ധാരിയെ വ്യാസനും കൃഷ്ണനും തടയുന്നു","kn":"ಗಾಂಧಾರಿಯನ್ನು ವ್ಯಾಸ ಮತ್ತು ಕೃಷ್ಣ ತಡೆಯುತ್ತಾರೆ"},"14":{"hi":"भीम गांधारी को उत्तर देते हैं","te":"గాంధారికి భీముడు సమాధానమిస్తాడు","ta":"காந்தாரிக்குப் பீமன் பதிலளிக்கிறான்","ml":"ഗാന്ധാരിക്ക് ഭീമൻ മറുപടി നൽകുന്നു","kn":"ಗಾಂಧಾರಿಗೆ ಭೀಮ ಉತ್ತರಿಸುತ್ತಾನೆ"},"15":{"hi":"गांधारी और युधिष्ठिर; द्रौपदी का शोक","te":"గాంధారి, యుధిష్ఠిరుడు; ద్రౌపది దుఃఖం","ta":"காந்தாரியும் யுதிஷ்டிரனும்; திரௌபதியின் துயரம்","ml":"ഗാന്ധാരിയും യുധിഷ്ഠിരനും; ദ്രൗപദിയുടെ ദുഃഖം","kn":"ಗಾಂಧಾರಿ ಮತ್ತು ಯುಧಿಷ್ಠಿರ; ದ್ರೌಪದಿಯ ಶೋಕ"},"16":{"hi":"मृतकों के बीच स्त्रियां","te":"మృతుల మధ్య స్త్రీలు","ta":"இறந்தவர்களிடையே இருந்த பெண்கள்","ml":"മരിച്ചവർക്കിടയിലെ സ്ത്രീകൾ","kn":"ಮೃತರ ನಡುವಿನ ಸ್ತ್ರೀಯರು"},"17":{"hi":"गांधारी दुर्योधन को देखती हैं","te":"గాంధారి దుర్యోధనుడిని చూస్తుంది","ta":"காந்தாரி துரியோதனனைப் பார்க்கிறாள்","ml":"ഗാന്ധാരി ദുര്യോധനനെ കാണുന്നു","kn":"ದುರ್ಯೋಧನನನ್ನು ಗಾಂಧಾರಿ ನೋಡುತ್ತಾಳೆ"},"18":{"hi":"गांधारी कृष्ण को कौरव मृतकों को दिखाती हैं","te":"కౌరవ మృతదేహాలను గాంధారి కృష్ణుడికి చూపుతుంది","ta":"காந்தாரி கௌரவர்களின் சடலங்களைக் கிருஷ்ணனுக்குக் காட்டுகிறாள்","ml":"കൗരവരുടെ മൃതദേഹങ്ങൾ ഗാന്ധാരി കൃഷ്ണനെ കാണിക്കുന്നു","kn":"ಕೌರವರ ಮೃತದೇಹಗಳನ್ನು ಗಾಂಧಾರಿ ಕೃಷ್ಣನಿಗೆ ತೋರಿಸುತ್ತಾಳೆ"},"19":{"hi":"विकर्ण और दुर्योधन का परिवार","te":"వికర్ణుడు, దుర్యోధనుడి కుటుంబం","ta":"விகர்ணனும் துரியோதனனின் குடும்பமும்","ml":"വികർണ്ണനും ദുര്യോധനന്റെ കുടുംബവും","kn":"ವಿಕರ್ಣ ಮತ್ತು ದುರ್ಯೋಧನನ ಕುಟುಂಬ"},"20":{"hi":"अभिमन्यु और उत्तरा","te":"అభిమన్యుడు, ఉత్తర","ta":"அபிமன்யுவும் உத்தரையும்","ml":"അഭിമന്യുവും ഉത്തരയും","kn":"ಅಭಿಮನ್ಯು ಮತ್ತು ಉತ್ತರೆ"},"21":{"hi":"कर्ण की पत्नी","te":"కర్ణుడి భార్య","ta":"கர்ணனின் மனைவி","ml":"കർണ്ണന്റെ ഭാര്യ","kn":"ಕರ್ಣನ ಪತ್ನಿ"},"22":{"hi":"जयद्रथ, भूरिश्रवा और अन्य","te":"జయద్రథుడు, భూరిశ్రవుడు, ఇతరులు","ta":"ஜயத்ரதன், பூரிசிரவஸ் மற்றும் பிறர்","ml":"ജയദ്രഥനും ഭൂരിശ്രവസ്സും മറ്റുള്ളവരും","kn":"ಜಯದ್ರಥ, ಭೂರಿಶ್ರವ ಮತ್ತು ಇತರರು"},"23":{"hi":"शल्य, भीष्म, द्रोण और द्रुपद","te":"శల్యుడు, భీష్ముడు, ద్రోణుడు, ద్రుపదుడు","ta":"சல்லியன், பீஷ்மர், துரோணர், துருபதன்","ml":"ശല്യർ, ഭീഷ്മർ, ദ്രോണർ, ദ്രുപദൻ","kn":"ಶಲ್ಯ, ಭೀಷ್ಮ, ದ್ರೋಣ ಮತ್ತು ದ್ರುಪದ"},"24":{"hi":"राजा और महान अस्त्र","te":"రాజులు, మహాస్త్రాలు","ta":"அரசர்களும் மாபெரும் அஸ்திரங்களும்","ml":"രാജാക്കന്മാരും മഹാസ്ത്രങ്ങളും","kn":"ರಾಜರು ಮತ್ತು ಮಹಾ ಅಸ್ತ್ರಗಳು"},"25":{"hi":"गांधारी का कृष्ण को शाप","te":"కృష్ణుడికి గాంధారి శాపం","ta":"கிருஷ்ணன் மீது காந்தாரியின் சாபம்","ml":"കൃഷ്ണന് ഗാന്ധാരിയുടെ ശാപം","kn":"ಕೃಷ್ಣನಿಗೆ ಗಾಂಧಾರಿಯ ಶಾಪ"},"26":{"hi":"कृष्ण गांधारी को सांत्वना देते हैं; अंत्येष्टि","te":"కృష్ణుడు గాంధారిని ఓదార్చుతాడు; అంత్యక్రియలు","ta":"கிருஷ்ணன் காந்தாரிக்கு ஆறுதல் கூறுகிறான்; இறுதிச் சடங்குகள்","ml":"കൃഷ്ണൻ ഗാന്ധാരിയെ ആശ്വസിപ്പിക്കുന്നു; അന്ത്യകർമ്മങ്ങൾ","kn":"ಕೃಷ್ಣ ಗಾಂಧಾರಿಯನ್ನು ಸಂತೈಸುತ್ತಾನೆ; ಅಂತ್ಯಕ್ರಿಯೆಗಳು"},"27":{"hi":"जलांजलि और कुंती का रहस्य","te":"తర్పణాలు; కుంతి రహస్యం","ta":"தர்ப்பணமும் குந்தியின் இரகசியமும்","ml":"തർപ്പണവും കുന്തിയുടെ രഹസ്യവും","kn":"ತರ್ಪಣ ಮತ್ತು ಕುಂತಿಯ ರಹಸ್ಯ"}}