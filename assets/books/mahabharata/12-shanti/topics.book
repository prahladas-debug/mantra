{"1":{"hi":"युधिष्ठिर का शोक और नारद का आगमन","te":"యుధిష్ఠిరుడి దుఃఖం; నారదుడి రాక","ta":"யுதிஷ்டிரனின் துயரமும் நாரதரின் வருகையும்","ml":"യുധിഷ്ഠിരന്റെ ദുഃഖവും നാരദന്റെ വരവും","kn":"ಯುಧಿಷ್ಠಿರನ ಶೋಕ ಮತ್ತು ನಾರದರ ಆಗಮನ"},"2":{"hi":"नारद कर्ण के अस्त्रों की कथा सुनाते हैं","te":"కర్ణుడి అస్త్రాల గురించి నారదుడు చెబుతాడు","ta":"கர்ணனின் அஸ்திரங்களைப் பற்றி நாரதர் கூறுகிறார்","ml":"കർണ്ണന്റെ അസ്ത്രങ്ങളെക്കുറിച്ച് നാരദൻ പറയുന്നു","kn":"ಕರ್ಣನ ಅಸ್ತ್ರಗಳ ಕುರಿತು ನಾರದರು ಹೇಳುತ್ತಾರೆ"},"3":{"hi":"कर्ण और परशुराम","te":"కర్ణుడు, పరశురాముడు","ta":"கர்ணனும் பரசுராமரும்","ml":"കർണ്ണനും പരശുരാമനും","kn":"ಕರ್ಣ ಮತ್ತು ಪರಶುರಾಮ"},"4":{"hi":"परशुराम का कर्ण को शाप","te":"కర్ణుడికి పరశురాముడి శాపం","ta":"கர்ணனுக்குப் பரசுராமர் அளித்த சாபம்","ml":"കർണ്ണന് പരശുരാമന്റെ ശാപം","kn":"ಕರ್ಣನಿಗೆ ಪರಶುರಾಮರ ಶಾಪ"},"5":{"hi":"कर्ण के अन्य शाप","te":"కర్ణుడికి వచ్చిన ఇతర శాపాలు","ta":"கர்ணனின் பிற சாபங்கள்","ml":"കർണ്ണന്റെ മറ്റു ശാപങ്ങൾ","kn":"ಕರ್ಣನಿಗೆ ಇತರ ಶಾಪಗಳು"},"6":{"hi":"युधिष्ठिर का पश्चात्ताप","te":"యుధిష్ఠిరుడి పశ్చాత్తాపం","ta":"யுதிஷ்டிரனின் வருத்தம்","ml":"യുധിഷ്ഠിരന്റെ പശ്ചാത്താപം","kn":"ಯುಧಿಷ್ಠಿರನ ಪಶ್ಚಾತ್ತಾಪ"},"7":{"hi":"युधिष्ठिर संसार त्यागने की इच्छा प्रकट करते हैं","te":"లోకాన్ని విడిచిపెట్టాలని యుధిష్ఠిరుడి కోరిక","ta":"உலகைத் துறக்க யுதிஷ்டிரன் விரும்புகிறான்","ml":"ലോകം വിട്ടുപോകാൻ യുധിഷ്ഠിരന് ആഗ്രഹം","kn":"ಲೋಕವನ್ನು ತೊರೆಯಲು ಯುಧಿಷ್ಠಿರನ ಇಚ್ಛೆ"},"8":{"hi":"अर्जुन युधिष्ठिर को फटकारते हैं","te":"యుధిష్ఠిరుడిని అర్జునుడు మందలిస్తాడు","ta":"அர்ஜுனன் யுதிஷ்டிரனைக் கடிந்துகொள்கிறான்","ml":"അർജ്ജുനൻ യുധിഷ്ഠിരനെ ശാസിക്കുന്നു","kn":"ಯುಧಿಷ್ಠಿರನನ್ನು ಅರ್ಜುನ ಗದರಿಸುತ್ತಾನೆ"},"9":{"hi":"युधिष्ठिर का संन्यास पर उत्तर","te":"త్యాగంపై యుధిష్ఠిరుడి సమాధానం","ta":"துறவறம் பற்றி யுதிஷ்டிரனின் பதில்","ml":"സന്ന്യാസത്തെക്കുറിച്ച് യുധിഷ്ഠിരന്റെ മറുപടി","kn":"ಸಂನ್ಯಾಸದ ಕುರಿತು ಯುಧಿಷ್ಠಿರನ ಉತ್ತರ"},"10":{"hi":"भीम का उत्तर","te":"భీముడి సమాధానం","ta":"பீமனின் பதில்","ml":"ഭീമന്റെ മറുപടി","kn":"ಭೀಮನ ಉತ್ತರ"},"11":{"hi":"अर्जुन द्वारा इंद्र और तरुण तपस्वियों की कथा","te":"ఇంద్రుడు, యువ తపస్వుల కథ; అర్జునుడి కథనం","ta":"இந்திரனும் இளம் துறவிகளும் பற்றிய அர்ஜுனனின் கதை","ml":"ഇന്ദ്രനെയും യുവതപസ്വികളെയും കുറിച്ച് അർജ്ജുനന്റെ കഥ","kn":"ಇಂದ್ರ ಮತ್ತು ಯುವ ತಪಸ್ವಿಗಳ ಕಥೆಯನ್ನು ಅರ್ಜುನ ಹೇಳುತ್ತಾನೆ"},"12":{"hi":"नकुल का परामर्श","te":"నకులుడి సలహా","ta":"நகுலனின் ஆலோசனை","ml":"നകുലന്റെ ഉപദേശം","kn":"ನಕುಲನ ಸಲಹೆ"},"13":{"hi":"सहदेव का परामर्श","te":"సహదేవుడి సలహా","ta":"சகாதேவனின் ஆலோசனை","ml":"സഹദേവന്റെ ഉപദേശം","kn":"ಸಹದೇವನ ಸಲಹೆ"},"14":{"hi":"द्रौपदी की विनती","te":"ద్రౌపది విజ్ఞప్తి","ta":"திரௌபதியின் வேண்டுகோள்","ml":"ദ്രൗപദിയുടെ അപേക്ഷ","kn":"ದ್ರೌಪದಿಯ ಮನವಿ"},"15":{"hi":"अर्जुन दंड और संसार पर","te":"శిక్ష, లోకం గురించి అర్జునుడు","ta":"தண்டனையும் உலகமும் பற்றி அர்ஜுனன்","ml":"ശിക്ഷയെയും ലോകത്തെയും കുറിച്ച് അർജ്ജുനൻ","kn":"ಶಿಕ್ಷೆ ಮತ್ತು ಲೋಕದ ಕುರಿತು ಅರ್ಜುನ"},"16":{"hi":"भीम मन के शोक पर","te":"మనసులోని దుఃఖంపై భీముడు","ta":"மனத்துயர் பற்றி பீமன்","ml":"മനസ്സിന്റെ ദുഃഖത്തെക്കുറിച്ച് ഭീമൻ","kn":"ಮನಸ್ಸಿನ ದುಃಖದ ಕುರಿತು ಭೀಮ"},"17":{"hi":"युधिष्ठिर कामना और आसक्ति पर","te":"కోరిక, అనురాగంపై యుధిష్ఠిరుడు","ta":"ஆசையும் பற்றுதலும் பற்றி யுதிஷ்டிரன்","ml":"ആഗ്രഹത്തെയും ആസക്തിയെയും കുറിച്ച് യുധിഷ്ഠിരൻ","kn":"ಆಸೆ ಮತ್ತು ಬಂಧನದ ಕುರಿತು ಯುಧಿಷ್ಠಿರ"},"18":{"hi":"अर्जुन धन और दान पर","te":"సంపద, దానంపై అర్జునుడు","ta":"செல்வமும் தானமும் பற்றி அர்ஜுனன்","ml":"സമ്പത്തും ദാനവും സംബന്ധിച്ച് അർജ്ജുനൻ","kn":"ಸಂಪತ್ತು ಮತ್ತು ದಾನದ ಕುರಿತು ಅರ್ಜುನ"},"19":{"hi":"युधिष्ठिर: संन्यास और कर्म","te":"త్యాగం, కర్మపై యుధిష్ఠిరుడు","ta":"துறவும் செயலும் பற்றி யுதிஷ்டிரன்","ml":"സന്ന്യാസവും കർമ്മവും: യുധിഷ്ഠിരൻ","kn":"ಯುಧಿಷ್ಠಿರ: ಸಂನ್ಯಾಸ ಮತ್ತು ಕರ್ಮ"},"20":{"hi":"देवस्थान यज्ञ पर","te":"యజ్ఞంపై దేవస్థానుడు","ta":"யாகம் பற்றி தேவஸ்தானன்","ml":"യാഗത്തെക്കുറിച്ച് ദേവസ്ഥാനൻ","kn":"ಯಜ್ಞದ ಕುರಿತು ದೇವಸ್ಥಾನ"},"21":{"hi":"इंद्र का तपस्वियों से प्रश्न","te":"తపస్వులకు ఇంద్రుడి ప్రశ్న","ta":"முனிவர்களிடம் இந்திரனின் கேள்வி","ml":"തപസ്വികളോട് ഇന്ദ്രന്റെ ചോദ്യം","kn":"ತಪಸ್ವಿಗಳಿಗೆ ಇಂದ್ರನ ಪ್ರಶ್ನೆ"},"22":{"hi":"अर्जुन और क्षत्रिय धर्म","te":"అర్జునుడు, క్షత్రియ ధర్మం","ta":"அர்ஜுனனும் சத்திரியத் தர்மமும்","ml":"അർജ്ജുനനും ക്ഷത്രിയധർമ്മവും","kn":"ಅರ್ಜುನ ಮತ್ತು ಕ್ಷತ್ರಿಯ ಧರ್ಮ"},"23":{"hi":"चार वर्ण और राजा का कर्तव्य","te":"నాలుగు వర్ణాలు, రాజు ధర్మం","ta":"நால் வருணங்களும் அரசனின் கடமையும்","ml":"നാലു വർണ്ണങ്ങളും രാജാവിന്റെ കടമയും","kn":"ನಾಲ್ಕು ವರ್ಣಗಳು ಮತ್ತು ರಾಜನ ಕರ್ತವ್ಯ"},"24":{"hi":"सुद्युम्न और शंख-लिखित भाई","te":"సుద్యుమ్నుడు, శంఖ లిఖితులు","ta":"சுத்யும்னனும் சங்கன், லிகிதன் சகோதரர்களும்","ml":"സുദ്യുമ്നനും ശംഖ്-ലിഖിത സഹോദരന്മാരും","kn":"ಸುದ್ಯುಮ್ನ ಮತ್ತು ಶಂಖ-ಲಿಖಿತ ಸಹೋದರರು"},"25":{"hi":"व्यास राजा के कर्तव्य पर","te":"రాజధర్మంపై వ్యాసుడు","ta":"அரசனின் கடமை பற்றி வியாசர்","ml":"രാജാവിന്റെ കടമയെക്കുറിച്ച് വ്യാസൻ","kn":"ರಾಜಧರ್ಮದ ಕುರಿತು ವ್ಯಾಸರು"},"26":{"hi":"सेनजित का गीत","te":"సేనజిత్తు గీతం","ta":"சேனஜித்தின் பாடல்","ml":"സേനജിത്തിന്റെ ഗീതം","kn":"ಸೇನಜಿತನ ಗೀತೆ"},"27":{"hi":"युधिष्ठिर का विलाप और व्यास का उत्तर","te":"యుధిష్ఠిరుడి విలాపం; వ్యాసుడి సమాధానం","ta":"யுதிஷ்டிரனின் புலம்பலும் வியாசரின் பதிலும்","ml":"യുധിഷ്ഠിരന്റെ വിലാപവും വ്യാസന്റെ മറുപടിയും","kn":"ಯುಧಿಷ್ಠಿರನ ಶೋಕ ಮತ್ತು ವ್ಯಾಸರ ಉತ್ತರ"},"28":{"hi":"व्यास जनक और अश्म की कथा सुनाते हैं","te":"జనకుడు, అశ్మ కథను వ్యాసుడు చెబుతాడు","ta":"ஜனகரும் அஷ்மனும் பற்றி வியாசர் கூறுகிறார்","ml":"ജനകന്റെയും അശ്മന്റെയും കഥ വ്യാസൻ പറയുന്നു","kn":"ವ್ಯಾಸರು ಜನಕ ಮತ್ತು ಅಶ್ಮನ ಕಥೆಯನ್ನು ಹೇಳುತ್ತಾರೆ"},"29":{"hi":"अर्जुन कृष्ण से पूछते हैं; सोलह राजा","te":"కృష్ణుడిని అర్జునుడు అడుగుతాడు; పదహారుగురు రాజులు","ta":"அர்ஜுனன் கிருஷ்ணனிடம் கேட்கிறான்; பதினாறு அரசர்கள்","ml":"അർജ്ജുനൻ കൃഷ്ണനോട് ചോദിക്കുന്നു; പതിനാറു രാജാക്കന്മാർ","kn":"ಅರ್ಜುನ ಕೃಷ್ಣನನ್ನು ಕೇಳುತ್ತಾನೆ; ಹದಿನಾರು ರಾಜರು"},"30":{"hi":"सोने का थूकने वाला बालक","te":"బంగారం ఉమ్మే బాలుడు","ta":"பொன் உமிழும் குழந்தை","ml":"സ്വർണ്ണം തുപ്പുന്ന കുട്ടി","kn":"ಚಿನ್ನವನ್ನು ಉಗುಳುವ ಮಗು"},"31":{"hi":"नारद और पर्वत का शाप","te":"నారదుడు, పర్వతుడి శాపం","ta":"நாரதரும் பர்வதரின் சாபமும்","ml":"നാരദനും പർവ്വതനും, പർവ്വതന്റെ ശാപം","kn":"ನಾರದ ಮತ್ತು ಪರ್ವತನ ಶಾಪ"},"32":{"hi":"व्यास प्रायश्चित्त पर","te":"ప్రాయశ్చిత్తంపై వ్యాసుడు","ta":"பிராயசித்தம் பற்றி வியாசர்","ml":"പ്രായശ്ചിത്തത്തെക്കുറിച്ച് വ്യാസൻ","kn":"ಪ್ರಾಯಶ್ಚಿತ್ತದ ಕುರಿತು ವ್ಯಾಸರು"},"33":{"hi":"युधिष्ठिर का दूसरा विलाप","te":"యుధిష్ఠిరుడి రెండవ విలాపం","ta":"யுதிஷ்டிரனின் இரண்டாம் புலம்பல்","ml":"യുധിഷ്ഠിരന്റെ രണ്ടാമത്തെ വിലാപം","kn":"ಯುಧಿಷ್ಠಿರನ ಎರಡನೆಯ ಶೋಕ"},"34":{"hi":"युद्ध के कारण पर व्यास का उत्तर","te":"యుద్ధానికి కారణంపై వ్యాసుడి సమాధానం","ta":"போருக்குக் காரணம் பற்றி வியாசரின் பதில்","ml":"യുദ്ധകാരണത്തെക്കുറിച്ച് വ്യാസന്റെ മറുപടി","kn":"ಯುದ್ಧದ ಕಾರಣದ ಕುರಿತು ವ್ಯಾಸರ ಉತ್ತರ"},"35":{"hi":"युधिष्ठिर प्रायश्चित्त के बारे में पूछते हैं","te":"ప్రాయశ్చిత్తం గురించి యుధిష్ఠిరుడి ప్రశ్న","ta":"பிராயசித்தம் பற்றி யுதிஷ்டிரன் கேட்கிறான்","ml":"പ്രായശ്ചിത്തത്തെക്കുറിച്ച് യുധിഷ്ഠിരന്റെ ചോദ്യം","kn":"ಪ್ರಾಯಶ್ಚಿತ್ತದ ಕುರಿತು ಯುಧಿಷ್ಠಿರ ಕೇಳುತ್ತಾನೆ"},"36":{"hi":"प्रायश्चित्त के नियम","te":"ప్రాయశ్చిత్త నియమాలు","ta":"பிராயசித்த விதிகள்","ml":"പ്രായശ്ചിത്തത്തിന്റെ നിയമങ്ങൾ","kn":"ಪ್ರಾಯಶ್ಚಿತ್ತದ ನಿಯಮಗಳು"},"37":{"hi":"युधिष्ठिर स्वीकार करते हैं और राजधर्म पूछते हैं","te":"యుధిష్ఠిరుడు అంగీకరిస్తూ రాజధర్మం అడుగుతాడు","ta":"யுதிஷ்டிரன் ஏற்று அரசர்களின் தர்மத்தைக் கேட்கிறான்","ml":"യുധിഷ്ഠിരൻ സമ്മതിക്കുന്നു, രാജധർമ്മം ചോദിക്കുന്നു","kn":"ಯುಧಿಷ್ಠಿರ ಒಪ್ಪಿ ರಾಜಧರ್ಮವನ್ನು ಕೇಳುತ್ತಾನೆ"},"38":{"hi":"युधिष्ठिर हस्तिनापुर जाते हैं","te":"యుధిష్ఠిరుడు హస్తినాపురానికి వెళ్తాడు","ta":"யுதிஷ்டிரன் அஸ்தினாபுரம் செல்கிறான்","ml":"യുധിഷ്ഠിരൻ ഹസ്തിനാപുരത്തേക്ക് പോകുന്നു","kn":"ಯುಧಿಷ್ಠಿರ ಹಸ್ತಿನಾಪುರಕ್ಕೆ ಹೋಗುತ್ತಾನೆ"},"39":{"hi":"नगर में प्रवेश और चार्वाक","te":"నగర ప్రవేశం, చార్వాకుడు","ta":"நகர நுழைவும் சார்வாகனும்","ml":"നഗരപ്രവേശവും ചാർവാകനും","kn":"ನಗರ ಪ್ರವೇಶ ಮತ್ತು ಚಾರ್ವಾಕ"},"40":{"hi":"युधिष्ठिर का राज्याभिषेक","te":"యుధిష్ఠిరుడి పట్టాభిషేకం","ta":"யுதிஷ்டிரனின் முடிசூட்டு விழா","ml":"യുധിഷ്ഠിരന്റെ അഭിഷേകം","kn":"ಯುಧಿಷ್ಠಿರನ ಪಟ್ಟಾಭಿಷೇಕ"},"41":{"hi":"युधिष्ठिर अपने अधिकारी नियुक्त करते हैं","te":"యుధిష్ఠిరుడు అధికారులను నియమిస్తాడు","ta":"யுதிஷ்டிரன் அதிகாரிகளை நியமிக்கிறான்","ml":"യുധിഷ്ഠിരൻ ഉദ്യോഗസ്ഥരെ നിയമിക്കുന്നു","kn":"ಯುಧಿಷ್ಠಿರ ತನ್ನ ಅಧಿಕಾರಿಗಳನ್ನು ನೇಮಿಸುತ್ತಾನೆ"},"42":{"hi":"परिजनों के अंतिम संस्कार","te":"బంధువుల అంత్యక్రియలు","ta":"உறவினர்களுக்கான இறுதிச் சடங்குகள்","ml":"ബന്ധുക്കൾക്കുള്ള അന്ത്യകർമ്മങ്ങൾ","kn":"ಬಂಧುಗಳಿಗೆ ಉತ್ತರಕ್ರಿಯೆಗಳು"},"43":{"hi":"युधिष्ठिर कृष्ण की स्तुति करते हैं","te":"యుధిష్ఠిరుడు కృష్ణుడిని స్తుతిస్తాడు","ta":"யுதிஷ்டிரன் கிருஷ்ணனைப் போற்றுகிறான்","ml":"യുധിഷ്ഠിരൻ കൃഷ്ണനെ സ്തുതിക്കുന്നു","kn":"ಯುಧಿಷ್ಠಿರ ಕೃಷ್ಣನನ್ನು ಸ್ತುತಿಸುತ್ತಾನೆ"},"44":{"hi":"पांडव राजमहल में बसते हैं","te":"పాండవులు రాజభవనంలో స్థిరపడతారు","ta":"பாண்டவர்கள் அரண்மனையில் குடியேறுகின்றனர்","ml":"പാണ്ഡവർ കൊട്ടാരത്തിൽ താമസമാക്കുന്നു","kn":"ಪಾಂಡವರು ಅರಮನೆಯಲ್ಲಿ ನೆಲೆಸುತ್ತಾರೆ"},"45":{"hi":"युधिष्ठिर के दान; कृष्ण का ध्यान","te":"యుధిష్ఠిరుడి దానాలు; ధ్యానంలో కృష్ణుడు","ta":"யுதிஷ்டிரனின் தானங்கள்; தியானத்தில் கிருஷ்ணன்","ml":"യുധിഷ്ഠിരന്റെ ദാനങ്ങൾ; ധ്യാനത്തിൽ കൃഷ്ണൻ","kn":"ಯುಧಿಷ್ಠಿರನ ದಾನ; ಧ್ಯಾನದಲ್ಲಿ ಕೃಷ್ಣ"},"46":{"hi":"कृष्ण भीष्म का स्मरण करते हैं","te":"భీష్ముడిని కృష్ణుడు స్మరిస్తాడు","ta":"பீஷ்மரை கிருஷ்ணன் நினைக்கிறான்","ml":"ഭീഷ്മരെക്കുറിച്ച് കൃഷ്ണൻ ചിന്തിക്കുന്നു","kn":"ಕೃಷ್ಣ ಭೀಷ್ಮರನ್ನು ಸ್ಮರಿಸುತ್ತಾನೆ"},"47":{"hi":"भीष्म की कृष्ण-स्तुति","te":"కృష్ణుడిని భీష్ముడు స్తుతిస్తాడు","ta":"பீஷ்மர் கிருஷ்ணனைப் போற்றுகிறார்","ml":"കൃഷ്ണനെ ഭീഷ്മർ സ്തുതിക്കുന്നു","kn":"ಕೃಷ್ಣನನ್ನು ಭೀಷ್ಮರು ಸ್ತುತಿಸುತ್ತಾರೆ"},"48":{"hi":"कुरुक्षेत्र की यात्रा","te":"కురుక్షేత్రానికి ప్రయాణం","ta":"குருக்ஷேத்திரப் பயணம்","ml":"കുരുക്ഷേത്രത്തിലേക്കുള്ള യാത്ര","kn":"ಕುರುಕ್ಷೇತ್ರಕ್ಕೆ ಪ್ರಯಾಣ"},"49":{"hi":"परशुराम की कथा","te":"పరశురాముడి కథ","ta":"பரசுராமரின் கதை","ml":"പരശുരാമന്റെ കഥ","kn":"ಪರಶುರಾಮರ ಕಥೆ"},"50":{"hi":"कृष्ण युधिष्ठिर को सांत्वना देते हैं","te":"యుధిష్ఠిరుడిని కృష్ణుడు ఓదార్చుతాడు","ta":"கிருஷ்ணன் யுதிஷ்டிரனுக்கு ஆறுதல் கூறுகிறான்","ml":"കൃഷ്ണൻ യുധിഷ്ഠിരനെ ആശ്വസിപ്പിക്കുന്നു","kn":"ಕೃಷ್ಣ ಯುಧಿಷ್ಠಿರನನ್ನು ಸಂತೈಸುತ್ತಾನೆ"},"51":{"hi":"कृष्ण भीष्म से मिलते हैं","te":"కృష్ణుడు భీష్ముడిని కలుస్తాడు","ta":"கிருஷ்ணன் பீஷ்மரைச் சந்திக்கிறான்","ml":"കൃഷ്ണൻ ഭീഷ്മരെ കാണുന്നു","kn":"ಕೃಷ್ಣ ಭೀಷ್ಮರನ್ನು ಭೇಟಿಯಾಗುತ್ತಾನೆ"},"52":{"hi":"कृष्ण भीष्म से उपदेश देने को कहते हैं","te":"బోధించమని భీష్ముడిని కృష్ణుడు కోరతాడు","ta":"உபதேசிக்குமாறு பீஷ்மரிடம் கிருஷ்ணன் கேட்கிறான்","ml":"പഠിപ്പിക്കാൻ കൃഷ്ണൻ ഭീഷ്മരോട് ആവശ്യപ്പെടുന്നു","kn":"ಭೀಷ್ಮರನ್ನು ಉಪದೇಶಿಸಲು ಕೃಷ್ಣ ಕೋರುತ್ತಾನೆ"},"53":{"hi":"पांडव भीष्म के पास पहुंचते हैं","te":"పాండవులు భీష్ముడి వద్దకు చేరతారు","ta":"பாண்டவர்கள் பீஷ்மரை அடைகின்றனர்","ml":"പാണ്ഡവർ ഭീഷ്മരുടെ അടുത്ത് എത്തുന്നു","kn":"ಪಾಂಡವರು ಭೀಷ್ಮರನ್ನು ತಲುಪುತ್ತಾರೆ"},"54":{"hi":"भीष्म उपदेश देने को सहमत होते हैं","te":"బోధించేందుకు భీష్ముడు అంగీకరిస్తాడు","ta":"உபதேசிக்க பீஷ்மர் ஒப்புக்கொள்கிறார்","ml":"പഠിപ്പിക്കാൻ ഭീഷ്മർ സമ്മതിക്കുന്നു","kn":"ಭೀಷ್ಮರು ಉಪದೇಶಿಸಲು ಒಪ್ಪುತ್ತಾರೆ"},"55":{"hi":"भीष्म के उपदेश का आरंभ","te":"భీష్ముడి బోధ ప్రారంభం","ta":"பீஷ்மரின் உபதேசத்தின் தொடக்கம்","ml":"ഭീഷ്മരുടെ ഉപദേശത്തിന്റെ തുടക്കം","kn":"ಭೀಷ್ಮರ ಉಪದೇಶದ ಆರಂಭ"},"56":{"hi":"राजा का आचरण","te":"రాజు ప్రవర్తన","ta":"அரசனின் நடத்தை","ml":"രാജാവിന്റെ പെരുമാറ്റം","kn":"ರಾಜನ ನಡತೆ"},"57":{"hi":"राजा का दैनिक अनुशासन","te":"రాజు దైనందిన క్రమశిక్షణ","ta":"அரசனின் அன்றாட ஒழுக்கம்","ml":"രാജാവിന്റെ ദൈനംദിന ചിട്ട","kn":"ರಾಜನ ದೈನಂದಿನ ಶಿಸ್ತು"},"58":{"hi":"राजा के कर्तव्यों का सार","te":"రాజధర్మాల సారాంశం","ta":"அரசனின் கடமைகளின் சாரம்","ml":"രാജകർത്തവ്യങ്ങളുടെ സാരം","kn":"ರಾಜಕರ್ತವ್ಯಗಳ ಸಾರ"},"59":{"hi":"राजत्व की उत्पत्ति","te":"రాజ్యాధికార మూలం","ta":"அரசாட்சியின் தோற்றம்","ml":"രാജത്വത്തിന്റെ ഉത്ഭവം","kn":"ರಾಜತ್ವದ ಉಗಮ"},"60":{"hi":"चारों वर्णों का धर्म","te":"నాలుగు వర్ణాల ధర్మం","ta":"நால் வருணங்களின் தர்மம்","ml":"നാലു വർണ്ണങ്ങളുടെ ധർമ്മം","kn":"ನಾಲ್ಕು ವರ್ಣಗಳ ಧರ್ಮ"},"61":{"hi":"जीवन के चार आश्रम","te":"జీవితంలోని నాలుగు దశలు","ta":"வாழ்க்கையின் நான்கு நிலைகள்","ml":"ജീവിതത്തിന്റെ നാലു ആശ്രമങ്ങൾ","kn":"ಜೀವನದ ನಾಲ್ಕು ಆಶ್ರಮಗಳು"},"62":{"hi":"सबके हित का धर्म","te":"అందరికీ మేలు చేసే ధర్మం","ta":"அனைவருக்கும் நன்மை தரும் தர்மம்","ml":"എല്ലാവർക്കും ഗുണകരമായ ധർമ്മം","kn":"ಸರ್ವರಿಗೂ ಹಿತವಾದ ಧರ್ಮ"},"63":{"hi":"संकट काल में वर्णों के कर्तव्य","te":"ఆపద సమయంలో వర్ణాల ధర్మాలు","ta":"இடர்க்காலத்தில் வருணங்களின் கடமைகள்","ml":"ആപത്തുകാലത്ത് വർണ്ണങ്ങളുടെ കർത്തവ്യങ്ങൾ","kn":"ಸಂಕಟ ಕಾಲದಲ್ಲಿ ವರ್ಣಗಳ ಕರ್ತವ್ಯ"},"64":{"hi":"इंद्र और मांधाता का क्षत्रिय धर्म पर संवाद","te":"క్షత్రియ ధర్మంపై ఇంద్రుడు, మాంధాత","ta":"சத்திரியர் தர்மம் பற்றி இந்திரனும் மாந்தாதாவும்","ml":"ക്ഷത്രിയധർമ്മത്തെക്കുറിച്ച് ഇന്ദ്രനും മാന്ധാതാവും","kn":"ಕ್ಷತ್ರಿಯ ಧರ್ಮದ ಕುರಿತು ಇಂದ್ರ ಮತ್ತು ಮಾಂಧಾತ"},"65":{"hi":"दंड और युग","te":"దండం, యుగాలు","ta":"தண்டக் கோல் மற்றும் யுகங்கள்","ml":"ദണ്ഡവും യുഗങ്ങളും","kn":"ದಂಡ ಮತ್ತು ಯುಗಗಳು"},"66":{"hi":"युधिष्ठिर सबके धर्म के बारे में पूछते हैं","te":"అందరి ధర్మం గురించి యుధిష్ఠిరుడి ప్రశ్న","ta":"அனைவரின் தர்மம் பற்றி யுதிஷ்டிரன் கேட்கிறான்","ml":"എല്ലാവരുടെയും ധർമ്മം യുധിഷ്ഠിരൻ ചോദിക്കുന്നു","kn":"ಸರ್ವ ಧರ್ಮದ ಕುರಿತು ಯುಧಿಷ್ಠಿರ ಕೇಳುತ್ತಾನೆ"},"67":{"hi":"उत्पत्ति: मनु और पहला राजा","te":"మూలం: మనువు, మొదటి రాజు","ta":"தோற்றம்: மனுவும் முதல் அரசனும்","ml":"ഉത്ഭവം: മനുവും ആദ്യരാജാവും","kn":"ಉಗಮ: ಮನು ಮತ್ತು ಮೊದಲ ರಾಜ"},"68":{"hi":"देवता के रूप में राजा","te":"దేవుడిగా రాజు","ta":"தெய்வமாகும் அரசன்","ml":"ദൈവതുല്യനായ രാജാവ്","kn":"ದೇವರಂತೆ ರಾಜ"},"69":{"hi":"राजा के लिए क्या शेष रहता है","te":"రాజుకు మిగిలిన కర్తవ్యం ఏమిటి","ta":"அரசனுக்கு எஞ்சியுள்ள கடமை","ml":"രാജാവിന് ഇനി ചെയ്യാനുള്ളത് എന്ത്","kn":"ರಾಜನಿಗೆ ಇನ್ನು ಉಳಿದಿರುವ ಕರ್ತವ್ಯ"},"70":{"hi":"दंड और राजा","te":"దండనీతి, రాజు","ta":"தண்டமும் அரசனும்","ml":"ദണ്ഡവും രാജാവും","kn":"ದಂಡ ಮತ್ತು ರಾಜ"},"71":{"hi":"राजा को कैसा आचरण करना चाहिए","te":"రాజు ఎలా నడుచుకోవాలి","ta":"அரசன் எவ்வாறு நடந்துகொள்ள வேண்டும்","ml":"രാജാവ് എങ്ങനെ പെരുമാറണം","kn":"ರಾಜನು ಹೇಗೆ ನಡೆದುಕೊಳ್ಳಬೇಕು"},"72":{"hi":"पाप रहित होकर प्रजा की रक्षा","te":"పాపం లేకుండా ప్రజలను రక్షించడం","ta":"பாவமின்றி மக்களைக் காத்தல்","ml":"പാപമില്ലാതെ ജനങ്ങളെ സംരക്ഷിക്കുക","kn":"ಪಾಪವಿಲ್ಲದೆ ಪ್ರಜೆಗಳನ್ನು ರಕ್ಷಿಸುವುದು"},"73":{"hi":"राजा कौन हो: ऐल की कथा","te":"రాజు ఎవరు: ఐల కథ","ta":"யார் அரசனாக வேண்டும்: ஐலனின் கதை","ml":"ആരാണ് രാജാവാകേണ്ടത്: ഐലന്റെ കഥ","kn":"ಯಾರು ರಾಜನಾಗಬೇಕು: ಐಲನ ಕಥೆ"},"74":{"hi":"राजा और उसका पुरोहित","te":"రాజు, అతని పురోహితుడు","ta":"அரசனும் அவனது புரோகிதரும்","ml":"രാജാവും പുരോഹിതനും","kn":"ರಾಜ ಮತ್ತು ಅವನ ಪುರೋಹಿತ"},"75":{"hi":"मुचुकुंद और कुबेर","te":"ముచుకుందుడు, కుబేరుడు","ta":"முசுகுந்தனும் குபேரனும்","ml":"മുചുകുന്ദനും കുബേരനും","kn":"ಮುಚುಕುಂದ ಮತ್ತು ಕುಬೇರ"},"76":{"hi":"राजा कैसे बढ़ता है","te":"రాజ్యం ఎలా వృద్ధి చెందుతుంది","ta":"அரசன் எவ்வாறு வளர்கிறான்","ml":"രാജാവ് എങ്ങനെ വളരുന്നു","kn":"ರಾಜನು ಬೆಳೆಯುವ ಬಗೆ"},"77":{"hi":"राज्य में वर्ण","te":"రాజ్యంలోని వర్ణాలు","ta":"அரசாட்சியின் வருணங்கள்","ml":"രാജ്യത്തിലെ വർണ്ണങ്ങൾ","kn":"ರಾಜ್ಯದಲ್ಲಿನ ವರ್ಣಗಳು"},"78":{"hi":"राजा का धन और सबके प्रति आचरण","te":"రాజు సంపద, అందరితో వ్యవహారం","ta":"அரசனின் செல்வமும் அனைவரிடமும் அவனது நடத்தையும்","ml":"രാജാവിന്റെ സമ്പത്തും എല്ലാവരോടുമുള്ള പെരുമാറ്റവും","kn":"ರಾಜನ ಸಂಪತ್ತು ಮತ್ತು ಎಲ್ಲರ ಕಡೆಗಿನ ನಡತೆ"},"79":{"hi":"विपत्ति में क्षत्रिय की जीविका","te":"కష్ట కాలంలో క్షత్రియుడి జీవనోపాధి","ta":"இக்கட்டில் சத்திரியனின் வாழ்வாதாரம்","ml":"ദുരിതകാലത്ത് ക്ഷത്രിയന്റെ ജീവിതമാർഗ്ഗം","kn":"ಸಂಕಟದಲ್ಲಿ ಕ್ಷತ್ರಿಯನ ಜೀವನೋಪಾಯ"},"80":{"hi":"यज्ञ के पुरोहित","te":"యజ్ఞ పురోహితులు","ta":"யாகத்தின் புரோகிதர்கள்","ml":"യാഗത്തിലെ പുരോഹിതന്മാർ","kn":"ಯಜ್ಞದ ಪುರೋಹಿತರು"},"81":{"hi":"परिजनों और मित्रों के साथ व्यवहार","te":"బంధువులు, మిత్రులతో వ్యవహారం","ta":"உறவினர்களையும் நட்பு நாட்டினரையும் கையாளுதல்","ml":"ബന്ധുക്കളോടും സഖ്യകക്ഷികളോടും ഇടപെടുന്ന വിധം","kn":"ಬಂಧುಗಳು ಮತ್ತು ಮಿತ್ರರೊಂದಿಗೆ ವ್ಯವಹಾರ"},"82":{"hi":"कृष्ण अपने परिजनों पर","te":"తన బంధువులపై కృష్ణుడు","ta":"தம் உறவினர்கள் பற்றி கிருஷ்ணன்","ml":"സ്വന്തം ബന്ധുക്കളെക്കുറിച്ച് കൃഷ്ണൻ","kn":"ತನ್ನ ಬಂಧುಗಳ ಕುರಿತು ಕೃಷ್ಣ"},"83":{"hi":"राजा और राजसेवकों की सेवा पर","te":"రాజును, రాజ సేవకులను సేవించడం","ta":"அரசனுக்கும் அரசனின் ஊழியர்களுக்கும் சேவை செய்வது பற்றி","ml":"രാജാവിനെയും രാജസേവകരെയും സേവിക്കുന്നതിനെക്കുറിച്ച്","kn":"ರಾಜನ ಸೇವೆ ಮತ್ತು ರಾಜಸೇವಕರ ಕುರಿತು"},"84":{"hi":"अच्छे मंत्री के गुण","te":"మంచి మంత్రి లక్షణాలు","ta":"நல்ல ஆலோசகரின் குணங்கள்","ml":"നല്ല മന്ത്രിയുടെ ഗുണങ്ങൾ","kn":"ಉತ್ತಮ ಮಂತ್ರಿಯ ಗುಣಗಳು"},"85":{"hi":"बृहस्पति और इंद्र: सबके प्रति मधुर रहो","te":"బృహస్పతి, ఇంద్రుడు: అందరితో మృదువుగా","ta":"பிருஹஸ்பதியும் இந்திரனும்: அனைவரிடமும் இனிமையாக இருங்கள்","ml":"ബൃഹസ്പതിയും ഇന്ദ്രനും: എല്ലാവരോടും സൗമ്യത","kn":"ಬೃಹಸ್ಪತಿ ಮತ್ತು ಇಂದ್ರ: ಎಲ್ಲರೊಂದಿಗೆ ಸೌಜನ್ಯದಿಂದಿರು"},"86":{"hi":"गुप्त रूप से प्रजा पर शासन","te":"రహస్యంగా ప్రజలను పాలించడం","ta":"இரகசியமாக மக்களை ஆளுதல்","ml":"രഹസ്യമായി ജനങ്ങളെ ഭരിക്കുന്നത്","kn":"ಗುಪ್ತತೆಯಿಂದ ಪ್ರಜೆಗಳನ್ನು ಆಳುವುದು"},"87":{"hi":"राजा का नगर","te":"రాజు నగరం","ta":"அரசனின் நகரம்","ml":"രാജാവിന്റെ നഗരം","kn":"ರಾಜನ ನಗರ"},"88":{"hi":"राज्य की रक्षा","te":"రాజ్య రక్షణ","ta":"அரசாட்சியைக் காத்தல்","ml":"രാജ്യത്തെ സംരക്ഷിക്കൽ","kn":"ರಾಜ್ಯದ ರಕ್ಷಣೆ"},"89":{"hi":"जब राजा को धन की आवश्यकता हो","te":"రాజుకు ధన అవసరం ఉన్నప్పుడు","ta":"அரசனுக்குச் செல்வம் தேவைப்படும்போது","ml":"സമ്പത്ത് ആവശ്യമായി വരുമ്പോൾ രാജാവ്","kn":"ರಾಜನಿಗೆ ಧನದ ಅಗತ್ಯ ಬಂದಾಗ"},"90":{"hi":"राजा के लिए अच्छे आचरण के उपदेश","te":"మంచి ప్రవర్తనపై రాజుకు సూచనలు","ta":"நல்ல நடத்தை பற்றி அரசனுக்கான அறிவுரைகள்","ml":"നല്ല പെരുമാറ്റത്തെക്കുറിച്ച് രാജാവിനുള്ള നിർദ്ദേശങ്ങൾ","kn":"ಉತ್ತಮ ನಡತೆಯ ಕುರಿತು ರಾಜನ ಉಪದೇಶ"},"91":{"hi":"उताथ्य का मांधाता को परामर्श","te":"మాంధాతకు ఉతథ్యుడి సలహా","ta":"மாந்தாதாவுக்கு உத்தத்யரின் ஆலோசனை","ml":"മാന്ധാതാവിന് ഉതഥ്യന്റെ ഉപദേശം","kn":"ಮಾಂಧಾತನಿಗೆ ಉತಥ್ಯನ ಸಲಹೆ"},"92":{"hi":"वर्षा और धर्मात्मा राजा","te":"వర్షం, ధర్మపరుడైన రాజు","ta":"மழையும் நீதியுள்ள அரசனும்","ml":"മഴയും നീതിമാനായ രാജാവും","kn":"ಮಳೆ ಮತ್ತು ಧರ್ಮಿಷ್ಠ ರಾಜ"},"93":{"hi":"धर्मात्मा राजा क्या करे","te":"ధర్మపరుడైన రాజు ఏం చేయాలి","ta":"நீதியுள்ள அரசன் செய்ய வேண்டியவை","ml":"നീതിമാനായ രാജാവ് ചെയ്യേണ്ടത്","kn":"ಧರ್ಮಿಷ್ಠ ರಾಜನು ಏನು ಮಾಡಬೇಕು"},"94":{"hi":"वामदेव का राजा को परामर्श","te":"ఒక రాజుకు వామదేవుడి సలహా","ta":"அரசனுக்கு வாமதேவரின் ஆலோசனை","ml":"രാജാവിന് വാമദേവന്റെ ഉപദേശം","kn":"ರಾಜನಿಗೆ ವಾಮದೇವನ ಸಲಹೆ"},"95":{"hi":"युद्ध के बिना विजय","te":"యుద్ధం లేకుండా జయించడం","ta":"போரின்றி வெல்லுதல்","ml":"യുദ്ധമില്ലാതെ ജയിക്കുന്നത്","kn":"ಯುದ್ಧವಿಲ್ಲದೆ ಗೆಲುವು"},"96":{"hi":"क्षत्रिय के युद्ध का धर्म","te":"క్షత్రియుడు పోరాడే ధర్మం","ta":"சத்திரியனுடன் போரிடும் தர்மம்","ml":"ക്ഷത്രിയന്റെ യുദ്ധധർമ്മം","kn":"ಕ್ಷತ್ರಿಯನ ಯುದ್ಧಧರ್ಮ"},"97":{"hi":"धर्म से विजय","te":"ధర్మంతో జయం","ta":"தர்மத்தால் வெற்றி","ml":"ധർമ്മത്താൽ ജയിക്കൽ","kn":"ಧರ್ಮದಿಂದ ವಿಜಯ"},"98":{"hi":"युद्ध का धर्म","te":"యుద్ధ ధర్మం","ta":"போரின் தர்மம்","ml":"യുദ്ധധർമ്മം","kn":"ಯುದ್ಧಧರ್ಮ"},"99":{"hi":"वीरों के लोक","te":"వీరుల లోకాలు","ta":"வீரர்களின் உலகங்கள்","ml":"വീരന്മാരുടെ ലോകങ്ങൾ","kn":"ವೀರರ ಲೋಕಗಳು"},"100":{"hi":"वीरों की महिमा","te":"శూరుల మహిమ","ta":"வீரர்களின் பெருமை","ml":"ധീരരുടെ മഹത്വം","kn":"ಶೂರರ ಮಹಿಮೆ"},"101":{"hi":"रणभूमि में सेना","te":"రణరంగంలో సేన","ta":"போர்க்களத்தில் படை","ml":"യുദ്ധഭൂമിയിലെ സേന","kn":"ರಣರಂಗದಲ್ಲಿನ ಸೇನೆ"},"102":{"hi":"अच्छी सेना के लक्षण","te":"మంచి సేన లక్షణాలు","ta":"நல்ல படையின் அடையாளங்கள்","ml":"നല്ല സേനയുടെ ലക്ഷണങ്ങൾ","kn":"ಉತ್ತಮ ಸೇನೆಯ ಲಕ್ಷಣಗಳು"},"103":{"hi":"विजय के लक्षण और आचरण","te":"విజయ సూచనలు, ప్రవర్తన","ta":"வெற்றியின் அடையாளங்களும் நடந்துகொள்ளும் முறையும்","ml":"ജയത്തിന്റെ ലക്ഷണങ്ങളും പെരുമാറ്റവും","kn":"ಜಯದ ಲಕ್ಷಣಗಳು ಮತ್ತು ನಡತೆಯ ಬಗೆ"},"104":{"hi":"कोमल और कठोर शत्रुओं से व्यवहार","te":"మృదువుగా, కఠినంగా శత్రువులతో వ్యవహారం","ta":"மென்மையாகவும் கடுமையாகவும் எதிரிகளைக் கையாளுதல்","ml":"ശത്രുക്കളോട് മൃദുവായും കഠിനമായും ഇടപെടുന്നത്","kn":"ಸೌಮ್ಯ ಮತ್ತು ಕ್ರೂರ ಶತ್ರುಗಳೊಂದಿಗೆ ವ್ಯವಹಾರ"},"105":{"hi":"नष्ट राजा और ऋषि का परामर्श","te":"చెడిపోయిన రాజు, ఋషి సలహా","ta":"அழிந்த அரசனும் முனிவரின் ஆலோசனையும்","ml":"തകർന്ന രാജാവും മുനിയുടെ ഉപദേശവും","kn":"ನಾಶಗೊಂಡ ರಾಜ ಮತ್ತು ಋಷಿಯ ಸಲಹೆ"},"106":{"hi":"भाग्य लौटाने का ऋषि का परामर्श","te":"అదృష్టాన్ని తిరిగి తెచ్చుకునే సలహా","ta":"அதிர்ஷ்டத்தை மீட்பது பற்றி முனிவரின் அறிவுரை","ml":"ഭാഗ്യം വീണ്ടെടുക്കാൻ മുനിയുടെ ഉപദേശം","kn":"ಭಾಗ್ಯ ಚಿಗುರಿಸುವ ಕುರಿತು ಋಷಿಯ ಸಲಹೆ"},"107":{"hi":"राजकुमार का इनकार और ऋषि का पुरस्कार","te":"రాకుమారుడి తిరస్కారం, ఋషి బహుమానం","ta":"இளவரசனின் மறுப்பும் முனிவரின் வெகுமதியும்","ml":"രാജകുമാരന്റെ വിസമ്മതവും മുനിയുടെ പ്രതിഫലവും","kn":"ರಾಜಕುಮಾರನ ನಿರಾಕರಣೆ ಮತ್ತು ಋಷಿಯ ಪ್ರತಿಫಲ"},"108":{"hi":"संघ और उनकी दुर्बलता","te":"సంఘాలు, వాటి బలహీనత","ta":"கூட்டணிகளும் அவற்றின் பலவீனமும்","ml":"സഖ്യങ്ങളും അവയുടെ ദൗർബല്യവും","kn":"ಒಕ್ಕೂಟಗಳು ಮತ್ತು ಅವುಗಳ ದೌರ್ಬಲ್ಯ"},"109":{"hi":"धर्म का महान मार्ग","te":"గొప్ప ధర్మమార్గం","ta":"தர்மத்தின் பெரிய பாதை","ml":"ധർമ്മത്തിന്റെ മഹാപാത","kn":"ಧರ್ಮದ ಮಹಾಮಾರ್ಗ"},"110":{"hi":"धर्म के अनुसार जीवन","te":"ధర్మంతో ఎలా జీవించాలి","ta":"தர்மத்தில் வாழும் முறை","ml":"ധർമ്മത്തോടെ ജീവിക്കുന്ന വിധം","kn":"ಧರ್ಮದಲ್ಲಿ ಬದುಕುವ ಬಗೆ"},"111":{"hi":"कठिन स्थानों को पार करना","te":"కష్టమైన ప్రదేశాలను దాటడం","ta":"கடினமான இடங்களைக் கடத்தல்","ml":"ദുർഘടമായ സ്ഥലങ്ങൾ കടക്കൽ","kn":"ಕಷ್ಟದ ಹಾದಿಗಳನ್ನು ದಾಟುವುದು"},"112":{"hi":"सियार और बाघ","te":"నక్క, పులి","ta":"நரியும் புலியும்","ml":"കുറുക്കനും കടുവയും","kn":"ನರಿ ಮತ್ತು ಹುಲಿ"},"113":{"hi":"आलसी सियार और ऊंट","te":"సోమరి నక్క, ఒంటె","ta":"சோம்பேறி நரியும் ஒட்டகமும்","ml":"മടിയനായ കുറുക്കനും ഒട്ടകവും","kn":"ಸೋಮಾರಿ ನರಿ ಮತ್ತು ಒಂಟೆ"},"114":{"hi":"दुर्बल राजा और शक्तिशाली शत्रु","te":"బలహీన రాజు, బలమైన శత్రువు","ta":"பலவீனமான அரசனும் வலிமையான எதிரியும்","ml":"ദുർബലനായ രാജാവും ശക്തനായ ശത്രുവും","kn":"ದುರ್ಬಲ ರಾಜ ಮತ್ತು ಬಲಿಷ್ಠ ಶತ್ರು"},"115":{"hi":"मूर्ख के अपमान सहना","te":"మూర్ఖుడి అవమానాలను ఓర్చుకోవడం","ta":"மூடனின் அவமானங்களைப் பொறுத்தல்","ml":"വിഡ്ഢിയുടെ അധിക്ഷേപം സഹിക്കൽ","kn":"ಮೂರ್ಖನ ನಿಂದನೆಯನ್ನು ಸಹಿಸುವುದು"},"116":{"hi":"युधिष्ठिर का मंत्रियों पर संदेह","te":"మంత్రులపై యుధిష్ఠిరుడికి సందేహం","ta":"அமைச்சர்கள் பற்றி யுதிஷ்டிரனின் ஐயம்","ml":"മന്ത്രിമാരെക്കുറിച്ച് യുധിഷ്ഠിരന്റെ സംശയം","kn":"ಮಂತ್ರಿಗಳ ಕುರಿತು ಯುಧಿಷ್ಠಿರನ ಸಂದೇಹ"},"117":{"hi":"कुत्ता, बाघ और तपस्वी की कथा","te":"కుక్క, పులి, ముని కథ","ta":"நாய், புலி, முனிவர் பற்றிய கதை","ml":"നായയുടെയും കടുവയുടെയും മുനിയുടെയും കഥ","kn":"ನಾಯಿ, ಹುಲಿ ಮತ್ತು ಋಷಿಯ ಕಥೆ"},"118":{"hi":"कुत्ते की कथा की शिक्षा","te":"కుక్క కథలోని నీతి","ta":"நாயின் கதையிலுள்ள நீதி","ml":"നായയുടെ കഥയിലെ ഗുണപാഠം","kn":"ನಾಯಿಯ ಕಥೆಯ ನೀತಿ"},"119":{"hi":"सेवकों को उचित स्थान देना","te":"సేవకులను సరిగా నియమించడం","ta":"ஊழியர்களை முறையாக அமர்த்துதல்","ml":"സേവകരെ ശരിയായ സ്ഥാനത്ത് നിയമിക്കൽ","kn":"ಸೇವಕರನ್ನು ಸರಿಯಾಗಿ ನೇಮಿಸುವುದು"},"120":{"hi":"राजनीति और राज्य की रक्षा","te":"రాజనీతి, రాజ్య రక్షణ","ta":"அரசனின் கொள்கையும் அரசாட்சியைக் காத்தலும்","ml":"രാജനീതിയും രാജ്യസംരക്ഷണവും","kn":"ರಾಜನೀತಿ ಮತ್ತು ರಾಜ್ಯರಕ್ಷಣೆಯ ಕುರಿತು"},"121":{"hi":"दंड का दंड","te":"దండం","ta":"தண்டக் கோல்","ml":"ദണ്ഡം","kn":"ದಂಡ"},"122":{"hi":"दंड की उत्पत्ति: वसुहोम और शिव का खड्ग","te":"దండం మూలం: వసుహోమ, శివుడి ఖడ్గం","ta":"தண்டக் கோலின் தோற்றம்: வசுஹோமரும் சிவனின் வாளும்","ml":"ദണ്ഡത്തിന്റെ ഉത്ഭവം: വസുഹോമനും ശിവന്റെ വാളും","kn":"ದಂಡದ ಉಗಮ: ವಸುಹೋಮ ಮತ್ತು ಶಿವನ ಖಡ್ಗ"},"123":{"hi":"धर्म, धन और काम","te":"ధర్మం, సంపద, కోరిక","ta":"தர்மம், செல்வம், ஆசை","ml":"ധർമ്മം, സമ്പത്ത്, കാമം","kn":"ಧರ್ಮ, ಅರ್ಥ ಮತ್ತು ಕಾಮ"},"124":{"hi":"दुर्योधन का प्रश्न और धृतराष्ट्र का उत्तर","te":"దుర్యోధనుడి ప్రశ్న, ధృతరాష్ట్రుడి సమాధానం","ta":"துரியோதனனின் கேள்வியும் திருதராஷ்டிரனின் பதிலும்","ml":"ദുര്യോധനന്റെ ചോദ്യവും ധൃതരാഷ്ട്രരുടെ മറുപടിയും","kn":"ದುರ್ಯೋಧನನ ಪ್ರಶ್ನೆ ಮತ್ತು ಧೃತರಾಷ್ಟ್ರನ ಉತ್ತರ"},"125":{"hi":"आशा और सुमित्रा की कथा","te":"ఆశ, సుమిత్ర కథ","ta":"நம்பிக்கையும் சுமித்திரையின் கதையும்","ml":"പ്രത്യാശയും സുമിത്രന്റെ കഥയും","kn":"ಆಶೆ ಮತ್ತು ಸುಮಿತ್ರನ ಕಥೆ"},"126":{"hi":"आशा पर ऋषियों का उपदेश","te":"ఆశపై ఋషుల బోధ","ta":"நம்பிக்கை பற்றி முனிவர்களின் போதனை","ml":"പ്രത്യാശയെക്കുറിച്ച് മുനിമാരുടെ ഉപദേശം","kn":"ಆಶೆಯ ಕುರಿತು ಋಷಿಗಳ ಉಪದೇಶ"},"127":{"hi":"गौतम और यम की कथा","te":"గౌతముడు, యముడి కథ","ta":"கௌதமரும் யமனும் பற்றிய கதை","ml":"ഗൗതമന്റെയും യമന്റെയും കഥ","kn":"ಗೌತಮ ಮತ್ತು ಯಮನ ಕಥೆ"},"128":{"hi":"संकट में राजा और कोष","te":"కష్టంలో ఉన్న రాజు, ఖజానా","ta":"இடரில் உள்ள அரசனும் கருவூலமும்","ml":"ദുരിതത്തിലായ രാജാവും ഖജനാവും","kn":"ಸಂಕಟದಲ್ಲಿರುವ ರಾಜ ಮತ್ತು ಕೋಶ"},"129":{"hi":"पतनशील राजा","te":"క్షీణిస్తున్న రాజు","ta":"வீழ்ச்சியடையும் அரசன்","ml":"ക്ഷയിച്ചുവരുന്ന രാജാവ്","kn":"ಅವನತಿಯಲ್ಲಿರುವ ರಾಜ"},"130":{"hi":"भ्रम का युग और आवश्यकता के नियम","te":"గందరగోళ యుగం; అవసర ధర్మాలు","ta":"குழப்பமான காலமும் நெருக்கடிக்கான விதிகளும்","ml":"ആശയക്കുഴപ്പത്തിന്റെ യുഗവും ആപത്ത് ധർമ്മവും","kn":"ಗೊಂದಲದ ಯುಗ ಮತ್ತು ಆಪದ್ಧರ್ಮದ ನಿಯಮಗಳು"},"131":{"hi":"धन संग्रह","te":"ధనం సమకూర్చడం","ta":"செல்வத்தைச் சேர்த்தல்","ml":"സമ്പത്ത് സമാഹരിക്കൽ","kn":"ಸಂಪತ್ತನ್ನು ಸಂಗ್ರಹಿಸುವುದು"},"132":{"hi":"धर्म बल पर टिका है","te":"ధర్మం బలంపై ఆధారపడి ఉంటుంది","ta":"தர்மம் வலிமையின் மீது நிற்கிறது","ml":"ധർമ്മം ശക്തിയിൽ അധിഷ്ഠിതം","kn":"ಧರ್ಮ ಬಲದ ಮೇಲೆ ನಿಂತಿದೆ"},"133":{"hi":"डाकुओं का धर्म","te":"దొంగల ధర్మం","ta":"கொள்ளையர்களின் தர்மம்","ml":"കള്ളന്മാരുടെ ധർമ്മം","kn":"ದರೋಡೆಕೋರರ ಧರ್ಮ"},"134":{"hi":"राजा के धन पर ब्रह्मा के श्लोक","te":"రాజు సంపదపై బ్రహ్మ శ్లోకాలు","ta":"அரசனின் செல்வம் பற்றி பிரம்மனின் சுலோகங்கள்","ml":"രാജാവിന്റെ സമ്പത്തിനെക്കുറിച്ച് ബ്രഹ്മാവിന്റെ ശ്ലോകങ്ങൾ","kn":"ರಾಜನ ಸಂಪತ್ತಿನ ಕುರಿತು ಬ್ರಹ್ಮನ ಶ್ಲೋಕಗಳು"},"135":{"hi":"तीन मछलियां: दूरदर्शिता","te":"మూడు చేపలు: ముందుచూపు","ta":"மூன்று மீன்கள்: முன்னெச்சரிக்கை","ml":"മൂന്നു മീനുകൾ: ദീർഘദർശനം","kn":"ಮೂರು ಮೀನುಗಳು: ದೂರದೃಷ್ಟಿ"},"136":{"hi":"बिल्ली और चूहा","te":"పిల్లి, ఎలుక","ta":"பூனையும் எலியும்","ml":"പൂച്ചയും എലിയും","kn":"ಬೆಕ್ಕು ಮತ್ತು ಇಲಿ"},"137":{"hi":"ब्रह्मदत्त और पक्षी की कथा","te":"బ్రహ్మదత్తుడు, పక్షి కథ","ta":"பிரம்மதத்தனும் பறவையும் பற்றிய கதை","ml":"ബ്രഹ്മദത്തന്റെയും പക്ഷിയുടെയും കഥ","kn":"ಬ್ರಹ್ಮದತ್ತ ಮತ್ತು ಪಕ್ಷಿಯ ಕಥೆ"},"138":{"hi":"विनाश के समय राजा का आचरण","te":"వినాశ సమయంలో రాజు ప్రవర్తన","ta":"அழிவுக் காலத்தில் அரசனின் நடத்தை","ml":"നാശകാലത്ത് രാജാവിന്റെ പെരുമാറ്റം","kn":"ವಿನಾಶದ ಕಾಲದಲ್ಲಿ ರಾಜನ ನಡತೆ"},"139":{"hi":"विश्वामित्र और कुत्ता-खाने वाला","te":"విశ్వామిత్రుడు, కుక్క మాంసం తినేవాడు","ta":"விசுவாமித்திரரும் சண்டாளனும்","ml":"വിശ്വാമിത്രനും നായ ഭക്ഷിക്കുന്നവനും","kn":"ವಿಶ್ವಾಮಿತ್ರ ಮತ್ತು ನಾಯಿ ಮಾಂಸ ಭಕ್ಷಕ"},"140":{"hi":"क्या डाकुओं का भी धर्म है","te":"దొంగలకు ధర్మం ఉంటుందా","ta":"கொள்ளையர்க்கும் தர்மம் உண்டா","ml":"കള്ളന്മാർക്കും ഒരു ധർമ്മമുണ്ടോ","kn":"ದರೋಡೆಕೋರರಿಗೂ ಧರ್ಮವಿದೆಯೇ"},"141":{"hi":"शरण: शिकारी और कबूतर की कथा आरंभ","te":"శరణు: వేటగాడు, పావురం కథ ప్రారంభం","ta":"புறா கதை தொடக்கம்: வேடனும் புறாவும்","ml":"അഭയം: വേടനും പ്രാവിന്റെയും കഥ തുടങ്ങുന്നു","kn":"ಆಶ್ರಯ: ಬೇಟೆಗಾರ ಮತ್ತು ಪಾರಿವಾಳದ ಕಥೆಯ ಆರಂಭ"},"142":{"hi":"कबूतर के घोंसले पर शिकारी","te":"పావురపు గూడు వద్ద వేటగాడు","ta":"புறாவின் கூட்டில் வேடன்","ml":"പ്രാവിന്റെ കൂടിനരികെ വേടൻ","kn":"ಪಾರಿವಾಳದ ಗೂಡಿನ ಬಳಿ ಬೇಟೆಗಾರ"},"143":{"hi":"शिकारी का पश्चात्ताप","te":"వేటగాడి పశ్చాత్తాపం","ta":"வேடனின் மனவருத்தம்","ml":"വേടന്റെ പശ്ചാത്താപം","kn":"ಬೇಟೆಗಾರನ ಪಶ್ಚಾತ್ತಾಪ"},"144":{"hi":"मादा कबूतर का विलाप","te":"ఆడ పావురం విలాపం","ta":"பெண் புறாவின் புலம்பல்","ml":"പെൺപ്രാവിന്റെ വിലാപം","kn":"ಹೆಣ್ಣು ಪಾರಿವಾಳದ ಶೋಕ"},"145":{"hi":"कबूतर स्वर्ग जाते हैं","te":"పావురాలు స్వర్గానికి వెళ్తాయి","ta":"புறாக்கள் சொர்க்கம் ஏகுகின்றன","ml":"പ്രാവുകൾ സ്വർഗ്ഗത്തിലേക്ക് ഉയരുന്നു","kn":"ಪಾರಿವಾಳಗಳು ಸ್ವರ್ಗಕ್ಕೇರುತ್ತವೆ"},"146":{"hi":"अनजाने पाप का प्रायश्चित्त","te":"తెలియక చేసిన పాపానికి ప్రాయశ్చిత్తం","ta":"அறியாமல் செய்த பாவத்துக்குப் பிராயசித்தம்","ml":"ഉദ്ദേശ്യമില്ലാത്ത പാപത്തിനുള്ള പ്രായശ്ചിത്തം","kn":"ಅರಿಯದೆ ಮಾಡಿದ ಪಾಪದ ಪ್ರಾಯಶ್ಚಿತ್ತ"},"147":{"hi":"जनमेजय का स्वीकारोक्ति","te":"జనమేజయుడి ఒప్పుకోలు","ta":"ஜனமேஜயனின் பாவ ஒப்புதல்","ml":"ജനമേജയന്റെ കുറ്റസമ്മതം","kn":"ಜನಮೇಜಯನ ಪಾಪನಿವೇದನೆ"},"148":{"hi":"पाप से मुक्त होने का मार्ग","te":"పాపం నుంచి విముక్తి మార్గం","ta":"பாவத்திலிருந்து விடுபடும் வழி","ml":"പാപത്തിൽനിന്ന് മോചനം നേടുന്ന വഴി","kn":"ಪಾಪದಿಂದ ಮುಕ್ತಿ ಪಡೆಯುವ ದಾರಿ"},"149":{"hi":"बालक के दाह-संस्कार पर सियार और गिद्ध","te":"బిడ్డ దహనంలో నక్క, రాబందు","ta":"குழந்தையின் இறுதிச் சடங்கில் நரியும் கழுகும்","ml":"കുട്ടിയുടെ ദഹനത്തിൽ കുറുക്കനും കഴുകനും","kn":"ಮಗುವಿನ ಚಿತೆಯ ಬಳಿ ನರಿ ಮತ್ತು ಹದ್ದು"},"150":{"hi":"नारद और शाल्मली वृक्ष","te":"నారదుడు, శాల్మలి వృక్షం","ta":"நாரதரும் சால்மலி மரமும்","ml":"നാരദനും ശാൽമലി മരവും","kn":"ನಾರದ ಮತ್ತು ಶಾಲ್ಮಲಿ ಮರ"},"151":{"hi":"आंधी का प्रकोप और वृक्ष का गिरना","te":"గాలి ప్రచండం; చెట్టు కూలుతుంది","ta":"காற்றின் சீற்றமும் மரம் வீழ்தலும்","ml":"കാറ്റിന്റെ രൗദ്രതയും മരത്തിന്റെ വീഴ്ചയും","kn":"ಗಾಳಿಯ ಆರ್ಭಟ ಮತ್ತು ಮರ ಬೀಳುವುದು"},"152":{"hi":"पाप का स्थान कौन सा है","te":"పాపానికి మూలస్థానం ఏది","ta":"பாவத்தின் இருப்பிடம் எது","ml":"പാപത്തിന്റെ ഇരിപ്പിടം എന്ത്","kn":"ಪಾಪದ ನೆಲೆ ಯಾವುದು"},"153":{"hi":"लोभ और अज्ञान","te":"అత్యాశ, అజ్ఞానం","ta":"பேராசையும் அறியாமையும்","ml":"അത്യാഗ്രഹവും അജ്ഞാനവും","kn":"ದುರಾಸೆ ಮತ್ತು ಅಜ್ಞಾನ"},"154":{"hi":"विद्वान ब्राह्मण और आत्मसंयम","te":"జ్ఞాని అయిన బ్రాహ్మణుడు, ఇంద్రియ నిగ్రహం","ta":"கற்றறிந்த அந்தணரும் தன்னடக்கமும்","ml":"പണ്ഡിതനായ ബ്രാഹ്മണനും ആത്മനിയന്ത്രണവും","kn":"ವಿದ್ವಾನ್ ಬ್ರಾಹ್ಮಣ ಮತ್ತು ಆತ್ಮ ಸಂಯಮ"},"155":{"hi":"तपस्या की शक्ति","te":"తపస్సు యొక్క శక్తి","ta":"தவத்தின் ஆற்றல்","ml":"തപസ്സിന്റെ ശക്തി","kn":"ತಪಸ್ಸಿನ ಶಕ್ತಿ"},"156":{"hi":"सत्य की महिमा","te":"సత్యం యొక్క మహిమ","ta":"உண்மையின் பெருமை","ml":"സത്യത്തിന്റെ മഹത്വം","kn":"ಸತ್ಯದ ಮಹಿಮೆ"},"157":{"hi":"क्रोध, काम और दुर्गुण","te":"కోపం, కోరిక, దుర్గుణాలు","ta":"கோபம், ஆசை, தீய குணங்கள்","ml":"കോപം, കാമം, ദുർഗുണങ്ങൾ","kn":"ಕ್ರೋಧ, ಕಾಮ ಮತ್ತು ದುರ್ಗುಣಗಳು"},"158":{"hi":"क्रूर मनुष्य और दयालु मनुष्य","te":"క్రూరుడు, దయగల వ్యక్తి","ta":"கொடியவனும் இரக்கமுள்ளவனும்","ml":"ക്രൂരനും ദയാലുവും","kn":"ಕ್ರೂರ ಮನುಷ್ಯ ಮತ್ತು ದಯಾಳು"},"159":{"hi":"ब्रह्महत्या के प्रायश्चित्त के नियम","te":"బ్రాహ్మణ హత్యకు ప్రాయశ్చిత్త నియమాలు","ta":"அந்தணக் கொலைக்கான பிராயசித்த விதிகள்","ml":"ബ്രാഹ്മണഹത്യയ്ക്കുള്ള പ്രായശ്ചിത്ത നിയമങ്ങൾ","kn":"ಬ್ರಹ್ಮಹತ್ಯೆಯ ಪ್ರಾಯಶ್ಚಿತ್ತದ ನಿಯಮಗಳು"},"160":{"hi":"खड्ग की उत्पत्ति","te":"ఖడ్గం పుట్టుక","ta":"வாளின் தோற்றம்","ml":"വാളിന്റെ ഉത്ഭവം","kn":"ಖಡ್ಗದ ಉಗಮ"},"161":{"hi":"फिर से धर्म, धन और काम","te":"మళ్లీ ధర్మం, సంపద, కోరిక","ta":"மீண்டும் தர்மம், செல்வம், ஆசை","ml":"ധർമ്മം, സമ്പത്ത്, കാമം വീണ്ടും","kn":"ಮತ್ತೆ ಧರ್ಮ, ಅರ್ಥ ಮತ್ತು ಕಾಮ"},"162":{"hi":"ब्राह्मण और डाकू अर्जुन","te":"బ్రాహ్మణుడు, దొంగ అర్జునుడు","ta":"அந்தணரும் கொள்ளையன் அர்ஜுனனும்","ml":"ബ്രാഹ്മണനും കവർച്ചക്കാരൻ അർജ്ജുനനും","kn":"ಬ್ರಾಹ್ಮಣ ಮತ್ತು ದರೋಡೆಕೋರ ಅರ್ಜುನ"},"163":{"hi":"गौतम और नदीजंघ क्रौंच","te":"గౌతముడు, నదిజంఘ అనే కొంగ","ta":"கௌதமரும் நதிஜங்கன் என்ற கொக்கும்","ml":"ഗൗതമനും ക്രൗഞ്ചപക്ഷിയായ നദീജംഘനും","kn":"ಗೌತಮ ಮತ್ತು ನದೀಜಂಘ ಕೊಕ್ಕರೆ"},"164":{"hi":"गौतम विरूपाक्ष तक पहुंचाए जाते हैं","te":"గౌతముడికి విరూపాక్షుడి వద్దకు సాయం","ta":"கௌதமர் விரூபாக்ஷத்திற்கு உதவப்படுகிறார்","ml":"ഗൗതമനെ വിരൂപാക്ഷത്തിലേക്ക് സഹായിക്കുന്നു","kn":"ಗೌತಮನನ್ನು ವಿರೂಪಾಕ್ಷನ ಬಳಿಗೆ ಕರೆದೊಯ್ಯಲಾಗುತ್ತದೆ"},"165":{"hi":"राक्षस राजा गौतम का सम्मान करता है","te":"రాక్షస రాజు గౌతముడిని గౌరవిస్తాడు","ta":"இராட்சச அரசனால் கௌதமர் கௌரவிக்கப்படுகிறார்","ml":"രാക്ഷസരാജാവ് ഗൗതമനെ ആദരിക്കുന്നു","kn":"ರಾಕ್ಷಸ ರಾಜನಿಂದ ಗೌತಮನಿಗೆ ಗೌರವ"},"166":{"hi":"क्रौंच का विश्वासघात","te":"కొంగ చేసిన ద్రోహం","ta":"கொக்கின் துரோகம்","ml":"പക്ഷിയുടെ വഞ്ചന","kn":"ಕೊಕ್ಕರೆಯ ದ್ರೋಹ"},"167":{"hi":"कृतघ्न का परिणाम","te":"కృతఘ్నుడి గతి","ta":"நன்றி மறந்தவனின் விதி","ml":"നന്ദികെട്ടവന്റെ ഗതി","kn":"ಕೃತಘ್ನರ ಗತಿ"},"168":{"hi":"मोक्षधर्म का आरंभ: सेनजित का उपदेश","te":"మోక్షధర్మం ఆరంభం: సేనజిత్తు బోధ","ta":"மோட்சதர்மத்தின் தொடக்கம்: சேனஜித்தின் போதனை","ml":"മോക്ഷധർമ്മത്തിന്റെ തുടക്കം: സേനജിത്തിന്റെ ഉപദേശം","kn":"ಮೋಕ್ಷಧರ್ಮದ ಆರಂಭ: ಸೇನಜಿತನ ಉಪದೇಶ"},"169":{"hi":"पिता का पुत्र को उपदेश","te":"తండ్రి బోధ కుమారుడికి","ta":"தந்தை மகனுக்குச் சொன்ன போதனை","ml":"പിതാവ് പുത്രനു നൽകുന്ന ഉപദേശം","kn":"ತಂದೆಯ ಮಗನಿಗೆ ಉಪದೇಶ"},"170":{"hi":"निर्धनता और धन: शम्याक का गीत","te":"పేదరికం, సంపద: శమ్యాకుడి గీతం","ta":"வறுமையும் செல்வமும்: சியாமகரின் பாடல்","ml":"ദാരിദ്ര്യവും സമ്പത്തും: ശമ്യാകന്റെ ഗീതം","kn":"ಬಡತನ ಮತ್ತು ಸಂಪತ್ತು: ಶಮ್ಯಾಕನ ಗೀತೆ"},"171":{"hi":"बोध्य के चौबीस गुरु","te":"బోధ్యుడి ఇరవై నాలుగు గురువులు","ta":"போத்யரின் இருபத்துநான்கு ஆசிரியர்கள்","ml":"ബോധ്യന്റെ ഇരുപത്തിനാലു ഗുരുക്കന്മാർ","kn":"ಬೋಧ್ಯನ ಇಪ್ಪತ್ನಾಲ್ಕು ಗುರುಗಳು"},"172":{"hi":"अजगर की जीवन-शैली","te":"కొండచిలువ జీవన విధానం","ta":"மலைப்பாம்பின் வாழ்க்கை முறை","ml":"അജഗരത്തിന്റെ ജീവിതരീതി","kn":"ಹೆಬ್ಬಾವಿನ ಜೀವನ ಕ್ರಮ"},"173":{"hi":"कश्यप और देवराज","te":"కశ్యపుడు, దేవేంద్రుడు","ta":"காசியபரும் தேவர்களின் அரசனும்","ml":"കശ്യപനും ദേവേന്ദ്രനും","kn":"ಕಶ್ಯಪ ಮತ್ತು ದೇವರ ರಾಜ"},"174":{"hi":"इंद्र की ब्राह्मण को शिक्षा","te":"బ్రాహ్మణుడికి ఇంద్రుడి పాఠం","ta":"அந்தணனுக்கு இந்திரனின் பாடம்","ml":"ഇന്ദ്രന്റെ പാഠം ബ്രാഹ്മണന്","kn":"ಬ್ರಾಹ್ಮಣನಿಗೆ ಇಂದ್ರನ ಪಾಠ"},"175":{"hi":"सृष्टि: भारद्वाज भृगु से पूछते हैं","te":"సృష్టి: భరద్వాజుడు భృగువును అడుగుతాడు","ta":"படைப்பு: பரத்வாஜர் பிருகுவிடம் கேட்கிறார்","ml":"സൃഷ്ടി: ഭരദ്വാജൻ ഭൃഗുവിനോട് ചോദിക്കുന്നു","kn":"ಸೃಷ್ಟಿ: ಭರದ್ವಾಜ ಭೃಗುವನ್ನು ಕೇಳುತ್ತಾನೆ"},"176":{"hi":"भारद्वाज पूछते हैं कि प्राणी कैसे बने","te":"ప్రాణులు ఎలా సృష్టించబడ్డాయి అని భరద్వాజుడు అడుగుతాడు","ta":"உயிர்கள் எவ்வாறு படைக்கப்பட்டன என பரத்வாஜர் கேட்கிறார்","ml":"ജീവികൾ എങ്ങനെ സൃഷ്ടിക്കപ്പെട്ടു എന്ന് ഭരദ്വാജൻ ചോദിക്കുന്നു","kn":"ಜೀವಿಗಳು ಹೇಗೆ ಸೃಷ್ಟಿಯಾದವು ಎಂದು ಭರದ್ವಾಜ ಕೇಳುತ್ತಾನೆ"},"177":{"hi":"पंचमहाभूत और उनके गुण","te":"పంచభూతాలు, వాటి గుణాలు","ta":"ஐம்பூதங்களும் அவற்றின் குணங்களும்","ml":"പഞ്ചഭൂതങ്ങളും അവയുടെ ഗുണങ്ങളും","kn":"ಪಂಚಭೂತಗಳು ಮತ್ತು ಅವುಗಳ ಗುಣಗಳು"},"178":{"hi":"शरीर में अग्नि","te":"శరీరంలోని అగ్ని","ta":"உடலிலுள்ள அக்னி","ml":"ശരീരത്തിലെ അഗ്നി","kn":"ದೇಹದಲ್ಲಿನ ಅಗ್ನಿ"},"179":{"hi":"क्या आत्मा वायु है","te":"ఆత్మ గాలేనా","ta":"ஆன்மா காற்றா","ml":"ആത്മാവ് വായുവാണോ","kn":"ಆತ್ಮವೇ ಗಾಳಿಯೇ?"},"180":{"hi":"आत्मा का नाश नहीं होता","te":"ఆత్మ నశించదు","ta":"ஆன்மா அழிவதில்லை","ml":"ആത്മാവ് നശിക്കുന്നില്ല","kn":"ಆತ್ಮ ನಾಶವಾಗುವುದಿಲ್ಲ"},"181":{"hi":"वर्णों की उत्पत्ति","te":"వర్ణాల మూలం","ta":"வருணங்களின் தோற்றம்","ml":"വർണ്ണങ്ങളുടെ ഉത്ഭവം","kn":"ವರ್ಣಗಳ ಉಗಮ"},"182":{"hi":"ब्राह्मण कौन होता है","te":"ఎవరు బ్రాహ్మణుడు అవుతారు","ta":"ஒருவனை அந்தணனாக்குவது எது","ml":"ആരാണ് ബ്രാഹ്മണൻ","kn":"ಯಾರು ಬ್ರಾಹ್ಮಣನಾಗುತ್ತಾನೆ"},"183":{"hi":"सृजन करने वाला सत्य","te":"సృష్టించే సత్యం","ta":"படைக்கும் உண்மை","ml":"സൃഷ്ടിക്കുന്ന സത്യം","kn":"ಸೃಷ್ಟಿಸುವ ಸತ್ಯ"},"184":{"hi":"दान का फल और चार आश्रम","te":"దాన ఫలం, జీవిత నాలుగు దశలు","ta":"தானத்தின் பலனும் வாழ்க்கையின் நான்கு நிலைகளும்","ml":"ദാനത്തിന്റെ ഫലവും ആശ്രമങ്ങളും","kn":"ದಾನದ ಫಲ ಮತ್ತು ನಾಲ್ಕು ಆಶ್ರಮಗಳು"},"185":{"hi":"वनवासी और संन्यासी","te":"అరణ్యవాసులు, సన్యాసులు","ta":"வனவாசிகளும் துறவிகளும்","ml":"വനവാസികളും സന്ന്യാസികളും","kn":"ವಾನಪ್ರಸ್ಥರು ಮತ್ತು ಸಂನ್ಯಾಸಿಗಳು"},"186":{"hi":"अच्छे आचरण के नियम","te":"మంచి ప్రవర్తన నియమాలు","ta":"நல்ல நடத்தையின் விதிகள்","ml":"നല്ല പെരുമാറ്റത്തിന്റെ നിയമങ്ങൾ","kn":"ಉತ್ತಮ ನಡತೆಯ ನಿಯಮಗಳು"},"187":{"hi":"आत्मा और इंद्रियां","te":"ఆత్మ, ఇంద్రియాలు","ta":"ஆன்மாவும் புலன்களும்","ml":"ആത്മാവും ഇന്ദ്രിയങ്ങളും","kn":"ಆತ್ಮ ಮತ್ತು ಇಂದ್ರಿಯಗಳು"},"188":{"hi":"ध्यान के चार प्रकार","te":"నాలుగు రకాల ధ్యానాలు","ta":"நான்கு வகை தியானங்கள்","ml":"നാലുതരം ധ്യാനം","kn":"ನಾಲ್ಕು ಬಗೆಯ ಧ್ಯಾನ"},"189":{"hi":"संन्यासी की साधना","te":"సన్యాసి సాధన","ta":"துறவியின் பயிற்சி","ml":"സന്ന്യാസിയുടെ സാധനകൾ","kn":"ಸಂನ್ಯಾಸಿಯ ಸಾಧನೆ"},"190":{"hi":"वेदपाठी का मार्ग","te":"వేదపఠనం చేసేవారి మార్గం","ta":"ஓதுபவரின் வழி","ml":"വേദപാരായണക്കാരന്റെ വഴി","kn":"ವೇದ ಪಠಿಸುವವನ ಮಾರ್ಗ"},"191":{"hi":"वेदपाठियों के नरक और स्वर्ग","te":"వేదపఠనం చేసేవారి నరకం, స్వర్గం","ta":"ஓதுபவர்களின் நரகங்களும் சொர்க்கங்களும்","ml":"വേദപാരായണക്കാരുടെ നരകവും സ്വർഗ്ഗവും","kn":"ವೇದ ಪಠಿಸುವವರ ನರಕ ಮತ್ತು ಸ್ವರ್ಗ"},"192":{"hi":"सावित्री, यम और ब्राह्मण वेदपाठी","te":"సావిత్రి, యముడు, బ్రాహ్మణ పఠితుడు","ta":"சாவித்திரி, யமன், அந்தணஓதுபவர்","ml":"സാവിത്രി, യമൻ, ബ്രാഹ്മണ പാരായണക്കാരൻ","kn":"ಸಾವಿತ್ರಿ, ಯಮ ಮತ್ತು ವೇದ ಪಠಿಸುವ ಬ್ರಾಹ್ಮಣ"},"193":{"hi":"वेदपाठी की कथा का अंत","te":"పఠితుడి కథ ముగింపు","ta":"ஓதுபவரின் கதையின் முடிவு","ml":"വേദപാരായണക്കാരന്റെ കഥയുടെ അന്ത്യം","kn":"ವೇದ ಪಠಿಸುವವನ ಕಥೆಯ ಅಂತ್ಯ"},"194":{"hi":"मनु: ज्ञान और कर्म का फल","te":"జ్ఞానం, కర్మ ఫలంపై మనువు","ta":"அறிவு, செயலின் பலன் பற்றி மனு","ml":"ജ്ഞാനത്തിന്റെയും കർമ്മത്തിന്റെയും ഫലത്തെക്കുറിച്ച് മനു","kn":"ಜ್ಞಾನ ಮತ್ತು ಕರ್ಮದ ಫಲದ ಕುರಿತು ಮನು"},"195":{"hi":"अविनाशी और तत्व","te":"నాశనం లేనిది, భూతాలు","ta":"அழியாததும் பூதங்களும்","ml":"അനശ്വരനും പഞ്ചഭൂതങ്ങളും","kn":"ಅವಿನಾಶಿ ಮತ್ತು ಪಂಚಭೂತಗಳು"},"196":{"hi":"चंद्रमा और आत्मा","te":"చంద్రుడు, ఆత్మ","ta":"சந்திரனும் ஆன்மாவும்","ml":"ചന്ദ്രനും ആത്മാവും","kn":"ಚಂದ್ರ ಮತ್ತು ಆತ್ಮ"},"197":{"hi":"स्वप्न, जागरण और आत्मा","te":"స్వప్నం, జాగ్రదవస్థ, ఆత్మ","ta":"கனவு, விழிப்பு, ஆன்மா","ml":"സ്വപ്നം, ജാഗ്രത്, ആത്മാവ്","kn":"ಕನಸು, ಎಚ್ಚರ ಮತ್ತು ಆತ್ಮ"},"198":{"hi":"गुण और मोक्ष","te":"గుణాలు, ముక్తి","ta":"குணங்களும் விடுதலையும்","ml":"ഗുണങ്ങളും മോക്ഷവും","kn":"ಗುಣಗಳು ಮತ್ತು ಮೋಕ್ಷ"},"199":{"hi":"इंद्रियों से परे का मार्ग","te":"ఇంద్రియాలకు ఆవల ఉన్న మార్గం","ta":"புலன்களைக் கடந்த வழி","ml":"ഇന്ദ്രിയങ്ങൾക്കപ്പുറമുള്ള വഴി","kn":"ಇಂದ್ರಿಯಗಳನ್ನು ಮೀರಿದ ದಾರಿ"},"200":{"hi":"कृष्ण की महिमा","te":"కృష్ణుడి మహిమ","ta":"கிருஷ்ணனின் பெருமை","ml":"കൃഷ്ണന്റെ മഹത്വം","kn":"ಕೃಷ್ಣನ ಮಹಿಮೆ"},"201":{"hi":"प्राचीन प्रजापति","te":"పూర్వ ప్రజాపతులు","ta":"உயிர்களின் பழைய தலைவர்கள்","ml":"പുരാതന പ്രജാപതികൾ","kn":"ಪ್ರಾಚೀನ ಪ್ರಜಾಪತಿಗಳು"},"202":{"hi":"नारायण और आदि प्राणी","te":"నారాయణుడు, మొదటి ప్రాణులు","ta":"நாராயணனும் முதல் உயிர்களும்","ml":"നാരായണനും ആദ്യജീവികളും","kn":"ನಾರಾಯಣ ಮತ್ತು ಆದಿ ಜೀವಿಗಳು"},"203":{"hi":"सर्वोच्च योग","te":"శ్రేష్ఠమైన యోగం","ta":"மேலான யோகம்","ml":"ഉത്തമയോഗം","kn":"ಪರಮ ಯೋಗ"},"204":{"hi":"अव्यक्त और प्राणी","te":"అవ్యక్తం, ప్రాణులు","ta":"வெளிப்படாதது மற்றும் உயிர்கள்","ml":"അവ്യക്തവും ജീവികളും","kn":"ಅವ್ಯಕ್ತ ಮತ್ತು ಜೀವಿಗಳು"},"205":{"hi":"धर्म और गुणों का स्वरूप","te":"ధర్మం, గుణాల స్వభావం","ta":"தர்மம் மற்றும் குணங்களின் இயல்பு","ml":"ധർമ്മത്തിന്റെയും ഗുണങ്ങളുടെയും സ്വഭാവം","kn":"ಧರ್ಮ ಮತ್ತು ಗುಣಗಳ ಸ್ವರೂಪ"},"206":{"hi":"आत्मा और क्षेत्र","te":"ఆత్మ, క్షేత్రం","ta":"ஆன்மாவும் களமும்","ml":"ആത്മാവും ക്ഷേത്രവും","kn":"ಆತ್ಮ ಮತ್ತು ಕ್ಷೇತ್ರ"},"207":{"hi":"साधन: स्थिर अभ्यास","te":"స్థిరమైన సాధన మార్గం","ta":"வழிமுறை: நிலையான பயிற்சி","ml":"ഉപായം: സ്ഥിരമായ സാധന","kn":"ಸಾಧನೆ: ಸ್ಥಿರ ಅಭ್ಯಾಸ"},"208":{"hi":"इंद्रियों पर विजय","te":"ఇంద్రియ నిగ్రహం","ta":"புலன்களை அடக்குதல்","ml":"ഇന്ദ്രിയനിയന്ത്രണം","kn":"ಇಂದ್ರಿಯ ನಿಗ್ರಹ"},"209":{"hi":"निद्रा, स्वप्न और जाग्रत मन","te":"నిద్ర, స్వప్నం, మేల్కొన్న మనసు","ta":"உறக்கம், கனவு, விழிப்பு நிலை மனம்","ml":"ഉറക്കം, സ്വപ്നം, ജാഗ്രത്തിലെ മനസ്സ്","kn":"ನಿದ್ರೆ, ಕನಸು ಮತ್ತು ಎಚ್ಚರದ ಮನಸ್ಸು"},"210":{"hi":"जानने योग्य चार बातें","te":"తెలుసుకోవలసిన నాలుగు విషయాలు","ta":"அறிய வேண்டிய நான்கு விஷயங்கள்","ml":"അറിയേണ്ട നാലു കാര്യങ്ങൾ","kn":"ತಿಳಿಯಬೇಕಾದ ನಾಲ್ಕು ವಿಷಯಗಳು"},"211":{"hi":"जनक और ऋषि पंचशिख","te":"జనకుడు, ఋషి పంచశిఖుడు","ta":"ஜனகரும் பஞ்சசிகர் முனிவரும்","ml":"ജനകനും പഞ്ചശിഖ മുനിയും","kn":"ಜನಕ ಮತ್ತು ಋಷಿ ಪಂಚಶಿಖ"},"212":{"hi":"जनक का संन्यास","te":"జనకుడి త్యాగం","ta":"ஜனகரின் துறவு","ml":"ജനകന്റെ സന്ന്യാസം","kn":"ಜನಕನ ಸಂನ್ಯಾಸ"},"213":{"hi":"सुख और दुःख किससे आते हैं","te":"సుఖాన్ని, దుఃఖాన్ని కలిగించేవి","ta":"மகிழ்ச்சியைத் தருவதும் துயரைத் தருவதும்","ml":"സുഖം നൽകുന്നതും ദുഃഖം നൽകുന്നതും","kn":"ಸುಖವನ್ನು ತರುವುದು ಮತ್ತು ದುಃಖವನ್ನು ತರುವುದು"},"214":{"hi":"यज्ञ, मांस और जीवन के मार्ग","te":"యజ్ఞం, మాంసం, జీవన మార్గాలు","ta":"யாகம், இறைச்சி, வாழ்க்கை முறைகள்","ml":"യാഗം, മാംസം, ജീവിതരീതികൾ","kn":"ಯಜ್ಞ, ಮಾಂಸ ಮತ್ತು ಜೀವನ ಮಾರ್ಗಗಳು"},"215":{"hi":"प्रह्लाद और इंद्र: शांत मन","te":"ప్రహ్లాదుడు, ఇంద్రుడు: శాంత మనసు","ta":"பிரஹ்லாதனும் இந்திரனும்: அமைதியான மனம்","ml":"പ്രഹ്ളാദനും ഇന്ദ്രനും: ശാന്തമായ മനസ്സ്","kn":"ಪ್ರಹ್ಲಾದ ಮತ್ತು ಇಂದ್ರ: ಶಾಂತ ಮನಸ್ಸು"},"216":{"hi":"पराजय के बाद इंद्र और बलि","te":"ఓటమి తర్వాత ఇంద్రుడు, బలి","ta":"வீழ்ச்சிக்குப் பிறகு இந்திரனும் பலியும்","ml":"തോൽവിക്കു ശേഷം ഇന്ദ്രനും ബലിയും","kn":"ಪತನದ ನಂತರ ಇಂದ್ರ ಮತ್ತು ಬಲಿ"},"217":{"hi":"बलि का काल पर उपदेश","te":"కాలంపై బలి బోధ","ta":"காலம் பற்றி பலியின் போதனை","ml":"കാലത്തെക്കുറിച്ച് ബലിയുടെ ഉപദേശം","kn":"ಕಾಲದ ಕುರಿತು ಬಲಿಯ ಉಪದೇಶ"},"218":{"hi":"बलि को भाग्य छोड़ता है","te":"బలిని అదృష్టం వీడుతుంది","ta":"பலியை விட்டு அதிர்ஷ்டம் விலகுகிறது","ml":"ബലിയെ ഭാഗ്യം വിട്ടുപോകുന്നു","kn":"ಬಲಿಯನ್ನು ಭಾಗ್ಯ ತೊರೆಯುತ್ತದೆ"},"219":{"hi":"इंद्र और नमुचि","te":"ఇంద్రుడు, నముచి","ta":"இந்திரனும் நமுசியும்","ml":"ഇന്ദ്രനും നമുചിയും","kn":"ಇಂದ್ರ ಮತ್ತು ನಮುಚಿ"},"220":{"hi":"बड़ी हानि में क्या करें","te":"గొప్ప నష్టంలో ఏం చేయాలి","ta":"பெரிய இழப்பில் என்ன செய்வது","ml":"വലിയ നഷ്ടത്തിൽ ചെയ്യേണ്ടത്","kn":"ಮಹಾ ನಷ್ಟದಲ್ಲಿ ಏನು ಮಾಡಬೇಕು"},"221":{"hi":"उत्थान और पतन के लक्षण","te":"ఉత్థాన పతనాల సూచనలు","ta":"எழுச்சி, வீழ்ச்சியின் அடையாளங்கள்","ml":"ഉയർച്ചയുടെയും താഴ്ചയുടെയും ലക്ഷണങ്ങൾ","kn":"ಉದಯ ಮತ್ತು ಪತನದ ಲಕ್ಷಣಗಳು"},"222":{"hi":"सर्वोच्च स्थान का मार्ग","te":"అత్యున్నత స్థానానికి మార్గం","ta":"மிக உயர்ந்த இடத்திற்கான வழி","ml":"ഉന്നതമായ സ്ഥാനത്തേക്കുള്ള വഴി","kn":"ಉನ್ನತ ಸ್ಥಾನಕ್ಕೆ ದಾರಿ"},"223":{"hi":"सबका प्रिय कौन है","te":"అందరికీ ప్రియమైనవాడు ఎవరు","ta":"அனைவராலும் விரும்பப்படுபவர் யார்","ml":"എല്ലാവർക്കും പ്രിയനായവൻ","kn":"ಎಲ್ಲರಿಗೂ ಪ್ರಿಯನಾದವನು ಯಾರು"},"224":{"hi":"युग, वेद और काल-चक्र","te":"యుగాలు, వేదాలు, కాల చక్రం","ta":"யுகங்கள், வேதங்கள், காலச் சுழற்சி","ml":"യുഗങ്ങളും വേദങ്ങളും കാലചക്രവും","kn":"ಯುಗಗಳು, ವೇದಗಳು ಮತ್ತು ಕಾಲಚಕ್ರ"},"225":{"hi":"जगत का प्रलय","te":"ప్రపంచ లయం","ta":"உலகின் அழிவு","ml":"ലോകത്തിന്റെ ലയം","kn":"ಜಗತ್ತಿನ ಲಯ"},"226":{"hi":"ब्राह्मण गृहस्थ के कर्तव्य","te":"బ్రాహ్మణ గృహస్థుడి కర్తవ్యాలు","ta":"அந்தண இல்லறத்தாரின் கடமைகள்","ml":"ബ്രാഹ്മണ ഗൃഹസ്ഥന്റെ കടമകൾ","kn":"ಬ್ರಾಹ್ಮಣ ಗೃಹಸ್ಥನ ಕರ್ತವ್ಯಗಳು"},"227":{"hi":"संसार की नदी को पार करना","te":"సంసార నదిని దాటడం","ta":"உலகெனும் ஆற்றைக் கடத்தல்","ml":"ലോകമെന്ന നദി കടക്കൽ","kn":"ಸಂಸಾರ ಸಾಗರವನ್ನು ದಾಟುವುದು"},"228":{"hi":"ज्ञान की नौका","te":"జ్ఞానమనే తెప్ప","ta":"ஞானமெனும் படகு","ml":"ജ്ഞാനമെന്ന തോണി","kn":"ಜ್ಞಾನದ ತೆಪ್ಪ"},"229":{"hi":"ज्ञान और वेद","te":"జ్ఞానం, వేదాలు","ta":"ஞானமும் வேதங்களும்","ml":"ജ്ഞാനവും വേദങ്ങളും","kn":"ಜ್ಞಾನ ಮತ್ತು ವೇದಗಳು"},"230":{"hi":"ब्राह्मण का प्राचीन मार्ग","te":"బ్రాహ్మణుడి పురాతన మార్గం","ta":"அந்தணரின் பழைய வழி","ml":"ബ്രാഹ്മണന്റെ പുരാതന മാർഗ്ഗം","kn":"ಬ್ರಾಹ್ಮಣರ ಪ್ರಾಚೀನ ಮಾರ್ಗ"},"231":{"hi":"शुकदेव आत्मा के बारे में पूछते हैं","te":"ఆత్మ గురించి శుకుడు అడుగుతాడు","ta":"ஆன்மா பற்றி சுகர் கேட்கிறார்","ml":"ആത്മാവിനെക്കുറിച്ച് ശുകൻ ചോദിക്കുന്നു","kn":"ಆತ್ಮದ ಕುರಿತು ಶುಕ ಕೇಳುತ್ತಾನೆ"},"232":{"hi":"सांख्य का मार्ग","te":"సాంఖ్య మార్గం","ta":"சாங்கிய வழி","ml":"സാംഖ്യത്തിന്റെ വഴി","kn":"ಸಾಂಖ್ಯದ ಮಾರ್ಗ"},"233":{"hi":"ज्ञान और कर्म","te":"జ్ఞానం, కర్మ","ta":"ஞானமும் செயலும்","ml":"ജ്ഞാനവും കർമ്മവും","kn":"ಜ್ಞಾನ ಮತ್ತು ಕರ್ಮ"},"234":{"hi":"सृष्टि और आश्रमों का जीवन","te":"సృష్టి, జీవిత దశల జీవనం","ta":"படைப்பும் நிலைகளின் வாழ்க்கையும்","ml":"സൃഷ്ടിയും ആശ്രമങ്ങളുടെ ജീവിതവും","kn":"ಸೃಷ್ಟಿ ಮತ್ತು ಆಶ್ರಮಗಳ ಜೀವನ"},"235":{"hi":"गृहस्थ का मार्ग","te":"గృహస్థుడి మార్గం","ta":"இல்லறத்தாரின் வழி","ml":"ഗൃഹസ്ഥന്റെ വഴി","kn":"ಗೃಹಸ್ಥನ ಮಾರ್ಗ"},"236":{"hi":"वानप्रस्थ और सर्वोच्च आश्रम","te":"అరణ్యవాసి, అత్యున్నత దశ","ta":"வனவாசியும் மிக உயர்ந்த நிலையும்","ml":"വനവാസിയും ഉത്തമ ആശ്രമവും","kn":"ವಾನಪ್ರಸ್ಥ ಮತ್ತು ಶ್ರೇಷ್ಠ ಹಂತ"},"237":{"hi":"भिक्षु","te":"భిక్షువు","ta":"பிச்சையேற்கும் துறவி","ml":"സന്ന്യാസി","kn":"ಸಂನ್ಯಾಸಿ"},"238":{"hi":"गुणों से परे आत्मा","te":"గుణాలకు ఆవల ఉన్న ఆత్మ","ta":"குணங்களுக்கு அப்பாற்பட்ட ஆன்மா","ml":"ഗുണങ്ങൾക്കപ്പുറമുള്ള ആത്മാവ്","kn":"ಗುಣಗಳನ್ನು ಮೀರಿದ ಆತ್ಮ"},"239":{"hi":"तत्व और इंद्रियां","te":"భూతాలు, ఇంద్రియాలు","ta":"பூதங்களும் புலன்களும்","ml":"മൂലകങ്ങളും ഇന്ദ്രിയങ്ങളും","kn":"ಭೂತಗಳು ಮತ್ತು ಇಂದ್ರಿಯಗಳು"},"240":{"hi":"मन, बुद्धि और आत्मा","te":"మనసు, బుద్ధి, ఆత్మ","ta":"மனம், புத்தி, ஆன்மா","ml":"മനസ്സ്, ബുദ്ധി, ആത്മാവ്","kn":"ಮನಸ್ಸು, ಬುದ್ಧಿ ಮತ್ತು ಆತ್ಮ"},"241":{"hi":"कर्म न करने वाला ऋषि","te":"కర్మ చేయని ఋషి","ta":"செயலற்றிருக்கும் ஞானி","ml":"പ്രവർത്തിക്കാത്ത ദ്രഷ്ടാവ്","kn":"ಕರ್ಮ ಮಾಡದ ದ್ರಷ್ಟಾರ"},"242":{"hi":"सर्वोच्च धर्म","te":"శ్రేష్ఠమైన ధర్మం","ta":"மிக உயர்ந்த தர்மம்","ml":"ഏറ്റവും ഉന്നതമായ ധർമ്മം","kn":"ಪರಮ ಧರ್ಮ"},"243":{"hi":"वैराग्य और शांत मन","te":"విరక్తి, శాంత మనసు","ta":"பற்றின்மையும் அமைதியான மனமும்","ml":"വിരക്തിയും ശാന്തമായ മനസ്സും","kn":"ವೈರಾಗ್ಯ ಮತ್ತು ಶಾಂತ ಮನಸ್ಸು"},"244":{"hi":"तत्व और काल","te":"భూతాలు, కాలం","ta":"பூதங்களும் காலமும்","ml":"മൂലകങ്ങളും കാലവും","kn":"ಭೂತಗಳು ಮತ್ತು ಕಾಲ"},"245":{"hi":"सूक्ष्म आत्मा और परम ईश्वर","te":"సూక్ష్మ ఆత్మ, పరమేశ్వరుడు","ta":"நுண்ணிய ஆன்மாவும் பரம்பொருளும்","ml":"സൂക്ഷ്മമായ ആത്മാവും പരമേശ്വരനും","kn":"ಸೂಕ್ಷ್ಮ ಆತ್ಮ ಮತ್ತು ಪರಮೇಶ್ವರ"},"246":{"hi":"कामना का वृक्ष","te":"కోరికల వృక్షం","ta":"ஆசை என்னும் மரம்","ml":"ആഗ്രഹത്തിന്റെ വൃക്ഷം","kn":"ಆಸೆಯ ಮರ"},"247":{"hi":"तत्वों के गुण","te":"భూతాల గుణాలు","ta":"பூதங்களின் குணங்கள்","ml":"മൂലകങ്ങളുടെ ഗുണങ്ങൾ","kn":"ಭೂತಗಳ ಗುಣಗಳು"},"248":{"hi":"मृत्यु की रचना हुई","te":"మరణం సృష్టించబడింది","ta":"மரணம் படைக்கப்பட்டது","ml":"മരണം സൃഷ്ടിക്കപ്പെട്ടു","kn":"ಮೃತ್ಯು ಸೃಷ್ಟಿಯಾಯಿತು"},"249":{"hi":"ब्रह्मा का क्रोध और मृत्यु की स्त्री","te":"బ్రహ్మ కోపం, మృత్యు స్త్రీ","ta":"பிரம்மனின் கோபமும் மரணத்தின் பெண்ணும்","ml":"ബ്രഹ്മാവിന്റെ കോപവും മരണത്തിന്റെ സ്ത്രീയും","kn":"ಬ್ರಹ್ಮನ ಕೋಪ ಮತ್ತು ಮೃತ್ಯು ದೇವತೆ"},"250":{"hi":"मृत्यु की तपस्या और उसका कार्य","te":"మృత్యువు తపస్సు, ఆమె పని","ta":"மரணத்தின் தவமும் அவளுடைய பணியும்","ml":"മരണത്തിന്റെ തപസ്സും അവളുടെ ദൗത്യവും","kn":"ಮೃತ್ಯುವಿನ ತಪಸ್ಸು ಮತ್ತು ಅವಳ ಕಾರ್ಯ"},"251":{"hi":"धर्म क्या है","te":"ధర్మం అంటే ఏమిటి","ta":"தர்மம் என்பது என்ன","ml":"ധർമ്മം എന്താണ്","kn":"ಧರ್ಮ ಎಂದರೇನು"},"252":{"hi":"युधिष्ठिर प्राचीन धर्म पर","te":"పురాతన ధర్మంపై యుధిష్ఠిరుడు","ta":"பழைய தர்மம் பற்றி யுதிஷ்டிரன்","ml":"പുരാതന ധർമ്മത്തെക്കുറിച്ച് യുധിഷ്ഠിരൻ","kn":"ಪ್ರಾಚೀನ ಧರ್ಮದ ಕುರಿತು ಯುಧಿಷ್ಠಿರ"},"253":{"hi":"जाजलि और तुलाधार वणिक","te":"జాజలి, తులాధారుడు","ta":"ஜாஜலியும் துலா எடைக்காரன் துலாதரனும்","ml":"ജാജലിയും തൂക്കക്കാരൻ തുലാധാരനും","kn":"ಜಾಜಲಿ ಮತ್ತು ತೂಕಗಾರ ತುಲಾಧಾರ"},"254":{"hi":"तुलाधार का अहिंसा धर्म","te":"తులాధారుడి అహింసా ధర్మం","ta":"துலாதரனின் அகிம்சைத் தர்மம்","ml":"തുലാധാരന്റെ അഹിംസാധർമ്മം","kn":"ತುಲಾಧಾರನ ಅಹಿಂಸಾ ಧರ್ಮ"},"255":{"hi":"श्रद्धा और यज्ञ","te":"శ్రద్ధ, యజ్ఞం","ta":"நம்பிக்கையும் யாகமும்","ml":"വിശ്വാസവും യാഗവും","kn":"ಶ್ರದ್ಧೆ ಮತ್ತು ಯಜ್ಞ"},"256":{"hi":"श्रद्धा मूल है","te":"శ్రద్ధ మూలం","ta":"நம்பிக்கையே வேர்","ml":"വിശ്വാസമാണ് മൂലം","kn":"ಶ್ರದ್ಧೆಯೇ ಮೂಲ"},"257":{"hi":"राजा विचक्षु का अहिंसा पर मत","te":"అహింసపై రాజు వికఖ్నుడు","ta":"அகிம்சை பற்றி விசக்நு அரசன்","ml":"അഹിംസയെക്കുറിച്ച് വിചഖ്നു രാജാവ്","kn":"ಅಹಿಂಸೆಯ ಕುರಿತು ರಾಜ ವಿಚಕ್ಷ್ಣು"},"258":{"hi":"धीरे कार्य करने वाला चिरकारी","te":"మెల్లగా పనిచేసే చిరకారి","ta":"மெதுவாகச் செயல்படும் சிரகாரின்","ml":"പതുക്കെ പ്രവർത്തിക്കുന്ന ചിരകാരിൻ","kn":"ನಿಧಾನವಾಗಿ ಕಾರ್ಯಮಾಡುವ ಚಿರಕಾರಿ"},"259":{"hi":"सत्यवान राजा से पिता को बचाता है","te":"సత్యవంతుడు తండ్రిని రాజు నుంచి రక్షిస్తాడు","ta":"சத்தியவான் அரசனிடமிருந்து தன் தந்தையைக் காக்கிறான்","ml":"സത്യവാൻ രാജാവിൽനിന്ന് പിതാവിനെ രക്ഷിക്കുന്നു","kn":"ಸತ್ಯವಾನ ತನ್ನ ತಂದೆಯನ್ನು ರಾಜನಿಂದ ರಕ್ಷಿಸುತ್ತಾನೆ"},"260":{"hi":"श्युमरश्मि कपिल से कर्म पूछते हैं","te":"కర్మపై శ్యుమరశ్మి కపిలుడిని అడుగుతాడు","ta":"செயல் பற்றி கபிலரிடம் சியுமரஷ்மி கேட்கிறான்","ml":"കർമ്മത്തെക്കുറിച്ച് ശ്യുമരശ്മി കപിലനോട് ചോദിക്കുന്നു","kn":"ಕರ್ಮದ ಕುರಿತು ಶ್ಯುಮರಶ್ಮಿ ಕಪಿಲನನ್ನು ಕೇಳುತ್ತಾನೆ"},"261":{"hi":"संन्यासी का मार्ग","te":"సన్యాసి మార్గం","ta":"துறவியின் வழி","ml":"സന്ന്യാസിയുടെ വഴി","kn":"ಸಂನ್ಯಾಸಿಯ ಮಾರ್ಗ"},"262":{"hi":"दो ब्राह्मण","te":"ఇద్దరు బ్రాహ్మణులు","ta":"இரண்டு அந்தணர்கள்","ml":"രണ്ടു ബ്രാഹ്മണർ","kn":"ಇಬ್ಬರು ಬ್ರಾಹ್ಮಣರು"},"263":{"hi":"धर्म, धन और काम","te":"ధర్మం, సంపద, కోరిక","ta":"தர்மம், செல்வம், ஆசை","ml":"ധർമ്മം, സമ്പത്ത്, കാമം","kn":"ಧರ್ಮ, ಅರ್ಥ ಮತ್ತು ಕಾಮ"},"264":{"hi":"हिंसा रहित यज्ञ","te":"హింస లేని యజ్ఞం","ta":"தீங்கற்ற யாகம்","ml":"ഹിംസയില്ലാത്ത യാഗം","kn":"ಹಿಂಸೆಯಿಲ್ಲದ ಯಜ್ಞ"},"265":{"hi":"मनुष्य पापी कैसे बनता है","te":"మనిషి పాపాత్ముడు ఎలా అవుతాడు","ta":"ஒருவன் பாவியாவது எப்படி","ml":"മനുഷ്യൻ പാപിയാകുന്ന വിധം","kn":"ಮನುಷ್ಯ ಪಾಪಿಯಾಗುವ ಬಗೆ"},"266":{"hi":"मोक्ष के साधन","te":"ముక్తికి సాధనాలు","ta":"விடுதலைக்கான வழிமுறைகள்","ml":"മോക്ഷത്തിനുള്ള മാർഗ്ഗങ്ങൾ","kn":"ಮೋಕ್ಷದ ಸಾಧನ"},"267":{"hi":"नारद और देवल-असित","te":"నారదుడు, దేవల-అసితుడు","ta":"நாரதரும் தேவல-அசிதரும்","ml":"നാരദനും ദേവല-അസിതനും","kn":"ನಾರದ ಮತ್ತು ದೇವಲ-ಅಸಿತ"},"268":{"hi":"मांडव्य और जनक","te":"మాండవ్యుడు, జనక రాజు","ta":"மாண்டவ்யரும் ஜனக அரசனும்","ml":"മാണ്ഡവ്യനും ജനകരാജാവും","kn":"ಮಾಂಡವ್ಯ ಮತ್ತು ಜನಕ ರಾಜ"},"269":{"hi":"घुमक्कड़ संन्यासी का मार्ग","te":"సంచార సన్యాసి మార్గం","ta":"அலையும் துறவியின் வழி","ml":"അലഞ്ഞുതിരിയുന്ന സന്ന്യാസിയുടെ വഴി","kn":"ಅಲೆದಾಡುವ ಸಂನ್ಯಾಸಿಯ ಮಾರ್ಗ"},"270":{"hi":"वृत्र और उशनस","te":"వృత్రుడు, ఉశనసుడు","ta":"விருத்திரனும் உசனஸும்","ml":"വൃത്രനും ഉശനസ്സും","kn":"ವೃತ್ರ ಮತ್ತು ಉಶನಸ್"},"271":{"hi":"वृत्र का विष्णु-ज्ञान","te":"విష్ణువు గురించి వృత్రుడి జ్ఞానం","ta":"விஷ்ணுவைப் பற்றி விருத்திரனின் அறிவு","ml":"വിഷ്ണുവിനെക്കുറിച്ച് വൃത്രന്റെ അറിവ്","kn":"ವಿಷ್ಣುವಿನ ಕುರಿತು ವೃತ್ರನ ಜ್ಞಾನ"},"272":{"hi":"इंद्र और वृत्र का युद्ध","te":"ఇంద్రుడు, వృత్రుడి యుద్ధం","ta":"இந்திரனுக்கும் விருத்திரனுக்கும் இடையிலான போர்","ml":"ഇന്ദ്രനും വൃത്രനും തമ്മിലുള്ള യുദ്ധം","kn":"ಇಂದ್ರ ಮತ್ತು ವೃತ್ರರ ಯುದ್ಧ"},"273":{"hi":"इंद्र और ब्रह्महत्या का पाप","te":"ఇంద్రుడు, బ్రాహ్మణ హత్యా పాపం","ta":"அந்தணக் கொலைப் பாவமும் இந்திரனும்","ml":"ഇന്ദ്രനും ബ്രാഹ്മണഹത്യയുടെ പാപവും","kn":"ಇಂದ್ರ ಮತ್ತು ಬ್ರಹ್ಮಹತ್ಯೆಯ ಪಾಪ"},"274":{"hi":"ज्वर की उत्पत्ति","te":"జ్వరం పుట్టుక","ta":"காய்ச்சலின் தோற்றம்","ml":"പനിയുടെ ഉത്ഭവം","kn":"ಜ್ವರದ ಉಗಮ"},"275":{"hi":"नारद और समंग","te":"నారదుడు, సమంగుడు","ta":"நாரதரும் சமங்கனும்","ml":"നാരദനും സമംഗനും","kn":"ನಾರದ ಮತ್ತು ಸಮಂಗ"},"276":{"hi":"परम कल्याण क्या है","te":"శ్రేయస్సు అంటే ఏమిటి","ta":"மிக உயர்ந்த நன்மை எது","ml":"ഉത്തമ നന്മ എന്താണ്","kn":"ಪರಮ ಶ್ರೇಯಸ್ಸು ಯಾವುದು"},"277":{"hi":"सगर और ऋषि अरिष्टनेमि","te":"సగరుడు, ఋషి అరిష్టనేమి","ta":"சகரனும் முனிவர் அரிஷ்டநேமியும்","ml":"സഗരനും മുനി അരിഷ്ടനേമിയും","kn":"ಸಗರ ಮತ್ತು ಋಷಿ ಅರಿಷ್ಟನೇಮಿ"},"278":{"hi":"शुक्र, कुबेर और ऋषि जैगीषव्य","te":"శుక్రుడు, కుబేరుడు, ఋషి జైగీషవ్యుడు","ta":"சுக்கிரன், குபேரன், முனிவர் ஜைகீஷவ்யர்","ml":"ശുക്രനും കുബേരനും മുനി ജൈഗീഷവ്യനും","kn":"ಶುಕ್ರ, ಕುಬೇರ ಮತ್ತು ಋಷಿ ಜೈಗೀಷವ್ಯ"},"279":{"hi":"मनुष्यों के मार्ग और उससे परे","te":"మనుషుల మార్గాలు, వాటి ఆవల","ta":"மனிதர்களின் வழிகளும் அதற்கப்பாலுள்ளதும்","ml":"മനുഷ്യരുടെ വഴികളും അതിനപ്പുറവും","kn":"ಮನುಷ್ಯರ ಮಾರ್ಗಗಳು ಮತ್ತು ಅದರಾಚೆಗಿನದು"},"280":{"hi":"पराशर का जनक को उपदेश आरंभ","te":"జనకుడికి పరాశరుడి బోధ ప్రారంభం","ta":"ஜனகருக்குப் பராசரரின் போதனை தொடங்குகிறது","ml":"പരാശരൻ ജനകന് ഉപദേശം തുടങ്ങുന്നു","kn":"ಜನಕನಿಗೆ ಪರಾಶರರ ಉಪದೇಶದ ಆರಂಭ"},"281":{"hi":"कौन किसकी सहायता करता है","te":"ఎవరు ఎవరికి సాయం చేస్తారు","ta":"யார் யாருக்கு உதவுகிறார்கள்","ml":"ആര് ആരെ സഹായിക്കുന്നു","kn":"ಯಾರು ಯಾರಿಗೆ ಸಹಾಯ ಮಾಡುತ್ತಾರೆ"},"282":{"hi":"आश्रमों के कर्तव्य","te":"వర్ణాల కర్తవ్యాలు","ta":"வருணங்களின் கடமைகள்","ml":"ആശ്രമങ്ങളുടെ കടമകൾ","kn":"ವರ್ಣಗಳ ಕರ್ತವ್ಯಗಳು"},"283":{"hi":"उचित रीति से अर्जित लाभ","te":"ధర్మబద్ధంగా సంపాదించిన లాభాలు","ta":"முறையாக ஈட்டிய வருவாய்","ml":"ന്യായമായി നേടുന്ന ലാഭം","kn":"ಧರ್ಮಬದ್ಧವಾಗಿ ಗಳಿಸಿದ ಲಾಭ"},"284":{"hi":"गृहस्थ धर्म और तपस्या","te":"గృహస్థ ధర్మం, తపస్సు","ta":"இல்லறத்தாரின் தர்மமும் தவமும்","ml":"ഗൃഹസ്ഥധർമ്മവും തപസ്സും","kn":"ಗೃಹಸ್ಥ ಧರ್ಮ ಮತ್ತು ತಪಸ್ಸು"},"285":{"hi":"जनक पूछते हैं कि आश्रम कैसे बने","te":"వర్ణాలు ఎలా ఏర్పడ్డాయని జనకుడు అడుగుతాడు","ta":"வருணங்கள் எவ்வாறு தோன்றின என ஜனகர் கேட்கிறார்","ml":"ആശ്രമങ്ങൾ എങ്ങനെ ഉണ്ടായി എന്ന് ജനകൻ ചോദിക്കുന്നു","kn":"ವರ್ಣಗಳು ಹೇಗೆ ಉದ್ಭವಿಸಿದವು ಎಂದು ಜನಕ ಕೇಳುತ್ತಾನೆ"},"286":{"hi":"शरीर और अज्ञान का शत्रु","te":"శరీరం, అజ్ఞాన శత్రువు","ta":"உடலும் அறியாமை எனும் எதிரியும்","ml":"ശരീരവും അജ്ഞാനമെന്ന ശത്രുവും","kn":"ದೇಹ ಮತ್ತು ಅಜ್ಞಾನದ ಶತ್ರು"},"287":{"hi":"जल में नौका","te":"నీటిలో పడవ","ta":"நீரில் மிதக்கும் படகு","ml":"വെള്ളത്തിലെ തോണി","kn":"ನೀರಿನಲ್ಲಿರುವ ದೋಣಿ"},"288":{"hi":"साध्यों और हंस का विवाद","te":"సాధ్యులు, హంస వివాదం","ta":"சாத்தியர்களின் வாதமும் அன்னப்பறவையும்","ml":"സാധ്യന്മാരുടെ തർക്കവും അരയന്നവും","kn":"ಸಾಧ್ಯರು ಮತ್ತು ಹಂಸದ ವಿವಾದ"},"289":{"hi":"सांख्य और योग","te":"సాంఖ్యం, యోగం","ta":"சாங்கியமும் யோகமும்","ml":"സാംഖ്യവും യോഗവും","kn":"ಸಾಂಖ್ಯ ಮತ್ತು ಯೋಗ"},"290":{"hi":"व्यास का योग और उसके अंत पर उपदेश","te":"యోగం, దాని ముగింపుపై వ్యాసుడి బోధ","ta":"யோகமும் அதன் முடிவும் பற்றி வியாசரின் போதனை","ml":"യോഗത്തെയും അതിന്റെ അവസാനത്തെയും കുറിച്ച് വ്യാസന്റെ ഉപദേശം","kn":"ಯೋಗ ಮತ್ತು ಅದರ ಅಂತ್ಯದ ಕುರಿತು ವ್ಯಾಸರ ಉಪದೇಶ"},"291":{"hi":"अविनाशी और नश्वर","te":"నాశనం లేనిది, నశించేది","ta":"அழியாததும் அழிவதும்","ml":"നശിക്കാത്തതും നശിക്കുന്നതും","kn":"ಅವಿನಾಶಿ ಮತ್ತು ನಾಶವಾಗುವುದು"},"292":{"hi":"मोहग्रस्त आत्मा और उसके जन्म","te":"మోహంలో ఉన్న ఆత్మ, దాని జన్మలు","ta":"மயங்கிய ஆன்மாவும் அதன் பிறவிகளும்","ml":"മോഹിതനായ ആത്മാവും അതിന്റെ ജന്മങ്ങളും","kn":"ಮೋಹಿತ ಆತ್ಮ ಮತ್ತು ಅದರ ಜನ್ಮಗಳು"},"293":{"hi":"कराल जनक वसिष्ठ से प्रश्न करते हैं","te":"కరాల జనకుడు, వసిష్ఠుడిని ప్రశ్నిస్తాడు","ta":"கராள ஜனகர் வசிஷ்டரிடம் கேட்கிறார்","ml":"കരാള ജനകൻ വസിഷ്ഠനോട് ചോദിക്കുന്നു","kn":"ಕರಾಳ ಜನಕ ವಸಿಷ್ಠರನ್ನು ಪ್ರಶ್ನಿಸುತ್ತಾನೆ"},"294":{"hi":"एकत्व और अनेकत्व","te":"ఏకత్వం, అనేకత్వం","ta":"ஒன்றும் பலவும்","ml":"ഏകത്വവും ബഹുത്വവും","kn":"ಏಕತ್ವ ಮತ್ತು ಬಹುತ್ವ"},"295":{"hi":"ज्ञान और अज्ञान","te":"జ్ఞానం, అజ్ఞానం","ta":"ஞானமும் அறியாமையும்","ml":"ജ്ഞാനവും അജ്ഞാനവും","kn":"ಜ್ಞಾನ ಮತ್ತು ಅಜ್ಞಾನ"},"296":{"hi":"पच्चीसवां और छब्बीसवां तत्व","te":"ఇరవై ఐదవది, ఇరవై ఆరవది","ta":"இருபத்தைந்தாவதும் இருபத்தாறாவதும்","ml":"ഇരുപത്തഞ്ചാമത്തേതും ഇരുപത്താറാമത്തേതും","kn":"ಇಪ್ಪತ್ತೈದನೆಯ ಮತ್ತು ಇಪ್ಪತ್ತಾರನೆಯ ತತ್ತ್ವ"},"297":{"hi":"वन में राजकुमार और ऋषि","te":"అడవిలో రాకుమారుడు, ఋషి","ta":"காட்டில் இளவரசனும் முனிவரும்","ml":"കാട്ടിലെ രാജകുമാരനും മുനിയും","kn":"ಕಾಡಿನಲ್ಲಿ ರಾಜಕುಮಾರ ಮತ್ತು ಋಷಿ"},"298":{"hi":"याज्ञवल्क्य और जनक: धर्म से परे क्या है","te":"యాజ్ఞవల్క్యుడు, జనకుడు: ధర్మానికి ఆవల ఏముంది","ta":"யாக்ஞவல்க்யரும் ஜனகரும்: தர்மத்திற்கு அப்பால் உள்ளது எது","ml":"യാജ്ഞവൽക്യനും ജനകനും: ധർമ്മത്തിനപ്പുറം എന്ത്","kn":"ಯಾಜ್ಞವಲ್ಕ್ಯ ಮತ್ತು ಜನಕ: ಧರ್ಮವನ್ನು ಮೀರಿದ್ದು ಏನು"},"299":{"hi":"काल की गणना","te":"కాల లెక్క","ta":"காலத்தின் கணக்கீடு","ml":"കാലത്തിന്റെ കണക്ക്","kn":"ಕಾಲದ ಲೆಕ್ಕ"},"300":{"hi":"तत्वों का लय","te":"భూతాల లయం","ta":"பூதங்களின் ஒடுக்கம்","ml":"മൂലകങ്ങളുടെ ലയം","kn":"ಭೂತಗಳ ಲಯ"},"301":{"hi":"आत्मा, विषय और देवता","te":"ఆత్మ, విషయాలు, దేవతలు","ta":"ஆன்மா, பொருள்கள், தேவர்கள்","ml":"ആത്മാവും വിഷയങ്ങളും ദേവന്മാരും","kn":"ಆತ್ಮ, ವಿಷಯಗಳು ಮತ್ತು ದೇವತೆಗಳು"},"302":{"hi":"तीन गुण और भाग्य के लक्षण","te":"మూడు గుణాలు, విధి సూచనలు","ta":"மூன்று குணங்களும் விதியின் அடையாளங்களும்","ml":"മൂന്നു ഗുണങ്ങളും വിധിയുടെ ലക്ഷണങ്ങളും","kn":"ಮೂರು ಗುಣಗಳು ಮತ್ತು ವಿಧಿಯ ಲಕ್ಷಣಗಳು"},"303":{"hi":"निर्गुण परमात्मा","te":"గుణాలు లేనివాడు","ta":"குணமற்ற ஒருவன்","ml":"ഗുണങ്ങളില്ലാത്തവൻ","kn":"ಗುಣರಹಿತ ಒಂದು"},"304":{"hi":"योग का अभ्यास","te":"యోగ సాధన","ta":"யோகப் பயிற்சி","ml":"യോഗാഭ്യാസം","kn":"ಯೋಗ ಸಾಧನೆ"},"305":{"hi":"शरीर त्यागना और मृत्यु के लक्षण","te":"శరీరాన్ని విడిచిపెట్టడం, మరణ సూచనలు","ta":"உடலை விடுதலும் மரணத்தின் அடையாளங்களும்","ml":"ശരീരം വിടുന്നതും മരണലക്ഷണങ്ങളും","kn":"ದೇಹ ತ್ಯಜಿಸುವುದು ಮತ್ತು ಮರಣದ ಲಕ್ಷಣಗಳು"},"306":{"hi":"याज्ञवल्क्य और विश्ववसु","te":"యాజ్ఞవల్క్యుడు, విశ్వావసు","ta":"யாக்ஞவல்க்யரும் விஸ்வவசுவும்","ml":"യാജ്ഞവൽക്യനും വിശ്വവസുവും","kn":"ಯಾಜ್ಞವಲ್ಕ್ಯ ಮತ್ತು ವಿಶ್ವಾವಸು"},"307":{"hi":"मृत्यु और बुढ़ापे को कैसे पार करें","te":"మృత్యువు, వృద్ధాప్యాన్ని దాటడం","ta":"மரணத்தையும் முதுமையையும் கடப்பது எப்படி","ml":"മരണത്തെയും വാർദ്ധക്യത്തെയും കടക്കുന്ന വിധം","kn":"ಮೃತ್ಯು ಮತ್ತು ಜರಾವನ್ನು ದಾಟುವ ಬಗೆ"},"308":{"hi":"सुलभा और जनक","te":"సులభ, జనకుడు","ta":"சுலபையும் ஜனகரும்","ml":"സുലഭയും ജനകനും","kn":"ಸುಲಭೆ ಮತ್ತು ಜನಕ"},"309":{"hi":"शुकदेव का संसार से विमुख होना","te":"శుకుడు ప్రపంచానికి దూరమవుతాడు","ta":"உலகிலிருந்து சுகர் விலகுகிறார்","ml":"ലോകത്തിൽനിന്ന് ശുകൻ അകലുന്നു","kn":"ಶುಕನ ಲೌಕಿಕ ವಿರಕ್ತಿ"},"310":{"hi":"शुकदेव का जन्म","te":"శుకుడి జననం","ta":"சுகரின் பிறப்பு","ml":"ശുകന്റെ ജനനം","kn":"ಶುಕನ ಜನನ"},"311":{"hi":"शुकदेव का उत्पन्न होना","te":"శుకుడు ఉనికిలోకి వస్తాడు","ta":"சுகர் உருவாகிறார்","ml":"ശുകന്റെ ഉദയം","kn":"ಶುಕನ ಉದ್ಭವ"},"312":{"hi":"शुकदेव मिथिला जाते हैं","te":"శుకుడు మిథిలకు వెళ్తాడు","ta":"சுகர் மிதிலைக்குச் செல்கிறார்","ml":"ശുകൻ മിഥിലയിലേക്ക് പോകുന്നു","kn":"ಶುಕ ಮಿಥಿಲೆಗೆ ಹೋಗುತ್ತಾನೆ"},"313":{"hi":"जनक शुकदेव को सिखाते हैं","te":"జనకుడు శుకుడికి బోధిస్తాడు","ta":"ஜனகர் சுகருக்குப் போதிக்கிறார்","ml":"ജനകൻ ശുകനെ പഠിപ്പിക്കുന്നു","kn":"ಜನಕ ಶುಕನಿಗೆ ಉಪದೇಶಿಸುತ್ತಾನೆ"},"314":{"hi":"शुकदेव की शांति और व्यास के अध्ययन-नियम","te":"శాంతిలో శుకుడు; వ్యాసుడి అధ్యయన నియమాలు","ta":"அமைதியடைந்த சுகர்; வியாசரின் கல்வி விதிகள்","ml":"ശുകന്റെ ശാന്തി, വ്യാസന്റെ പഠനനിയമങ്ങൾ","kn":"ಶಾಂತನಾದ ಶುಕ, ವ್ಯಾಸರ ಅಧ್ಯಯನ ನಿಯಮಗಳು"},"315":{"hi":"व्यास के शिष्यों को उपदेश","te":"వ్యాసుడి శిష్యులకు బోధ","ta":"வியாசரின் சீடர்களுக்கான போதனை","ml":"വ്യാസന്റെ ശിഷ്യർക്കുള്ള ഉപദേശം","kn":"ವ್ಯಾಸರ ಶಿಷ್ಯರಿಗೆ ಉಪದೇಶ"},"316":{"hi":"नारद शुकदेव को सिखाते हैं","te":"నారదుడు శుకుడికి బోధిస్తాడు","ta":"நாரதர் சுகருக்குப் போதிக்கிறார்","ml":"നാരദൻ ശുകനെ പഠിപ്പിക്കുന്നു","kn":"ನಾರದರು ಶುಕನಿಗೆ ಉಪದೇಶಿಸುತ್ತಾರೆ"},"317":{"hi":"संतोष और आत्मा की शांति","te":"సంతృప్తి, ఆత్మ శాంతి","ta":"மனநிறைவும் ஆன்மாவின் அமைதியும்","ml":"സന്തോഷവും ആത്മശാന്തിയും","kn":"ಸಂತೋಷ ಮತ್ತು ಆತ್ಮದ ಶಾಂತಿ"},"318":{"hi":"शुकदेव जाने का निश्चय करते हैं","te":"శుకుడు వెళ్లాలని నిశ్చయిస్తాడు","ta":"சுகர் புறப்படத் தீர்மானிக்கிறார்","ml":"ശുകൻ പോകാൻ തീരുമാനിക്കുന്നു","kn":"ಶುಕ ಹೊರಡಲು ನಿರ್ಧರಿಸುತ್ತಾನೆ"},"319":{"hi":"शुकदेव की उड़ान","te":"శుకుడి ప్రయాణం","ta":"சுகரின் பறப்பு","ml":"ശുകന്റെ പറക്കൽ","kn":"ಶುಕನ ಹಾರಾಟ"},"320":{"hi":"शुकदेव सर्वोच्च लोक पहुंचते हैं","te":"శుకుడు అత్యున్నత స్థితికి చేరుకుంటాడు","ta":"சுகர் மிக உயர்ந்த நிலையை அடைகிறார்","ml":"ശുകൻ ഉന്നതിയിലെത്തുന്നു","kn":"ಶುಕ ಪರಮ ಸ್ಥಿತಿಯನ್ನು ತಲುಪುತ್ತಾನೆ"},"321":{"hi":"बदरी में नारद: किसकी उपासना करें","te":"బదరిలో నారదుడు: ఎవరిని పూజించాలి","ta":"பதரியில் நாரதர்: யாரை வழிபட வேண்டும்","ml":"ബദരിയിൽ നാരദൻ: ആരെ ആരാധിക്കണം","kn":"ಬದರಿಯಲ್ಲಿ ನಾರದ: ಯಾರನ್ನು ಪೂಜಿಸಬೇಕು"},"322":{"hi":"ऋषियों पर नारायण की कृपा","te":"ఋషులపై నారాయణుడి అనుగ్రహం","ta":"முனிவர்கள் மீது நாராயணனின் அருள்","ml":"മുനിമാരിൽ നാരായണന്റെ അനുഗ്രഹം","kn":"ಋಷಿಗಳ ಮೇಲೆ ನಾರಾಯಣನ ಕೃಪೆ"},"323":{"hi":"एकत, द्वित और त्रित","te":"ఏకత, ద్విత, త్రిత","ta":"ஏகதர், த்விதர், த்ரிதர்","ml":"ഏകതൻ, ദ്വിതൻ, ത്രിതൻ","kn":"ಏಕತ, ದ್ವಿತ ಮತ್ತು ತ್ರಿತ"},"324":{"hi":"राजा वसु और ऋषि","te":"వసు రాజు, ఋషులు","ta":"வசு அரசனும் முனிவர்களும்","ml":"വസു രാജാവും മുനിമാരും","kn":"ರಾಜ ವಸು ಮತ್ತು ಋಷಿಗಳು"},"325":{"hi":"श्वेतद्वीप पर नारद की स्तुति","te":"శ్వేత ద్వీపంలో నారదుడి స్తోత్రం","ta":"வெள்ளைத் தீவில் நாரதரின் துதி","ml":"ശ്വേതദ്വീപിൽ നാരദന്റെ സ്തുതി","kn":"ಶ್ವೇತದ್ವೀಪದಲ್ಲಿ ನಾರದರ ಸ್ತೋತ್ರ"},"326":{"hi":"विष्णु नारद को अपना रूप दिखाते हैं","te":"విష్ణువు నారదుడికి తన రూపం చూపుతాడు","ta":"விஷ்ணு நாரதருக்குத் தன் வடிவைக் காட்டுகிறார்","ml":"വിഷ്ണു നാരദന് തന്റെ രൂപം കാണിക്കുന്നു","kn":"ವಿಷ್ಣು ನಾರದರಿಗೆ ತನ್ನ ರೂಪವನ್ನು ತೋರಿಸುತ್ತಾನೆ"},"327":{"hi":"देवता नारायण से यज्ञ के बारे में पूछते हैं","te":"యజ్ఞం గురించి నారాయణుడిని దేవతలు అడుగుతారు","ta":"யாகம் பற்றி நாராயணனிடம் தேவர்கள் கேட்கிறார்கள்","ml":"യാഗത്തെക്കുറിച്ച് ദേവന്മാർ നാരായണനോട് ചോദിക്കുന്നു","kn":"ಯಜ್ಞದ ಕುರಿತು ದೇವತೆಗಳು ನಾರಾಯಣನನ್ನು ಕೇಳುತ್ತಾರೆ"},"328":{"hi":"कृष्ण के नाम","te":"కృష్ణుడి నామాలు","ta":"கிருஷ்ணனின் திருநாமங்கள்","ml":"കൃഷ്ണന്റെ നാമങ്ങൾ","kn":"ಕೃಷ್ಣನ ನಾಮಗಳು"},"329":{"hi":"अग्नि और सोम","te":"అగ్ని, సోముడు","ta":"அக்னியும் சோமனும்","ml":"അഗ്നിയും സോമനും","kn":"ಅಗ್ನಿ ಮತ್ತು ಸೋಮ"},"330":{"hi":"कृष्ण के नाम और रूप","te":"కృష్ణుడి నామాలు, రూపాలు","ta":"கிருஷ்ணனின் திருநாமங்களும் வடிவங்களும்","ml":"കൃഷ്ണന്റെ നാമങ്ങളും രൂപങ്ങളും","kn":"ಕೃಷ್ಣನ ನಾಮ ಮತ್ತು ರೂಪಗಳು"},"331":{"hi":"जनमेजय नर और नारायण के बारे में पूछते हैं","te":"నర, నారాయణుల గురించి జనమేజయుడి ప్రశ్న","ta":"நரன், நாராயணன் பற்றி ஜனமேஜயன் கேட்கிறான்","ml":"നരനെയും നാരായണനെയും കുറിച്ച് ജനമേജയൻ ചോദിക്കുന്നു","kn":"ನರ ಮತ್ತು ನಾರಾಯಣರ ಕುರಿತು ಜನಮೇಜಯ ಕೇಳುತ್ತಾನೆ"},"332":{"hi":"जो दिखाई नहीं देते वे प्रभु","te":"కనిపించని ప్రభువు","ta":"காண இயலாத இறைவன்","ml":"കാണാൻ കഴിയാത്ത ഭഗവാൻ","kn":"ಕಾಣಲಾಗದ ಪರಮಾತ್ಮ"},"333":{"hi":"नारद और पितरों का तर्पण","te":"నారదుడు, పితృదేవతలకు తర్పణం","ta":"நாரதரும் முன்னோர்களுக்கான படையலும்","ml":"നാരദനും പിതൃക്കൾക്കുള്ള തർപ്പണവും","kn":"ನಾರದ ಮತ್ತು ಪಿತೃಗಳಿಗೆ ಅರ್ಪಣೆ"},"334":{"hi":"नारायणीय प्रसंग का अंत","te":"నారాయణీయ కథనం ముగింపు","ta":"நாராயணீயத்தின் முடிவு","ml":"നാരായണീയ വിവരണത്തിന്റെ അവസാനം","kn":"ನಾರಾಯಣೀಯದ ವೃತ್ತಾಂತದ ಅಂತ್ಯ"},"335":{"hi":"जनमेजय पूछते हैं कि व्यास ने क्या कहा","te":"వ్యాసుడు చెప్పిన దాని గురించి జనమేజయుడి ప్రశ్న","ta":"வியாசர் கூறியதை ஜனமேஜயன் கேட்கிறான்","ml":"വ്യാസൻ പറഞ്ഞത് ജനമേജയൻ ചോദിക്കുന്നു","kn":"ವ್ಯಾಸರು ಏನು ಹೇಳಿದರು ಎಂದು ಜನಮೇಜಯ ಕೇಳುತ್ತಾನೆ"},"336":{"hi":"एकनिष्ठ भक्तों पर प्रभु की कृपा","te":"ఏకాగ్ర భక్తులపై ప్రభువు అనుగ్రహం","ta":"ஒருமனப்பட்ட பக்தர்கள் மீது இறைவனின் அருள்","ml":"ഏകാഗ്രഭക്തരിൽ ഭഗവാന്റെ അനുഗ്രഹം","kn":"ಏಕಾಗ್ರ ಭಕ್ತರ ಮೇಲೆ ಭಗವಂತನ ಕೃಪೆ"},"337":{"hi":"ज्ञान के रूप","te":"జ్ఞాన రూపాలు","ta":"ஞானத்தின் வடிவங்கள்","ml":"ജ്ഞാനത്തിന്റെ രൂപങ്ങൾ","kn":"ಜ್ಞಾನದ ರೂಪಗಳು"},"338":{"hi":"रुद्र ब्रह्मा से एक के बारे में पूछते हैं","te":"ఏకుడి గురించి రుద్రుడు బ్రహ్మను అడుగుతాడు","ta":"ஒன்றைப் பற்றி பிரம்மனிடம் ருத்ரன் கேட்கிறான்","ml":"ഏകനെക്കുറിച്ച് ബ്രഹ്മാവിനോട് രുദ്രന്റെ ചോദ്യം","kn":"ಏಕನ ಕುರಿತು ರುದ್ರ ಬ್ರಹ್ಮನನ್ನು ಕೇಳುತ್ತಾನೆ"},"339":{"hi":"ब्रह्मा शाश्वत पुरुष का उपदेश देते हैं","te":"శాశ్వత పురుషుడి బోధ, బ్రహ్మ","ta":"நித்திய புருஷனை பிரம்மன் போதிக்கிறார்","ml":"ശാശ്വതനായ പുരുഷനെ ബ്രഹ്മാവ് പഠിപ്പിക്കുന്നു","kn":"ಶಾಶ್ವತ ಪುರುಷನ ಕುರಿತು ಬ್ರಹ್ಮ ಉಪದೇಶಿಸುತ್ತಾನೆ"},"340":{"hi":"आश्रमों में सर्वोच्च धर्म","te":"ఆశ్రమాలలో శ్రేష్ఠమైన ధర్మం","ta":"நிலைகளில் மிக உயர்ந்த தர்மம்","ml":"ആശ്രമങ്ങളിലെ ഉത്തമ ധർമ്മം","kn":"ಆಶ್ರಮಗಳಲ್ಲಿ ಪರಮ ಧರ್ಮ"},"341":{"hi":"महापद्म का ब्राह्मण","te":"మహాపద్మ బ్రాహ్మణుడు","ta":"மகாபத்மரின் அந்தணர்","ml":"മഹാപദ്മത്തിലെ ബ്രാഹ്മണൻ","kn":"ಮಹಾಪದ್ಮದ ಬ್ರಾಹ್ಮಣ"},"342":{"hi":"अनेक मार्गों पर ब्राह्मण का संशय","te":"అనేక మార్గాలపై బ్రాహ్మణుడి సందేహం","ta":"பல வழிகள் பற்றிய அந்தணரின் ஐயம்","ml":"പല വഴികളെക്കുറിച്ച് ബ്രാഹ്മണന്റെ സംശയം","kn":"ಅನೇಕ ಮಾರ್ಗಗಳ ಕುರಿತು ಬ್ರಾಹ್ಮಣನ ಸಂದೇಹ"},"343":{"hi":"अतिथि का उपदेश: नाग पद्मनाभ","te":"అతిథి బోధ: నాగుడు పద్మనాభుడు","ta":"விருந்தினரின் போதனை: பத்மநாபன் என்ற நாகம்","ml":"അതിഥിയുടെ ഉപദേശം: നാഗനായ പദ്മനാഭൻ","kn":"ಅತಿಥಿಯ ಉಪದೇಶ: ನಾಗ ಪದ್ಮನಾಭ"},"344":{"hi":"ब्राह्मण नाग के पास जाता है","te":"బ్రాహ్మణుడు నాగుడి వద్దకు వెళ్తాడు","ta":"அந்தணர் நாகத்திடம் செல்கிறார்","ml":"ബ്രാഹ്മണൻ നാഗത്തിന്റെ അടുത്തേക്ക് പോകുന്നു","kn":"ಬ್ರಾಹ್ಮಣ ನಾಗನ ಬಳಿಗೆ ಹೋಗುತ್ತಾನೆ"},"345":{"hi":"नाग की पत्नी","te":"నాగుడి భార్య","ta":"நாகத்தின் மனைவி","ml":"നാഗത്തിന്റെ ഭാര്യ","kn":"ನಾಗನ ಪತ್ನಿ"},"346":{"hi":"ब्राह्मण का उपवास और नागों का शोक","te":"బ్రాహ్మణుడు ఉపవాసం; నాగులు దుఃఖిస్తారు","ta":"அந்தணர் உண்ணாநோன்பிருக்க நாகங்கள் வருந்துகின்றன","ml":"ബ്രാഹ്മണൻ ഉപവസിക്കുന്നു, നാഗങ്ങൾ ദുഃഖിക്കുന്നു","kn":"ಬ್ರಾಹ್ಮಣ ಉಪವಾಸ ಮಾಡುತ್ತಾನೆ, ನಾಗರು ದುಃಖಿಸುತ್ತಾರೆ"},"347":{"hi":"नाग की पत्नी पति से आग्रह करती है","te":"నాగుడి భార్య భర్తను ప్రోత్సహిస్తుంది","ta":"நாகத்தின் மனைவி கணவனை வற்புறுத்துகிறாள்","ml":"നാഗത്തിന്റെ ഭാര്യ ഭർത്താവിനെ പ്രേരിപ്പിക്കുന്നു","kn":"ನಾಗನ ಪತ್ನಿ ಪತಿಯನ್ನು ಒತ್ತಾಯಿಸುತ್ತಾಳೆ"},"348":{"hi":"नाग इस भेंट पर विचार करता है","te":"నాగుడు సందర్శనను తూకం వేస్తాడు","ta":"நாகம் வருகையை எடைபோடுகிறது","ml":"സന്ദർശനം നാഗം തൂക്കിനോക്കുന്നു","kn":"ನಾಗ ಭೇಟಿಯನ್ನು ಪರಿಗಣಿಸುತ್ತಾನೆ"},"349":{"hi":"नाग अपनी सेवा प्रस्तुत करता है","te":"నాగుడు తన సేవను అందిస్తాడు","ta":"நாகம் தன் சேவையை அளிக்கிறது","ml":"നാഗം തന്റെ സേവന വാഗ്ദാനം നൽകുന്നു","kn":"ನಾಗ ತನ್ನ ಸೇವೆಯನ್ನು ಅರ್ಪಿಸುತ್ತಾನೆ"},"350":{"hi":"सूर्य के रथ का आश्चर्य","te":"సూర్యుడి రథంలో ఆశ్చర్యం","ta":"சூரியனின் தேரில் வியப்பு","ml":"സൂര്യരഥത്തിലെ അത്ഭുതം","kn":"ಸೂರ್ಯರಥದಲ್ಲಿನ ಅದ್ಭುತ"},"351":{"hi":"सूर्य का उत्तर: स्वर्ग पाने वाला एक बटोरने वाला","te":"సూర్యుడి సమాధానం: స్వర్గం పొందిన ధాన్యం ఏరుకునే వ్యక్తి","ta":"சூரியனின் பதில்: சொர்க்கம் அடைந்த கதிர்பொறுக்கி","ml":"സൂര്യന്റെ മറുപടി: സ്വർഗ്ഗം നേടിയ ശേഖരക്കാരൻ","kn":"ಸೂರ್ಯನ ಉತ್ತರ: ಸ್ವರ್ಗ ಪಡೆದ ಕಾಳು ಆಯುವವನು"},"352":{"hi":"ब्राह्मण का संकल्प","te":"బ్రాహ్మణుడి నిశ్చయం","ta":"அந்தணரின் உறுதி","ml":"ബ്രാഹ്മണന്റെ തീരുമാനം","kn":"ಬ್ರಾಹ್ಮಣನ ಸಂಕಲ್ಪ"},"353":{"hi":"वन में अन्न बटोरने वाला","te":"అడవిలో ధాన్యం ఏరుకునే వ్యక్తి","ta":"காட்டிலுள்ள கதிர்பொறுக்கி","ml":"കാട്ടിലെ ശേഖരക്കാരൻ","kn":"ಕಾಡಿನಲ್ಲಿ ಕಾಳು ಆಯುವವನು"}}