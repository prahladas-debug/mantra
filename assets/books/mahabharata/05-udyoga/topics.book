{"1":{"hi":"विराट के दरबार में सभा","kn":"ವಿರಾಟನ ಸಭೆಯಲ್ಲಿ ಮಂತ್ರಾಲೋಚನೆ","te":"విరాటుడి సభలో మంత్రాంగం","ta":"விராடன் அரசவையில் ஆலோசனைக் கூட்டம்","ml":"വിരാടന്റെ സഭയിലെ ആലോചനായോഗം"},"2":{"hi":"बलराम समझौते का परामर्श देते हैं","kn":"ಸಂಧಿಗೆ ಬಲರಾಮನ ಸಲಹೆ","te":"సంధి చేసుకోమని బలరాముడి హితవు","ta":"சமாதானம் வேண்டும் என பலராமன் அறிவுறுத்துகிறான்","ml":"ബലരാമൻ സന്ധിക്ക് ഉപദേശിക്കുന്നു"},"3":{"hi":"सात्यकि का उत्तर","kn":"ಸಾತ್ಯಕಿಯ ಪ್ರತ್ಯುತ್ತರ","te":"సాత్యకి ప్రతివాదన","ta":"சாத்யகியின் பதிலடி","ml":"സാത്യകിയുടെ മറുപടി"},"4":{"hi":"द्रुपद का परामर्श","kn":"ದ್ರುಪದನ ಸಲಹೆ","te":"ద్రుపదుడి హితవు","ta":"துருபதனின் ஆலோசனை","ml":"ദ്രുപദന്റെ ഉപദേശം"},"5":{"hi":"कृष्ण द्वारका लौटते हैं","kn":"ಕೃಷ್ಣನು ದ್ವಾರಕೆಗೆ ಹಿಂದಿರುಗುವುದು","te":"కృష్ణుడు ద్వారకకు తిరిగి వెళ్తాడు","ta":"கிருஷ்ணன் துவாரகைக்குத் திரும்புகிறான்","ml":"കൃഷ്ണൻ ദ്വാരകയിലേക്ക് മടങ്ങുന്നു"},"6":{"hi":"द्रुपद अपने पुरोहित को निर्देश देते हैं","kn":"ದ್ರುಪದನು ತನ್ನ ಪುರೋಹಿತನಿಗೆ ಆಜ್ಞಾಪಿಸುವುದು","te":"ద్రుపదుడు తన పురోహితుడికి ఆజ్ఞాపిస్తాడు","ta":"தன் புரோகிதருக்குத் துருபதன் கட்டளையிடுகிறான்","ml":"ദ്രുപദൻ തന്റെ പുരോഹിതന് നിർദേശം നൽകുന്നു"},"7":{"hi":"कृष्ण की शय्या के पास अर्जुन और दुर्योधन","kn":"ಕೃಷ್ಣನ ಶಯ್ಯೆಯ ಬಳಿ ಅರ್ಜುನ ಮತ್ತು ದುರ್ಯೋಧನರು","te":"కృష్ణుడి శయ్య వద్ద అర్జునుడు, దుర్యోధనుడు","ta":"கிருஷ்ணனின் படுக்கையருகே அர்ஜுனனும் துரியோதனனும்","ml":"കൃഷ്ണന്റെ കിടക്കയ്ക്കരികിൽ അർജുനനും ദുര്യോധനനും"},"8":{"hi":"दुर्योधन शल्य को अपनी ओर कर लेता है","kn":"ದುರ್ಯೋಧನನಿಂದ ಶಲ್ಯನ ಮನವೊಲಿಕೆ","te":"దుర్యోధనుడి చేత శల్యుడు ఒప్పించబడతాడు","ta":"துரியோதனனால் சல்லியன் வசப்படுகிறான்","ml":"ദുര്യോധനൻ ശല്യനെ തന്റെ പക്ഷത്താക്കുന്നു"},"9":{"hi":"इंद्र त्रिशिरा का वध करते हैं और वृत्र प्रकट होता है","kn":"ಇಂದ್ರನು ತ್ರಿಶಿರನನ್ನು ಸಂಹರಿಸುವುದು; ವೃತ್ರನ ಉದಯ","te":"ఇంద్రుడు త్రిశిరుడిని సంహరిస్తాడు; వృత్రుడు ఉద్భవిస్తాడు","ta":"திரிசிரஸைக் கொல்லும் இந்திரன்; விருத்திரன் எழுகிறான்","ml":"ഇന്ദ്രൻ ത്രിശിരസ്സിനെ വധിക്കുന്നു; വൃത്രൻ ഉദയം ചെയ്യുന്നു"},"10":{"hi":"वृत्र की मृत्यु","kn":"ವೃತ್ರನ ಮರಣ","te":"వృత్రుడి మరణం","ta":"விருத்திரனின் மரணம்","ml":"വൃത്രന്റെ വധം"},"11":{"hi":"नहुष देवताओं के राजा बनते हैं","kn":"ದೇವತೆಗಳ ರಾಜನಾಗಿ ನಹುಷನ ಪಟ್ಟಾಭಿಷೇಕ","te":"నహుషుడు దేవతలకు రాజవుతాడు","ta":"தேவர்களின் அரசனாக நகுஷன் ஆக்கப்படுகிறான்","ml":"നഹുഷൻ ദേവേന്ദ്രനാകുന്നു"},"12":{"hi":"बृहस्पति शची की रक्षा करते हैं","kn":"ಶಚೀದೇವಿಯನ್ನು ಬೃಹಸ್ಪತಿ ರಕ್ಷಿಸುವುದು","te":"బృహస్పతి శచీదేవిని రక్షిస్తాడు","ta":"சசியை பிருஹஸ்பதி காக்கிறான்","ml":"ബൃഹസ്പതി ശചിയെ സംരക്ഷിക്കുന്നു"},"13":{"hi":"शची इंद्र को खोजती है","kn":"ಇಂದ್ರನನ್ನು ಹುಡುಕುವ ಶಚೀದೇವಿ","te":"శచీదేవి ఇంద్రుడిని వెతుకుతుంది","ta":"இந்திரனைத் தேடுகிறாள் சசி","ml":"ശചി ഇന്ദ്രനെ അന്വേഷിക്കുന്നു"},"14":{"hi":"उपश्रुति शची को इंद्र के पास ले जाती है","kn":"ಶಚೀದೇವಿಯನ್ನು ಇಂದ್ರನ ಬಳಿಗೆ ಉಪಶ್ರುತಿ ಕರೆದೊಯ್ಯುವುದು","te":"ఉపశ్రుతి శచీదేవిని ఇంద్రుడి వద్దకు తీసుకువెళ్తుంది","ta":"உபஸ்ருதி சசியை இந்திரனிடம் அழைத்துச் செல்கிறாள்","ml":"ഉപശ്രുതി ശചിയെ ഇന്ദ്രന്റെ അടുത്തേക്ക് നയിക്കുന്നു"},"15":{"hi":"नहुष के विरुद्ध इंद्र की चाल","kn":"ನಹುಷನ ವಿರುದ್ಧ ಇಂದ್ರನ ಉಪಾಯ","te":"నహుషుడికి వ్యతిరేకంగా ఇంద్రుడి ఉపాయం","ta":"நகுஷனுக்கு எதிராக இந்திரனின் தந்திரம்","ml":"നഹുഷനെതിരെ ഇന്ദ്രന്റെ തന്ത്രം"},"16":{"hi":"इंद्र मिलते हैं और पुनः प्रतिष्ठित होते हैं","kn":"ಇಂದ್ರನು ಪತ್ತೆಯಾಗಿ ಪುನಃ ಪದವಿಗೆ ಬರುವುದು","te":"ఇంద్రుడు కనిపిస్తాడు; తిరిగి స్థానం పొందుతాడు","ta":"இந்திரன் கண்டறியப்பட்டு மீண்டும் நிலைநிறுத்தப்படுகிறான்","ml":"ഇന്ദ്രനെ കണ്ടെത്തി സ്ഥാനത്ത് പുനഃസ്ഥാപിക്കുന്നു"},"17":{"hi":"नहुष पर अगस्त्य का शाप","kn":"ನಹುಷನಿಗೆ ಅಗಸ್ತ್ಯರ ಶಾಪ","te":"నహుషుడిపై అగస్త్యుడి శాపం","ta":"நகுஷனுக்கு அகஸ்தியரின் சாபம்","ml":"നഹുഷന് അഗസ്ത്യന്റെ ശാപം"},"18":{"hi":"इंद्र की वापसी और शल्य का प्रस्थान","kn":"ಇಂದ್ರನ ಮರಳುವಿಕೆ ಮತ್ತು ಶಲ್ಯನ ನಿರ್ಗಮನ","te":"ఇంద్రుడి తిరిగి రాక; శల్యుడి నిష్క్రమణ","ta":"இந்திரனின் திரும்புதலும் சல்லியனின் புறப்பாடும்","ml":"ഇന്ദ്രന്റെ മടങ്ങിവരവും ശല്യന്റെ മടക്കവും"},"19":{"hi":"सेनाएँ एकत्र होती हैं","kn":"ಸೇನೆಗಳು ಸೇರುವುದು","te":"సైన్యాలు సమకూడతాయి","ta":"படைகள் கூடுகின்றன","ml":"സേനകൾ ഒരുമിച്ചുകൂടുന്നു"},"20":{"hi":"द्रुपद का पुरोहित कौरवों से बात करता है","kn":"ದ್ರುಪದನ ಪುರೋಹಿತನು ಕೌರವರನ್ನು ಉದ್ದೇಶಿಸಿ ಮಾತನಾಡುವುದು","te":"ద్రుపదుడి పురోహితుడు కౌరవులను ఉద్దేశించి మాట్లాడతాడు","ta":"கௌரவர்களிடம் துருபதனின் புரோகிதர் பேசுகிறார்","ml":"ദ്രുപദന്റെ പുരോഹിതൻ കൗരവരോട് സംസാരിക്കുന്നു"},"21":{"hi":"भीष्म, कर्ण और धृतराष्ट्र उत्तर देते हैं","kn":"ಭೀಷ್ಮ, ಕರ್ಣ ಮತ್ತು ಧೃತರಾಷ್ಟ್ರರ ಪ್ರತಿಕ್ರಿಯೆ","te":"భీష్ముడు, కర్ణుడు, ధృతరాష్ట్రుడు ప్రతిస్పందిస్తారు","ta":"பீஷ்மர், கர்ணன், திருதராஷ்டிரர் ஆகியோரின் பதில்","ml":"ഭീഷ്മരും കർണനും ധൃതരാഷ്ട്രരും മറുപടി പറയുന്നു"},"22":{"hi":"संजय के द्वारा धृतराष्ट्र का संदेश","kn":"ಸಂಜಯನ ಮೂಲಕ ಧೃತರಾಷ್ಟ್ರನ ಸಂದೇಶ","te":"సంజయుడి ద్వారా ధృతరాష్ట్రుడి సందేశం","ta":"சஞ்சயன் வழியாகத் திருதராஷ்டிரரின் செய்தி","ml":"സഞ്ജയൻ മുഖേന ധൃതരാഷ്ട്രരുടെ സന്ദേശം"},"23":{"hi":"उपप्लव्य में संजय","kn":"ಉಪಪ್ಲವ್ಯದಲ್ಲಿ ಸಂಜಯ","te":"ఉపప్లవ్యంలో సంజయుడు","ta":"உபப்லாவ்யத்தில் சஞ்சயன்","ml":"ഉപപ്ലവ്യത്തിൽ സഞ്ജയൻ"},"24":{"hi":"संजय का अभिवादन","kn":"ಸಂಜಯನ ನಮಸ್ಕಾರ","te":"సంజయుడి అభివాదం","ta":"சஞ்சயனின் வணக்கம்","ml":"സഞ്ജയന്റെ അഭിവാദനം"},"25":{"hi":"संजय शांति की अपील करते हैं","kn":"ಸಂಧಿಗಾಗಿ ಸಂಜಯನ ಒತ್ತಾಯ","te":"శాంతి కోరుతాడు సంజయుడు","ta":"சமாதானத்தை சஞ்சயன் வலியுறுத்துகிறான்","ml":"സഞ്ജയൻ സന്ധിക്ക് അഭ്യർഥിക്കുന്നു"},"26":{"hi":"युधिष्ठिर का उत्तर","kn":"ಯುಧಿಷ್ಠಿರನ ಉತ್ತರ","te":"యుధిష్ఠిరుడి సమాధానం","ta":"யுதிட்டிரனின் பதில்","ml":"യുധിഷ്ഠിരന്റെ മറുപടി"},"27":{"hi":"संजय त्याग का उपदेश देते हैं","kn":"ಸಂಜಯನು ವೈರಾಗ್ಯದ ಉಪದೇಶ ನೀಡುವುದು","te":"త్యాగం గురించి సంజయుడి బోధ","ta":"துறவறத்தைச் சஞ்சயன் போதிக்கிறான்","ml":"സഞ്ജയൻ സന്ന്യാസത്തെക്കുറിച്ച് ഉപദേശിക്കുന്നു"},"28":{"hi":"युधिष्ठिर कृष्ण पर निर्णय छोड़ते हैं","kn":"ಕೃಷ್ಣನ ಅಭಿಪ್ರಾಯಕ್ಕೆ ಯುಧಿಷ್ಠಿರನ ಒಪ್ಪಿಗೆ","te":"కృష్ణుడికి యుధిష్ఠిరుడు మాట ఇస్తాడు","ta":"கிருஷ்ணனின் முடிவுக்கு யுதிட்டிரன் பணிகிறான்","ml":"യുധിഷ്ഠിരൻ കൃഷ്ണന്റെ അഭിപ്രായത്തിന് വഴങ്ങുന്നു"},"29":{"hi":"संजय को कृष्ण का उत्तर","kn":"ಸಂಜಯನಿಗೆ ಕೃಷ್ಣನ ಉತ್ತರ","te":"సంజయుడికి కృష్ణుడి సమాధానం","ta":"சஞ்சயனுக்குக் கிருஷ்ணனின் பதில்","ml":"സഞ്ജയന് കൃഷ്ണന്റെ മറുപടി"},"30":{"hi":"युधिष्ठिर का कौरवों के लिए संदेश","kn":"ಕೌರವರಿಗೆ ಯುಧಿಷ್ಠಿರನ ಸಂದೇಶ","te":"కౌరవులకు యుధిష్ఠిరుడి సందేశం","ta":"கௌரவர்களுக்கு யுதிட்டிரனின் செய்தி","ml":"കൗരവർക്കുള്ള യുധിഷ്ഠിരന്റെ സന്ദേശം"},"31":{"hi":"पाँच गाँव","kn":"ಐದು ಗ್ರಾಮಗಳು","te":"ఐదు గ్రామాలు","ta":"ஐந்து ஊர்கள்","ml":"അഞ്ചു ഗ്രാമങ്ങൾ"},"32":{"hi":"संजय धृतराष्ट्र को समाचार देते हैं","kn":"ಸಂಜಯನು ಧೃತರಾಷ್ಟ್ರನಿಗೆ ವರದಿ ಒಪ್ಪಿಸುವುದು","te":"సంజయుడు ధృతరాష్ట్రుడికి నివేదిస్తాడు","ta":"திருதராஷ்டிரரிடம் சஞ்சயன் அறிவிக்கிறான்","ml":"സഞ്ജയൻ ധൃതരാഷ്ട്രരെ വിവരം അറിയിക്കുന്നു"},"33":{"hi":"विदुर का परामर्श: बुद्धिमान और मूर्ख","kn":"ವಿದುರನ ಸಲಹೆ: ಜ್ಞಾನಿ ಮತ್ತು ಮೂರ್ಖ","te":"విదురుడి హితవు: జ్ఞానులు, మూర్ఖులు","ta":"அறிஞரும் மூடரும்: விதுரரின் ஆலோசனை","ml":"വിദുരന്റെ ഉപദേശം: ജ്ഞാനിയും മൂഢനും"},"34":{"hi":"विदुर का सदाचार और संयम पर उपदेश","kn":"ಸದಾಚಾರ ಮತ್ತು ಸಂಯಮದ ಬಗ್ಗೆ ವಿದುರ","te":"సరైన ప్రవర్తన, నిగ్రహం గురించి విదురుడు","ta":"நல்லொழுக்கமும் அடக்கமும் பற்றி விதுரர்","ml":"സദാചാരത്തെയും നിയന്ത്രണത്തെയും കുറിച്ച് വിദുരൻ"},"35":{"hi":"विरोचन और सुधन्वा","kn":"ವಿರೋಚನ ಮತ್ತು ಸುಧನ್ವ","te":"విరోచనుడు, సుధన్వుడు","ta":"விரோசனனும் சுதன்வனும்","ml":"വിരോചനനും സുധന്വാവും"},"36":{"hi":"हंस का उपदेश और उत्तम कुल के लक्षण","kn":"ಹಂಸದ ಉಪದೇಶ ಮತ್ತು ಉತ್ತಮ ಕುಲದ ಲಕ್ಷಣಗಳು","te":"హంస బోధ, మంచి కుటుంబ లక్షణాలు","ta":"அன்னத்தின் போதனையும் நல்ல குடியின் அடையாளங்களும்","ml":"ഹംസോപദേശവും സത്കുലലക്ഷണങ്ങളും"},"37":{"hi":"विदुर के सत्रह प्रकार के मूर्ख","kn":"ಹದಿನೇಳು ಮೂರ್ಖರ ಬಗ್ಗೆ ವಿದುರ","te":"పదిహేడు మంది మూర్ఖుల గురించి విదురుడు","ta":"பதினேழு மூடர்கள் பற்றி விதுரர்","ml":"പതിനേഴു മൂഢന്മാരെക്കുറിച്ച് വിദുരൻ"},"38":{"hi":"विदुर: सम्मान और राजा का आचरण","kn":"ಗೌರವ ಮತ್ತು ರಾಜನ ನಡೆನುಡಿಯ ಬಗ್ಗೆ ವಿದುರ","te":"గౌరవం, రాజు ప్రవర్తన గురించి విదురుడు","ta":"மதிப்பும் அரசனின் நடத்தையும் பற்றி விதுரர்","ml":"മാനത്തെയും രാജധർമത്തെയും കുറിച്ച് വിദുരൻ"},"39":{"hi":"भाग्य के हाथ की कठपुतली मनुष्य","kn":"ವಿಧಿಯ ಕೈಗೊಂಬೆಯಾದ ಮನುಷ್ಯ","te":"విధికి బొమ్మగా మనిషి","ta":"விதியின் பொம்மையாக மனிதன்","ml":"വിധിയുടെ പാവയായ മനുഷ്യൻ"},"40":{"hi":"विदुर: मृत्यु और वर्णों के कर्तव्य","kn":"ಮರಣ ಮತ್ತು ವರ್ಣಧರ್ಮಗಳ ಬಗ್ಗೆ ವಿದುರ","te":"మరణం, వర్ణధర్మాల గురించి విదురుడు","ta":"மரணமும் வருணக் கடமைகளும் பற்றி விதுரர்","ml":"മരണത്തെയും വർണധർമങ്ങളെയും കുറിച്ച് വിദുരൻ"},"41":{"hi":"विदुर सनत्सुजात को बुलाते हैं","kn":"ಸನತ್ಸುಜಾತರನ್ನು ವಿದುರ ಕರೆಸುವುದು","te":"సనత్సుజాతుడిని విదురుడు పిలిపిస్తాడు","ta":"சனத்சுஜாதரை விதுரர் அழைக்கிறார்","ml":"സനത്സുജാതനെ വിദുരൻ വിളിച്ചുവരുത്തുന്നു"},"42":{"hi":"सनत्सुजात मृत्यु पर","kn":"ಮರಣದ ಬಗ್ಗೆ ಸನತ್ಸುಜಾತರು","te":"మరణం గురించి సనత్సుజాతుడు","ta":"மரணம் பற்றி சனத்சுஜாதர்","ml":"മരണത്തെക്കുറിച്ച് സനത്സുജാതൻ"},"43":{"hi":"सनत्सुजात सच्चे ब्राह्मण पर","kn":"ನಿಜವಾದ ಬ್ರಾಹ್ಮಣನ ಬಗ್ಗೆ ಸನತ್ಸುಜಾತರು","te":"నిజమైన బ్రాహ్మణుడి గురించి సనత్సుజాతుడు","ta":"உண்மையான பிராமணன் பற்றி சனத்சுஜாதர்","ml":"യഥാർഥ ബ്രാഹ്മണനെക്കുറിച്ച് സനത്സുജാതൻ"},"44":{"hi":"सनत्सुजात ब्रह्मचर्य पर","kn":"ಬ್ರಹ್ಮಚರ್ಯದ ಬಗ್ಗೆ ಸನತ್ಸುಜಾತರು","te":"బ్రహ్మచర్యం గురించి సనత్సుజాతుడు","ta":"மாணவப் பருவம் பற்றி சனத்சுஜாதர்","ml":"ബ്രഹ്മചര്യത്തെക്കുറിച്ച് സനത്സുജാതൻ"},"45":{"hi":"सनत्सुजात परम ज्योति पर","kn":"ಪರಮ ಜ್ಯೋತಿಯ ಬಗ್ಗೆ ಸನತ್ಸುಜಾತರು","te":"పరమ కాంతి గురించి సనత్సుజాతుడు","ta":"உயர் ஒளி பற்றி சனத்சுஜாதர்","ml":"പരമപ്രകാശത്തെക്കുറിച്ച് സനത്സുജാതൻ"},"46":{"hi":"संजय को सुनने के लिए सभा जुटती है","kn":"ಸಂಜಯನ ಮಾತು ಕೇಳಲು ಸಭೆ ಸೇರುವುದು","te":"సంజయుడి మాట వినడానికి సభ సమకూడుతుంది","ta":"சஞ்சயனின் சொல்லைக் கேட்க சபை கூடுகிறது","ml":"സഞ്ജയന്റെ വാക്കുകൾ കേൾക്കാൻ സദസ്സ് ഒത്തുകൂടുന്നു"},"47":{"hi":"अर्जुन का संदेश","kn":"ಅರ್ಜುನನ ಸಂದೇಶ","te":"అర్జునుడి సందేశం","ta":"அர்ஜுனனின் செய்தி","ml":"അർജുനന്റെ സന്ദേശം"},"48":{"hi":"भीष्म नर और नारायण के विषय में","kn":"ನರ ಮತ್ತು ನಾರಾಯಣರ ಬಗ್ಗೆ ಭೀಷ್ಮ","te":"నరనారాయణుల గురించి భీష్ముడు","ta":"நர நாராயணர் பற்றி பீஷ்மர்","ml":"നരനെയും നാരായണനെയും കുറിച്ച് ഭീഷ്മർ"},"49":{"hi":"संजय पांडव मित्रों का वर्णन करते हैं","kn":"ಪಾಂಡವರ ಮಿತ್ರರನ್ನು ಸಂಜಯ ವರ್ಣಿಸುವುದು","te":"పాండవ మిత్రుల గురించి సంజయుడు వివరిస్తాడు","ta":"பாண்டவ நட்புப் படைகளை சஞ்சயன் விவரிக்கிறான்","ml":"പാണ്ഡവ സഖ്യകക്ഷികളെ സഞ്ജയൻ വിവരിക്കുന്നു"},"50":{"hi":"धृतराष्ट्र भीम से डरते हैं","kn":"ಭೀಮನ ಬಗ್ಗೆ ಧೃತರಾಷ್ಟ್ರನ ಭಯ","te":"భీముడంటే ధృతరాష్ట్రుడికి భయం","ta":"பீமனைக் கண்டு திருதராஷ்டிரர் அஞ்சுகிறார்","ml":"ഭീമനെ ധൃതരാഷ്ട്രർ ഭയക്കുന്നു"},"51":{"hi":"धृतराष्ट्र अर्जुन और कृष्ण से डरते हैं","kn":"ಅರ್ಜುನ ಮತ್ತು ಕೃಷ್ಣರ ಬಗ್ಗೆ ಧೃತರಾಷ್ಟ್ರನ ಭಯ","te":"అర్జునుడు, కృష్ణుల పట్ల ధృతరాష్ట్రుడికి భయం","ta":"அர்ஜுனனையும் கிருஷ்ணனையும் கண்டு திருதராஷ்டிரர் அஞ்சுகிறார்","ml":"അർജുനനെയും കൃഷ്ണനെയും ധൃതരാഷ്ട്രർ ഭയക്കുന്നു"},"52":{"hi":"धृतराष्ट्र शांति की कामना करते हैं","kn":"ಶಾಂತಿಯನ್ನು ಧೃತರಾಷ್ಟ್ರನು ಬಯಸುವುದು","te":"శాంతిని ధృతరాష్ట్రుడు కోరుకుంటాడు","ta":"சமாதானத்தை திருதராஷ்டிரர் விரும்புகிறார்","ml":"ധൃതരാഷ്ട്രർ സമാധാനം ആഗ്രഹിക്കുന്നു"},"53":{"hi":"संजय धृतराष्ट्र को दोष देते हैं","kn":"ಧೃತರಾಷ್ಟ್ರನನ್ನು ಸಂಜಯನು ದೂಷಿಸುವುದು","te":"ధృతరాష్ట్రుడిని సంజయుడు నిందిస్తాడు","ta":"திருதராஷ்டிரரைச் சஞ்சயன் குற்றம் சாட்டுகிறான்","ml":"സഞ്ജയൻ ധൃതരാഷ്ട്രരെ കുറ്റപ്പെടുത്തുന്നു"},"54":{"hi":"दुर्योधन का आत्मविश्वास","kn":"ದುರ್ಯೋಧನನ ಆತ್ಮವಿಶ್ವಾಸ","te":"దుర్యోధనుడి ఆత్మవిశ్వాసం","ta":"துரியோதனனின் தன்னம்பிக்கை","ml":"ദുര്യോധനന്റെ ആത്മവിശ്വാസം"},"55":{"hi":"संजय पांडव सेना का वर्णन करते हैं","kn":"ಪಾಂಡವ ಸೇನೆಯನ್ನು ಸಂಜಯ ವರ್ಣಿಸುವುದು","te":"పాండవ సైన్యం గురించి సంజయుడి వివరణ","ta":"பாண்டவப் படையை சஞ்சயன் விவரிக்கிறான்","ml":"പാണ്ഡവസേനയെ സഞ്ജയൻ വിവരിക്കുന്നു"},"56":{"hi":"कौन किससे युद्ध करेगा","kn":"ಯಾರು ಯಾರೊಡನೆ ಹೋರಾಡುವರು","te":"ఎవరు ఎవరితో పోరాడతారు","ta":"யார் யாருடன் போரிடுவர்","ml":"ആര് ആരോടു പോരാടും"},"57":{"hi":"दुर्योधन झुकने से इनकार करता है","kn":"ಮಣಿಯಲು ದುರ್ಯೋಧನನ ನಿರಾಕರಣೆ","te":"లొంగిపోవడానికి దుర్యోధనుడు నిరాకరిస్తాడు","ta":"விட்டுக்கொடுக்க துரியோதனன் மறுக்கிறான்","ml":"ദുര്യോധനൻ വഴങ്ങാൻ വിസമ്മതിക്കുന്നു"},"58":{"hi":"संजय के द्वारा कृष्ण का संदेश","kn":"ಸಂಜಯನ ಮೂಲಕ ಕೃಷ್ಣನ ಸಂದೇಶ","te":"సంజయుడి ద్వారా కృష్ణుడి సందేశం","ta":"சஞ்சயன் வழியாகக் கிருஷ்ணனின் செய்தி","ml":"സഞ്ജയൻ മുഖേന കൃഷ്ണന്റെ സന്ദേശം"},"59":{"hi":"धृतराष्ट्र दोनों पक्षों को तौलते हैं","kn":"ಎರಡು ಪಕ್ಷಗಳನ್ನು ಧೃತರಾಷ್ಟ್ರನು ತೂಗಿ ನೋಡುವುದು","te":"రెండు పక్షాలను ధృతరాష్ట్రుడు బేరీజు వేస్తాడు","ta":"இரு தரப்பையும் திருதராஷ்டிரர் எடைபோடுகிறார்","ml":"ഇരുപക്ഷത്തെയും ധൃതരാഷ്ട്രർ തൂക്കിനോക്കുന്നു"},"60":{"hi":"दुर्योधन अपनी शक्तियों की डींग मारता है","kn":"ತನ್ನ ಶಕ್ತಿಯ ಬಗ್ಗೆ ದುರ್ಯೋಧನನ ಆತ್ಮಪ್ರಶಂಸೆ","te":"తన శక్తులను దుర్యోధనుడు గొప్పగా చెప్పుకుంటాడు","ta":"தன் வலிமை பற்றி துரியோதனனின் பெருமை","ml":"തന്റെ ശക്തിയെക്കുറിച്ച് ദുര്യോധനന്റെ വീമ്പ്"},"61":{"hi":"कर्ण शस्त्र नीचे रखते हैं","kn":"ಕರ್ಣನು ತನ್ನ ಆಯುಧಗಳನ್ನು ಕೆಳಗಿಡುವುದು","te":"కర్ణుడు ఆయుధాలు క్రింద పెడతాడు","ta":"கர்ணன் ஆயுதங்களைக் கீழே வைக்கிறான்","ml":"കർണൻ ആയുധം താഴെ വെക്കുന്നു"},"62":{"hi":"विदुर की पक्षियों की दृष्टांत-कथा","kn":"ವಿದುರನ ಪಕ್ಷಿಗಳ ಕಥೆ","te":"పక్షుల ఉపమానం చెబుతాడు విదురుడు","ta":"பறவைகளின் உவமை வழியாக விதுரர்","ml":"പക്ഷികളുടെ ഉപമ വിദുരൻ പറയുന്നു"},"63":{"hi":"धृतराष्ट्र दुर्योधन को चेतावनी देते हैं","kn":"ದುರ್ಯೋಧನನನ್ನು ಧೃತರಾಷ್ಟ್ರನು ಎಚ್ಚರಿಸುವುದು","te":"దుర్యోధనుడిని ధృతరాష్ట్రుడు హెచ్చరిస్తాడు","ta":"துரியோதனனை திருதராஷ்டிரர் எச்சரிக்கிறார்","ml":"ധൃതരാഷ്ട്രർ ദുര്യോധനന് മുന്നറിയിപ്പ് നൽകുന്നു"},"64":{"hi":"अर्जुन के अंतिम शब्द","kn":"ಅರ್ಜುನನ ಕೊನೆಯ ಮಾತುಗಳು","te":"అర్జునుడి చివరి మాటలు","ta":"அர்ஜுனனின் இறுதி வார்த்தைகள்","ml":"അർജുനന്റെ അന്ത്യവചനങ്ങൾ"},"65":{"hi":"धृतराष्ट्र कृष्ण के विषय में पूछते हैं","kn":"ಕೃಷ್ಣನ ಬಗ್ಗೆ ಧೃತರಾಷ್ಟ್ರನ ಪ್ರಶ್ನೆ","te":"కృష్ణుడి గురించి ధృతరాష్ట్రుడు అడుగుతాడు","ta":"கிருஷ்ணனைப் பற்றி திருதராஷ்டிரர் கேட்கிறார்","ml":"കൃഷ്ണനെക്കുറിച്ച് ധൃതരാഷ്ട്രർ ചോദിക്കുന്നു"},"66":{"hi":"संजय कृष्ण की महिमा बताते हैं","kn":"ಕೃಷ್ಣನ ಮಹಿಮೆಯ ಬಗ್ಗೆ ಸಂಜಯ","te":"కృష్ణుడి మహిమ గురించి సంజయుడు","ta":"கிருஷ்ணனின் மகிமை பற்றி சஞ்சயன்","ml":"കൃഷ്ണന്റെ മഹിമയെക്കുറിച്ച് സഞ്ജയൻ"},"67":{"hi":"कृष्ण की शरण लो","kn":"ಕೃಷ್ಣನಲ್ಲಿ ಶರಣಾಗುವುದು","te":"కృష్ణుడిని శరణు వేడండి","ta":"கிருஷ்ணனிடம் அடைக்கலம் புகுதல்","ml":"കൃഷ്ണനിൽ ശരണം തേടുക"},"68":{"hi":"कृष्ण के नाम","kn":"ಕೃಷ್ಣನ ನಾಮಗಳು","te":"కృష్ణుడి నామాలు","ta":"கிருஷ்ணனின் திருநாமங்கள்","ml":"കൃഷ്ണന്റെ നാമങ്ങൾ"},"69":{"hi":"धृतराष्ट्र कृष्ण को देखने की इच्छा रखते हैं","kn":"ಕೃಷ್ಣನನ್ನು ನೋಡುವ ಆಸೆ ಧೃತರಾಷ್ಟ್ರನಿಗೆ","te":"కృష్ణుడిని చూడాలని ధృతరాష్ట్రుడు ఆశిస్తాడు","ta":"கிருஷ்ணனைக் காண திருதராஷ்டிரர் ஏங்குகிறார்","ml":"കൃഷ്ണനെ കാണാൻ ധൃതരാഷ്ട്രർ ആഗ്രഹിക്കുന്നു"},"70":{"hi":"युधिष्ठिर कृष्ण से दूत बनकर जाने को कहते हैं","kn":"ರಾಯಭಾರಿಯಾಗಿ ಹೋಗಲು ಕೃಷ್ಣನನ್ನು ಯುಧಿಷ್ಠಿರ ಕೋರುವುದು","te":"రాయబారిగా వెళ్లమని కృష్ణుడిని యుధిష్ఠిరుడు కోరతాడు","ta":"தூதுவராகச் செல்லுமாறு கிருஷ்ணனிடம் யுதிட்டிரன் கேட்கிறான்","ml":"ദൂതനായി പോകണമെന്ന് യുധിഷ്ഠിരൻ കൃഷ്ണനോട് അഭ്യർഥിക്കുന്നു"},"71":{"hi":"दुर्योधन के विषय में कृष्ण का मत","kn":"ದುರ್ಯೋಧನನ ಬಗ್ಗೆ ಕೃಷ್ಣನ ಅಭಿಪ್ರಾಯ","te":"దుర్యోధనుడి గురించి కృష్ణుడి అభిప్రాయం","ta":"துரியோதனனைப் பற்றிய கிருஷ்ணனின் கருத்து","ml":"ദുര്യോധനനെക്കുറിച്ച് കൃഷ്ണന്റെ വീക്ഷണം"},"72":{"hi":"भीम शांति के पक्ष में बोलते हैं","kn":"ಶಾಂತಿಯ ಪರವಾಗಿ ಭೀಮನ ಮಾತು","te":"శాంతి కోసం భీముడు మాట్లాడతాడు","ta":"சமாதானத்திற்காக பீமன் பேசுகிறான்","ml":"സന്ധിക്കായി ഭീമൻ സംസാരിക്കുന്നു"},"73":{"hi":"कृष्ण भीम पर व्यंग्य करते हैं","kn":"ಭೀಮನನ್ನು ಕೃಷ್ಣನು ಹಂಗಿಸುವುದು","te":"భీముడిని కృష్ణుడు ఎత్తిపొడుస్తాడు","ta":"பீமனை கிருஷ்ணன் கேலி செய்கிறான்","ml":"ഭീമനെ കൃഷ്ണൻ പരിഹസിക്കുന്നു"},"74":{"hi":"भीम का क्रोधित उत्तर","kn":"ಭೀಮನ ಕೋಪದ ಉತ್ತರ","te":"భీముడి కోపపు సమాధానం","ta":"பீமனின் கோபப் பதில்","ml":"ഭീമന്റെ കോപത്തോടെയുള്ള മറുപടി"},"75":{"hi":"कृष्ण अपने व्यंग्य का कारण बताते हैं","kn":"ತನ್ನ ಹಂಗಿಸುವಿಕೆಯನ್ನು ಕೃಷ್ಣನು ವಿವರಿಸುವುದು","te":"తన ఎత్తిపొడుపును కృష్ణుడు వివరిస్తాడు","ta":"தன் கேலிக்கான விளக்கத்தை கிருஷ்ணன் அளிக்கிறான்","ml":"പരിഹാസത്തിന്റെ കാരണം കൃഷ്ണൻ വിശദീകരിക്കുന്നു"},"76":{"hi":"अर्जुन का परामर्श","kn":"ಅರ್ಜುನನ ಸಲಹೆ","te":"అర్జునుడి హితవు","ta":"அர்ஜுனனின் ஆலோசனை","ml":"അർജുനന്റെ ഉപദേശം"},"77":{"hi":"कृष्ण भाग्य और पुरुषार्थ पर","kn":"ದೈವ ಮತ್ತು ಪ್ರಯತ್ನದ ಬಗ್ಗೆ ಕೃಷ್ಣ","te":"విధి, ప్రయత్నం గురించి కృష్ణుడు","ta":"விதியும் முயற்சியும் பற்றி கிருஷ்ணன்","ml":"വിധിയെയും പ്രയത്നത്തെയും കുറിച്ച് കൃഷ്ണൻ"},"78":{"hi":"नकुल का परामर्श","kn":"ನಕುಲನ ಸಲಹೆ","te":"నకులుడి హితవు","ta":"நகுலனின் ஆலோசனை","ml":"നകുലന്റെ ഉപദേശം"},"79":{"hi":"सहदेव और सात्यकि युद्ध की माँग करते हैं","kn":"ಯುದ್ಧಕ್ಕೆ ಕರೆ ನೀಡುವ ಸಹದೇವ ಮತ್ತು ಸಾತ್ಯಕಿ","te":"సహదేవుడు, సాత్యకి యుద్ధాన్ని కోరతారు","ta":"சகதேவனும் சாத்யகியும் போரை வலியுறுத்துகின்றனர்","ml":"സഹദേവനും സാത്യകിയും യുദ്ധത്തിന് ആഹ്വാനം ചെയ്യുന്നു"},"80":{"hi":"द्रौपदी की विनती और कृष्ण की प्रतिज्ञा","kn":"ದ್ರೌಪದಿಯ ಮನವಿ ಮತ್ತು ಕೃಷ್ಣನ ಪ್ರತಿಜ್ಞೆ","te":"ద్రౌపది మొర, కృష్ణుడి ప్రతిజ్ఞ","ta":"திரௌபதியின் வேண்டுகோளும் கிருஷ்ணனின் சபதமும்","ml":"ദ്രൗപദിയുടെ അപേക്ഷയും കൃഷ്ണന്റെ പ്രതിജ്ഞയും"},"81":{"hi":"कृष्ण हस्तिनापुर के लिए प्रस्थान करते हैं","kn":"ಹಸ್ತಿನಾಪುರಕ್ಕೆ ಕೃಷ್ಣನ ಪ್ರಯಾಣ","te":"కృష్ణుడు హస్తినాపురానికి బయలుదేరతాడు","ta":"ஹஸ்தினாபுரத்திற்குக் கிருஷ்ணன் புறப்படுகிறான்","ml":"കൃഷ്ണൻ ഹസ്തിനാപുരത്തേക്ക് പുറപ്പെടുന്നു"},"82":{"hi":"कृष्ण की यात्रा","kn":"ಕೃಷ್ಣನ ಪ್ರಯಾಣದ ಹಾದಿ","te":"కృష్ణుడి ప్రయాణం","ta":"கிருஷ்ணனின் பயணம்","ml":"കൃഷ്ണന്റെ യാത്ര"},"83":{"hi":"कृष्ण के लिए विश्राम-गृह तैयार होते हैं","kn":"ಕೃಷ್ಣನಿಗಾಗಿ ವಿಶ್ರಾಂತಿ ಗೃಹಗಳ ಸಿದ್ಧತೆ","te":"కృష్ణుడి కోసం విడిది గృహాలు సిద్ధమవుతాయి","ta":"கிருஷ்ணனுக்காக தங்குமிடங்கள் அமைக்கப்படுகின்றன","ml":"കൃഷ്ണന് വിശ്രമകേന്ദ്രങ്ങൾ ഒരുക്കുന്നു"},"84":{"hi":"धृतराष्ट्र कृष्ण के लिए उपहारों की योजना बनाते हैं","kn":"ಕೃಷ್ಣನಿಗೆ ಉಡುಗೊರೆಗಳ ಯೋಜನೆ ಧೃತರಾಷ್ಟ್ರನದು","te":"కృష్ణుడికి కానుకలు ఇవ్వాలని ధృతరాష్ట్రుడి పథకం","ta":"கிருஷ்ணனுக்குப் பரிசுகளைத் திருதராஷ்டிரர் திட்டமிடுகிறார்","ml":"കൃഷ്ണന് സമ്മാനങ്ങൾ നൽകാൻ ധൃതരാഷ്ട്രർ പദ്ധതിയിടുന്നു"},"85":{"hi":"विदुर: कृष्ण को खरीदा नहीं जा सकता","kn":"ಕೃಷ್ಣನನ್ನು ಕೊಳ್ಳಲಾಗದು ಎಂದು ವಿದುರ","te":"విదురుడు: కృష్ణుడిని కొనలేము","ta":"கிருஷ்ணனை விலைக்கு வாங்க முடியாது என்கிறார் விதுரர்","ml":"വിദുരൻ: കൃഷ്ണനെ വിലയ്ക്കുവാങ്ങാനാവില്ല"},"86":{"hi":"दुर्योधन कृष्ण को बंदी बनाने की योजना बनाता है","kn":"ಕೃಷ್ಣನನ್ನು ಬಂಧಿಸಲು ದುರ್ಯೋಧನನ ಯೋಜನೆ","te":"కృష్ణుడిని బంధించాలని దుర్యోధనుడి పథకం","ta":"கிருஷ்ணனைச் சிறைப்பிடிக்கத் துரியோதனன் திட்டமிடுகிறான்","ml":"കൃഷ്ണനെ ബന്ധിക്കാൻ ദുര്യോധനൻ പദ്ധതിയിടുന്നു"},"87":{"hi":"कृष्ण हस्तिनापुर में प्रवेश करते हैं","kn":"ಹಸ್ತಿನಾಪುರ ಪ್ರವೇಶಿಸುವ ಕೃಷ್ಣ","te":"కృష్ణుడు హస్తినాపురంలో ప్రవేశిస్తాడు","ta":"ஹஸ்தினாபுரத்திற்குள் கிருஷ்ணன் நுழைகிறான்","ml":"കൃഷ്ണൻ ഹസ്തിനാപുരത്തിൽ പ്രവേശിക്കുന്നു"},"88":{"hi":"कृष्ण कुंती से मिलते हैं","kn":"ಕುಂತಿಯನ್ನು ಕೃಷ್ಣನು ಭೇಟಿಯಾಗುವುದು","te":"కృష్ణుడు కుంతిని కలుస్తాడు","ta":"குந்தியைக் கிருஷ்ணன் சந்திக்கிறான்","ml":"കൃഷ്ണൻ കുന്തിയെ കാണുന്നു"},"89":{"hi":"कृष्ण दुर्योधन का भोजन अस्वीकार करते हैं","kn":"ದುರ್ಯೋಧನನ ಭೋಜನವನ್ನು ಕೃಷ್ಣನು ನಿರಾಕರಿಸುವುದು","te":"దుర్యోధనుడి భోజనాన్ని కృష్ణుడు తిరస్కరిస్తాడు","ta":"துரியோதனனின் விருந்தை கிருஷ்ணன் மறுக்கிறான்","ml":"ദുര്യോധനന്റെ ഭക്ഷണം കൃഷ്ണൻ നിരസിക്കുന്നു"},"90":{"hi":"विदुर कृष्ण को चेतावनी देते हैं","kn":"ಕೃಷ್ಣನನ್ನು ವಿದುರ ಎಚ್ಚರಿಸುವುದು","te":"కృష్ణుడిని విదురుడు హెచ్చరిస్తాడు","ta":"கிருஷ்ணனை விதுரர் எச்சரிக்கிறார்","ml":"വിദുരൻ കൃഷ്ണന് മുന്നറിയിപ്പ് നൽകുന്നു"},"91":{"hi":"कृष्ण का विदुर को उत्तर","kn":"ವಿದುರನಿಗೆ ಕೃಷ್ಣನ ಉತ್ತರ","te":"విదురుడికి కృష్ణుడి సమాధానం","ta":"விதுரருக்குக் கிருஷ்ணனின் பதில்","ml":"വിദുരന് കൃഷ്ണന്റെ മറുപടി"},"92":{"hi":"कृष्ण सभा में जाते हैं","kn":"ಕೃಷ್ಣನು ಸಭೆಗೆ ಹೋಗುವುದು","te":"కృష్ణుడు సభకు వెళ్తాడు","ta":"சபைக்குக் கிருஷ்ணன் செல்கிறான்","ml":"കൃഷ്ണൻ സഭയിലേക്ക് പോകുന്നു"},"93":{"hi":"सभा में कृष्ण की अपील","kn":"ಸಭೆಯಲ್ಲಿ ಕೃಷ್ಣನ ಮನವಿ","te":"సభలో కృష్ణుడి విజ్ఞప్తి","ta":"சபையில் கிருஷ்ணனின் வேண்டுகோள்","ml":"സഭയിൽ കൃഷ്ണന്റെ അഭ്യർഥന"},"94":{"hi":"परशुराम की दंभोद्भव की कथा","kn":"ದಂಭೋದ್ಭವನ ಕುರಿತ ಪರಶುರಾಮರ ಕಥೆ","te":"దంభోద్భవుడి కథ చెబుతాడు పరశురాముడు","ta":"தம்போத்பவனின் கதையைச் சொல்லும் பரசுராமர்","ml":"ദംഭോദ്ഭവന്റെ കഥ പരശുരാമൻ പറയുന്നു"},"95":{"hi":"कण्व मातलि की कथा आरंभ करते हैं","kn":"ಮಾತಲಿಯ ಕಥೆಯನ್ನು ಕಣ್ವರು ಆರಂಭಿಸುವುದು","te":"మాతలి కథను కణ్వుడు మొదలుపెడతాడు","ta":"மாதலியின் கதையை கண்வர் தொடங்குகிறார்","ml":"മാതലിയുടെ കഥ കണ്വൻ ആരംഭിക്കുന്നു"},"96":{"hi":"वरुण के लोक में मातलि और नारद","kn":"ವರುಣಲೋಕದಲ್ಲಿ ಮಾತಲಿ ಮತ್ತು ನಾರದರು","te":"వరుణ లోకంలో మాతలి, నారదుడు","ta":"வருணனின் உலகில் மாதலியும் நாரதரும்","ml":"വരുണലോകത്ത് മാതലിയും നാരദനും"},"97":{"hi":"पाताल नगरी","kn":"ಪಾತಾಳ ನಗರ","te":"పాతాళ నగరం","ta":"பாதாளத்தின் நகரம்","ml":"പാതാളനഗരം"},"98":{"hi":"हिरण्यपुर","kn":"ಹಿರಣ್ಯಪುರ","te":"హిరణ్యపురం","ta":"ஹிரண்யபுரம்","ml":"ഹിരണ്യപുരം"},"99":{"hi":"सुपर्णों का लोक","kn":"ಸುಪರ್ಣರ ಲೋಕ","te":"సుపర్ణుల లోకం","ta":"சுபர்ணர்களின் உலகம்","ml":"സുപർണരുടെ ലോകം"},"100":{"hi":"रसातल और गौ सुरभि","kn":"ರಸಾತಲ ಮತ್ತು ಸುರಭಿ ಧೇನು","te":"రసాతలం, సురభి ఆవు","ta":"ரசாதலமும் சுரபி பசுவும்","ml":"രസാതലവും സുരഭിപ്പശുവും"},"101":{"hi":"भोगवती और नाग सुमुख","kn":"ಭೋಗವತಿ ಮತ್ತು ಸರ್ಪ ಸುಮುಖ","te":"భోగవతి, సర్పం సుముఖుడు","ta":"போகவதியும் நாகன் சுமுகனும்","ml":"ഭോഗവതിയും സർപ്പം സുമുഖനും"},"102":{"hi":"सुमुख का विनाश और इंद्र का वरदान","kn":"ಸುಮುಖನ ವಿನಾಶ ಮತ್ತು ಇಂದ್ರನ ವರ","te":"సుముఖుడికి శాపం, ఇంద్రుడి వరం","ta":"சுமுகனின் அழிவும் இந்திரனின் வரமும்","ml":"സുമുഖന്റെ നാശവും ഇന്ദ്രന്റെ വരദാനവും"},"103":{"hi":"गरुड़ का गर्व टूटता है","kn":"ಗರುಡನ ಗರ್ವ ಮುರಿಯುವುದು","te":"గరుత్మంతుడి గర్వం అణగుతుంది","ta":"கருடனின் செருக்கு அடக்கப்படுகிறது","ml":"ഗരുഡന്റെ അഹങ്കാരം ശമിക്കുന്നു"},"104":{"hi":"गालव की गुरु-दक्षिणा","kn":"ಗಾಲವನ ಗುರುದಕ್ಷಿಣೆ","te":"గాలవుడి గురుదక్షిణ","ta":"காலவரின் குருதட்சிணை","ml":"ഗാലവന്റെ ഗുരുദക്ഷിണ"},"105":{"hi":"गालव की निराशा","kn":"ಗಾಲವನ ನಿರಾಶೆ","te":"గాలవుడి నిరాశ","ta":"காலவரின் விரக்தி","ml":"ഗാലവന്റെ നിരാശ"},"106":{"hi":"गरुड़ पूर्व दिशा का वर्णन करते हैं","kn":"ಪೂರ್ವ ದಿಕ್ಕನ್ನು ಗರುಡ ವರ್ಣಿಸುವುದು","te":"తూర్పు దిక్కును గరుడుడు వివరిస్తాడు","ta":"கிழக்கைப் பற்றி கருடன் விவரிக்கிறான்","ml":"ഗരുഡൻ കിഴക്കിനെ വിവരിക്കുന്നു"},"107":{"hi":"गरुड़ दक्षिण दिशा का वर्णन करते हैं","kn":"ದಕ್ಷಿಣ ದಿಕ್ಕನ್ನು ಗರುಡ ವರ್ಣಿಸುವುದು","te":"దక్షిణ దిక్కును గరుడుడు వివరిస్తాడు","ta":"தெற்கைப் பற்றி கருடன் விவரிக்கிறான்","ml":"ഗരുഡൻ തെക്കിനെ വിവരിക്കുന്നു"},"108":{"hi":"गरुड़ पश्चिम दिशा का वर्णन करते हैं","kn":"ಪಶ್ಚಿಮ ದಿಕ್ಕನ್ನು ಗರುಡ ವರ್ಣಿಸುವುದು","te":"పశ్చిమ దిక్కును గరుడుడు వివరిస్తాడు","ta":"மேற்கைப் பற்றி கருடன் விவரிக்கிறான்","ml":"ഗരുഡൻ പടിഞ്ഞാറിനെ വിവരിക്കുന്നു"},"109":{"hi":"गरुड़ उत्तर दिशा का वर्णन करते हैं","kn":"ಉತ್ತರ ದಿಕ್ಕನ್ನು ಗರುಡ ವರ್ಣಿಸುವುದು","te":"ఉత్తర దిక్కును గరుడుడు వివరిస్తాడు","ta":"வடக்கைப் பற்றி கருடன் விவரிக்கிறான்","ml":"ഗരുഡൻ വടക്കിനെ വിവരിക്കുന്നു"},"110":{"hi":"पूर्व दिशा की उड़ान","kn":"ಪೂರ್ವ ದಿಕ್ಕಿನತ್ತ ಹಾರಾಟ","te":"తూర్పు దిక్కుకు ప్రయాణం","ta":"கிழக்கு நோக்கிய பறப்பு","ml":"കിഴക്കോട്ടുള്ള പറക്കൽ"},"111":{"hi":"गरुड़ और तपस्विनी शाण्डिली","kn":"ಗರುಡ ಮತ್ತು ತಪಸ್ವಿನಿ ಶಾಂಡಿಲಿ","te":"గరుడుడు, తపస్వి శాండిలి","ta":"கருடனும் துறவி சாண்டிலியும்","ml":"ഗരുഡനും തപസ്വിനിയായ ശാണ്ഡിലിയും"},"112":{"hi":"गालव राजा ययाति के पास जाते हैं","kn":"ರಾಜ ಯಯಾತಿಯ ಬಳಿಗೆ ಗಾಲವ ಹೋಗುವುದು","te":"గాలవుడు యయాతి రాజు వద్దకు వెళ్తాడు","ta":"யயாதி மன்னனிடம் காலவர் செல்கிறார்","ml":"ഗാലവൻ യയാതിരാജാവിന്റെ അടുത്തേക്ക് പോകുന്നു"},"113":{"hi":"ययाति अपनी पुत्री माधवी को देते हैं","kn":"ಯಯಾತಿಯು ತನ್ನ ಮಗಳು ಮಾಧವಿಯನ್ನು ನೀಡುವುದು","te":"యయాతి తన కుమార్తె మాధవిని ఇస్తాడు","ta":"தன் மகள் மாதவியை யயாதி அளிக்கிறான்","ml":"യയാതി മകൾ മാധവിയെ നൽകുന്നു"},"114":{"hi":"माधवी और हर्यश्व","kn":"ಮಾಧವಿ ಮತ್ತು ಹರ್ಯಶ್ವ","te":"మాధవి, హర్యశ్వుడు","ta":"மாதவியும் ஹர்யஸ்வனும்","ml":"മാധവിയും ഹര്യശ്വനും"},"115":{"hi":"माधवी और दिवोदास","kn":"ಮಾಧವಿ ಮತ್ತು ದಿವೋದಾಸ","te":"మాధవి, దివోదాసుడు","ta":"மாதவியும் திவோதாசனும்","ml":"മാധവിയും ദിവോദാസനും"},"116":{"hi":"माधवी और उशीनर","kn":"ಮಾಧವಿ ಮತ್ತು ಉಶೀನರ","te":"మాధవి, ఉశీనరుడు","ta":"மாதவியும் உசீநரனும்","ml":"മാധവിയും ഉശീനരനും"},"117":{"hi":"गालव अपनी गुरु-दक्षिणा चुकाते हैं","kn":"ಗಾಲವನು ಗುರುದಕ್ಷಿಣೆ ಸಲ್ಲಿಸುವುದು","te":"గాలవుడు గురుదక్షిణ చెల్లిస్తాడు","ta":"காலவர் குருதட்சிணையைச் செலுத்துகிறார்","ml":"ഗാലവൻ ഗുരുദക്ഷിണ നൽകുന്നു"},"118":{"hi":"माधवी वन को चुनती है","kn":"ಕಾಡನ್ನು ಮಾಧವಿ ಆಯ್ಕೆಮಾಡುವುದು","te":"మాధవి అరణ్యాన్ని ఎంచుకుంటుంది","ta":"காட்டைத் தேர்ந்தெடுக்கிறாள் மாதவி","ml":"മാധവി വനം തിരഞ്ഞെടുക്കുന്നു"},"119":{"hi":"ययाति अपने पौत्रों के बीच गिरते हैं","kn":"ಮೊಮ್ಮಕ್ಕಳ ನಡುವೆ ಯಯಾತಿಯ ಪತನ","te":"మనవల మధ్య యయాతి పడిపోతాడు","ta":"பேரன்களிடையே யயாதி வீழ்கிறான்","ml":"യയാതി പേരക്കുട്ടികൾക്കിടയിലേക്ക് വീഴുന്നു"},"120":{"hi":"ययाति स्वर्ग में पुनः प्रतिष्ठित होते हैं","kn":"ಯಯಾತಿ ಸ್ವರ್ಗಕ್ಕೆ ಪುನಃ ಸೇರುವುದು","te":"యయాతి స్వర్గానికి తిరిగి చేరుకుంటాడు","ta":"யயாதி மீண்டும் சொர்க்கத்திற்கு உயர்த்தப்படுகிறான்","ml":"യയാതി സ്വർഗത്തിലേക്ക് തിരിച്ചെത്തുന്നു"},"121":{"hi":"अहंकार का पतन","kn":"ಗರ್ವದ ಪತನ","te":"గర్వం పతనం","ta":"செருக்கின் வீழ்ச்சி","ml":"അഹങ്കാരത്തിന്റെ പതനം"},"122":{"hi":"कृष्ण दुर्योधन को परामर्श देते हैं","kn":"ದುರ್ಯೋಧನನಿಗೆ ಕೃಷ್ಣನ ಸಲಹೆ","te":"దుర్యోధనుడికి కృష్ణుడి హితవు","ta":"துரியோதனனுக்குக் கிருஷ்ணன் அறிவுரை கூறுகிறான்","ml":"ദുര്യോധനന് കൃഷ്ണൻ ഉപദേശം നൽകുന്നു"},"123":{"hi":"भीष्म और द्रोण दुर्योधन से आग्रह करते हैं","kn":"ದುರ್ಯೋಧನನನ್ನು ಭೀಷ್ಮ ಮತ್ತು ದ್ರೋಣರು ಒತ್ತಾಯಿಸುವುದು","te":"దుర్యోధనుడిని భీష్ముడు, ద్రోణుడు ప్రోత్సహిస్తారు","ta":"துரியோதனனை பீஷ்மரும் துரோணரும் வலியுறுத்துகின்றனர்","ml":"ഭീഷ്മരും ദ്രോണരും ദുര്യോധനനോട് അഭ്യർഥിക്കുന്നു"},"124":{"hi":"बड़ों की अंतिम विनती","kn":"ಹಿರಿಯರ ಕೊನೆಯ ಮನವಿ","te":"పెద్దల చివరి విజ్ఞప్తి","ta":"பெரியோர்களின் இறுதி வேண்டுகோள்","ml":"മുതിർന്നവരുടെ അവസാന അഭ്യർഥന"},"125":{"hi":"सुई की नोक भर भूमि भी नहीं","kn":"ಸೂಜಿಮೊನೆಯಷ್ಟು ಭೂಮಿಯೂ ಇಲ್ಲ","te":"సూది మొన మోపంత భూమి కూడా కాదు","ta":"ஊசி முனையளவு நிலம்கூட இல்லை","ml":"സൂചിമുനയോളം ഭൂമിപോലും"},"126":{"hi":"कृष्ण दुर्योधन की निंदा करते हैं","kn":"ದುರ್ಯೋಧನನನ್ನು ಕೃಷ್ಣನು ಖಂಡಿಸುವುದು","te":"దుర్యోధనుడిని కృష్ణుడు ఖండిస్తాడు","ta":"துரியோதனனை கிருஷ்ணன் கண்டிக்கிறான்","ml":"ദുര്യോധനനെ കൃഷ്ണൻ അപലപിക്കുന്നു"},"127":{"hi":"गांधारी का परामर्श","kn":"ಗಾಂಧಾರಿಯ ಸಲಹೆ","te":"గాంధారి హితవు","ta":"காந்தாரியின் ஆலோசனை","ml":"ഗാന്ധാരിയുടെ ഉപദേശം"},"128":{"hi":"कृष्ण को बंदी बनाने का षड्यंत्र","kn":"ಕೃಷ್ಣನನ್ನು ಬಂಧಿಸುವ ಸಂಚು","te":"కృష్ణుడిని బంధించే పథకం","ta":"கிருஷ்ணனைச் சிறைப்பிடிக்கும் சதி","ml":"കൃഷ്ണനെ ബന്ധിക്കാനുള്ള ഗൂഢാലോചന"},"129":{"hi":"कृष्ण का विश्वरूप","kn":"ಕೃಷ್ಣನ ವಿಶ್ವರೂಪ","te":"కృష్ణుడి విశ్వరూపం","ta":"கிருஷ்ணனின் விஸ்வரூபம்","ml":"കൃഷ്ണന്റെ വിശ്വരൂപം"},"130":{"hi":"कुंती का संदेश: क्षत्रिय का कर्तव्य","kn":"ಕ್ಷತ್ರಿಯ ಧರ್ಮ: ಕುಂತಿಯ ಸಂದೇಶ","te":"కుంతి సందేశం: క్షత్రియుడి ధర్మం","ta":"க்ஷத்திரியனின் கடமை: குந்தியின் செய்தி","ml":"ക്ഷത്രിയധർമത്തെക്കുറിച്ച് കുന്തിയുടെ സന്ദേശം"},"131":{"hi":"विदुला अपने पुत्र को जगाती है","kn":"ವಿದುಲೆಯು ತನ್ನ ಮಗನನ್ನು ಎಚ್ಚರಿಸುವುದು","te":"విదుల తన కుమారుడిని ప్రేరేపిస్తుంది","ta":"தன் மகனை விதுலை எழுப்புகிறாள்","ml":"മകനെ വിദുല ഉണർത്തുന്നു"},"132":{"hi":"विदुला का प्रोत्साहन जारी","kn":"ವಿದುಲೆಯ ಪ್ರೋತ್ಸಾಹದ ಮಾತು ಮುಂದುವರಿಕೆ","te":"విదుల ప్రబోధం కొనసాగింపు","ta":"விதுலையின் உற்சாக வார்த்தைகள் தொடர்கின்றன","ml":"വിദുലയുടെ ഉപദേശം തുടരുന്നു"},"133":{"hi":"संजय अपनी माता को उत्तर देते हैं","kn":"ತಾಯಿಗೆ ಸಂಜಯನ ಉತ್ತರ","te":"తల్లికి సంజయుడు సమాధానం ఇస్తాడు","ta":"தன் தாய்க்குச் சஞ்சயன் பதிலளிக்கிறான்","ml":"സഞ്ജയൻ അമ്മയ്ക്ക് മറുപടി നൽകുന്നു"},"134":{"hi":"संजय जागृत होते हैं","kn":"ಸಂಜಯನು ಎಚ್ಚರಗೊಳ್ಳುವುದು","te":"సంజయుడు మేల్కొల్పబడతాడు","ta":"சஞ்சயன் எழுச்சி பெறுகிறான்","ml":"സഞ്ജയൻ ഉണർവ് നേടുന്നു"},"135":{"hi":"कुंती के अपने पुत्रों को संदेश","kn":"ಮಕ್ಕಳಿಗೆ ಕುಂತಿಯ ಸಂದೇಶಗಳು","te":"కుంతి తన కుమారులకు సందేశాలు పంపుతుంది","ta":"தன் மகன்களுக்குக் குந்தியின் செய்திகள்","ml":"മക്കൾക്കുള്ള കുന്തിയുടെ സന്ദേശങ്ങൾ"},"136":{"hi":"भीष्म और द्रोण फिर विनती करते हैं","kn":"ಭೀಷ್ಮ ಮತ್ತು ದ್ರೋಣರ ಮತ್ತೆ ಮನವಿ","te":"భీష్ముడు, ద్రోణుడు మళ్ళీ వేడుకుంటారు","ta":"பீஷ்மரும் துரோணரும் மீண்டும் வேண்டுகின்றனர்","ml":"ഭീഷ്മരും ദ്രോണരും വീണ്ടും അപേക്ഷിക്കുന്നു"},"137":{"hi":"द्रोण की अंतिम चेतावनी","kn":"ದ್ರೋಣರ ಕೊನೆಯ ಎಚ್ಚರಿಕೆ","te":"ద్రోణుడి తుది హెచ్చరిక","ta":"துரோணரின் இறுதி எச்சரிக்கை","ml":"ദ്രോണരുടെ അവസാന മുന്നറിയിപ്പ്"},"138":{"hi":"कृष्ण कर्ण का जन्म प्रकट करते हैं","kn":"ಕರ್ಣನ ಜನ್ಮರಹಸ್ಯವನ್ನು ಕೃಷ್ಣನು ಬಹಿರಂಗಪಡಿಸುವುದು","te":"కర్ణుడి జన్మ రహస్యాన్ని కృష్ణుడు వెల్లడిస్తాడు","ta":"கர்ணனின் பிறப்பை கிருஷ்ணன் வெளிப்படுத்துகிறான்","ml":"കർണന്റെ ജനനം കൃഷ്ണൻ വെളിപ്പെടുത്തുന്നു"},"139":{"hi":"कर्ण इनकार करते हैं","kn":"ಕರ್ಣನ ನಿರಾಕರಣೆ","te":"కర్ణుడు నిరాకరిస్తాడు","ta":"கர்ணன் மறுக்கிறான்","ml":"കർണൻ വിസമ്മതിക്കുന്നു"},"140":{"hi":"कर्ण को कृष्ण का उत्तर","kn":"ಕರ್ಣನಿಗೆ ಕೃಷ್ಣನ ಉತ್ತರ","te":"కర్ణుడికి కృష్ణుడి సమాధానం","ta":"கர்ணனுக்குக் கிருஷ்ணனின் பதில்","ml":"കർണന് കൃഷ്ണന്റെ മറുപടി"},"141":{"hi":"कर्ण का विनाश का स्वप्न","kn":"ಕರ್ಣನ ವಿನಾಶದ ಕನಸು","te":"వినాశనం గురించి కర్ణుడి కల","ta":"கர்ணனின் அழிவுக் கனவு","ml":"കർണന്റെ നാശത്തെക്കുറിച്ചുള്ള സ്വപ്നം"},"142":{"hi":"कुंती कर्ण के पास जाती हैं","kn":"ಕರ್ಣನ ಬಳಿಗೆ ಕುಂತಿ ಹೋಗುವುದು","te":"కర్ణుడి వద్దకు కుంతి వెళ్తుంది","ta":"கர்ணனிடம் குந்தி செல்கிறாள்","ml":"കുന്തി കർണന്റെ അടുത്തേക്ക് പോകുന്നു"},"143":{"hi":"कुंती कर्ण के सामने स्वयं को प्रकट करती हैं","kn":"ಕರ್ಣನಿಗೆ ಕುಂತಿ ತನ್ನ ಪರಿಚಯ ನೀಡುವುದು","te":"కర్ణుడికి కుంతి తన గుర్తింపును వెల్లడిస్తుంది","ta":"தன்னை கர்ணனுக்கு குந்தி வெளிப்படுத்துகிறாள்","ml":"കർണന് കുന്തി തന്നെത്തന്നെ വെളിപ്പെടുത്തുന്നു"},"144":{"hi":"कर्ण का कुंती को वचन","kn":"ಕುಂತಿಗೆ ಕರ್ಣನ ವಾಗ್ದಾನ","te":"కుంతికి కర్ణుడి వాగ్దానం","ta":"குந்திக்குக் கர்ணனின் வாக்குறுதி","ml":"കുന്തിക്ക് കർണന്റെ വാഗ്ദാനം"},"145":{"hi":"कृष्ण पांडवों को भीष्म के वचन बताते हैं","kn":"ಭೀಷ್ಮರ ಮಾತುಗಳನ್ನು ಪಾಂಡವರಿಗೆ ಕೃಷ್ಣನು ತಿಳಿಸುವುದು","te":"భీష్ముడి మాటలను పాండవులకు కృష్ణుడు నివేదిస్తాడు","ta":"பீஷ்மரின் சொற்களைப் பாண்டவர்களுக்குக் கிருஷ்ணன் அறிவிக்கிறான்","ml":"പാണ്ഡവരോട് കൃഷ്ണൻ റിപ്പോർട്ട് ചെയ്യുന്നു: ഭീഷ്മരുടെ വാക്കുകൾ"},"146":{"hi":"द्रोण और विदुर के वचन","kn":"ದ್ರೋಣ ಮತ್ತು ವಿದುರರ ಮಾತುಗಳು","te":"ద్రోణుడి, విదురుడి మాటలు","ta":"துரோணரினதும் விதுரரினதும் சொற்கள்","ml":"ദ്രോണരുടെയും വിദുരന്റെയും വാക്കുകൾ"},"147":{"hi":"धृतराष्ट्र सिंहासन का इतिहास बताते हैं","kn":"ಸಿಂಹಾಸನದ ಇತಿಹಾಸವನ್ನು ಧೃತರಾಷ್ಟ್ರ ಹೇಳುವುದು","te":"సింహాసనం చరిత్రను ధృతరాష్ట్రుడు చెబుతాడు","ta":"அரியணையின் வரலாற்றை திருதராஷ்டிரர் கூறுகிறார்","ml":"സിംഹാസനത്തിന്റെ ചരിത്രം ധൃതരാഷ്ട്രർ പറയുന്നു"},"148":{"hi":"युद्ध के बिना राज्य नहीं","kn":"ಯುದ್ಧವಿಲ್ಲದೆ ರಾಜ್ಯವಿಲ್ಲ","te":"యుద్ధం లేకుండా రాజ్యం లేదు","ta":"போரின்றி அரசில்லை","ml":"യുദ്ധമില്ലാതെ രാജ്യമില്ല"},"149":{"hi":"सेनापति का चुनाव","kn":"ಸೇನಾಧಿಪತಿಯ ಆಯ್ಕೆ","te":"సేనాధిపతి ఎంపిక","ta":"படைத்தலைவரின் தேர்வு","ml":"സേനാപതിയുടെ തിരഞ്ഞെടുപ്പ്"},"150":{"hi":"दुर्योधन युद्ध की तैयारी करता है","kn":"ಯುದ್ಧಕ್ಕೆ ದುರ್ಯೋಧನನ ಸಿದ್ಧತೆ","te":"యుద్ధానికి దుర్యోధనుడు సన్నద్ధమవుతాడు","ta":"போருக்குத் துரியோதனன் ஆயத்தமாகிறான்","ml":"ദുര്യോധനൻ യുദ്ധത്തിന് ഒരുങ്ങുന്നു"},"151":{"hi":"युधिष्ठिर के संदेह और कृष्ण का उत्तर","kn":"ಯುಧಿಷ್ಠಿರನ ಸಂದೇಹ ಮತ್ತು ಕೃಷ್ಣನ ಉತ್ತರ","te":"యుధిష్ఠిరుడి సందేహాలు, కృష్ణుడి సమాధానం","ta":"யுதிட்டிரனின் ஐயமும் கிருஷ்ணனின் பதிலும்","ml":"യുധിഷ്ഠിരന്റെ സംശയവും കൃഷ്ണന്റെ മറുപടിയും"},"152":{"hi":"कौरव सेना की व्यूह-रचना","kn":"ಕೌರವ ಸೇನೆಯ ವ್ಯೂಹರಚನೆ","te":"కౌరవ సైన్యం వ్యూహంలో నిలుస్తుంది","ta":"கௌரவப் படை அணிவகுக்கிறது","ml":"കൗരവസേനയുടെ വ്യൂഹരചന"},"153":{"hi":"भीष्म सेनापति बनाए जाते हैं","kn":"ಭೀಷ್ಮರು ಸೇನಾಧಿಪತಿಯಾಗುವುದು","te":"భీష్ముడు సేనాధిపతిగా నియమితుడవుతాడు","ta":"பீஷ்மர் படைத்தலைவராக்கப்படுகிறார்","ml":"ഭീഷ്മർ സേനാപതിയാകുന്നു"},"154":{"hi":"बलराम तीर्थयात्रा पर जाते हैं","kn":"ತೀರ್ಥಯಾತ್ರೆಗೆ ಬಲರಾಮನ ಪ್ರಯಾಣ","te":"బలరాముడు తీర్థయాత్రకు వెళ్తాడు","ta":"புனிதப் பயணம் செல்கிறான் பலராமன்","ml":"ബലരാമൻ തീർഥയാത്ര പോകുന്നു"},"155":{"hi":"दोनों पक्षों द्वारा रुक्मी का अस्वीकार","kn":"ಎರಡೂ ಕಡೆಯವರಿಂದ ರುಕ್ಮಿಯ ತಿರಸ್ಕಾರ","te":"రెండు పక్షాలూ రుక్మిని తిరస్కరిస్తాయి","ta":"இரு தரப்பாலும் ருக்மி நிராகரிக்கப்படுகிறான்","ml":"രുക്മിയെ ഇരുപക്ഷവും തള്ളുന്നു"},"156":{"hi":"सेनाएँ आमने-सामने","kn":"ಸೇನೆಗಳು ಮುಖಾಮುಖಿಯಾಗುವುದು","te":"సైన్యాలు ఒకదానికొకటి ఎదురుగా నిలుస్తాయి","ta":"படைகள் ஒன்றையொன்று எதிர்கொள்கின்றன","ml":"സേനകൾ പരസ്പരം അഭിമുഖീകരിക്കുന്നു"},"157":{"hi":"दुर्योधन उलूक को भेजता है","kn":"ಉಲೂಕನನ್ನು ದುರ್ಯೋಧನನು ಕಳುಹಿಸುವುದು","te":"దుర్యోధనుడు ఉలూకుడిని పంపుతాడు","ta":"உலூகனை துரியோதனன் அனுப்புகிறான்","ml":"ദുര്യോധനൻ ഉലൂകനെ അയക്കുന്നു"},"158":{"hi":"उलूक व्यंग्य सुनाता है","kn":"ಉಲೂಕನು ಹಂಗಿಸುವ ಮಾತುಗಳನ್ನು ನುಡಿಯುವುದು","te":"ఉలూకుడు ఎగతాళి మాటలు చెబుతాడు","ta":"உலூகன் இகழ்ச்சி வார்த்தைகளைச் சொல்கிறான்","ml":"ഉലൂകൻ പരിഹാസവാക്കുകൾ അറിയിക്കുന്നു"},"159":{"hi":"अर्जुन का उलूक को उत्तर","kn":"ಉಲೂಕನಿಗೆ ಅರ್ಜುನನ ಉತ್ತರ","te":"ఉలూకుడికి అర్జునుడి సమాధానం","ta":"உலூகனுக்கு அர்ஜுனனின் பதில்","ml":"ഉലൂകന് അർജുനന്റെ മറുപടി"},"160":{"hi":"पांडवों के दुर्योधन को उत्तर","kn":"ದುರ್ಯೋಧನನಿಗೆ ಪಾಂಡವರ ಉತ್ತರಗಳು","te":"దుర్యోధనుడికి పాండవుల సమాధానాలు","ta":"துரியோதனனுக்குப் பாண்டவர்களின் பதில்கள்","ml":"ദുര്യോധനന് പാണ്ഡവരുടെ മറുപടികൾ"},"161":{"hi":"पांडव सेना की व्यूह-रचना","kn":"ಪಾಂಡವ ಸೇನೆಯ ನಿಯೋಜನೆ","te":"పాండవ సైన్యం వ్యూహంలో నిలుస్తుంది","ta":"பாண்டவப் படை நிறுத்தப்படுகிறது","ml":"പാണ്ഡവസേനയുടെ വിന്യാസം"},"162":{"hi":"भीष्म कौरव योद्धाओं की गिनती करते हैं","kn":"ಕೌರವ ವೀರರನ್ನು ಭೀಷ್ಮರು ಎಣಿಸುವುದು","te":"కౌరవ యోధులను భీష్ముడు లెక్కిస్తాడు","ta":"கௌரவ வீரர்களை பீஷ்மர் எண்ணுகிறார்","ml":"കൗരവ യോദ്ധാക്കളെ ഭീഷ്മർ എണ്ണുന്നു"},"163":{"hi":"भीष्म और कौरव योद्धाओं की गिनती","kn":"ಇನ್ನಷ್ಟು ಕೌರವ ವೀರರನ್ನು ಭೀಷ್ಮರು ಎಣಿಸುವುದು","te":"మరిన్ని కౌరవ యోధులను భీష్ముడు లెక్కిస్తాడు","ta":"மேலும் கௌரவ வீரர்களை பீஷ்மர் எண்ணுகிறார்","ml":"കൂടുതൽ കൗരവ യോദ്ധാക്കളെ ഭീഷ്മർ എണ്ണുന്നു"},"164":{"hi":"भीष्म महान योद्धाओं की गिनती करते हैं","kn":"ಮಹಾರಥಿಗಳನ್ನು ಭೀಷ್ಮರು ಎಣಿಸುವುದು","te":"గొప్ప యోధులను భీష్ముడు లెక్కిస్తాడు","ta":"பெரும் வீரர்களை பீஷ்மர் எண்ணுகிறார்","ml":"മഹായോദ്ധാക്കളെ ഭീഷ്മർ എണ്ണുന്നു"},"165":{"hi":"कर्ण को आधा योद्धा माना जाता है","kn":"ಅರ್ಧ ರಥಿಕನೆಂದು ಕರ್ಣನ ಮೌಲ್ಯಮಾಪನ","te":"కర్ణుడిని అర్ధ యోధుడిగా లెక్కిస్తారు","ta":"அரை வீரனாக கர்ணன் மதிப்பிடப்படுகிறான்","ml":"അർധരഥനായി കർണനെ വിലയിരുത്തുന്നു"},"166":{"hi":"भीष्म पांडव योद्धाओं की गिनती करते हैं","kn":"ಪಾಂಡವ ವೀರರನ್ನು ಭೀಷ್ಮರು ಎಣಿಸುವುದು","te":"పాండవ యోధులను భీష్ముడు లెక్కిస్తాడు","ta":"பாண்டவ வீரர்களை பீஷ்மர் எண்ணுகிறார்","ml":"പാണ്ഡവ യോദ്ധാക്കളെ ഭീഷ്മർ എണ്ണുന്നു"},"167":{"hi":"पांडवों के महारथी","kn":"ಪಾಂಡವ ಮಹಾರಥಿಗಳು","te":"పాండవ మహారథులు","ta":"பாண்டவ மகாரதர்கள்","ml":"പാണ്ഡവ മഹാരഥർ"},"168":{"hi":"और पांडव योद्धा","kn":"ಇನ್ನಷ್ಟು ಪಾಂಡವ ವೀರರು","te":"మరిన్ని పాండవ యోధులు","ta":"மேலும் பாண்டவ வீரர்கள்","ml":"കൂടുതൽ പാണ്ഡവ യോദ്ധാക്കൾ"},"169":{"hi":"भीष्म की सीमाएँ","kn":"ಭೀಷ್ಮರ ಮಿತಿಗಳು","te":"భీష్ముడి పరిమితులు","ta":"பீஷ்மரின் வரம்புகள்","ml":"ഭീഷ്മരുടെ പരിമിതികൾ"},"170":{"hi":"भीष्म शिखंडी से युद्ध क्यों नहीं करेंगे","kn":"ಶಿಖಂಡಿಯೊಡನೆ ಹೋರಾಡದ ಭೀಷ್ಮರ ಕಾರಣ","te":"శిఖండితో భీష్ముడు ఎందుకు పోరాడడు","ta":"சிகண்டியுடன் பீஷ்மர் போரிடாததன் காரணம்","ml":"ശിഖണ്ഡിയോട് ഭീഷ്മർ പോരാടാത്തതിന്റെ കാരണം"},"171":{"hi":"अंबा की विनती","kn":"ಅಂಬೆಯ ಮನವಿ","te":"అంబ చేసిన విజ్ఞప్తి","ta":"அம்பையின் வேண்டுகோள்","ml":"അംബയുടെ അപേക്ഷ"},"172":{"hi":"शाल्व अंबा को ठुकराता है","kn":"ಅಂಬೆಯನ್ನು ಶಾಲ್ವನು ತಿರಸ್ಕರಿಸುವುದು","te":"శాల్వుడు అంబను తిరస్కరిస్తాడు","ta":"அம்பையை சால்வன் நிராகரிக்கிறான்","ml":"ശാല്വൻ അംബയെ തള്ളുന്നു"},"173":{"hi":"अंबा तपस्वियों के बीच","kn":"ತಪಸ್ವಿಗಳ ನಡುವೆ ಅಂಬೆ","te":"తపస్వుల మధ్య అంబ","ta":"துறவிகளிடையே அம்பை","ml":"തപസ്വികൾക്കിടയിൽ അംബ"},"174":{"hi":"होत्रवाहन, अंबा के नाना","kn":"ಅಂಬೆಯ ಅಜ್ಜ ಹೋತ್ರವಾಹನ","te":"అంబ తాత హోత్రవాహనుడు","ta":"அம்பையின் தாத்தா ஹோத்ரவாஹனன்","ml":"അംബയുടെ മുത്തച്ഛൻ ഹോത്രവാഹനൻ"},"175":{"hi":"अकृतव्रण और परशुराम","kn":"ಆಕೃತವ್ರಣ ಮತ್ತು ಪರಶುರಾಮ","te":"అకృతవ్రణుడు, పరశురాముడు","ta":"அக்ருதவிரணனும் பரசுராமரும்","ml":"അകൃതവ്രണനും പരശുരാമനും"},"176":{"hi":"अंबा परशुराम से भीष्म का वध करने को कहती है","kn":"ಭೀಷ್ಮರನ್ನು ಸಂಹರಿಸುವಂತೆ ಪರಶುರಾಮರಲ್ಲಿ ಅಂಬೆಯ ಕೋರಿಕೆ","te":"భీష్ముడిని వధించమని పరశురాముడిని అంబ కోరుతుంది","ta":"பீஷ்மரைக் கொல்லுமாறு பரசுராமரிடம் அம்பை கேட்கிறாள்","ml":"ഭീഷ്മരെ വധിക്കണമെന്ന് അംബ പരശുരാമനോട് ആവശ്യപ്പെടുന്നു"},"177":{"hi":"परशुराम कुरुक्षेत्र जाते हैं","kn":"ಕುರುಕ್ಷೇತ್ರಕ್ಕೆ ಪರಶುರಾಮರ ಪ್ರಯಾಣ","te":"పరశురాముడు కురుక్షేత్రానికి వెళ్తాడు","ta":"குருக்ஷேத்திரத்திற்குப் பரசுராமர் செல்கிறார்","ml":"പരശുരാമൻ കുരുക്ഷേത്രത്തിലേക്ക് പോകുന്നു"},"178":{"hi":"भीष्म परशुराम को मना करते हैं","kn":"ಪರಶುರಾಮರನ್ನು ಭೀಷ್ಮರು ನಿರಾಕರಿಸುವುದು","te":"పరశురాముడిని భీష్ముడు తిరస్కరిస్తాడు","ta":"பரசுராமரை பீஷ்மர் மறுக்கிறார்","ml":"പരശുരാമനെ ഭീഷ്മർ നിരസിക്കുന്നു"},"179":{"hi":"कुरुक्षेत्र में युद्ध आरंभ होता है","kn":"ಕುರುಕ್ಷೇತ್ರದಲ್ಲಿ ಯುದ್ಧದ ಆರಂಭ","te":"కురుక్షేత్రంలో యుద్ధం ప్రారంభమవుతుంది","ta":"குருக்ஷேத்திரத்தில் போர் தொடங்குகிறது","ml":"കുരുക്ഷേത്രത്തിൽ യുദ്ധം ആരംഭിക്കുന്നു"},"180":{"hi":"पहले दिन का युद्ध","kn":"ಮೊದಲ ದಿನದ ಯುದ್ಧ","te":"మొదటి రోజు యుద్ధం","ta":"முதல் நாள் போர்","ml":"ആദ്യദിന യുദ്ധം"},"181":{"hi":"युद्ध आगे बढ़ता है","kn":"ಯುದ್ಧ ಮುಂದುವರಿಯುವುದು","te":"యుద్ధం కొనసాగుతుంది","ta":"போர் தொடர்கிறது","ml":"യുദ്ധം തുടരുന്നു"},"182":{"hi":"बराबरी का युद्ध","kn":"ಸಮಾನ ಹೋರಾಟ","te":"సమాన పోరాటం","ta":"சம நிலைப் போர்","ml":"തുല്യയുദ്ധം"},"183":{"hi":"ब्राह्मण भीष्म को आश्वस्त करते हैं","kn":"ಭೀಷ್ಮರಿಗೆ ಬ್ರಾಹ್ಮಣರ ಧೈರ್ಯವಚನ","te":"భీష్ముడికి బ్రాహ్మణులు ధైర్యం చెబుతారు","ta":"பீஷ்மருக்கு பிராமணர்கள் ஆறுதல் கூறுகின்றனர்","ml":"ബ്രാഹ്മണർ ഭീഷ്മർക്ക് ധൈര്യം നൽകുന്നു"},"184":{"hi":"प्रस्वाप अस्त्र का प्रकट होना","kn":"ಪ್ರಸ್ವಾಪ ಅಸ್ತ್ರದ ಬಹಿರಂಗ","te":"ప్రస్వాపాస్త్రం వెల్లడవుతుంది","ta":"பிரஸ்வாபம் என்ற ஆயுதம் வெளிப்படுகிறது","ml":"പ്രസ്വാപാസ്ത്രം വെളിപ്പെടുന്നു"},"185":{"hi":"भीष्म प्रस्वाप अस्त्र तैयार करते हैं","kn":"ಪ್ರಸ್ವಾಪ ಅಸ್ತ್ರವನ್ನು ಭೀಷ್ಮರು ಸಿದ್ಧಪಡಿಸುವುದು","te":"భీష్ముడు ప్రస్వాపాస్త్రాన్ని సిద్ధం చేస్తాడు","ta":"பிரஸ்வாபத்தை பீஷ்மர் தயார் செய்கிறார்","ml":"ഭീഷ്മർ പ്രസ്വാപാസ്ത്രം പ്രയോഗിക്കാൻ ഒരുങ്ങുന്നു"},"186":{"hi":"युद्ध का अंत","kn":"ಯುದ್ಧ ಅಂತ್ಯಗೊಳ್ಳುವುದು","te":"యుద్ధం ముగుస్తుంది","ta":"போர் முடிகிறது","ml":"യുദ്ധം അവസാനിക്കുന്നു"},"187":{"hi":"अंबा की तपस्या","kn":"ಅಂಬೆಯ ತಪಸ್ಸು","te":"అంబ తపస్సు","ta":"அம்பையின் தவம்","ml":"അംബയുടെ തപസ്സ്"},"188":{"hi":"अंबा अग्नि में प्रवेश करती है","kn":"ಅಂಬೆ ಅಗ್ನಿಪ್ರವೇಶ ಮಾಡುವುದು","te":"అంబ అగ్నిలో ప్రవేశిస్తుంది","ta":"அம்பை தீயில் புகுகிறாள்","ml":"അംബ അഗ്നിയിൽ പ്രവേശിക്കുന്നു"},"189":{"hi":"शिखंडिनी का जन्म","kn":"ಶಿಖಂಡಿನಿಯ ಜನನ","te":"శిఖండిని జననం","ta":"சிகண்டினியின் பிறப்பு","ml":"ശിഖണ്ഡിനിയുടെ ജനനം"},"190":{"hi":"शिखंडी का विवाह","kn":"ಶಿಖಂಡಿಯ ವಿವಾಹ","te":"శిఖండి వివాహం","ta":"சிகண்டியின் திருமணம்","ml":"ശിഖണ്ഡിയുടെ വിവാഹം"},"191":{"hi":"द्रुपद संकट में","kn":"ದ್ರುಪದನಿಗೆ ಅಪಾಯ","te":"ద్రుపదుడికి ప్రమాదం","ta":"துருபதன் ஆபத்தில்","ml":"ദ്രുപദൻ അപകടത്തിൽ"},"192":{"hi":"शिखंडिनी वन की ओर जाती है","kn":"ಶಿಖಂಡಿನಿ ಕಾಡಿಗೆ ಹೊರಡುವುದು","te":"శిఖండిని అరణ్యానికి బయలుదేరుతుంది","ta":"காட்டிற்குச் செல்கிறாள் சிகண்டினி","ml":"ശിഖണ്ഡിനി വനത്തിലേക്ക് പോകുന്നു"},"193":{"hi":"यक्ष और शिखंडिनी का लिंग-विनिमय","kn":"ಯಕ್ಷನು ಶಿಖಂಡಿನಿಯೊಡನೆ ಲಿಂಗ ವಿನಿಮಯ ಮಾಡಿಕೊಳ್ಳುವುದು","te":"యక్షుడు శిఖండినితో లింగ మార్పిడి చేసుకుంటాడు","ta":"சிகண்டினியுடன் பாலினம் மாற்றிக்கொள்ளும் யட்சன்","ml":"യക്ഷൻ ശിഖണ്ഡിനിയുമായി ലിംഗം കൈമാറ്റം ചെയ്യുന്നു"},"194":{"hi":"प्रत्येक को कितना समय लगेगा?","kn":"ಇದಕ್ಕೆ ಎಷ್ಟು ಕಾಲ ಬೇಕಾಗುವುದು?","te":"ప్రతి ఒక్కరికీ ఎంత సమయం పడుతుంది","ta":"ஒவ்வொன்றுக்கும் எவ்வளவு காலம் ஆகும்?","ml":"ഓരോന്നിനും എത്ര കാലമെടുക്കും?"},"195":{"hi":"अर्जुन का उत्तर","kn":"ಅರ್ಜುನನ ಉತ್ತರ","te":"అర్జునుడి సమాధానం","ta":"அர்ஜுனனின் பதில்","ml":"അർജുനന്റെ മറുപടി"},"196":{"hi":"कौरव सेना का कूच","kn":"ಕೌರವ ಸೇನೆ ಮುನ್ನಡೆಯುವುದು","te":"కౌరవ సైన్యం కదులుతుంది","ta":"கௌரவப் படை அணிவகுத்துச் செல்கிறது","ml":"കൗരവസേന മാർച്ച് ചെയ്യുന്നു"},"197":{"hi":"पांडव सेना का कूच","kn":"ಪಾಂಡವ ಸೇನೆ ಮುನ್ನಡೆಯುವುದು","te":"పాండవ సైన్యం కదులుతుంది","ta":"பாண்டவப் படை அணிவகுத்துச் செல்கிறது","ml":"പാണ്ഡവസേന മാർച്ച് ചെയ്യുന്നു"}}