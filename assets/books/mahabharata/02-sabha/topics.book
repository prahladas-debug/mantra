{"1":{"hi":"मय सभा-भवन बनाने का प्रस्ताव रखते हैं","ml":"മയൻ ഒരു സഭാമണ്ഡപം പണിയാമെന്ന് വാഗ്ദാനം ചെയ്യുന്നു","te":"మయుడు ఒక సభాభవనం నిర్మిస్తానని ప్రతిపాదిస్తాడు","kn":"ಮಯನು ಸಭಾಗೃಹವನ್ನು ನಿರ್ಮಿಸಲು ಮುಂದಾಗುತ್ತಾನೆ","ta":"மயன் ஒரு மண்டபம் கட்ட முன்வருகிறான்"},"2":{"hi":"कृष्ण द्वारका लौटते हैं","ml":"കൃഷ്ണൻ ദ്വാരകയിലേക്ക് മടങ്ങുന്നു","te":"కృష్ణుడు ద్వారకకు తిరిగి వెళ్తాడు","kn":"ಕೃಷ್ಣ ದ್ವಾರಕೆಗೆ ಹಿಂದಿರುಗುತ್ತಾನೆ","ta":"கிருஷ்ணர் துவாரகைக்குத் திரும்புகிறார்"},"3":{"hi":"मय सभा-भवन का निर्माण करते हैं","ml":"മയൻ സഭാമണ്ഡപം പണിയുന്നു","te":"మయుడు సభాభవనాన్ని నిర్మిస్తాడు","kn":"ಮಯನು ಸಭಾಗೃಹವನ್ನು ನಿರ್ಮಿಸುತ್ತಾನೆ","ta":"மயன் மண்டபத்தைக் கட்டுகிறான்"},"4":{"hi":"युधिष्ठिर सभा-भवन में प्रवेश करते हैं","ml":"യുധിഷ്ഠിരൻ സഭാമണ്ഡപത്തിൽ പ്രവേശിക്കുന്നു","te":"ధర్మరాజు సభాభవనంలో ప్రవేశిస్తాడు","kn":"ಯುಧಿಷ್ಠಿರ ಸಭಾಗೃಹವನ್ನು ಪ್ರವೇಶಿಸುತ್ತಾನೆ","ta":"யுதிட்டிரன் மண்டபத்தில் நுழைகிறான்"},"5":{"hi":"राजधर्म पर नारद के प्रश्न","ml":"രാജത്വത്തെക്കുറിച്ച് നാരദന്റെ ചോദ്യങ്ങൾ","te":"రాజధర్మంపై నారదుని ప్రశ్నలు","kn":"ರಾಜಧರ್ಮದ ಕುರಿತು ನಾರದರ ಪ್ರಶ್ನೆಗಳು","ta":"அரசாட்சி பற்றி நாரதரின் கேள்விகள்"},"6":{"hi":"युधिष्ठिर देवताओं के सभा-भवनों के बारे में पूछते हैं","ml":"ദേവന്മാരുടെ സഭകളെക്കുറിച്ച് യുധിഷ്ഠിരൻ ചോദിക്കുന്നു","te":"దేవతల సభల గురించి ధర్మరాజు ప్రశ్నిస్తాడు","kn":"ದೇವತೆಗಳ ಸಭಾಗೃಹಗಳ ಕುರಿತು ಯುಧಿಷ್ಠಿರನ ಪ್ರಶ್ನೆ","ta":"தேவர்களின் மண்டபங்கள் பற்றி யுதிட்டிரன் கேட்கிறான்"},"7":{"hi":"इंद्र की सभा","ml":"ഇന്ദ്രന്റെ സഭ","te":"ఇంద్రుని సభ","kn":"ಇಂದ್ರನ ಸಭಾಗೃಹ","ta":"இந்திரனின் மண்டபம்"},"8":{"hi":"यम की सभा","ml":"യമന്റെ സഭ","te":"యముని సభ","kn":"ಯಮನ ಸಭಾಗೃಹ","ta":"யமனின் மண்டபம்"},"9":{"hi":"वरुण की सभा","ml":"വരുണന്റെ സഭ","te":"వరుణుని సభ","kn":"ವರುಣನ ಸಭಾಗೃಹ","ta":"வருணனின் மண்டபம்"},"10":{"hi":"कुबेर की सभा","ml":"കുബേരന്റെ സഭ","te":"కుబేరుని సభ","kn":"ಕುಬೇರನ ಸಭಾಗೃಹ","ta":"குபேரனின் மண்டபம்"},"11":{"hi":"ब्रह्मा की सभा और पांडु का संदेश","ml":"ബ്രഹ്മാവിന്റെ സഭയും പാണ്ഡുവിന്റെ സന്ദേശവും","te":"బ్రహ్మ సభ, పాండు సందేశం","kn":"ಬ್ರಹ್ಮನ ಸಭಾಗೃಹ ಮತ್ತು ಪಾಂಡುವಿನ ಸಂದೇಶ","ta":"பிரம்மனின் மண்டபமும் பாண்டுவின் செய்தியும்"},"12":{"hi":"युधिष्ठिर राजसूय अभिषेक पर विचार करते हैं","ml":"രാജ്യാഭിഷേകത്തെക്കുറിച്ച് യുധിഷ്ഠിരൻ ആലോചിക്കുന്നു","te":"రాజ్యాభిషేకం గురించి ధర్మరాజు ఆలోచిస్తాడు","kn":"ರಾಜ್ಯಾಭಿಷೇಕದ ಕುರಿತು ಯುಧಿಷ್ಠಿರನ ಚಿಂತನೆ","ta":"அரசாபிஷேகம் பற்றி யுதிட்டிரன் ஆலோசிக்கிறான்"},"13":{"hi":"कृष्ण का परामर्श: जरासंध का वध होना चाहिए","ml":"ജരാസന്ധൻ വീഴണമെന്ന് കൃഷ്ണൻ ഉപദേശിക്കുന്നു","te":"జరాసంధుడు పడాలని కృష్ణుడు సూచిస్తాడు","kn":"ಕೃಷ್ಣನ ಸಲಹೆ: ಜರಾಸಂಧನ ಅಂತ್ಯವಾಗಬೇಕು","ta":"ஜராசந்தன் வீழ்த்தப்பட வேண்டும் என கிருஷ்ணர் அறிவுறுத்துகிறார்"},"14":{"hi":"भीम और कृष्ण कार्रवाई पर बल देते हैं","ml":"ഭീമനും കൃഷ്ണനും നടപടി ആവശ്യപ്പെടുന്നു","te":"భీముడు, కృష్ణుడు చర్య తీసుకోవాలని కోరతారు","kn":"ಭೀಮ ಮತ್ತು ಕೃಷ್ಣ ಕ್ರಮಕ್ಕೆ ಒತ್ತಾಯಿಸುತ್ತಾರೆ","ta":"பீமனும் கிருஷ்ணரும் செயலை வலியுறுத்துகின்றனர்"},"15":{"hi":"अर्जुन का संकल्प","ml":"അർജ്ജുനന്റെ തീരുമാനം","te":"అర్జునుని సంకల్పం","kn":"ಅರ್ಜುನನ ಸಂಕಲ್ಪ","ta":"அர்ஜுனனின் உறுதி"},"16":{"hi":"जरासंध का जन्म","ml":"ജരാസന്ധന്റെ ജനനം","te":"జరాసంధుని జననం","kn":"ಜರಾಸಂಧನ ಜನನ","ta":"ஜராசந்தனின் பிறப்பு"},"17":{"hi":"जरा बालक का नामकरण करती है; जरासंध की शक्ति","ml":"ജര കുഞ്ഞിന് പേരിടുന്നു; ജരാസന്ധന്റെ ശക്തി","te":"జర ఆ బిడ్డకు పేరు పెడుతుంది, జరాసంధుని బలం","kn":"ಜರೆ ಮಗುವಿಗೆ ಹೆಸರಿಡುತ್ತಾಳೆ; ಜರಾಸಂಧನ ಶಕ್ತಿ","ta":"ஜரா குழந்தைக்குப் பெயரிடுகிறாள், ஜராசந்தனின் வலிமை"},"18":{"hi":"कृष्ण, भीम और अर्जुन मगध के लिए निकलते हैं","ml":"കൃഷ്ണനും ഭീമനും അർജ്ജുനനും മഗധയിലേക്ക് പുറപ്പെടുന്നു","te":"కృష్ణుడు, భీముడు, అర్జునుడు మగధకు బయలుదేరతారు","kn":"ಕೃಷ್ಣ, ಭೀಮ ಮತ್ತು ಅರ್ಜುನರು ಮಗಧಕ್ಕೆ ಹೊರಡುತ್ತಾರೆ","ta":"கிருஷ்ணர், பீமன், அர்ஜுனன் மகதத்திற்குப் புறப்படுகின்றனர்"},"19":{"hi":"गिरिव्रज में प्रवेश","ml":"ഗിരിവ്രജത്തിൽ പ്രവേശിക്കുന്നു","te":"గిరివ్రజంలో ప్రవేశం","kn":"ಗಿರಿವ್ರಜವನ್ನು ಪ್ರವೇಶಿಸುವುದು","ta":"கிரிவிரஜத்திற்குள் நுழைதல்"},"20":{"hi":"कृष्ण जरासंध को चुनौती देते हैं","ml":"കൃഷ്ണൻ ജരാസന്ധനെ വെല്ലുവിളിക്കുന്നു","te":"కృష్ణుడు జరాసంధుని సవాలు చేస్తాడు","kn":"ಕೃಷ್ಣ ಜರಾಸಂಧನಿಗೆ ಸವಾಲೊಡ್ಡುತ್ತಾನೆ","ta":"ஜராசந்தனுக்கு கிருஷ்ணர் சவால் விடுகிறார்"},"21":{"hi":"भीम और जरासंध की कुश्ती","ml":"ഭീമനും ജരാസന്ധനും തമ്മിലുള്ള ഗുസ്തി","te":"భీమ జరాసంధుల మల్లయుద్ధం","kn":"ಭೀಮ ಮತ್ತು ಜರಾಸಂಧನ ಕುಸ್ತಿ","ta":"பீமனுக்கும் ஜராசந்தனுக்கும் இடையிலான மல்யுத்தம்"},"22":{"hi":"जरासंध की मृत्यु और राजाओं की मुक्ति","ml":"ജരാസന്ധന്റെ മരണവും രാജാക്കന്മാരുടെ മോചനവും","te":"జరాసంధుని మరణం, రాజుల విముక్తి","kn":"ಜರಾಸಂಧನ ಮರಣ ಮತ್ತು ರಾಜರ ಬಿಡುಗಡೆ","ta":"ஜராசந்தனின் மரணமும் மன்னர்களின் விடுதலையும்"},"23":{"hi":"अर्जुन उत्तर दिशा पर विजय पाते हैं: भगदत्त","ml":"അർജ്ജുനൻ വടക്ക് കീഴടക്കുന്നു: ഭഗദത്തൻ","te":"అర్జునుడు ఉత్తర దిక్కును జయిస్తాడు, భగదత్తుడు","kn":"ಅರ್ಜುನ ಉತ್ತರ ದಿಕ್ಕನ್ನು ಗೆಲ್ಲುತ್ತಾನೆ: ಭಗದತ್ತ","ta":"வடக்கை அர்ஜுனன் வெல்கிறான்: பகதத்தன்"},"24":{"hi":"हिमालय में अर्जुन की विजयें","ml":"ഹിമാലയത്തിലെ അർജ്ജുനന്റെ വിജയങ്ങൾ","te":"హిమాలయంలో అర్జునుని విజయాలు","kn":"ಹಿಮಾಲಯದಲ್ಲಿ ಅರ್ಜುನನ ವಿಜಯಗಳು","ta":"இமயமலையில் அர்ஜுனனின் வெற்றிகள்"},"25":{"hi":"उत्तर कुरु देश में अर्जुन","ml":"ഉത്തരകുരുവിന്റെ ദേശത്ത് അർജ്ജുനൻ","te":"ఉత్తర కురువుల దేశంలో అర్జునుడు","kn":"ಉತ್ತರ ಕುರುಗಳ ನಾಡಿನಲ್ಲಿ ಅರ್ಜುನ","ta":"வடக்குக் குருக்களின் நாட்டில் அர்ஜுனன்"},"26":{"hi":"भीम पूर्व दिशा के लिए निकलते हैं","ml":"ഭീമൻ കിഴക്കോട്ട് പുറപ്പെടുന്നു","te":"భీముడు తూర్పు దిక్కుకు బయలుదేరతాడు","kn":"ಭೀಮ ಪೂರ್ವ ದಿಕ್ಕಿಗೆ ಹೊರಡುತ್ತಾನೆ","ta":"பீமன் கிழக்கு நோக்கிப் புறப்படுகிறான்"},"27":{"hi":"भीम पूर्व दिशा पर विजय पाते हैं","ml":"ഭീമൻ കിഴക്ക് കീഴടക്കുന്നു","te":"భీముడు తూర్పు దిక్కును జయిస్తాడు","kn":"ಭೀಮ ಪೂರ್ವ ದಿಕ್ಕನ್ನು ಗೆಲ್ಲುತ್ತಾನೆ","ta":"பீமன் கிழக்கை வெல்கிறான்"},"28":{"hi":"सहदेव दक्षिण दिशा पर विजय पाते हैं","ml":"സഹദേവൻ തെക്ക് കീഴടക്കുന്നു","te":"సహదేవుడు దక్షిణ దిక్కును జయిస్తాడు","kn":"ಸಹದೇವ ದಕ್ಷಿಣ ದಿಕ್ಕನ್ನು ಗೆಲ್ಲುತ್ತಾನೆ","ta":"சகாதேவன் தெற்கை வெல்கிறான்"},"29":{"hi":"नकुल पश्चिम दिशा पर विजय पाते हैं","ml":"നകുലൻ പടിഞ്ഞാറ് കീഴടക്കുന്നു","te":"నకులుడు పశ్చిమ దిక్కును జయిస్తాడు","kn":"ನಕುಲ ಪಶ್ಚಿಮ ದಿಕ್ಕನ್ನು ಗೆಲ್ಲುತ್ತಾನೆ","ta":"நகுலன் மேற்கை வெல்கிறான்"},"30":{"hi":"राजसूय यज्ञ की तैयारियाँ","ml":"രാജസൂയത്തിനുള്ള ഒരുക്കങ്ങൾ","te":"రాజసూయ యాగానికి సన్నాహాలు","kn":"ರಾಜಸೂಯ ಯಜ್ಞದ ಸಿದ್ಧತೆಗಳು","ta":"ராஜசூய யாகத்திற்கான ஏற்பாடுகள்"},"31":{"hi":"राजा पहुँचते हैं","ml":"രാജാക്കന്മാർ എത്തുന്നു","te":"రాజులు వస్తారు","kn":"ರಾಜರುಗಳ ಆಗಮನ","ta":"மன்னர்கள் வருகின்றனர்"},"32":{"hi":"यज्ञ आरंभ होता है","ml":"യാഗം ആരംഭിക്കുന്നു","te":"యాగం ప్రారంభమవుతుంది","kn":"ಯಜ್ಞ ಆರಂಭವಾಗುತ್ತದೆ","ta":"யாகம் தொடங்குகிறது"},"33":{"hi":"पहला सम्मान कृष्ण को मिलता है","ml":"ആദ്യ ബഹുമതി കൃഷ്ണന്","te":"మొదటి గౌరవం కృష్ణునికి దక్కుతుంది","kn":"ಮೊದಲ ಗೌರವ ಕೃಷ್ಣನಿಗೆ ಸಲ್ಲುತ್ತದೆ","ta":"முதல் மரியாதை கிருஷ்ணருக்கு அளிக்கப்படுகிறது"},"34":{"hi":"शिशुपाल का विरोध","ml":"ശിശുപാലന്റെ പ്രതിഷേധം","te":"శిశుపాలుని నిరసన","kn":"ಶಿಶುಪಾಲನ ಪ್ರತಿಭಟನೆ","ta":"சிசுபாலனின் எதிர்ப்பு"},"35":{"hi":"भीष्म सम्मान की रक्षा करते हैं","ml":"ഭീഷ്മർ ബഹുമതിയെ സംരക്ഷിക്കുന്നു","te":"భీష్ముడు ఆ గౌరవాన్ని సమర్థిస్తాడు","kn":"ಭೀಷ್ಮರು ಗೌರವವನ್ನು ಸಮರ್ಥಿಸುತ್ತಾರೆ","ta":"மரியாதையை பீஷ்மர் பாதுகாக்கிறார்"},"36":{"hi":"सहदेव की चुनौती; राजा षड्यंत्र रचते हैं","ml":"സഹദേവന്റെ വെല്ലുവിളി; രാജാക്കന്മാർ ഗൂഢാലോചന നടത്തുന്നു","te":"సహదేవుని సవాలు, రాజుల కుట్ర","kn":"ಸಹದೇವನ ಸವಾಲು; ರಾಜರು ಒಳಸಂಚು ಮಾಡುತ್ತಾರೆ","ta":"சகாதேவனின் சவால், மன்னர்கள் சதி செய்கின்றனர்"},"37":{"hi":"भीष्म युधिष्ठिर को शांत करते हैं","ml":"ഭീഷ്മർ യുധിഷ്ഠിരനെ ശാന്തനാക്കുന്നു","te":"భీష్ముడు ధర్మరాజును శాంతపరుస్తాడు","kn":"ಭೀಷ್ಮರು ಯುಧಿಷ್ಠಿರನನ್ನು ಸಮಾಧಾನಪಡಿಸುತ್ತಾರೆ","ta":"பீஷ்மர் யுதிட்டிரனை அமைதிப்படுத்துகிறார்"},"38":{"hi":"शिशुपाल भीष्म और कृष्ण का अपमान करता है","ml":"ശിശുപാലൻ ഭീഷ്മരെയും കൃഷ്ണനെയും ആക്ഷേപിക്കുന്നു","te":"శిశుపాలుడు భీష్మునిని, కృష్ణుని దూషిస్తాడు","kn":"ಶಿಶುಪಾಲ ಭೀಷ್ಮ ಮತ್ತು ಕೃಷ್ಣನನ್ನು ನಿಂದಿಸುತ್ತಾನೆ","ta":"சிசுபாலன் பீஷ்மரையும் கிருஷ்ணரையும் இகழ்கிறான்"},"39":{"hi":"शिशुपाल जरासंध की प्रशंसा करता है; भीम क्रोधित होते हैं","ml":"ശിശുപാലൻ ജരാസന്ധനെ പുകഴ്ത്തുന്നു; ഭീമൻ കോപിക്കുന്നു","te":"శిశుపాలుడు జరాసంధుని పొగడతాడు, భీముడు ఆగ్రహిస్తాడు","kn":"ಶಿಶುಪಾಲ ಜರಾಸಂಧನನ್ನು ಹೊಗಳುತ್ತಾನೆ; ಭೀಮ ಕೋಪಗೊಳ್ಳುತ್ತಾನೆ","ta":"சிசுபாலன் ஜராசந்தனைப் புகழ்கிறான், பீமன் சினக்கிறான்"},"40":{"hi":"शिशुपाल का जन्म","ml":"ശിശുപാലന്റെ ജനനം","te":"శిశుపాలుని జననం","kn":"ಶಿಶುಪಾಲನ ಜನನ","ta":"சிசுபாலனின் பிறப்பு"},"41":{"hi":"शिशुपाल कृष्ण को चुनौती देता है","ml":"ശിശുപാലൻ കൃഷ്ണനെ വെല്ലുവിളിക്കുന്നു","te":"శిశుపాలుడు కృష్ణుని సవాలు చేస్తాడు","kn":"ಶಿಶುಪಾಲ ಕೃಷ್ಣನಿಗೆ ಸವಾಲೊಡ್ಡುತ್ತಾನೆ","ta":"சிசுபாலன் கிருஷ்ணருக்கு சவால் விடுகிறான்"},"42":{"hi":"शिशुपाल की मृत्यु; यज्ञ पूर्ण होता है","ml":"ശിശുപാലന്റെ മരണം; യാഗം പൂർത്തിയാകുന്നു","te":"శిశుపాలుని మరణం, యాగం పూర్తవుతుంది","kn":"ಶಿಶುಪಾಲನ ಮರಣ; ಯಜ್ಞ ಪೂರ್ಣಗೊಳ್ಳುತ್ತದೆ","ta":"சிசுபாலனின் மரணம், யாகம் நிறைவடைகிறது"},"43":{"hi":"सभा में दुर्योधन का अपमान","ml":"സഭയിൽ ദുര്യോധനൻ അപമാനിതനാകുന്നു","te":"సభలో దుర్యోధనుని అవమానం","kn":"ಸಭಾಗೃಹದಲ್ಲಿ ದುರ್ಯೋಧನನಿಗೆ ಅವಮಾನ","ta":"மண்டபத்தில் துரியோதனன் அவமானப்படுத்தப்படுகிறான்"},"44":{"hi":"शकुनि चौसर के खेल का प्रस्ताव रखता है","ml":"ശകുനി ചൂതുകളി നിർദ്ദേശിക്കുന്നു","te":"శకుని పాచికల ఆటను ప్రతిపాదిస్తాడు","kn":"ಶಕುನಿ ಪಗಡೆ ಆಟವನ್ನು ಪ್ರಸ್ತಾಪಿಸುತ್ತಾನೆ","ta":"சகுனி பகடையாட்டத்தை முன்மொழிகிறான்"},"45":{"hi":"धृतराष्ट्र पुत्र के आगे झुकते हैं","ml":"ധൃതരാഷ്ട്രർ പുത്രന് വഴങ്ങുന്നു","te":"ధృతరాష్ట్రుడు కొడుకు మాటకు తలొగ్గుతాడు","kn":"ಧೃತರಾಷ್ಟ್ರ ಮಗನಿಗೆ ಮಣಿಯುತ್ತಾನೆ","ta":"திருதராஷ்டிரர் தம் மகனுக்கு இணங்குகிறார்"},"46":{"hi":"दुर्योधन अपनी ईर्ष्या का वर्णन करता है","ml":"ദുര്യോധനൻ തന്റെ അസൂയ വിവരിക്കുന്നു","te":"దుర్యోధనుడు తన అసూయను వివరిస్తాడు","kn":"ದುರ್ಯೋಧನ ತನ್ನ ಅಸೂಯೆಯನ್ನು ವಿವರಿಸುತ್ತಾನೆ","ta":"துரியோதனன் தன் பொறாமையை விவரிக்கிறான்"},"47":{"hi":"राजाओं का कर","ml":"രാജാക്കന്മാരുടെ കപ്പം","te":"రాజుల కప్పం","kn":"ರಾಜರುಗಳ ಕಪ್ಪ ಕಾಣಿಕೆ","ta":"மன்னர்களின் காணிக்கை"},"48":{"hi":"और अधिक कर","ml":"കപ്പത്തിന്റെ കൂടുതൽ വിവരങ്ങൾ","te":"మరింత కప్పం","kn":"ಇನ್ನಷ್ಟು ಕಪ್ಪ ಕಾಣಿಕೆ","ta":"மேலும் காணிக்கைகள்"},"49":{"hi":"युधिष्ठिर को दिया गया सम्मान","ml":"യുധിഷ്ഠിരന് നൽകുന്ന ആദരവ്","te":"ధర్మరాజుకు చూపిన గౌరవం","kn":"ಯುಧಿಷ್ಠಿರನಿಗೆ ತೋರಿದ ಗೌರವ","ta":"யுதிட்டிரனுக்குக் காட்டப்பட்ட மரியாதை"},"50":{"hi":"धृतराष्ट्र परामर्श देते हैं; दुर्योधन हठ करता है","ml":"ധൃതരാഷ്ട്രർ ഉപദേശിക്കുന്നു; ദുര്യോധനൻ നിർബന്ധിക്കുന്നു","te":"ధృతరాష్ట్రుడు హితబోధ చేస్తాడు, దుర్యోధనుడు పట్టుపడతాడు","kn":"ಧೃತರಾಷ್ಟ್ರನ ಬುದ್ಧಿವಾದ; ದುರ್ಯೋಧನನ ಹಟ","ta":"திருதராஷ்டிரர் அறிவுறுத்துகிறார், துரியோதனன் வலியுறுத்துகிறான்"},"51":{"hi":"चौसर का निर्णय; विदुर भेजे जाते हैं","ml":"ചൂതുകളിയുടെ തീരുമാനം; വിദുരനെ അയക്കുന്നു","te":"పాచికల ఆట నిర్ణయం, విదురుడు పంపబడతాడు","kn":"ಪಗಡೆ ಆಟ ನಿಶ್ಚಯವಾಗುತ್ತದೆ; ವಿದುರನನ್ನು ಕಳುಹಿಸಲಾಗುತ್ತದೆ","ta":"பகடையாட்டம் முடிவாகிறது, விதுரர் அனுப்பப்படுகிறார்"},"52":{"hi":"युधिष्ठिर निमंत्रण स्वीकार करते हैं","ml":"യുധിഷ്ഠിരൻ ക്ഷണം സ്വീകരിക്കുന്നു","te":"ధర్మరాజు ఆహ్వానాన్ని అంగీకరిస్తాడు","kn":"ಯುಧಿಷ್ಠಿರ ಆಹ್ವಾನವನ್ನು ಸ್ವೀಕರಿಸುತ್ತಾನೆ","ta":"யுதிட்டிரன் அழைப்பை ஏற்கிறான்"},"53":{"hi":"खेल आरंभ होता है","ml":"കളി ആരംഭിക്കുന്നു","te":"ఆట ప్రారంభమవుతుంది","kn":"ಆಟ ಆರಂಭವಾಗುತ್ತದೆ","ta":"ஆட்டம் தொடங்குகிறது"},"54":{"hi":"युधिष्ठिर अपना धन हार जाते हैं","ml":"യുധിഷ്ഠിരൻ സമ്പത്ത് നഷ്ടപ്പെടുത്തുന്നു","te":"ధర్మరాజు తన సంపదను కోల్పోతాడు","kn":"ಯುಧಿಷ್ಠಿರ ತನ್ನ ಸಂಪತ್ತನ್ನು ಕಳೆದುಕೊಳ್ಳುತ್ತಾನೆ","ta":"யுதிட்டிரன் தன் செல்வத்தை இழக்கிறான்"},"55":{"hi":"धृतराष्ट्र को विदुर की चेतावनी","ml":"ധൃതരാഷ്ട്രർക്ക് വിദുരന്റെ മുന്നറിയിപ്പ്","te":"ధృతరాష్ట్రునికి విదురుని హెచ్చరిక","kn":"ವಿದುರನ ಧೃತರಾಷ್ಟ್ರನಿಗೆ ಎಚ್ಚರಿಕೆ","ta":"திருதராஷ்டிரருக்கு விதுரரின் எச்சரிக்கை"},"56":{"hi":"विदुर: पासा कलह की जड़ है","ml":"വിദുരൻ: ചൂതാണ് കലഹത്തിന്റെ മൂലം","te":"విదురుడు: పాచికలే కలహానికి మూలం","kn":"ವಿದುರ: ಪಗಡೆ ಕಲಹದ ಮೂಲ","ta":"சூதாட்டமே பகையின் மூலம் என விதுரர்"},"57":{"hi":"दुर्योधन विदुर का तिरस्कार करता है","ml":"വിദുരനെ ദുര്യോധനൻ പരിഹസിക്കുന്നു","te":"విదురుని దుర్యోధనుడు తిరస్కరిస్తాడు","kn":"ದುರ್ಯೋಧನ ವಿದುರನನ್ನು ಹೀಯಾಳಿಸುತ್ತಾನೆ","ta":"துரியோதனன் விதுரரை இகழ்கிறான்"},"58":{"hi":"युधिष्ठिर भाइयों, स्वयं और द्रौपदी को दाँव पर लगाते हैं","ml":"യുധിഷ്ഠിരൻ സഹോദരന്മാരെയും സ്വയത്തെയും ദ്രൗപദിയെയും പന്തയം വെക്കുന്നു","te":"ధర్మరాజు తన సోదరులను, తనను, ద్రౌపదిని పణంగా పెడతాడు","kn":"ಯುಧಿಷ್ಠಿರ ತಮ್ಮಂದಿರನ್ನು, ತನ್ನನ್ನು ಮತ್ತು ದ್ರೌಪದಿಯನ್ನು ಪಣಕ್ಕಿಡುತ್ತಾನೆ","ta":"தம்பியரையும் தன்னையும் திரௌபதியையும் யுதிட்டிரன் பந்தயம் வைக்கிறான்"},"59":{"hi":"दुर्योधन द्रौपदी को लाने का आदेश देता है","ml":"ദ്രൗപദിയെ കൊണ്ടുവരാൻ ദുര്യോധനൻ കല്പിക്കുന്നു","te":"ద్రౌపదిని తీసుకురమ్మని దుర్యోధనుడు ఆజ్ఞాపిస్తాడు","kn":"ದ್ರೌಪದಿಯನ್ನು ಕರೆತರಲು ದುರ್ಯೋಧನನ ಆಜ್ಞೆ","ta":"திரௌபதியை அழைத்து வருமாறு துரியோதனன் கட்டளையிடுகிறான்"},"60":{"hi":"द्रौपदी को सभा में घसीटा जाता है","ml":"ദ്രൗപദിയെ സഭയിലേക്ക് വലിച്ചിഴയ്ക്കുന്നു","te":"ద్రౌపదిని సభలోకి ఈడ్చుకువస్తారు","kn":"ದ್ರೌಪದಿಯನ್ನು ಸಭೆಗೆ ಎಳೆದೊಯ್ಯಲಾಗುತ್ತದೆ","ta":"திரௌபதி மண்டபத்திற்கு இழுத்து வரப்படுகிறாள்"},"61":{"hi":"विकर्ण का विरोध और द्रौपदी का चीरहरण","ml":"വികർണ്ണന്റെ പ്രതിഷേധവും ദ്രൗപദിയുടെ വസ്ത്രാക്ഷേപവും","te":"వికర్ణుని నిరసన, ద్రౌపది వస్త్రాపహరణం","kn":"ವಿಕರ್ಣನ ಪ್ರತಿಭಟನೆ ಮತ್ತು ದ್ರೌಪದಿಯ ವಸ್ತ್ರಾಪಹರಣ","ta":"விகர்ணனின் எதிர்ப்பும் திரௌபதியின் துகில் உரிதலும்"},"62":{"hi":"द्रौपदी का सभा से प्रश्न","ml":"ദ്രൗപദിയുടെ സദസ്സിനോടുള്ള ചോദ്യം","te":"సభను ద్రౌపది ప్రశ్నిస్తుంది","kn":"ದ್ರೌಪದಿಯ ಸಭೆಗೆ ಪ್ರಶ್ನೆ","ta":"சபையிடம் திரௌபதியின் கேள்வி"},"63":{"hi":"भीम की प्रतिज्ञा और धृतराष्ट्र के वरदान","ml":"ഭീമന്റെ പ്രതിജ്ഞയും ധൃതരാഷ്ട്രരുടെ വരങ്ങളും","te":"భీముని ప్రతిజ్ఞ, ధృతరాష్ట్రుని వరాలు","kn":"ಭೀಮನ ಪ್ರತಿಜ್ಞೆ ಮತ್ತು ಧೃತರಾಷ್ಟ್ರನ ವರಗಳು","ta":"பீமனின் சபதமும் திருதராஷ்டிரரின் வரங்களும்"},"64":{"hi":"भीम को रोका जाता है","ml":"ഭീമനെ തടയുന്നു","te":"భీముడు నిగ్రహించబడతాడు","kn":"ಭೀಮನನ್ನು ತಡೆಯಲಾಗುತ್ತದೆ","ta":"பீமன் தடுக்கப்படுகிறான்"},"65":{"hi":"धृतराष्ट्र राज्य लौटाते हैं","ml":"ധൃതരാഷ്ട്രർ രാജ്യം തിരികെ നൽകുന്നു","te":"ధృతరాష్ట్రుడు రాజ్యాన్ని తిరిగి ఇస్తాడు","kn":"ಧೃತರಾಷ್ಟ್ರ ರಾಜ್ಯವನ್ನು ಹಿಂದಿರುಗಿಸುತ್ತಾನೆ","ta":"திருதராஷ்டிரர் நாட்டை மீட்டுத் தருகிறார்"},"66":{"hi":"दुर्योधन दूसरे खेल की माँग करता है","ml":"ദുര്യോധനൻ രണ്ടാമത് ഒരു കളി ആവശ്യപ്പെടുന്നു","te":"దుర్యోధనుడు రెండవ ఆటను కోరతాడు","kn":"ದುರ್ಯೋಧನ ಎರಡನೆಯ ಆಟವನ್ನು ಬೇಡುತ್ತಾನೆ","ta":"இரண்டாவது ஆட்டத்தைத் துரியோதனன் கோருகிறான்"},"67":{"hi":"दूसरा खेल","ml":"രണ്ടാമത്തെ കളി","te":"రెండవ ఆట","kn":"ಎರಡನೆಯ ಆಟ","ta":"இரண்டாவது ஆட்டம்"},"68":{"hi":"पांडवों की प्रतिशोध की प्रतिज्ञाएँ","ml":"പ്രതികാരത്തിനായുള്ള പാണ്ഡവരുടെ പ്രതിജ്ഞകൾ","te":"పాండవుల ప్రతీకార ప్రతిజ్ఞలు","kn":"ಪಾಂಡವರ ಸೇಡಿನ ಪ್ರತಿಜ್ಞೆಗಳು","ta":"பாண்டவர்களின் பழிவாங்கும் சபதங்கள்"},"69":{"hi":"विदुर का विदाई-परामर्श","ml":"വിദുരന്റെ യാത്രയയപ്പ് ഉപദേശം","te":"విదురుని వీడ్కోలు హితబోధ","kn":"ವಿದುರನ ವಿದಾಯದ ಬುದ್ಧಿವಾದ","ta":"விதுரரின் பிரியாவிடை அறிவுரை"},"70":{"hi":"द्रौपदी और कुंती का विछोह","ml":"ദ്രൗപദിയും കുന്തിയും പിരിയുന്നു","te":"ద్రౌపది, కుంతి విడిపోతారు","kn":"ದ್ರೌಪದಿ ಮತ್ತು ಕುಂತಿಯ ಅಗಲಿಕೆ","ta":"திரௌபதியும் குந்தியும் பிரிகின்றனர்"},"71":{"hi":"पांडवों का प्रस्थान कैसे हुआ","ml":"പാണ്ഡവർ പുറപ്പെട്ടതെങ്ങനെ","te":"పాండవులు ఎలా బయలుదేరారు","kn":"ಪಾಂಡವರು ಹೊರಟ ರೀತಿ","ta":"பாண்டவர்கள் புறப்பட்ட விதம்"},"72":{"hi":"धृतराष्ट्र का पश्चाताप","ml":"ധൃതരാഷ്ട്രരുടെ പശ്ചാത്താപം","te":"ధృతరాష్ట్రుని పశ్చాత్తాపం","kn":"ಧೃತರಾಷ್ಟ್ರನ ಪಶ್ಚಾತ್ತಾಪ","ta":"திருதராஷ்டிரரின் வருத்தம்"}}