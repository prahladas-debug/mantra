{"1":{"hi":"उग्रश्रवा नैमिष वन पहुँचते हैं","ml":"ഉഗ്രശ്രവസ്സ് നൈമിശാരണ്യത്തിൽ എത്തുന്നു","te":"ఉగ్రశ్రవుడు నైమిశారణ్యానికి వస్తాడు","ta":"உக்கிரசிரவஸ் நைமிசாரண்ய வனத்திற்கு வருகிறார்","kn":"ಉಗ್ರಶ್ರವರು ನೈಮಿಷಾರಣ್ಯಕ್ಕೆ ಬರುತ್ತಾರೆ"},"2":{"hi":"सौ पर्वों का सार","ml":"നൂറു പർവങ്ങളുടെ സംക്ഷിപ്ത വിവരണം","te":"నూరు పర్వాల సంగ్రహం","ta":"நூறு பர்வங்களின் சுருக்கம்","kn":"ನೂರು ಪರ್ವಗಳ ಸಾರಾಂಶ"},"3":{"hi":"पौष्य, धौम्य के शिष्यों और उत्तंक की कथाएँ","ml":"പൗഷ്യൻ, ധൗമ്യശിഷ്യർ, ഉതങ്കൻ എന്നിവരുടെ കഥകൾ","te":"పౌష్యుడు, ధౌమ్య శిష్యులు, ఉత్తంకుని కథలు","ta":"பௌஷ்யர், தௌம்யரின் சீடர்கள், உத்தங்கரின் கதைகள்","kn":"ಪೌಷ್ಯ, ಧೌಮ್ಯರ ಶಿಷ್ಯರು ಮತ್ತು ಉತ್ತಂಕನ ಕಥೆಗಳು"},"4":{"hi":"सूत शौनक की प्रतीक्षा करते हैं","ml":"ശൗനകനെ കാത്ത് ചാരണൻ ഇരിക്കുന്നു","te":"శౌనకుని కోసం సూతుడు ఎదురుచూస్తాడు","ta":"சௌனகருக்காகக் காத்திருக்கும் சூதர்","kn":"ಶೌನಕರಿಗಾಗಿ ಸೂತರು ಕಾಯುತ್ತಾರೆ"},"5":{"hi":"पुलोमा और दानव","ml":"പുലോമയും രാക്ഷസനും","te":"పులోమ, రాక్షసుడు","ta":"புலோமையும் அசுரனும்","kn":"ಪುಲೋಮೆ ಮತ್ತು ರಾಕ್ಷಸ"},"6":{"hi":"च्यवन का जन्म और भृगु का अग्नि को शाप","ml":"ച്യവനന്റെ ജനനവും അഗ്നിക്ക് ഭൃഗുവിന്റെ ശാപവും","te":"చ్యవనుని జననం, అగ్నికి భృగువు శాపం","ta":"சியவனரின் பிறப்பும் அக்னிக்குப் பிருகுவின் சாபமும்","kn":"ಚ್ಯವನನ ಜನನ ಮತ್ತು ಭೃಗುವಿನ ಅಗ್ನಿಶಾಪ"},"7":{"hi":"अग्नि लुप्त होते हैं और ब्रह्मा शाप को शिथिल करते हैं","ml":"അഗ്നി പിൻവാങ്ങുന്നു; ബ്രഹ്മാവ് ശാപം ലഘൂകരിക്കുന്നു","te":"అగ్ని వెనుదిరుగుతాడు, బ్రహ్మ శాపాన్ని సడలిస్తాడు","ta":"அக்னி விலகுகிறார், பிரம்மா சாபத்தைத் தணிக்கிறார்","kn":"ಅಗ್ನಿ ಹಿಂದೆ ಸರಿಯುತ್ತಾನೆ; ಬ್ರಹ್ಮನು ಶಾಪವನ್ನು ಸಡಿಲಿಸುತ್ತಾನೆ"},"8":{"hi":"रुरु की वधू प्रमद्वरा सर्पदंश से मरती है","ml":"രുരുവിന്റെ വധു പ്രമദ്വര പാമ്പുകടിയേറ്റ് മരിക്കുന്നു","te":"రురుని భార్య ప్రమద్వర పాము కాటుతో మరణిస్తుంది","ta":"ருருவின் மனைவி பிரமத்வரை பாம்புக்கடியால் இறக்கிறாள்","kn":"ರುರುವಿನ ವಧು ಪ್ರಮದ್ವರೆ ಹಾವುಕಡಿತದಿಂದ ಮರಣಿಸುತ್ತಾಳೆ"},"9":{"hi":"रुरु प्रमद्वरा को अपनी आधी आयु देते हैं","ml":"രുരു പ്രമദ്വരയ്ക്ക് തന്റെ ആയുസ്സിന്റെ പകുതി നൽകുന്നു","te":"రురుడు తన ఆయుష్షులో సగం ప్రమద్వరకు ఇస్తాడు","ta":"ருரு தன் ஆயுளில் பாதியைப் பிரமத்வரைக்கு அளிக்கிறார்","kn":"ರುರು ತನ್ನ ಆಯುಷ್ಯದ ಅರ್ಧವನ್ನು ಪ್ರಮದ್ವರೆಗೆ ನೀಡುತ್ತಾನೆ"},"10":{"hi":"डुंडुभ रुरु से विनती करता है","ml":"ഡുണ്ഡുഭം രുരുവിനോട് അപേക്ഷിക്കുന്നു","te":"డుండుభం రురుని వేడుకుంటుంది","ta":"துண்டுபம் ருருவிடம் கெஞ்சுகிறது","kn":"ದುಂದುಭಿ ರುರುವನ್ನು ಬೇಡುತ್ತದೆ"},"11":{"hi":"सहस्रपाद रुरु को अहिंसा सिखाते हैं","ml":"സഹസ്രപാത് രുരുവിന് അഹിംസ ഉപദേശിക്കുന്നു","te":"సహస్రపాదుడు రురునికి అహింసను బోధిస్తాడు","ta":"சகஸ்ரபாத் ருருவுக்கு அகிம்சையைப் போதிக்கிறார்","kn":"ಸಹಸ್ರಪಾತ್ ರುರುವಿಗೆ ಅಹಿಂಸೆಯನ್ನು ಬೋಧಿಸುತ್ತಾನೆ"},"12":{"hi":"रुरु आस्तीक की कथा सुनते हैं","ml":"ആസ്തികന്റെ കഥ രുരു പഠിക്കുന്നു","te":"రురుడు ఆస్తికుని కథ తెలుసుకుంటాడు","ta":"ருரு ஆஸ்திகரின் கதையை அறிகிறார்","kn":"ರುರು ಆಸ್ತಿಕನ ಕಥೆಯನ್ನು ತಿಳಿಯುತ್ತಾನೆ"},"13":{"hi":"जरत्कारु अपने पितरों से मिलते हैं","ml":"ജരത്കാരു തന്റെ പൂർവികരെ കാണുന്നു","te":"జరత్కారుడు తన పితరులను కలుస్తాడు","ta":"ஜரத்காரு தம் முன்னோர்களைச் சந்திக்கிறார்","kn":"ಜರತ್ಕಾರು ತನ್ನ ಪಿತೃಗಳನ್ನು ಭೇಟಿಯಾಗುತ್ತಾನೆ"},"14":{"hi":"कद्रू और विनता को वरदान मिलते हैं","ml":"കദ്രുവും വിനതയും വരങ്ങൾ നേടുന്നു","te":"కద్రువ, వినతలు వరాలు పొందుతారు","ta":"கத்ருவும் வினதையும் வரம் பெறுகின்றனர்","kn":"ಕದ್ರು ಮತ್ತು ವಿನತೆಯರು ವರಗಳನ್ನು ಪಡೆಯುತ್ತಾರೆ"},"15":{"hi":"देवता समुद्र मंथन का निश्चय करते हैं","ml":"സമുദ്രം കടയാൻ ദേവന്മാർ തീരുമാനിക്കുന്നു","te":"సముద్రాన్ని మథించాలని దేవతలు నిశ్చయిస్తారు","ta":"பாற்கடலைக் கடைய தேவர்கள் தீர்மானிக்கின்றனர்","kn":"ಸಾಗರ ಮಥನಕ್ಕೆ ದೇವತೆಗಳು ನಿಶ್ಚಯಿಸುತ್ತಾರೆ"},"16":{"hi":"समुद्र मंथन","ml":"സമുദ്രമഥനം","te":"సముద్ర మథనం","ta":"பாற்கடல் கடையப்படுதல்","kn":"ಸಾಗರ ಮಥನ"},"17":{"hi":"राहु का सिर और अमृत के लिए युद्ध","ml":"രാഹുവിന്റെ തല; അമൃതിനായുള്ള യുദ്ധം","te":"రాహువు తల, అమృతం కోసం పోరాటం","ta":"ராகுவின் தலையும் அமுதத்திற்கான போரும்","kn":"ರಾಹುವಿನ ತಲೆ ಮತ್ತು ಅಮೃತಕ್ಕಾಗಿ ಯುದ್ಧ"},"18":{"hi":"अश्व की पूँछ पर शर्त","ml":"കുതിരവാലിനെച്ചൊല്ലിയുള്ള പന്തയം","te":"గుర్రం తోకపై పందెం","ta":"குதிரையின் வாலைப் பற்றிய பந்தயம்","kn":"ಕುದುರೆಯ ಬಾಲದ ಕುರಿತ ಪಂದ್ಯ"},"19":{"hi":"दोनों बहनें समुद्र के ऊपर उड़ती हैं","ml":"സഹോദരിമാർ സമുദ്രത്തിനു മീതെ പറക്കുന്നു","te":"అక్కచెల్లెళ్లు సముద్రం మీదుగా ఎగురుతారు","ta":"சகோதரிகள் கடலின் மேல் பறக்கின்றனர்","kn":"ಸಹೋದರಿಯರು ಸಾಗರದ ಮೇಲೆ ಹಾರುತ್ತಾರೆ"},"20":{"hi":"विनता की दासता और गरुड़ का जन्म","ml":"വിനതയുടെ അടിമത്തവും ഗരുഡന്റെ ജനനവും","te":"వినత బానిసత్వం, గరుడుని జననం","ta":"வினதையின் அடிமைத்தனமும் கருடனின் பிறப்பும்","kn":"ವಿನತೆಯ ದಾಸ್ಯ ಮತ್ತು ಗರುಡನ ಜನನ"},"21":{"hi":"कद्रू इंद्र की स्तुति करती हैं","ml":"കദ്രു ഇന്ദ്രനെ സ്തുതിക്കുന്നു","te":"కద్రువ ఇంద్రుని స్తుతిస్తుంది","ta":"கத்ரு இந்திரனைப் போற்றுகிறாள்","kn":"ಕದ್ರು ಇಂದ್ರನನ್ನು ಸ್ತುತಿಸುತ್ತಾಳೆ"},"22":{"hi":"इंद्र सर्पों पर वर्षा भेजते हैं","ml":"ഇന്ദ്രൻ പാമ്പുകളുടെ മേൽ മഴ പെയ്യിക്കുന്നു","te":"ఇంద్రుడు నాగులపై వర్షం కురిపిస్తాడు","ta":"இந்திரன் பாம்புகளின் மேல் மழை பொழிகிறார்","kn":"ಇಂದ್ರನು ಸರ್ಪಗಳ ಮೇಲೆ ಮಳೆ ಸುರಿಸುತ್ತಾನೆ"},"23":{"hi":"स्वतंत्रता का मूल्य: अमृत","ml":"സ്വാതന്ത്ര്യത്തിന്റെ വില: അമൃത്","te":"స్వేచ్ఛకు మూల్యం అమృతం","ta":"விடுதலையின் விலை: அமுதம்","kn":"ಬಿಡುಗಡೆಯ ಬೆಲೆ: ಅಮೃತ"},"24":{"hi":"विनता गरुड़ को आशीर्वाद देती हैं","ml":"വിനത ഗരുഡനെ അനുഗ്രഹിക്കുന്നു","te":"వినత గరుడుని దీవిస్తుంది","ta":"வினதை கருடனை ஆசீர்வதிக்கிறாள்","kn":"ವಿನತೆ ಗರುಡನನ್ನು ಆಶೀರ್ವದಿಸುತ್ತಾಳೆ"},"25":{"hi":"हाथी और कछुआ","ml":"ആനയും ആമയും","te":"ఏనుగు, తాబేలు కథ","ta":"யானையும் ஆமையும்","kn":"ಆನೆ ಮತ್ತು ಆಮೆ"},"26":{"hi":"गरुड़ वालखिल्यों को बचाते हैं","ml":"ഗരുഡൻ വാലഖില്യന്മാരെ രക്ഷിക്കുന്നു","te":"గరుడుడు వాలఖిల్యులను రక్షిస్తాడు","ta":"வாலகில்யர்களை கருடன் காக்கிறார்","kn":"ಗರುಡನು ವಾಲಖಿಲ್ಯರನ್ನು ರಕ್ಷಿಸುತ್ತಾನೆ"},"27":{"hi":"गरुड़ का जन्म इंद्र का गर्व तोड़ने के लिए क्यों हुआ","ml":"ഇന്ദ്രനെ വിനയിപ്പിക്കാൻ ഗരുഡൻ ജനിച്ചത് എന്തുകൊണ്ട്","te":"ఇంద్రుని గర్వం అణచడానికి గరుడుడు జన్మించిన కారణం","ta":"இந்திரனின் செருக்கை அடக்க கருடன் பிறந்ததன் காரணம்","kn":"ಇಂದ್ರನ ಗರ್ವಭಂಗಕ್ಕಾಗಿ ಗರುಡನ ಜನನ ಏಕಾಯಿತು"},"28":{"hi":"गरुड़ देवताओं से युद्ध करते हैं","ml":"ഗരുഡൻ ദേവന്മാരോട് യുദ്ധം ചെയ്യുന്നു","te":"గరుడుడు దేవతలతో పోరాడుతాడు","ta":"கருடன் தேவர்களோடு போரிடுகிறார்","kn":"ಗರುಡನು ದೇವತೆಗಳೊಡನೆ ಹೋರಾಡುತ್ತಾನೆ"},"29":{"hi":"गरुड़ अमृत लेते हैं और विष्णु से मिलते हैं","ml":"ഗരുഡൻ അമൃത് എടുത്ത് വിഷ്ണുവിനെ കാണുന്നു","te":"గరుడుడు అమృతాన్ని తీసుకుని విష్ణువును కలుస్తాడు","ta":"கருடன் அமுதத்தை எடுத்துக்கொண்டு விஷ்ணுவைச் சந்திக்கிறார்","kn":"ಗರುಡನು ಅಮೃತವನ್ನು ಪಡೆದು ವಿಷ್ಣುವನ್ನು ಭೇಟಿಯಾಗುತ್ತಾನೆ"},"30":{"hi":"विनता मुक्त होती हैं और सर्पों की जीभ चिरती है","ml":"വിനത മോചിതയാകുന്നു; പാമ്പുകളുടെ നാവ് പിളരുന്നു","te":"వినత విముక్తి పొందుతుంది, నాగుల నాలుకలు చీలుతాయి","ta":"வினதை விடுதலை பெறுகிறாள், பாம்புகளின் நாக்குகள் பிளக்கப்படுகின்றன","kn":"ವಿನತೆ ಬಿಡುಗಡೆಯಾಗುತ್ತಾಳೆ; ಸರ್ಪಗಳ ನಾಲಿಗೆ ಸೀಳಾಗುತ್ತದೆ"},"31":{"hi":"प्रमुख नाग सर्पों के नाम","ml":"പ്രധാന സർപ്പങ്ങളുടെ പേരുകൾ","te":"ప్రధాన నాగుల పేర్లు","ta":"முதன்மை நாகங்களின் பெயர்கள்","kn":"ಪ್ರಧಾನ ಸರ್ಪಗಳ ಹೆಸರುಗಳು"},"32":{"hi":"शेष को पृथ्वी धारण करने के लिए नियुक्त किया जाता है","ml":"ഭൂമിയെ താങ്ങാൻ ശേഷനെ നിയോഗിക്കുന്നു","te":"భూమిని మోయడానికి శేషుడు నియమితుడవుతాడు","ta":"பூமியைத் தாங்க சேஷன் நியமிக்கப்படுகிறான","kn":"ಭೂಮಿಯನ್ನು ಹೊರಲು ಶೇಷನನ್ನು ನೇಮಿಸಲಾಗುತ್ತದೆ"},"33":{"hi":"वासुकि की नाग-सभा","ml":"വാസുകിയുടെ സർപ്പസഭ","te":"వాసుకి నాగ సభ","ta":"வாசுகியின் நாகர் சபை","kn":"ವಾಸುಕಿಯ ಸರ್ಪ ಸಭೆ"},"34":{"hi":"एलापत्र ब्रह्मा के वचन का स्मरण कराते हैं","ml":"ബ്രഹ്മാവിന്റെ വാഗ്ദാനം ഏലാപത്രൻ ഓർക്കുന്നു","te":"ఏలాపత్రుడు బ్రహ్మ వాగ్దానాన్ని గుర్తుచేస్తాడు","ta":"ஏலாபத்ரர் பிரம்மனின் வாக்குறுதியை நினைவுகூர்கிறார்","kn":"ಏಲಾಪತ್ರನು ಬ್ರಹ್ಮನ ವಚನವನ್ನು ನೆನಪಿಸುತ್ತಾನೆ"},"35":{"hi":"वासुकि अपनी बहन की रक्षा करते हैं","ml":"വാസുകി സഹോദരിയെ കാക്കുന്നു","te":"వాసుకి తన సోదరిని రక్షిస్తాడు","ta":"வாசுகி தன் சகோதரியைக் காக்கிறார்","kn":"ವಾಸುಕಿ ತನ್ನ ತಂಗಿಯನ್ನು ಕಾಯುತ್ತಾನೆ"},"36":{"hi":"परीक्षित मौन ऋषि शमीक का अपमान करते हैं","ml":"മൗനിയായ മുനി ശമീകനെ പരീക്ഷിത്ത് അപമാനിക്കുന്നു","te":"మౌనంగా ఉన్న శమీకుని పరీక్షిత్తు అవమానిస్తాడు","ta":"பரீட்சித்து மௌனத்தில் இருந்த சமீகரை அவமதிக்கிறான்","kn":"ಮೌನಿ ಶಮೀಕ ಋಷಿಗೆ ಪರೀಕ್ಷಿತನು ಅವಮಾನ ಮಾಡುತ್ತಾನೆ"},"37":{"hi":"श्रृंगी परीक्षित को शाप देते हैं","ml":"ശൃംഗി പരീക്ഷിത്തിനെ ശപിക്കുന്നു","te":"శృంగి పరీక్షిత్తుకు శాపమిస్తాడు","ta":"சிருங்கி பரீட்சித்துக்குச் சாபமிடுகிறார்","kn":"ಶೃಂಗಿ ಪರೀಕ್ಷಿತನಿಗೆ ಶಾಪ ನೀಡುತ್ತಾನೆ"},"38":{"hi":"परीक्षित स्वयं को सुरक्षित करते हैं; कश्यप निकलते हैं","ml":"പരീക്ഷിത്ത് സ്വയം കാക്കുന്നു; കശ്യപൻ യാത്ര തിരിക്കുന്നു","te":"పరీక్షిత్తు తనను కాపాడుకుంటాడు, కశ్యపుడు బయలుదేరతాడు","ta":"பரீட்சித்து தன்னைக் காத்துக்கொள்கிறான், காசியபர் புறப்படுகிறார்","kn":"ಪರೀಕ್ಷಿತನು ತನ್ನನ್ನು ಕಾಯ್ದುಕೊಳ್ಳುತ್ತಾನೆ; ಕಶ್ಯಪರು ಹೊರಡುತ್ತಾರೆ"},"39":{"hi":"तक्षक कश्यप को लौटाते हैं और परीक्षित को मारते हैं","ml":"തക്ഷകൻ കശ്യപനെ തിരിച്ചയച്ച് പരീക്ഷിത്തിനെ കൊല്ലുന്നു","te":"తక్షకుడు కశ్యపుని వెనక్కి పంపి పరీక్షిత్తును చంపుతాడు","ta":"தட்சகன் காசியபரைத் திருப்பி அனுப்பி பரீட்சித்தைக் கொல்கிறான்","kn":"ತಕ್ಷಕನು ಕಶ್ಯಪರನ್ನು ಹಿಂದಿರುಗಿಸಿ ಪರೀಕ್ಷಿತನನ್ನು ಕೊಲ್ಲುತ್ತಾನೆ"},"40":{"hi":"जनमेजय राजा बनते हैं","ml":"ജനമേജയൻ രാജാവാകുന്നു","te":"జనమేజయుడు రాజవుతాడు","ta":"ஜனமேஜயன் அரசனாகிறான்","kn":"ಜನಮೇಜಯ ರಾಜನಾಗುತ್ತಾನೆ"},"41":{"hi":"जरत्कारु गड्ढे में लटके अपने पितरों को पाते हैं","ml":"കുഴിയിൽ തൂങ്ങിക്കിടക്കുന്ന പൂർവികരെ ജരത്കാരു കാണുന്നു","te":"గొయ్యిలో వేలాడుతున్న తన పితరులను జరత్కారుడు చూస్తాడు","ta":"குழியில் தொங்கும் தம் முன்னோர்களை ஜரத்காரு காண்கிறார்","kn":"ಜರತ್ಕಾರು ಗುಂಡಿಯಲ್ಲಿ ನೇತಾಡುತ್ತಿರುವ ತನ್ನ ಪಿತೃಗಳನ್ನು ಕಾಣುತ್ತಾನೆ"},"42":{"hi":"जरत्कारु की पत्नी के लिए शर्तें","ml":"ജരത്കാരുവിന്റെ വിവാഹ വ്യവസ്ഥകൾ","te":"భార్య కోసం జరత్కారుడు పెట్టిన షరతులు","ta":"ஜரத்காருவின் மனைவிக்கான நிபந்தனைகள்","kn":"ಜರತ್ಕಾರುವಿನ ಪತ್ನಿಯ ಕುರಿತ ಷರತ್ತುಗಳು"},"43":{"hi":"जरत्कारु विवाह करके प्रस्थान करते हैं","ml":"ജരത്കാരു വിവാഹം കഴിച്ച് യാത്രയാകുന്നു","te":"జరత్కారుడు వివాహం చేసుకుని వెళ్లిపోతాడు","ta":"ஜரத்காரு திருமணம் செய்து புறப்படுகிறார்","kn":"ಜರತ್ಕಾರು ವಿವಾಹವಾಗಿ ಹೊರಡುತ್ತಾನೆ"},"44":{"hi":"आस्तीक का जन्म","ml":"ആസ്തികന്റെ ജനനം","te":"ఆస్తికుని జననం","ta":"ஆஸ்திகரின் பிறப்பு","kn":"ಆಸ್ತಿಕನ ಜನನ"},"45":{"hi":"मंत्री जनमेजय को उनके पिता की बात बताते हैं","ml":"പിതാവിനെക്കുറിച്ച് മന്ത്രിമാർ ജനമേജയനോട് പറയുന്നു","te":"మంత్రులు జనమేజయునికి అతని తండ్రి గురించి చెబుతారు","ta":"அமைச்சர்கள் ஜனமேஜயனுக்குத் தந்தையின் மரணத்தைக் கூறுகின்றனர்","kn":"ಮಂತ್ರಿಗಳು ಜನಮೇಜಯನಿಗೆ ಅವನ ತಂದೆಯ ಕುರಿತು ತಿಳಿಸುತ್ತಾರೆ"},"46":{"hi":"जनमेजय प्रतिशोध का संकल्प लेते हैं","ml":"ജനമേജയൻ പ്രതികാരം ചെയ്യാൻ തീരുമാനിക്കുന്നു","te":"జనమేజయుడు ప్రతీకారం తీర్చుకోవాలని నిశ్చయిస్తాడు","ta":"பழிவாங்கத் தீர்மானிக்கிறான் ஜனமேஜயன்","kn":"ಜನಮೇಜಯ ಸೇಡು ತೀರಿಸಿಕೊಳ್ಳಲು ನಿಶ್ಚಯಿಸುತ್ತಾನೆ"},"47":{"hi":"सर्प-यज्ञ आरंभ होता है","ml":"സർപ്പയാഗം ആരംഭിക്കുന്നു","te":"సర్పయాగం ప్రారంభమవుతుంది","ta":"பாம்புகளுக்கான யாகம் தொடங்குகிறது","kn":"ಸರ್ಪಯಾಗ ಆರಂಭವಾಗುತ್ತದೆ"},"48":{"hi":"तक्षक इंद्र की शरण में जाते हैं; वासुकि आस्तीक को बुलाते हैं","ml":"തക്ഷകൻ ഇന്ദ്രന്റെ അടുത്തേക്ക് ഓടുന്നു; വാസുകി ആസ്തികനെ വിളിപ്പിക്കുന്നു","te":"తక్షకుడు ఇంద్రుని ఆశ్రయిస్తాడు, వాసుకి ఆస్తికుని పిలిపిస్తాడు","ta":"தட்சகன் இந்திரனிடம் ஓடுகிறான், வாசுகி ஆஸ்திகரை அழைக்கிறார்","kn":"ತಕ್ಷಕ ಇಂದ್ರನ ಬಳಿ ಓಡುತ್ತಾನೆ; ವಾಸುಕಿ ಆಸ್ತಿಕನನ್ನು ಕರೆಸುತ್ತಾನೆ"},"49":{"hi":"आस्तीक यज्ञ-स्थल पर जाते हैं","ml":"ആസ്തികൻ യാഗശാലയിലേക്ക് പോകുന്നു","te":"ఆస్తికుడు యాగానికి వెళ్తాడు","ta":"ஆஸ்திகர் யாகசாலைக்குச் செல்கிறார்","kn":"ಆಸ್ತಿಕ ಯಾಗಕ್ಕೆ ಹೋಗುತ್ತಾನೆ"},"50":{"hi":"आस्तीक जनमेजय की प्रशंसा करते हैं","ml":"ജനമേജയനെ ആസ്തികൻ സ്തുതിക്കുന്നു","te":"ఆస్తికుడు జనమేజయుని స్తుతిస్తాడు","ta":"ஜனமேஜயனை ஆஸ்திகர் புகழ்கிறார்","kn":"ಜನಮೇಜಯನನ್ನು ಆಸ್ತಿಕ ಸ್ತುತಿಸುತ್ತಾನೆ"},"51":{"hi":"आस्तीक यज्ञ समाप्त करने की माँग करते हैं","ml":"യാഗം അവസാനിപ്പിക്കണമെന്ന് ആസ്തികൻ ആവശ്യപ്പെടുന്നു","te":"యాగాన్ని ఆపమని ఆస్తికుడు కోరతాడు","ta":"யாகத்தை நிறுத்தும்படி ஆஸ்திகர் கேட்கிறார்","kn":"ಯಾಗವನ್ನು ನಿಲ್ಲಿಸಬೇಕೆಂದು ಆಸ್ತಿಕ ಕೇಳುತ್ತಾನೆ"},"52":{"hi":"अग्नि में भस्म हुए सर्प","ml":"തീയിൽ നശിച്ച സർപ്പങ്ങൾ","te":"అగ్నిలో మరణించిన నాగులు","ta":"நெருப்பில் அழிந்த பாம்புகள்","kn":"ಬೆಂಕಿಯಲ್ಲಿ ಮಡಿದ ಸರ್ಪಗಳು"},"53":{"hi":"यज्ञ समाप्त होता है और सर्प आस्तीक को आशीर्वाद देते हैं","ml":"യാഗം അവസാനിക്കുന്നു; സർപ്പങ്ങൾ ആസ്തികനെ അനുഗ്രഹിക്കുന്നു","te":"యాగం ముగుస్తుంది, నాగులు ఆస్తికుని దీవిస్తాయి","ta":"யாகம் நிறைவடைகிறது, பாம்புகள் ஆஸ்திகரை ஆசீர்வதிக்கின்றன","kn":"ಯಾಗ ಕೊನೆಗೊಳ್ಳುತ್ತದೆ; ಸರ್ಪಗಳು ಆಸ್ತಿಕನನ್ನು ಹರಸುತ್ತವೆ"},"54":{"hi":"व्यास जनमेजय के यज्ञ में आते हैं","ml":"ജനമേജയന്റെ യാഗത്തിൽ വ്യാസൻ എത്തുന്നു","te":"జనమేజయుని యాగానికి వ్యాసుడు వస్తాడు","ta":"ஜனமேஜயனின் யாகத்திற்கு வியாசர் வருகிறார்","kn":"ಜನಮೇಜಯನ ಯಾಗಕ್ಕೆ ವ್ಯಾಸರು ಬರುತ್ತಾರೆ"},"55":{"hi":"वैशंपायन संक्षेप में कथा सुनाते हैं","ml":"വൈശമ്പായനൻ കഥ ചുരുക്കിപ്പറയുന്നു","te":"వైశంపాయనుడు కథను సంక్షిప్తంగా చెబుతాడు","ta":"வைசம்பாயனர் கதையைச் சுருக்கமாகக் கூறுகிறார்","kn":"ವೈಶಂಪಾಯನರು ಕಥೆಯನ್ನು ಸಂಕ್ಷೇಪವಾಗಿ ಹೇಳುತ್ತಾರೆ"},"56":{"hi":"भारत-कथा सुनने का पुण्य","ml":"ഭാരതം കേൾക്കുന്നതിന്റെ പുണ്യം","te":"భారతం వినడం వల్ల కలిగే పుణ్యం","ta":"பாரதத்தைக் கேட்பதன் புண்ணியம்","kn":"ಭಾರತವನ್ನು ಕೇಳುವ ಪುಣ್ಯ"},"57":{"hi":"उपरिचर वसु और सत्यवती व व्यास का जन्म","ml":"ഉപരിചരവസുവും സത്യവതിയുടെയും വ്യാസന്റെയും ജനനവും","te":"ఉపరిచర వసువు, సత్యవతి, వ్యాసుల జననాలు","ta":"உபரிசர வசுவும் சத்தியவதி, வியாசரின் பிறப்புகளும்","kn":"ಉಪರಿಚರ ವಸು; ಸತ್ಯವತಿ ಮತ್ತು ವ್ಯಾಸರ ಜನನ"},"58":{"hi":"पृथ्वी का भार और देवताओं का अवतरण","ml":"ഭൂഭാരവും ദേവന്മാരുടെ ഭൂമിയിലേക്കുള്ള ഇറക്കവും","te":"భూభారం, దేవతల అవతరణ","ta":"பூமியின் பாரமும் தேவர்களின் இறங்குதலும்","kn":"ಭೂಭಾರ ಮತ್ತು ದೇವತೆಗಳ ಅವತಾರ"},"59":{"hi":"देवताओं, दानवों और प्राणियों की उत्पत्ति","ml":"ദേവന്മാർ, അസുരന്മാർ, ജീവികൾ എന്നിവരുടെ ഉത്ഭവം","te":"దేవతలు, రాక్షసులు, జీవుల ఉత్పత్తి","ta":"தேவர்கள், அசுரர்கள், உயிரினங்களின் தோற்றம்","kn":"ದೇವತೆಗಳು, ದಾನವರು ಮತ್ತು ಜೀವಿಗಳ ಉಗಮ"},"60":{"hi":"देवताओं और ऋषियों के वंश","ml":"ദേവന്മാരുടെയും മുനിമാരുടെയും വംശാവലി","te":"దేవతలు, మహర్షుల వంశావళి","ta":"தேவர்கள், முனிவர்களின் வம்சங்கள்","kn":"ದೇವತೆಗಳು ಮತ್ತು ಋಷಿಗಳ ವಂಶಾವಳಿ"},"61":{"hi":"कौन किसके रूप में जन्मा","ml":"ആര് ആരായി ജനിച്ചു","te":"ఎవరు ఎవరిగా జన్మించారు","ta":"யார் யாராகப் பிறந்தனர்","kn":"ಯಾರು ಯಾರಾಗಿ ಜನಿಸಿದರು"},"62":{"hi":"राजा दुष्यंत का शासन","ml":"ദുഷ്യന്ത രാജാവിന്റെ ഭരണം","te":"దుష్యంత మహారాజు పాలన","ta":"துஷ்யந்த மன்னனின் ஆட்சி","kn":"ದುಷ್ಯಂತ ರಾಜನ ಆಳ್ವಿಕೆ"},"63":{"hi":"दुष्यंत का आखेट","ml":"ദുഷ്യന്തന്റെ വേട്ട","te":"దుష్యంతుని వేట","ta":"துஷ்யந்தனின் வேட்டை","kn":"ದುಷ್ಯಂತನ ಬೇಟೆ"},"64":{"hi":"दुष्यंत कण्व के आश्रम पहुँचते हैं","ml":"ദുഷ്യന്തൻ കണ്വാശ്രമത്തിൽ എത്തുന്നു","te":"దుష్యంతుడు కణ్వుని ఆశ్రమానికి చేరుకుంటాడు","ta":"துஷ்யந்தன் கண்வரின் ஆசிரமத்தை அடைகிறான்","kn":"ದುಷ್ಯಂತ ಕಣ್ವರ ಆಶ್ರಮವನ್ನು ತಲುಪುತ್ತಾನೆ"},"65":{"hi":"दुष्यंत शकुंतला से मिलते हैं","ml":"ദുഷ്യന്തൻ ശകുന്തളയെ കണ്ടുമുട്ടുന്നു","te":"దుష్యంతుడు శకుంతలను కలుస్తాడు","ta":"துஷ்யந்தன் சகுந்தலையைச் சந்திக்கிறான்","kn":"ದುಷ್ಯಂತ ಶಕುಂತಲೆಯನ್ನು ಭೇಟಿಯಾಗುತ್ತಾನೆ"},"66":{"hi":"शकुंतला का जन्म","ml":"ശകുന്തളയുടെ ജനനം","te":"శకుంతల జననం","ta":"சகுந்தலையின் பிறப்பு","kn":"ಶಕುಂತಲೆಯ ಜನನ"},"67":{"hi":"गांधर्व विवाह","ml":"ഗാന്ധർവ വിവാഹം","te":"గాంధర్వ వివాహం","ta":"காந்தர்வ திருமணம்","kn":"ಗಾಂಧರ್ವ ವಿವಾಹ"},"68":{"hi":"दुष्यंत के दरबार में शकुंतला","ml":"ദുഷ്യന്തന്റെ സദസ്സിൽ ശകുന്തള","te":"దుష్యంతుని సభలో శకుంతల","ta":"துஷ்யந்தனின் அரண்மனையில் சகுந்தலை","kn":"ದುಷ್ಯಂತನ ಆಸ್ಥಾನದಲ್ಲಿ ಶಕುಂತಲೆ"},"69":{"hi":"आकाशवाणी भरत की घोषणा करती है","ml":"ഭരതനെ പ്രഖ്യാപിച്ച് സ്വർഗ്ഗത്തിൽ നിന്നൊരു ശബ്ദം","te":"ఆకాశవాణి భరతుని ప్రకటిస్తుంది","ta":"விண்ணிலிருந்து ஒலித்த குரல் பரதனை அறிவிக்கிறது","kn":"ಆಕಾಶವಾಣಿ ಭರತನನ್ನು ಘೋಷಿಸುತ್ತದೆ"},"70":{"hi":"दक्ष से ययाति तक","ml":"ദക്ഷൻ മുതൽ യയാതി വരെ","te":"దక్షుని నుండి యయాతి వరకు","ta":"தட்சன் முதல் யயாதி வரை","kn":"ದಕ್ಷನಿಂದ ಯಯಾತಿಯವರೆಗೆ"},"71":{"hi":"कच संजीवनी विद्या का रहस्य सीखते हैं","ml":"പുനരുജ്ജീവനത്തിന്റെ രഹസ്യം കചൻ പഠിക്കുന്നു","te":"మృతసంజీవని విద్యను కచుడు నేర్చుకుంటాడు","ta":"கசன் உயிர்ப்பிக்கும் ரகசியத்தை அறிகிறான்","kn":"ಕಚನು ಸಂಜೀವಿನಿ ವಿದ್ಯೆಯ ರಹಸ್ಯವನ್ನು ತಿಳಿಯುತ್ತಾನೆ"},"72":{"hi":"कच और देवयानी एक-दूसरे को शाप देते हैं","ml":"കചനും ദേവയാനിയും പരസ്പരം ശപിക്കുന്നു","te":"కచుడు, దేవయాని ఒకరికొకరు శాపమిచ్చుకుంటారు","ta":"கசனும் தேவயானியும் ஒருவரையொருவர் சபிக்கின்றனர்","kn":"ಕಚ ಮತ್ತು ದೇವಯಾನಿ ಪರಸ್ಪರ ಶಾಪ ನೀಡುತ್ತಾರೆ"},"73":{"hi":"शर्मिष्ठा देवयानी को कुएँ में गिराती है","ml":"ശർമ്മിഷ്ഠ ദേവയാനിയെ കിണറ്റിൽ തള്ളിയിടുന്നു","te":"శర్మిష్ఠ దేవయానిని బావిలో పడేస్తుంది","ta":"சர்மிஷ்டை தேவயானியைக் கிணற்றில் தள்ளுகிறாள்","kn":"ಶರ್ಮಿಷ್ಠೆ ದೇವಯಾನಿಯನ್ನು ಬಾವಿಗೆ ತಳ್ಳುತ್ತಾಳೆ"},"74":{"hi":"शुक्राचार्य धैर्य रखने का उपदेश देते हैं","ml":"ക്ഷമ വേണമെന്ന് ശുക്രൻ ഉപദേശിക്കുന്നു","te":"శుక్రాచార్యుడు ఓర్పు వహించమని బోధిస్తాడు","ta":"சுக்கிரர் பொறுமையை அறிவுறுத்துகிறார்","kn":"ಶುಕ್ರನು ಸಹನೆಯನ್ನು ಉಪದೇಶಿಸುತ್ತಾನೆ"},"75":{"hi":"शर्मिष्ठा देवयानी की दासी बनती है","ml":"ശർമ്മിഷ്ഠ ദേവയാനിയുടെ ദാസിയാകുന്നു","te":"శర్మిష్ఠ దేవయానికి దాసి అవుతుంది","ta":"சர்மிஷ்டை தேவயானியின் பணிப்பெண்ணாகிறாள்","kn":"ಶರ್ಮಿಷ್ಠೆ ದೇವಯಾನಿಯ ದಾಸಿಯಾಗುತ್ತಾಳೆ"},"76":{"hi":"ययाति देवयानी से विवाह करते हैं","ml":"യയാതി ദേവയാനിയെ വിവാഹം കഴിക്കുന്നു","te":"యయాతి దేవయానిని వివాహం చేసుకుంటాడు","ta":"யயாதி தேவயானியைத் திருமணம் செய்கிறான்","kn":"ಯಯಾತಿ ದೇವಯಾನಿಯನ್ನು ವಿವಾಹವಾಗುತ್ತಾನೆ"},"77":{"hi":"शर्मिष्ठा ययाति के पास जाती है","ml":"ശർമ്മിഷ്ഠ യയാതിയെ സമീപിക്കുന്നു","te":"శర్మిష్ఠ యయాతిని సమీపిస్తుంది","ta":"சர்மிஷ்டை யயாதியை அணுகுகிறாள்","kn":"ಶರ್ಮಿಷ್ಠೆ ಯಯಾತಿಯನ್ನು ಸಮೀಪಿಸುತ್ತಾಳೆ"},"78":{"hi":"शुक्राचार्य ययाति को वृद्धावस्था का शाप देते हैं","ml":"യയാതിക്ക് വാർധക്യം നൽകി ശുക്രൻ ശപിക്കുന്നു","te":"శుక్రాచార్యుడు యయాతికి వార్ధక్య శాపమిస్తాడు","ta":"சுக்கிரர் யயாதிக்கு முதுமையால் சாபமிடுகிறார்","kn":"ಶುಕ್ರನು ಯಯಾತಿಗೆ ವೃದ್ಧಾಪ್ಯದ ಶಾಪ ನೀಡುತ್ತಾನೆ"},"79":{"hi":"पुरु पिता की वृद्धावस्था ले लेते हैं","ml":"പിതാവിന്റെ വാർധക്യം പുരു ഏറ്റെടുക്കുന്നു","te":"పూరుడు తండ్రి వార్ధక్యాన్ని స్వీకరిస్తాడు","ta":"புரு தன் தந்தையின் முதுமையை ஏற்கிறான்","kn":"ಪುರು ತಂದೆಯ ವೃದ್ಧಾಪ್ಯವನ್ನು ಸ್ವೀಕರಿಸುತ್ತಾನೆ"},"80":{"hi":"ययाति पुरु का यौवन लौटाते हैं और उन्हें राजा बनाते हैं","ml":"പുരുവിന്റെ യൗവനം തിരികെ നൽകി യയാതി അവനെ രാജാവാക്കുന്നു","te":"యయాతి పూరునికి యౌవనాన్ని తిరిగిస్తాడు, పట్టాభిషేకం చేస్తాడు","ta":"யயாதி புருவின் இளமையைத் திருப்பித் தந்து அவனுக்கு முடிசூட்டுகிறான்","kn":"ಯಯಾತಿ ಪುರುವಿನ ಯೌವನವನ್ನು ಹಿಂದಿರುಗಿಸಿ ಪಟ್ಟಾಭಿಷೇಕ ಮಾಡುತ್ತಾನೆ"},"81":{"hi":"ययाति की तपस्या और स्वर्गारोहण","ml":"യയാതിയുടെ തപസ്സും സ്വർഗ്ഗാരോഹണവും","te":"యయాతి తపస్సు, స్వర్గారోహణం","ta":"யயாதியின் தவமும் சொர்க்கத்திற்கு ஏறுதலும்","kn":"ಯಯಾತಿಯ ತಪಸ್ಸು ಮತ್ತು ಸ್ವರ್ಗಾರೋಹಣ"},"82":{"hi":"पुरु को दी गई ययाति की सीख का स्मरण","ml":"പുരുവിന് നൽകിയ ഉപദേശം യയാതി ഓർക്കുന്നു","te":"పూరునికి యయాతి ఇచ్చిన ఉపదేశం గుర్తుచేయబడుతుంది","ta":"புருவுக்கு யயாதி கூறிய அறிவுரை நினைவுகூரப்படுகிறது","kn":"ಪುರುವಿಗೆ ಯಯಾತಿಯ ಉಪದೇಶದ ಸ್ಮರಣೆ"},"83":{"hi":"ययाति स्वर्ग से गिरते हैं","ml":"യയാതി സ്വർഗ്ഗത്തിൽ നിന്ന് വീഴുന്നു","te":"యయాతి స్వర్గం నుండి పడిపోతాడు","ta":"யயாதி சொர்க்கத்திலிருந்து வீழ்கிறான்","kn":"ಯಯಾತಿ ಸ್ವರ್ಗದಿಂದ ಬೀಳುತ್ತಾನೆ"},"84":{"hi":"ययाति अष्टक से मिलते हैं","ml":"യയാതി അഷ്ടകനെ കാണുന്നു","te":"యయాతి అష్టకుని కలుస్తాడు","ta":"யயாதி அஷ்டகரைச் சந்திக்கிறான்","kn":"ಯಯಾತಿ ಅಷ್ಟಕನನ್ನು ಭೇಟಿಯಾಗುತ್ತಾನೆ"},"85":{"hi":"स्वर्ग, नरक और पुनर्जन्म पर ययाति","ml":"സ്വർഗ്ഗം, നരകം, പുനർജന്മം: യയാതിയുടെ വാക്കുകൾ","te":"స్వర్గం, నరకం, పునర్జన్మపై యయాతి మాటలు","ta":"சொர்க்கம், நரகம், மறுபிறப்பு பற்றி யயாதி","kn":"ಸ್ವರ್ಗ, ನರಕ ಮತ್ತು ಪುನರ್ಜನ್ಮದ ಕುರಿತು ಯಯಾತಿ"},"86":{"hi":"जीवन के चार आश्रम","ml":"ജീവിതത്തിന്റെ നാല് ഘട്ടങ്ങൾ","te":"జీవితంలోని నాలుగు ఆశ్రమాలు","ta":"வாழ்க்கையின் நான்கு நிலைகள்","kn":"ಜೀವನದ ನಾಲ್ಕು ಆಶ್ರಮಗಳು"},"87":{"hi":"राजर्षि ययाति को अपने लोक अर्पित करते हैं","ml":"രാജർഷിമാർ യയാതിക്ക് തങ്ങളുടെ ലോകങ്ങൾ വാഗ്ദാനം ചെയ്യുന്നു","te":"రాజర్షులు యయాతికి తమ లోకాలను అర్పిస్తారు","ta":"அரச முனிவர்கள் யயாதிக்குத் தம் உலகங்களை அளிக்கின்றனர்","kn":"ರಾಜರ್ಷಿಗಳು ಯಯಾತಿಗೆ ತಮ್ಮ ಲೋಕಗಳನ್ನು ಅರ್ಪಿಸುತ್ತಾರೆ"},"88":{"hi":"ययाति अपने पौत्रों के साथ स्वर्ग जाते हैं","ml":"യയാതി പേരക്കുട്ടികളോടൊപ്പം സ്വർഗ്ഗത്തിലേക്ക് ഉയരുന്നു","te":"యయాతి మనవళ్లతో కలిసి స్వర్గానికి ఎక్కుతాడు","ta":"யயாதி தன் பேரர்களுடன் மேலேறுகிறான்","kn":"ಯಯಾತಿ ತನ್ನ ಮೊಮ್ಮಕ್ಕಳೊಂದಿಗೆ ಸ್ವರ್ಗಕ್ಕೇರುತ್ತಾನೆ"},"89":{"hi":"पुरु से कुरु तक पौरव राजा","ml":"പുരു മുതൽ കുരു വരെയുള്ള പൗരവ രാജാക്കന്മാർ","te":"పూరుని నుండి కురువు వరకు పౌరవ రాజులు","ta":"புருவிலிருந்து குரு வரையிலான பௌரவ மன்னர்கள்","kn":"ಪುರುವಿನಿಂದ ಕುರುವಿನವರೆಗಿನ ಪೌರವ ರಾಜರು"},"90":{"hi":"पांडवों तक की पूरी वंशावली","ml":"പാണ്ഡവർ വരെയുള്ള പൂർണ്ണ വംശാവലി","te":"పాండవుల వరకు పూర్తి వంశావళి","ta":"பாண்டவர்கள் வரையிலான முழு வம்சாவளி","kn":"ಪಾಂಡವರವರೆಗಿನ ಸಂಪೂರ್ಣ ವಂಶಾವಳಿ"},"91":{"hi":"महाभिष का शाप और वसुओं का गंगा के साथ समझौता","ml":"മഹാഭിഷയുടെ ശാപവും വസുക്കളുടെ ഗംഗയുമായുള്ള ഉടമ്പടിയും","te":"మహాభిషుని శాపం, గంగతో వసువుల ఒప్పందం","ta":"மஹாபிஷனின் சாபமும் வசுக்களின் கங்கையுடனான உடன்படிக்கையும்","kn":"ಮಹಾಭಿಷನ ಶಾಪ ಮತ್ತು ವಸುಗಳ ಗಂಗೆಯೊಂದಿಗಿನ ಒಪ್ಪಂದ"},"92":{"hi":"शांतनु गंगा से विवाह करते हैं और भीष्म का जन्म होता है","ml":"ശന്തനു ഗംഗയെ വിവാഹം കഴിക്കുന്നു; ഭീഷ്മർ ജനിക്കുന്നു","te":"శంతనుడు గంగను వివాహం చేసుకుంటాడు, భీష్ముడు జన్మిస్తాడు","ta":"சந்தனு கங்கையை மணக்கிறார், பீஷ்மர் பிறக்கிறார்","kn":"ಶಂತನು ಗಂಗೆಯನ್ನು ವಿವಾಹವಾಗುತ್ತಾನೆ; ಭೀಷ್ಮರ ಜನನ"},"93":{"hi":"वसिष्ठ ने वसुओं को शाप क्यों दिया","ml":"വസിഷ്ഠൻ വസുക്കളെ ശപിച്ചത് എന്തുകൊണ്ട്","te":"వసువులకు వశిష్ఠుడు శాపమివ్వడానికి కారణం","ta":"வசிஷ்டர் வசுக்களுக்குச் சாபமிட்டதன் காரணம்","kn":"ವಸಿಷ್ಠರು ವಸುಗಳಿಗೆ ಶಾಪ ನೀಡಿದ ಕಾರಣ"},"94":{"hi":"देवव्रत की कठोर प्रतिज्ञा","ml":"ദേവവ്രതന്റെ ഭീകരമായ പ്രതിജ്ഞ","te":"దేవవ్రతుని భీకర ప్రతిజ్ఞ","ta":"தேவவிரதனின் கடும் சபதம்","kn":"ದೇವವ್ರತನ ಭೀಕರ ಪ್ರತಿಜ್ಞೆ"},"95":{"hi":"चित्रांगद और गंधर्व","ml":"ചിത്രാംഗദനും ഗന്ധർവനും","te":"చిత్రాంగదుడు, గంధర్వుడు","ta":"சித்ராங்கதனும் கந்தர்வனும்","kn":"ಚಿತ್ರಾಂಗದ ಮತ್ತು ಗಂಧರ್ವ"},"96":{"hi":"भीष्म काशी की राजकुमारियों को जीतते हैं","ml":"കാശിയിലെ രാജകുമാരിമാരെ ഭീഷ്മർ നേടുന്നു","te":"కాశీ రాకుమార్తెలను భీష్ముడు గెలుస్తాడు","ta":"காசி இளவரசிகளை பீஷ்மர் வெல்கிறார்","kn":"ಕಾಶಿಯ ರಾಜಕುಮಾರಿಯರನ್ನು ಭೀಷ್ಮರು ಗೆಲ್ಲುತ್ತಾರೆ"},"97":{"hi":"सत्यवती भीष्म से वंश आगे बढ़ाने को कहती हैं","ml":"വംശം തുടരാൻ സത്യവതി ഭീഷ്മരോട് ആവശ്യപ്പെടുന്നു","te":"వంశాన్ని కొనసాగించమని సత్యవతి భీష్ముని కోరుతుంది","ta":"வம்சம் தொடர பீஷ்மரிடம் சத்தியவதி கேட்கிறாள்","kn":"ವಂಶವನ್ನು ಮುಂದುವರಿಸಲು ಸತ್ಯವತಿ ಭೀಷ್ಮರನ್ನು ಕೇಳುತ್ತಾಳೆ"},"98":{"hi":"वंश चलाने के पूर्व उदाहरण","ml":"വംശം തുടരുന്നതിനുള്ള മുൻ ഉദാഹരണങ്ങൾ","te":"వంశాన్ని కొనసాగించడానికి పూర్వ ఉదాహరణలు","ta":"வம்சம் தொடர்வதற்கான முன்னுதாரணங்கள்","kn":"ವಂಶ ಮುಂದುವರಿಸುವ ಪೂರ್ವ ನಿದರ್ಶನಗಳು"},"99":{"hi":"सत्यवती व्यास को बुलाती हैं","ml":"സത്യവതി വ്യാസനെ വിളിച്ചുവരുത്തുന്നു","te":"సత్యవతి వ్యాసుని పిలిపిస్తుంది","ta":"சத்தியவதி வியாசரை அழைக்கிறாள்","kn":"ಸತ್ಯವತಿ ವ್ಯಾಸರನ್ನು ಕರೆಸುತ್ತಾಳೆ"},"100":{"hi":"धृतराष्ट्र, पांडु और विदुर का जन्म","ml":"ധൃതരാഷ്ട്രർ, പാണ്ഡു, വിദുരർ എന്നിവരുടെ ജനനം","te":"ధృతరాష్ట్రుడు, పాండురాజు, విదురుల జననాలు","ta":"திருதராஷ்டிரர், பாண்டு, விதுரரின் பிறப்புகள்","kn":"ಧೃತರಾಷ್ಟ್ರ, ಪಾಂಡು ಮತ್ತು ವಿದುರರ ಜನನ"},"101":{"hi":"विदुर के रूप में धर्म का जन्म: अणीमांडव्य की कथा","ml":"വിദുരനായി ജനിച്ച ധർമ്മൻ: അണിമാണ്ഡവ്യന്റെ കഥ","te":"విదురుడిగా జన్మించిన ధర్ముడు, అణీమాండవ్యుని కథ","ta":"விதுரராகப் பிறந்த தர்மன், அணிமாண்டவ்யரின் கதை","kn":"ವಿದುರನಾಗಿ ಜನಿಸಿದ ಧರ್ಮ; ಅಣಿಮಾಂಡವ್ಯನ ಕಥೆ"},"102":{"hi":"राज्य समृद्ध होता है; पांडु राजा बनते हैं","ml":"രാജ്യം അഭിവൃദ്ധിപ്പെടുന്നു; പാണ്ഡു രാജാവാകുന്നു","te":"రాజ్యం సుభిక్షమవుతుంది, పాండురాజు రాజవుతాడు","ta":"நாடு செழிக்கிறது, பாண்டு அரசனாகிறான்","kn":"ರಾಜ್ಯ ಸಮೃದ್ಧವಾಗುತ್ತದೆ; ಪಾಂಡು ರಾಜನಾಗುತ್ತಾನೆ"},"103":{"hi":"गांधारी धृतराष्ट्र से विवाह करती हैं","ml":"ഗാന്ധാരി ധൃതരാഷ്ട്രരെ വിവാഹം കഴിക്കുന്നു","te":"గాంధారి ధృతరాష్ట్రుని వివాహం చేసుకుంటుంది","ta":"காந்தாரி திருதராஷ்டிரரை மணக்கிறாள்","kn":"ಗಾಂಧಾರಿ ಧೃತರಾಷ್ಟ್ರನನ್ನು ವಿವಾಹವಾಗುತ್ತಾಳೆ"},"104":{"hi":"कुंती और कर्ण का जन्म","ml":"കുന്തിയും കർണ്ണന്റെ ജനനവും","te":"కుంతి, కర్ణుని జననం","ta":"குந்தியும் கர்ணனின் பிறப்பும்","kn":"ಕುಂತಿ ಮತ್ತು ಕರ್ಣನ ಜನನ"},"105":{"hi":"पांडु कुंती और माद्री से विवाह करते हैं और पृथ्वी पर विजय पाते हैं","ml":"പാണ്ഡു കുന്തിയെയും മാദ്രിയെയും വിവാഹം കഴിച്ച് ഭൂമി കീഴടക്കുന്നു","te":"పాండురాజు కుంతి, మాద్రిలను వివాహం చేసుకుని భూమిని జయిస్తాడు","ta":"பாண்டு குந்தி, மாத்ரியை மணந்து பூமியை வெல்கிறான்","kn":"ಪಾಂಡು ಕುಂತಿ ಮತ್ತು ಮಾದ್ರಿಯನ್ನು ವಿವಾಹವಾಗಿ ಭೂಮಿಯನ್ನು ಗೆಲ್ಲುತ್ತಾನೆ"},"106":{"hi":"पांडु वन चले जाते हैं; विदुर विवाह करते हैं","ml":"പാണ്ഡു വനത്തിലേക്ക് പിൻവാങ്ങുന്നു; വിദുരൻ വിവാഹം കഴിക്കുന്നു","te":"పాండురాజు అరణ్యానికి వెళ్తాడు, విదురుడు వివాహం చేసుకుంటాడు","ta":"பாண்டு காட்டிற்குச் செல்கிறான், விதுரர் திருமணம் செய்கிறார்","kn":"ಪಾಂಡು ಅರಣ್ಯಕ್ಕೆ ತೆರಳುತ್ತಾನೆ; ವಿದುರ ವಿವಾಹವಾಗುತ್ತಾನೆ"},"107":{"hi":"सौ कौरवों का जन्म","ml":"നൂറ് കൗരവരുടെ ജനനം","te":"నూరుగురు కౌరవుల జననం","ta":"நூறு கௌரவர்களின் பிறப்பு","kn":"ನೂರು ಕೌರವರ ಜನನ"},"108":{"hi":"धृतराष्ट्र के पुत्रों के नाम","ml":"ധൃതരാഷ്ട്രരുടെ പുത്രന്മാരുടെ പേരുകൾ","te":"ధృతరాష్ట్రుని కుమారుల పేర్లు","ta":"திருதராஷ்டிரரின் புதல்வர்களின் பெயர்கள்","kn":"ಧೃತರಾಷ್ಟ್ರನ ಪುತ್ರರ ಹೆಸರುಗಳು"},"109":{"hi":"पांडु ऋषि किंदम की हत्या करते हैं","ml":"പാണ്ഡു കിന്ദമ മുനിയെ കൊല്ലുന്നു","te":"పాండురాజు కిందముడు అనే మహర్షిని చంపుతాడు","ta":"கிந்தம முனிவரை பாண்டு கொல்கிறான்","kn":"ಪಾಂಡು ಋಷಿ ಕಿಂದಮನನ್ನು ಕೊಲ್ಲುತ್ತಾನೆ"},"110":{"hi":"पांडु संसार का त्याग करते हैं","ml":"പാണ്ഡു ലോകത്തെ ഉപേക്ഷിക്കുന്നു","te":"పాండురాజు సంసారాన్ని త్యజిస్తాడు","ta":"பாண்டு உலகைத் துறக்கிறான்","kn":"ಪಾಂಡು ಸಂಸಾರವನ್ನು ತ್ಯಜಿಸುತ್ತಾನೆ"},"111":{"hi":"पांडु पुत्रों की कामना करते हैं","ml":"പാണ്ഡു പുത്രന്മാരെ ആഗ്രഹിക്കുന്നു","te":"పుత్రుల కోసం పాండురాజు ఆరాటపడతాడు","ta":"பாண்டு மகன்களை விரும்புகிறான்","kn":"ಪಾಂಡು ಪುತ್ರರಿಗಾಗಿ ಹಂಬಲಿಸುತ್ತಾನೆ"},"112":{"hi":"कुंती भद्रा और व्युषिताश्व की कथा सुनाती हैं","ml":"ഭദ്രയെയും വ്യുഷിതാശ്വനെയും കുറിച്ച് കുന്തി പറയുന്നു","te":"భద్ర, వ్యుషితాశ్వుల గురించి కుంతి చెబుతుంది","ta":"பத்ரையையும் வ்யுஷிதாஷ்வனையும் பற்றி குந்தி கூறுகிறாள்","kn":"ಭದ್ರೆ ಮತ್ತು ವ್ಯುಷಿತಾಶ್ವರ ಕುರಿತು ಕುಂತಿ ಹೇಳುತ್ತಾಳೆ"},"113":{"hi":"प्राचीन प्रथा और दुर्वासा का मंत्र","ml":"പുരാതന ആചാരവും ദുർവാസാവിന്റെ മന്ത്രവും","te":"పురాతన ఆచారం, దుర్వాసుని మంత్రం","ta":"பண்டைய வழக்கமும் துர்வாசரின் மந்திரமும்","kn":"ಪುರಾತನ ಸಂಪ್ರದಾಯ ಮತ್ತು ದುರ್ವಾಸರ ಮಂತ್ರ"},"114":{"hi":"युधिष्ठिर, भीम और अर्जुन का जन्म","ml":"യുധിഷ്ഠിരൻ, ഭീമൻ, അർജ്ജുനൻ എന്നിവരുടെ ജനനം","te":"ధర్మరాజు, భీముడు, అర్జునుల జననాలు","ta":"யுதிட்டிரன், பீமன், அர்ஜுனன் பிறப்பு","kn":"ಯುಧಿಷ್ಠಿರ, ಭೀಮ ಮತ್ತು ಅರ್ಜುನರ ಜನನ"},"115":{"hi":"नकुल और सहदेव का जन्म","ml":"നകുലന്റെയും സഹദേവന്റെയും ജനനം","te":"నకుల, సహదేవుల జననాలు","ta":"நகுலன், சகாதேவன் பிறப்பு","kn":"ನಕುಲ ಮತ್ತು ಸಹದೇವರ ಜನನ"},"116":{"hi":"पांडु और माद्री की मृत्यु","ml":"പാണ്ഡുവിന്റെയും മാദ്രിയുടെയും മരണം","te":"పాండురాజు, మాద్రి మరణం","ta":"பாண்டு, மாத்ரியின் மரணம்","kn":"ಪಾಂಡು ಮತ್ತು ಮಾದ್ರಿಯ ಮರಣ"},"117":{"hi":"ऋषि पांडवों को हस्तिनापुर लाते हैं","ml":"മുനിമാർ പാണ്ഡവരെ ഹസ്തിനാപുരത്തേക്ക് കൊണ്ടുവരുന്നു","te":"మహర్షులు పాండవులను హస్తినాపురానికి తీసుకువస్తారు","ta":"முனிவர்கள் பாண்டவர்களை அஸ்தினாபுரத்திற்கு அழைத்து வருகின்றனர்","kn":"ಋಷಿಗಳು ಪಾಂಡವರನ್ನು ಹಸ್ತಿನಾಪುರಕ್ಕೆ ಕರೆತರುತ್ತಾರೆ"},"118":{"hi":"पांडु का अंतिम संस्कार","ml":"പാണ്ഡുവിന്റെ ശവസംസ്കാരം","te":"పాండురాజు అంత్యక్రియలు","ta":"பாண்டுவின் இறுதிச் சடங்கு","kn":"ಪಾಂಡುವಿನ ಉತ್ತರಕ್ರಿಯೆ"},"119":{"hi":"सत्यवती प्रस्थान करती हैं; दुर्योधन भीम को विष देता है","ml":"സത്യവതി മടങ്ങുന്നു; ദുര്യോധനൻ ഭീമനെ വിഷം കൊടുക്കുന്നു","te":"సత్యవతి వెళ్లిపోతుంది, దుర్యోధనుడు భీమునికి విషం పెడతాడు","ta":"சத்தியவதி புறப்படுகிறாள், துரியோதனன் பீமனுக்கு நஞ்சு கொடுக்கிறான்","kn":"ಸತ್ಯವತಿ ನಿರ್ಗಮಿಸುತ್ತಾಳೆ; ದುರ್ಯೋಧನನು ಭೀಮನಿಗೆ ವಿಷ ಹಾಕುತ್ತಾನೆ"},"120":{"hi":"कृप और कृपी का जन्म","ml":"കൃപരുടെയും കൃപിയുടെയും ജനനം","te":"కృపాచార్యుడు, కృపి జననం","ta":"கிருபர், கிருபியின் பிறப்பு","kn":"ಕೃಪ ಮತ್ತು ಕೃಪಿಯ ಜನನ"},"121":{"hi":"द्रोण का जन्म; राम से उन्हें अस्त्र मिलते हैं","ml":"ദ്രോണരുടെ ജനനം; രാമനിൽ നിന്ന് ആയുധങ്ങൾ","te":"ద్రోణుని జననం, రాముని నుండి అతని ఆయుధాలు","ta":"துரோணரின் பிறப்பு, இராமரிடமிருந்து அவர் ஆயுதங்கள் பெறுதல்","kn":"ದ್ರೋಣರ ಜನನ; ರಾಮನಿಂದ ಅವರಿಗೆ ಶಸ್ತ್ರಾಸ್ತ್ರಗಳು"},"122":{"hi":"द्रुपद द्रोण का तिरस्कार करते हैं; द्रोण हस्तिनापुर आते हैं","ml":"ദ്രുപദൻ ദ്രോണരെ തള്ളുന്നു; ദ്രോണർ ഹസ്തിനാപുരത്തെത്തുന്നു","te":"ద్రుపదుడు ద్రోణుని తిరస్కరిస్తాడు, ద్రోణుడు హస్తినాపురానికి వస్తాడు","ta":"துருபதன் துரோணரை நிராகரிக்கிறான், துரோணர் அஸ்தினாபுரம் வருகிறார்","kn":"ದ್ರುಪದನು ದ್ರೋಣರನ್ನು ತಿರಸ್ಕರಿಸುತ್ತಾನೆ; ದ್ರೋಣರು ಹಸ್ತಿನಾಪುರಕ್ಕೆ ಬರುತ್ತಾರೆ"},"123":{"hi":"अर्जुन की भक्ति और एकलव्य का अंगूठा","ml":"അർജ്ജുനന്റെ ഭക്തിയും ഏകലവ്യന്റെ പെരുവിരലും","te":"అర్జునుని భక్తి, ఏకలవ్యుని బొటనవేలు","ta":"அர்ஜுனனின் பக்தியும் ஏகலைவனின் கட்டைவிரலும்","kn":"ಅರ್ಜುನನ ಭಕ್ತಿ ಮತ್ತು ಏಕಲವ್ಯನ ಹೆಬ್ಬೆರಳು"},"124":{"hi":"राजकुमारों का शस्त्र-प्रदर्शन","ml":"രാജകുമാരന്മാരുടെ മത്സരം","te":"రాకుమారుల పోటీ","ta":"இளவரசர்களின் போட்டி","kn":"ರಾಜಕುಮಾರರ ರಣಕೌಶಲ ಪ್ರದರ್ಶನ"},"125":{"hi":"भीम और दुर्योधन में भिड़ंत; अर्जुन का कौशल","ml":"ഭീമനും ദുര്യോധനനും ഏറ്റുമുട്ടുന്നു; അർജ്ജുനന്റെ പ്രകടനം","te":"భీమ దుర్యోధనుల ఘర్షణ, అర్జునుని ప్రదర్శన","ta":"பீமனும் துரியோதனனும் மோதுகின்றனர், அர்ஜுனனின் திறமை வெளிப்பாடு","kn":"ಭೀಮ ಮತ್ತು ದುರ್ಯೋಧನರ ಘರ್ಷಣೆ; ಅರ್ಜುನನ ಪ್ರದರ್ಶನ"},"126":{"hi":"कर्ण अर्जुन को चुनौती देते हैं और अंग का राजा बनाए जाते हैं","ml":"കർണ്ണൻ അർജ്ജുനനെ വെല്ലുവിളിക്കുന്നു; അംഗരാജാവാകുന്നു","te":"కర్ణుడు అర్జునుని సవాలు చేస్తాడు, అంగ రాజ్యానికి రాజవుతాడు","ta":"கர்ணன் அர்ஜுனனுக்கு சவால் விடுக்கிறான், அங்கநாட்டு அரசனாக்கப்படுகிறான்","kn":"ಕರ್ಣ ಅರ್ಜುನನಿಗೆ ಸವಾಲೊಡ್ಡುತ್ತಾನೆ; ಅಂಗ ದೇಶದ ರಾಜನಾಗುತ್ತಾನೆ"},"127":{"hi":"अधिरथ प्रकट होते हैं; दुर्योधन कर्ण का पक्ष लेते हैं","ml":"അധിരഥൻ പ്രത്യക്ഷനാകുന്നു; ദുര്യോധനൻ കർണ്ണനെ പിന്തുണയ്ക്കുന്നു","te":"అధిరథుడు ప్రత్యక్షమవుతాడు, దుర్యోధనుడు కర్ణుని సమర్థిస్తాడు","ta":"அதிரதன் தோன்றுகிறான், துரியோதனன் கர்ணனைக் காக்கிறான்","kn":"ಅಧಿರಥ ಕಾಣಿಸಿಕೊಳ್ಳುತ್ತಾನೆ; ದುರ್ಯೋಧನ ಕರ್ಣನನ್ನು ರಕ್ಷಿಸುತ್ತಾನೆ"},"128":{"hi":"द्रोण की गुरु-दक्षिणा: द्रुपद की बंदी","ml":"ദ്രോണരുടെ ദക്ഷിണ: ദ്രുപദന്റെ ബന്ധനം","te":"ద్రోణుని గురుదక్షిణ, ద్రుపదుని బంధించడం","ta":"துரோணரின் குருதட்சணை: துருபதனைச் சிறைபிடித்தல்","kn":"ದ್ರೋಣರ ಗುರುದಕ್ಷಿಣೆ: ದ್ರುಪದನ ಸೆರೆ"},"129":{"hi":"पांडवों के प्रति दुर्योधन की ईर्ष्या","ml":"പാണ്ഡവരോടുള്ള ദുര്യോധനന്റെ അസൂയ","te":"పాండవులపై దుర్యోధనుని అసూయ","ta":"பாண்டவர்கள் மீது துரியோதனனின் பொறாமை","kn":"ಪಾಂಡವರ ಮೇಲೆ ದುರ್ಯೋಧನನ ಅಸೂಯೆ"},"130":{"hi":"दुर्योधन पांडवों को वारणावत भेजने की योजना बनाता है","ml":"പാണ്ഡവരെ വാരണാവതത്തിലേക്ക് അയക്കാൻ ദുര്യോധനൻ പദ്ധതിയിടുന്നു","te":"పాండవులను వారణావతానికి పంపాలని దుర్యోధనుడు పన్నాగం పన్నుతాడు","ta":"வாரணாவதத்திற்கு பாண்டவர்களை அனுப்பத் துரியோதனன் திட்டமிடுகிறான்","kn":"ಪಾಂಡವರನ್ನು ವಾರಣಾವತಕ್ಕೆ ಕಳುಹಿಸಲು ದುರ್ಯೋಧನನ ಯೋಜನೆ"},"131":{"hi":"पांडव वारणावत भेजे जाते हैं","ml":"പാണ്ഡവർ വാരണാവതത്തിലേക്ക് അയക്കപ്പെടുന്നു","te":"పాండవులు వారణావతానికి పంపబడతారు","ta":"பாண்டவர்கள் வாரணாவதத்திற்கு அனுப்பப்படுகின்றனர்","kn":"ಪಾಂಡವರು ವಾರಣಾವತಕ್ಕೆ ಕಳುಹಿಸಲ್ಪಡುತ್ತಾರೆ"},"132":{"hi":"पुरोचन लाक्षागृह बनाने का आदेश पाते हैं","ml":"അരക്കില്ലം പണിയാൻ പുരോചനനോട് കല്പിക്കുന്നു","te":"లక్క ఇల్లు కట్టమని పురోచనునికి ఆజ్ఞ","ta":"அரக்கு மாளிகையைக் கட்ட புரோசனன் கட்டளையிடப்படுகிறான்","kn":"ಅರಗಿನ ಮನೆಯನ್ನು ಕಟ್ಟಲು ಪುರೋಚನನಿಗೆ ಆಜ್ಞೆ"},"133":{"hi":"विदुर की सांकेतिक चेतावनी","ml":"വിദുരന്റെ മറഞ്ഞ മുന്നറിയിപ്പ്","te":"విదురుని పరోక్ష హెచ్చరిక","ta":"விதுரரின் மறைமுக எச்சரிக்கை","kn":"ವಿದುರನ ಗೂಢ ಎಚ್ಚರಿಕೆ"},"134":{"hi":"युधिष्ठिर लाक्षागृह का भेद पहचानते हैं","ml":"അരക്കില്ലത്തിന്റെ ചതി യുധിഷ്ഠിരൻ മനസ്സിലാക്കുന്നു","te":"లక్క ఇల్లును ధర్మరాజు గ్రహిస్తాడు","ta":"அரக்கு மாளிகையின் சூழ்ச்சியை யுதிட்டிரன் கண்டுகொள்கிறான்","kn":"ಅರಗಿನ ಮನೆಯ ಸುಳಿವನ್ನು ಯುಧಿಷ್ಠಿರ ಅರಿಯುತ್ತಾನೆ"},"135":{"hi":"विदुर का खनक सुरंग खोदता है","ml":"വിദുരന്റെ ഖനിത്തൊഴിലാളി തുരങ്കം കുഴിക്കുന്നു","te":"విదురుడు పంపిన గని కార్మికుడు సొరంగం తవ్వుతాడు","ta":"விதுரரின் சுரங்கத் தொழிலாளி சுரங்கம் தோண்டுகிறான்","kn":"ವಿದುರನ ಗಣಿಕಾರ ಸುರಂಗ ತೋಡುತ್ತಾನೆ"},"136":{"hi":"लाक्षागृह का दहन","ml":"അരക്കില്ലം കത്തിനശിക്കുന്നു","te":"లక్క ఇల్లు దగ్ధమవుతుంది","ta":"அரக்கு மாளிகை எரிதல்","kn":"ಅರಗಿನ ಮನೆಯ ದಹನ"},"137":{"hi":"पांडवों को मृत मान लिया जाता है","ml":"പാണ്ഡവർ മരിച്ചെന്ന് കരുതപ്പെടുന്നു","te":"పాండవులు మరణించారని భావిస్తారు","ta":"பாண்டவர்கள் இறந்ததாகக் கருதப்படுகின்றனர்","kn":"ಪಾಂಡವರು ಮೃತರೆಂದು ಭಾವಿಸಲ್ಪಡುತ್ತಾರೆ"},"138":{"hi":"भीम अपने परिवार को वन से पार ले जाते हैं","ml":"ഭീമൻ കുടുംബത്തെ കാട്ടിലൂടെ വഹിച്ചുകൊണ്ടുപോകുന്നു","te":"భీముడు తన కుటుంబాన్ని అడవిలో మోసుకెళ్తాడు","ta":"பீமன் தன் குடும்பத்தைக் காட்டின் வழியே சுமந்து செல்கிறான்","kn":"ಭೀಮನು ಕುಟುಂಬವನ್ನು ಕಾಡಿನ ಮೂಲಕ ಹೊತ್ತೊಯ್ಯುತ್ತಾನೆ"},"139":{"hi":"हिडिंब अपनी बहन को भेजता है; वह भीम पर मोहित होती है","ml":"ഹിഡിംബൻ സഹോദരിയെ അയക്കുന്നു; അവൾ ഭീമനിൽ അനുരക്തയാകുന്നു","te":"హిడింబుడు తన సోదరిని పంపుతాడు, ఆమె భీమునితో ప్రేమలో పడుతుంది","ta":"இடும்பன் தன் சகோதரியை அனுப்புகிறான், அவள் பீமனைக் காதலிக்கிறாள்","kn":"ಹಿಡಿಂಬನು ತನ್ನ ತಂಗಿಯನ್ನು ಕಳುಹಿಸುತ್ತಾನೆ; ಆಕೆ ಭೀಮನನ್ನು ಪ್ರೀತಿಸುತ್ತಾಳೆ"},"140":{"hi":"हिडिंब आक्रमण करता है","ml":"ഹിഡിംബൻ ആക്രമിക്കുന്നു","te":"హిడింబుడు దాడి చేస్తాడు","ta":"இடும்பன் தாக்குகிறான்","kn":"ಹಿಡಿಂಬ ದಾಳಿ ಮಾಡುತ್ತಾನೆ"},"141":{"hi":"भीम हिडिंब से युद्ध करते हैं","ml":"ഭീമൻ ഹിഡിംബനോട് പോരാടുന്നു","te":"భీముడు హిడింబునితో పోరాడుతాడు","ta":"பீமன் இடும்பனுடன் போரிடுகிறான்","kn":"ಭೀಮ ಹಿಡಿಂಬನೊಡನೆ ಹೋರಾಡುತ್ತಾನೆ"},"142":{"hi":"हिडिंब की मृत्यु","ml":"ഹിഡിംബന്റെ മരണം","te":"హిడింబుని మరణం","ta":"இடும்பனின் மரணம்","kn":"ಹಿಡಿಂಬನ ಮರಣ"},"143":{"hi":"भीम और हिडिंबा; घटोत्कच का जन्म","ml":"ഭീമനും ഹിഡിംബിയും; ഘടോത്കചന്റെ ജനനം","te":"భీముడు, హిడింబ, ఘటోత్కచుని జననం","ta":"பீமனும் இடும்பியும், கடோற்கசனின் பிறப்பு","kn":"ಭೀಮ ಮತ್ತು ಹಿಡಿಂಬೆ; ಘಟೋತ್ಕಚನ ಜನನ"},"144":{"hi":"व्यास पांडवों को एकचक्रा भेजते हैं","ml":"വ്യാസൻ പാണ്ഡവരെ ഏകചക്രത്തിലേക്ക് അയക്കുന്നു","te":"వ్యాసుడు పాండవులను ఏకచక్రానికి పంపుతాడు","ta":"வியாசர் பாண்டவர்களை ஏகசக்ரத்திற்கு அனுப்புகிறார்","kn":"ವ್ಯಾಸರು ಪಾಂಡವರನ್ನು ಏಕಚಕ್ರಕ್ಕೆ ಕಳುಹಿಸುತ್ತಾರೆ"},"145":{"hi":"एकचक्रा में ब्राह्मण का विलाप","ml":"ഏകചക്രത്തിലെ ബ്രാഹ്മണന്റെ വിലാപം","te":"ఏకచక్రంలో బ్రాహ్మణుని విలాపం","ta":"ஏகசக்ரத்தில் அந்தணரின் புலம்பல்","kn":"ಏಕಚಕ್ರದಲ್ಲಿ ಬ್ರಾಹ್ಮಣನ ಆಕ್ರಂದನ"},"146":{"hi":"ब्राह्मण की पत्नी स्वयं को अर्पित करती है","ml":"ബ്രാഹ്മണന്റെ ഭാര്യ തന്നെത്തന്നെ അർപ്പിക്കുന്നു","te":"బ్రాహ్మణుని భార్య తనను తాను అర్పించుకుంటుంది","ta":"அந்தணரின் மனைவி தன்னை அர்ப்பணிக்கிறாள்","kn":"ಬ್ರಾಹ್ಮಣನ ಪತ್ನಿ ತನ್ನನ್ನೇ ಅರ್ಪಿಸುತ್ತಾಳೆ"},"147":{"hi":"पुत्री और छोटा पुत्र","ml":"മകളും കൊച്ചുമകനും","te":"కుమార్తె, చిన్న కుమారుడు","ta":"மகளும் சிறிய மகனும்","kn":"ಮಗಳು ಮತ್ತು ಪುಟ್ಟ ಮಗ"},"148":{"hi":"राक्षस बक का कर","ml":"രാക്ഷസൻ ബകന്റെ കപ്പം","te":"రాక్షసుడు బకాసురునికి కప్పం","ta":"பகாசுரனுக்கான காணிக்கை","kn":"ರಾಕ್ಷಸ ಬಕನ ಕಪ್ಪ"},"149":{"hi":"कुंती भीम को भेजती हैं","ml":"കുന്തി ഭീമനെ അർപ്പിക്കുന്നു","te":"కుంతి భీమును అర్పిస్తుంది","ta":"குந்தி பீமனை அளிக்க முன்வருகிறாள்","kn":"ಕುಂತಿ ಭೀಮನನ್ನು ಅರ್ಪಿಸುತ್ತಾಳೆ"},"150":{"hi":"युधिष्ठिर कुंती के निर्णय पर प्रश्न करते हैं","ml":"കുന്തിയുടെ തീരുമാനം യുധിഷ്ഠിരൻ ചോദ്യം ചെയ്യുന്നു","te":"కుంతి నిర్ణయాన్ని ధర్మరాజు ప్రశ్నిస్తాడు","ta":"குந்தியின் முடிவை யுதிட்டிரன் கேள்வி கேட்கிறான்","kn":"ಕುಂತಿಯ ನಿರ್ಧಾರವನ್ನು ಯುಧಿಷ್ಠಿರ ಪ್ರಶ್ನಿಸುತ್ತಾನೆ"},"151":{"hi":"भीम बक का वध करते हैं","ml":"ഭീമൻ ബകനെ കൊല്ലുന്നു","te":"భీముడు బకాసురుని చంపుతాడు","ta":"பீமன் பகாசுரனைக் கொல்கிறான்","kn":"ಭೀಮ ಬಕನನ್ನು ಕೊಲ್ಲುತ್ತಾನೆ"},"152":{"hi":"एकचक्रा मुक्त होता है","ml":"ഏകചക്രം മോചിതമാകുന്നു","te":"ఏకచక్రం విముక్తమవుతుంది","ta":"ஏகசக்ரம் விடுவிக்கப்படுகிறது","kn":"ಏಕಚಕ್ರ ಮುಕ್ತವಾಗುತ್ತದೆ"},"153":{"hi":"द्रौपदी के स्वयंवर का समाचार","ml":"ദ്രൗപദിയുടെ സ്വയംവരവാർത്ത","te":"ద్రౌపది స్వయంవర వార్త","ta":"திரௌபதியின் சுயம்வரச் செய்தி","kn":"ದ್ರೌಪದಿಯ ಸ್ವಯಂವರದ ಸುದ್ದಿ"},"154":{"hi":"ब्राह्मण द्रोण और द्रुपद की कथा सुनाता है","ml":"ദ്രോണരെയും ദ്രുപദനെയും കുറിച്ച് ബ്രാഹ്മണൻ പറയുന്നു","te":"ద్రోణ ద్రుపదుల గురించి బ్రాహ్మణుడు చెబుతాడు","ta":"துரோணரையும் துருபதனையும் பற்றி அந்தணர் கூறுகிறார்","kn":"ದ್ರೋಣ ಮತ್ತು ದ್ರುಪದರ ಕುರಿತು ಬ್ರಾಹ್ಮಣ ಹೇಳುತ್ತಾನೆ"},"155":{"hi":"धृष्टद्युम्न और द्रौपदी का जन्म","ml":"ധൃഷ്ടദ്യുമ്നന്റെയും ദ്രൗപദിയുടെയും ജനനം","te":"ధృష్టద్యుమ్నుడు, ద్రౌపదుల జననాలు","ta":"திருஷ்டத்யும்னன், திரௌபதியின் பிறப்புகள்","kn":"ಧೃಷ್ಟದ್ಯುಮ್ನ ಮತ್ತು ದ್ರೌಪದಿಯ ಜನನ"},"156":{"hi":"पांडव पांचाल जाने का निश्चय करते हैं","ml":"പാണ്ഡവർ പാഞ്ചാലത്തേക്ക് പോകാൻ തീരുമാനിക്കുന്നു","te":"పాండవులు పాంచాలానికి వెళ్లాలని నిశ్చయిస్తారు","ta":"பாஞ்சாலத்திற்குச் செல்ல பாண்டவர்கள் முடிவு செய்கின்றனர்","kn":"ಪಾಂಚಾಲಕ್ಕೆ ಹೋಗಲು ಪಾಂಡವರ ನಿರ್ಧಾರ"},"157":{"hi":"व्यास द्रौपदी के पाँच पतियों की भविष्यवाणी करते हैं","ml":"ദ്രൗപദിക്ക് അഞ്ച് ഭർത്താക്കന്മാർ ഉണ്ടാകുമെന്ന് വ്യാസൻ പ്രവചിക്കുന്നു","te":"ద్రౌపదికి ఐదుగురు భర్తలు ఉంటారని వ్యాసుడు చెబుతాడు","ta":"திரௌபதிக்கு ஐந்து கணவர்கள் என்று வியாசர் முன்னறிவிக்கிறார்","kn":"ದ್ರೌಪದಿಯ ಐವರು ಪತಿಗಳನ್ನು ವ್ಯಾಸರು ಭವಿಷ್ಯ ನುಡಿಯುತ್ತಾರೆ"},"158":{"hi":"अर्जुन गंधर्व अंगारपर्ण को पराजित करते हैं","ml":"അർജ്ജുനൻ ഗന്ധർവനായ അംഗാരപർണ്ണനെ തോൽപ്പിക്കുന്നു","te":"అర్జునుడు గంధర్వుడు అంగారపర్ణుని ఓడిస్తాడు","ta":"கந்தர்வன் அங்காரபர்ணனை அர்ஜுனன் வெல்கிறான்","kn":"ಅರ್ಜುನನು ಗಂಧರ್ವ ಅಂಗಾರಪರ್ಣನನ್ನು ಸೋಲಿಸುತ್ತಾನೆ"},"159":{"hi":"गंधर्व ने उन पर आक्रमण क्यों किया","ml":"ഗന്ധർവൻ അവരെ ആക്രമിച്ചത് എന്തുകൊണ്ട്","te":"గంధర్వుడు వారిపై ఎందుకు దాడి చేశాడు","ta":"கந்தர்வன் அவர்களைத் தாக்கியதன் காரணம்","kn":"ಗಂಧರ್ವ ಅವರ ಮೇಲೆ ದಾಳಿ ಮಾಡಿದ ಕಾರಣ"},"160":{"hi":"संवरण तपती पर मोहित होते हैं","ml":"സംവരണൻ താപതിയിൽ അനുരക്തനാകുന്നു","te":"సంవరణుడు తపతితో ప్రేమలో పడతాడు","ta":"சம்வரணன் தபதியைக் காதலிக்கிறான்","kn":"ಸಂವರಣನು ತಪತಿಯನ್ನು ಪ್ರೀತಿಸುತ್ತಾನೆ"},"161":{"hi":"तपती संवरण के सामने प्रकट होती हैं","ml":"താപതി സംവരണന് തന്നെ വെളിപ്പെടുത്തുന്നു","te":"తపతి సంవరణునికి తన నిజరూపం చూపుతుంది","ta":"தபதி தன்னை சம்வரணனுக்கு வெளிப்படுத்துகிறாள்","kn":"ತಪತಿ ಸಂವರಣನಿಗೆ ತನ್ನನ್ನು ಬಹಿರಂಗಪಡಿಸುತ್ತಾಳೆ"},"162":{"hi":"संवरण की तपस्या; वसिष्ठ सूर्य के पास जाते हैं","ml":"സംവരണന്റെ തപസ്സ്; വസിഷ്ഠൻ സൂര്യന്റെ അടുത്തേക്ക് പോകുന്നു","te":"సంవరణుని తపస్సు, వశిష్ఠుడు సూర్యుని వద్దకు వెళ్తాడు","ta":"சம்வரணனின் தவம், வசிஷ்டர் சூரியனிடம் செல்கிறார்","kn":"ಸಂವರಣನ ತಪಸ್ಸು; ವಸಿಷ್ಠರು ಸೂರ್ಯನ ಬಳಿ ಹೋಗುತ್ತಾರೆ"},"163":{"hi":"संवरण तपती से विवाह करते हैं; कुरु का जन्म","ml":"സംവരണൻ താപതിയെ വിവാഹം കഴിക്കുന്നു; കുരുവിന്റെ ജനനം","te":"సంవరణుడు తపతిని వివాహం చేసుకుంటాడు, కురుని జననం","ta":"சம்வரணன் தபதியை மணக்கிறான், குருவின் பிறப்பு","kn":"ಸಂವರಣ ತಪತಿಯನ್ನು ವಿವಾಹವಾಗುತ್ತಾನೆ; ಕುರುವಿನ ಜನನ"},"164":{"hi":"वसिष्ठ की महिमा","ml":"വസിഷ്ഠന്റെ മഹത്വം","te":"వశిష్ఠుని మహిమ","ta":"வசிஷ்டரின் பெருமை","kn":"ವಸಿಷ್ಠರ ಮಹಿಮೆ"},"165":{"hi":"विश्वामित्र और वसिष्ठ की गाय","ml":"വിശ്വാമിത്രനും വസിഷ്ഠന്റെ പശുവും","te":"విశ్వామిత్రుడు, వశిష్ఠుని ఆవు","ta":"விசுவாமித்திரரும் வசிஷ்டரின் பசுவும்","kn":"ವಿಶ್ವಾಮಿತ್ರ ಮತ್ತು ವಸಿಷ್ಠರ ಹಸು"},"166":{"hi":"कल्माषपाद नरभक्षी बनते हैं","ml":"കല്മാഷപാദൻ നരഭോജിയാകുന്നു","te":"కల్మాషపాదుడు నరభక్షకుడవుతాడు","ta":"கல்மாஷபாதன் நரமாமிசம் உண்பவனாகிறான்","kn":"ಕಲ್ಮಾಷಪಾದ ನರಭಕ್ಷಕನಾಗುತ್ತಾನೆ"},"167":{"hi":"वसिष्ठ अपने अजन्मे पौत्र की ध्वनि सुनते हैं","ml":"ജനിക്കാത്ത പേരക്കുട്ടിയെ വസിഷ്ഠൻ കേൾക്കുന്നു","te":"వశిష్ఠుడు పుట్టని మనవని మాటలు వింటాడు","ta":"வசிஷ்டர் பிறக்காத பேரனின் குரலைக் கேட்கிறார்","kn":"ವಸಿಷ್ಠರು ತಮ್ಮ ಗರ್ಭಸ್ಥ ಮೊಮ್ಮಗನ ಧ್ವನಿ ಕೇಳುತ್ತಾರೆ"},"168":{"hi":"वसिष्ठ कल्माषपाद को मुक्त करते हैं","ml":"വസിഷ്ഠൻ കല്മാഷപാദനെ മോചിപ്പിക്കുന്നു","te":"వశిష్ఠుడు కల్మాషపాదుని విముక్తుని చేస్తాడు","ta":"வசிஷ்டர் கல்மாஷபாதனை விடுவிக்கிறார்","kn":"ವಸಿಷ್ಠರು ಕಲ್ಮಾಷಪಾದನನ್ನು ಮುಕ್ತಗೊಳಿಸುತ್ತಾರೆ"},"169":{"hi":"पराशर का जन्म; भृगु और हैहय","ml":"പരാശരന്റെ ജനനം; ഭൃഗുക്കളും ഹൈഹയരും","te":"పరాశరుని జననం, భృగువులు, హైహయులు","ta":"பராசரரின் பிறப்பு, பிருகுக்களும் ஹைஹயர்களும்","kn":"ಪರಾಶರನ ಜನನ; ಭೃಗುಗಳು ಮತ್ತು ಹೈಹಯರು"},"170":{"hi":"और्व का क्रोध","ml":"ഔർവന്റെ കോപം","te":"ఔర్వుని కోపం","ta":"ஔர்வரின் சினம்","kn":"ಔರ್ವನ ಕೋಪ"},"171":{"hi":"और्व अपनी अग्नि समुद्र में डालते हैं","ml":"ഔർവൻ തന്റെ അഗ്നി കടലിലേക്ക് എറിയുന്നു","te":"ఔర్వుడు తన అగ్నిని సముద్రంలో విసురుతాడు","ta":"ஔர்வர் தன் நெருப்பைக் கடலில் வீசுகிறார்","kn":"ಔರ್ವ ತನ್ನ ಅಗ್ನಿಯನ್ನು ಸಮುದ್ರಕ್ಕೆ ಎಸೆಯುತ್ತಾನೆ"},"172":{"hi":"पराशर का राक्षसों के लिए यज्ञ","ml":"പരാശരന്റെ രാക്ഷസയാഗം","te":"పరాశరుని రాక్షస యాగం","ta":"அசுரர்களுக்கான பராசரரின் யாகம்","kn":"ರಾಕ್ಷಸರ ವಿರುದ್ಧ ಪರಾಶರನ ಯಾಗ"},"173":{"hi":"कल्माषपाद की रानी वसिष्ठ के पास क्यों गईं","ml":"കല്മാഷപാദന്റെ രാജ്ഞി വസിഷ്ഠനെ സമീപിച്ചത് എന്തുകൊണ്ട്","te":"కల్మాషపాదుని రాణి వశిష్ఠుని వద్దకు ఎందుకు వెళ్లింది","ta":"கல்மாஷபாதனின் ராணி வசிஷ்டரிடம் சென்றதன் காரணம்","kn":"ಕಲ್ಮಾಷಪಾದನ ರಾಣಿ ವಸಿಷ್ಠರ ಬಳಿ ಹೋದ ಕಾರಣ"},"174":{"hi":"धौम्य पांडवों के पुरोहित बनते हैं","ml":"ധൗമ്യൻ പാണ്ഡവരുടെ പുരോഹിതനാകുന്നു","te":"ధౌమ్యుడు పాండవుల పురోహితుడవుతాడు","ta":"தௌம்யர் பாண்டவர்களின் புரோகிதராகிறார்","kn":"ಧೌಮ್ಯರು ಪಾಂಡವರ ಪುರೋಹಿತರಾಗುತ್ತಾರೆ"},"175":{"hi":"पांचाल के मार्ग पर","ml":"പാഞ്ചാലത്തേക്കുള്ള വഴിയിൽ","te":"పాంచాల మార్గంలో","ta":"பாஞ்சாலத்திற்கான பாதையில்","kn":"ಪಾಂಚಾಲ ಹಾದಿಯಲ್ಲಿ"},"176":{"hi":"स्वयंवर में सभा जुटती है","ml":"സ്വയംവരത്തിനായി സദസ്സ് ഒരുങ്ങുന്നു","te":"స్వయంవరానికి రాజులు సమకూరతారు","ta":"சுயம்வரம் கூடுகிறது","kn":"ಸ್ವಯಂವರ ಸಭೆ ಸೇರುತ್ತದೆ"},"177":{"hi":"धृष्टद्युम्न स्वयंवर के प्रार्थियों के नाम बताते हैं","ml":"ധൃഷ്ടദ്യുമ്നൻ മത്സരാർത്ഥികളുടെ പേരുകൾ വിളിക്കുന്നു","te":"ధృష్టద్యుమ్నుడు అభ్యర్థులను ప్రకటిస్తాడు","ta":"திருஷ்டத்யும்னன் போட்டியாளர்களின் பெயர்களை அறிவிக்கிறான்","kn":"ಧೃಷ್ಟದ್ಯುಮ್ನ ಸ್ಪರ್ಧಿಗಳ ಹೆಸರುಗಳನ್ನು ಘೋಷಿಸುತ್ತಾನೆ"},"178":{"hi":"राजा धनुष की प्रत्यंचा चढ़ाने में असफल रहते हैं","ml":"വില്ലിൽ ഞാൺ കയറ്റാൻ രാജാക്കന്മാർക്ക് കഴിയുന്നില്ല","te":"ధనుస్సుకు నారి ఎక్కించలేక రాజులు విఫలమవుతారు","ta":"வில்லில் நாண் பூட்ட மன்னர்கள் தோல்வியடைகின்றனர்","kn":"ಬಿಲ್ಲಿಗೆ ಹೆದೆಯೇರಿಸಲು ರಾಜರುಗಳು ವಿಫಲರಾಗುತ್ತಾರೆ"},"179":{"hi":"अर्जुन द्रौपदी को जीतते हैं","ml":"അർജ്ജുനൻ ദ്രൗപദിയെ നേടുന്നു","te":"అర్జునుడు ద్రౌపదిని గెలుస్తాడు","ta":"அர்ஜுனன் திரௌபதியை வெல்கிறான்","kn":"ಅರ್ಜುನನು ದ್ರೌಪದಿಯನ್ನು ಗೆಲ್ಲುತ್ತಾನೆ"},"180":{"hi":"राजा द्रुपद पर आक्रमण करते हैं","ml":"രാജാക്കന്മാർ ദ്രുപദനെ ആക്രമിക്കുന്നു","te":"రాజులు ద్రుపదునిపై దాడి చేస్తారు","ta":"மன்னர்கள் துருபதனைத் தாக்குகின்றனர்","kn":"ರಾಜರುಗಳು ದ್ರುಪದನ ಮೇಲೆ ದಾಳಿ ಮಾಡುತ್ತಾರೆ"},"181":{"hi":"अर्जुन और भीम कर्ण और शल्य को पराजित करते हैं","ml":"അർജ്ജുനനും ഭീമനും കർണ്ണനെയും ശല്യനെയും തോൽപ്പിക്കുന്നു","te":"అర్జున భీములు కర్ణ, శల్యులను ఓడిస్తారు","ta":"அர்ஜுனனும் பீமனும் கர்ணனையும் சல்யனையும் வெல்கின்றனர்","kn":"ಅರ್ಜುನ ಮತ್ತು ಭೀಮ ಕರ್ಣ ಮತ್ತು ಶಲ್ಯರನ್ನು ಸೋಲಿಸುತ್ತಾರೆ"},"182":{"hi":"द्रौपदी पाँचों की पत्नी बनती हैं","ml":"ദ്രൗപദി അഞ്ചുപേരുടെയും ഭാര്യയാകുന്നു","te":"ద్రౌపది ఐదుగురికీ భార్య అవుతుంది","ta":"திரௌபதி ஐவருக்கும் மனைவியாகிறாள்","kn":"ದ್ರೌಪದಿ ಐವರ ಪತ್ನಿಯಾಗುತ್ತಾಳೆ"},"183":{"hi":"कृष्ण और बलराम पांडवों से मिलने आते हैं","ml":"കൃഷ്ണനും ബലരാമനും പാണ്ഡവരെ സന്ദർശിക്കുന്നു","te":"కృష్ణ, బలరాములు పాండవులను సందర్శిస్తారు","ta":"கிருஷ்ணரும் பலராமரும் பாண்டவர்களைச் சந்திக்கின்றனர்","kn":"ಕೃಷ್ಣ ಮತ್ತು ಬಲರಾಮರು ಪಾಂಡವರನ್ನು ಭೇಟಿಯಾಗುತ್ತಾರೆ"},"184":{"hi":"धृष्टद्युम्न पांडवों की गुप्तचरी करते हैं","ml":"ധൃഷ്ടദ്യുമ്നൻ പാണ്ഡവരെ ഒളിഞ്ഞുനോക്കുന്നു","te":"పాండవులపై ధృష్టద్యుమ్నుడు గూఢచర్యం చేస్తాడు","ta":"திருஷ்டத்யும்னன் பாண்டவர்களை உளவு பார்க்கிறான்","kn":"ಧೃಷ್ಟದ್ಯುಮ್ನ ಪಾಂಡವರ ಮೇಲೆ ಗೂಢಚರ್ಯೆ ಮಾಡುತ್ತಾನೆ"},"185":{"hi":"द्रुपद अपने पुरोहित को भेजते हैं","ml":"ദ്രുപദൻ തന്റെ പുരോഹിതനെ അയക്കുന്നു","te":"ద్రుపదుడు తన పురోహితుని పంపుతాడు","ta":"துருபதன் தன் புரோகிதரை அனுப்புகிறான்","kn":"ದ್ರುಪದ ತನ್ನ ಪುರೋಹಿತರನ್ನು ಕಳುಹಿಸುತ್ತಾನೆ"},"186":{"hi":"द्रुपद के महल में पांडव","ml":"ദ്രുപദന്റെ കൊട്ടാരത്തിലെ പാണ്ഡവർ","te":"ద్రుపదుని రాజభవనంలో పాండవులు","ta":"துருபதனின் அரண்மனையில் பாண்டவர்கள்","kn":"ದ್ರುಪದನ ಅರಮನೆಯಲ್ಲಿ ಪಾಂಡವರು"},"187":{"hi":"युधिष्ठिर स्वयं को प्रकट करते हैं; पाँच पतियों का प्रश्न","ml":"യുധിഷ്ഠിരൻ തന്നെത്തന്നെ വെളിപ്പെടുത്തുന്നു; അഞ്ച് ഭർത്താക്കന്മാരുടെ ചോദ്യം","te":"ధర్మరాజు తన నిజ స్వరూపం చాటుతాడు, ఐదుగురు భర్తల ప్రశ్న","ta":"யுதிட்டிரன் தன்னை வெளிப்படுத்துகிறான், ஐவர் கணவர் என்ற கேள்வி","kn":"ಯುಧಿಷ್ಠಿರ ತನ್ನನ್ನು ಬಹಿರಂಗಪಡಿಸುತ್ತಾನೆ; ಐವರು ಪತಿಗಳ ಪ್ರಶ್ನೆ"},"188":{"hi":"व्यास से परामर्श लिया जाता है","ml":"വ്യാസനോട് ആലോചിക്കുന്നു","te":"వ్యాసుని సంప్రదింపు","ta":"வியாசரிடம் ஆலோசனை கேட்கப்படுகிறது","kn":"ವ್ಯಾಸರ ಸಲಹೆ ಕೇಳಲಾಗುತ್ತದೆ"},"189":{"hi":"पाँच इंद्रों की कथा","ml":"അഞ്ച് ഇന്ദ്രന്മാരുടെ കഥ","te":"ఐదుగురు ఇంద్రుల కథ","ta":"ஐந்து இந்திரர்களின் கதை","kn":"ಐವರು ಇಂದ್ರರ ಕಥೆ"},"190":{"hi":"द्रौपदी का विवाह","ml":"ദ്രൗപദിയുടെ വിവാഹം","te":"ద్రౌపది వివాహం","ta":"திரௌபதியின் திருமணம்","kn":"ದ್ರೌಪದಿಯ ವಿವಾಹ"},"191":{"hi":"कुंती द्रौपदी को आशीर्वाद देती हैं; कृष्ण के उपहार","ml":"കുന്തി ദ്രൗപദിയെ അനുഗ്രഹിക്കുന്നു; കൃഷ്ണന്റെ സമ്മാനങ്ങൾ","te":"కుంతి ద్రౌపదిని దీవిస్తుంది, కృష్ణుని కానుకలు","ta":"குந்தி திரௌபதியை ஆசீர்வதிக்கிறாள், கிருஷ்ணரின் பரிசுகள்","kn":"ಕುಂತಿ ದ್ರೌಪದಿಯನ್ನು ಹರಸುತ್ತಾಳೆ; ಕೃಷ್ಣನ ಉಡುಗೊರೆಗಳು"},"192":{"hi":"कौरव जानते हैं कि पांडव जीवित हैं","ml":"പാണ്ഡവർ ജീവിച്ചിരിപ്പുണ്ടെന്ന് കൗരവർ അറിയുന്നു","te":"పాండవులు బతికే ఉన్నారని కౌరవులు తెలుసుకుంటారు","ta":"பாண்டவர்கள் உயிருடன் இருப்பதைக் கௌரவர்கள் அறிகின்றனர்","kn":"ಪಾಂಡವರು ಜೀವಂತರಿರುವ ವಿಷಯ ಕೌರವರಿಗೆ ತಿಳಿಯುತ್ತದೆ"},"193":{"hi":"दुर्योधन की चालें","ml":"ദുര്യോധനന്റെ കുതന്ത്രങ്ങൾ","te":"దుర్యోధనుని కుట్రలు","ta":"துரியோதனனின் சூழ்ச்சிகள்","kn":"ದುರ್ಯೋಧನನ ಕುತಂತ್ರಗಳು"},"194":{"hi":"कर्ण खुले युद्ध की सलाह देते हैं","ml":"കർണ്ണൻ തുറന്ന യുദ്ധം ഉപദേശിക്കുന്നു","te":"కర్ణుడు బహిరంగ యుద్ధాన్ని సూచిస్తాడు","ta":"கர்ணன் வெளிப்படையான போரை அறிவுறுத்துகிறான்","kn":"ಕರ್ಣ ಬಹಿರಂಗ ಯುದ್ಧವನ್ನು ಸಲಹೆ ಮಾಡುತ್ತಾನೆ"},"195":{"hi":"भीष्म शांति की सलाह देते हैं","ml":"ഭീഷ്മർ സമാധാനം ഉപദേശിക്കുന്നു","te":"భీష్ముడు శాంతిని సూచిస్తాడు","ta":"பீஷ்மர் சமாதானத்தை அறிவுறுத்துகிறார்","kn":"ಭೀಷ್ಮರು ಶಾಂತಿಯನ್ನು ಸಲಹೆ ಮಾಡುತ್ತಾರೆ"},"196":{"hi":"द्रोण भीष्म से सहमत होते हैं; कर्ण आपत्ति करते हैं","ml":"ദ്രോണർ ഭീഷ്മരോട് യോജിക്കുന്നു; കർണ്ണൻ എതിർക്കുന്നു","te":"ద్రోణుడు భీష్ముని అంగీకరిస్తాడు, కర్ణుడు అభ్యంతరం చెబుతాడు","ta":"துரோணர் பீஷ்மருடன் உடன்படுகிறார், கர்ணன் மறுக்கிறான்","kn":"ದ್ರೋಣರು ಭೀಷ್ಮರನ್ನು ಒಪ್ಪುತ್ತಾರೆ; ಕರ್ಣ ಆಕ್ಷೇಪಿಸುತ್ತಾನೆ"},"197":{"hi":"विदुर का परामर्श","ml":"വിദുരന്റെ ഉപദേശം","te":"విదురుని హితబోధ","ta":"விதுரரின் அறிவுரை","kn":"ವಿದುರನ ಸಲಹೆ"},"198":{"hi":"विदुर पांडवों को लाने भेजे जाते हैं","ml":"പാണ്ഡവരെ കൂട്ടിക്കൊണ്ടുവരാൻ വിദുരനെ അയക്കുന്നു","te":"పాండవులను తీసుకురావడానికి విదురుని పంపుతారు","ta":"பாண்டவர்களை அழைத்து வர விதுரர் அனுப்பப்படுகிறார்","kn":"ಪಾಂಡವರನ್ನು ಕರೆತರಲು ವಿದುರನನ್ನು ಕಳುಹಿಸಲಾಗುತ್ತದೆ"},"199":{"hi":"आधा राज्य और इंद्रप्रस्थ की स्थापना","ml":"രാജ്യത്തിന്റെ പകുതിയും ഇന്ദ്രപ്രസ്ഥത്തിന്റെ സ്ഥാപനവും","te":"రాజ్యంలో సగభాగం, ఇంద్రప్రస్థ స్థాపన","ta":"பாதி அரசும் இந்திரப்பிரஸ்தத்தின் ஸ்தாபனமும்","kn":"ಅರ್ಧ ರಾಜ್ಯ ಮತ್ತು ಇಂದ್ರಪ್ರಸ್ಥದ ಸ್ಥಾಪನೆ"},"200":{"hi":"नारद इंद्रप्रस्थ आते हैं","ml":"നാരദൻ ഇന്ദ്രപ്രസ്ഥം സന്ദർശിക്കുന്നു","te":"నారదుడు ఇంద్రప్రస్థాన్ని సందర్శిస్తాడు","ta":"நாரதர் இந்திரப்பிரஸ்தத்திற்கு வருகிறார்","kn":"ನಾರದರು ಇಂದ್ರಪ್ರಸ್ಥಕ್ಕೆ ಭೇಟಿ ನೀಡುತ್ತಾರೆ"},"201":{"hi":"सुंद और उपसुंद की तपस्या","ml":"സുന്ദന്റെയും ഉപസുന്ദന്റെയും തപസ്സ്","te":"సుందోపసుందుల తపస్సు","ta":"சுந்தன், உபசுந்தனின் தவம்","kn":"ಸುಂದ ಮತ್ತು ಉಪಸುಂದರ ತಪಸ್ಸು"},"202":{"hi":"सुंद और उपसुंद लोकों पर विजय पाते हैं","ml":"സുന്ദനും ഉപസുന്ദനും ലോകങ്ങൾ കീഴടക്കുന്നു","te":"సుందోపసుందులు లోకాలను జయిస్తారు","ta":"சுந்தனும் உபசுந்தனும் உலகங்களை வெல்கின்றனர்","kn":"ಸುಂದ ಮತ್ತು ಉಪಸುಂದ ಲೋಕಗಳನ್ನು ಗೆಲ್ಲುತ್ತಾರೆ"},"203":{"hi":"तिलोत्तमा की रचना","ml":"തിലോത്തമയുടെ സൃഷ്ടി","te":"తిలోత్తమ సృష్టి","ta":"திலோத்தமையின் படைப்பு","kn":"ತಿಲೋತ್ತಮೆಯ ಸೃಷ್ಟಿ"},"204":{"hi":"सुंद और उपसुंद एक-दूसरे को मार डालते हैं","ml":"സുന്ദനും ഉപസുന്ദനും പരസ്പരം കൊല്ലുന്നു","te":"సుందోపసుందులు ఒకరినొకరు చంపుకుంటారు","ta":"சுந்தனும் உபசுந்தனும் ஒருவரையொருவர் கொல்கின்றனர்","kn":"ಸುಂದ ಮತ್ತು ಉಪಸುಂದ ಪರಸ್ಪರ ಕೊಲ್ಲುತ್ತಾರೆ"},"205":{"hi":"ब्राह्मण की गायों को बचाने के लिए अर्जुन वचन तोड़ते हैं","ml":"ബ്രാഹ്മണന്റെ പശുക്കളെ രക്ഷിക്കാൻ അർജ്ജുനൻ ഉടമ്പടി ലംഘിക്കുന്നു","te":"బ్రాహ్మణుని ఆవులను కాపాడేందుకు అర్జునుడు నియమాన్ని ఉల్లంఘిస్తాడు","ta":"அந்தணரின் பசுக்களைக் காக்க அர்ஜுனன் உடன்படிக்கையை மீறுகிறான்","kn":"ಬ್ರಾಹ್ಮಣನ ಹಸುಗಳನ್ನು ರಕ್ಷಿಸಲು ಅರ್ಜುನ ಒಪ್ಪಂದವನ್ನು ಮುರಿಯುತ್ತಾನೆ"},"206":{"hi":"अर्जुन और उलूपी","ml":"അർജ്ജുനനും ഉലൂപിയും","te":"అర్జునుడు, ఉలూపి","ta":"அர்ஜுனனும் உலூபியும்","kn":"ಅರ್ಜುನ ಮತ್ತು ಉಲೂಪಿ"},"207":{"hi":"अर्जुन मणिपुर की चित्रांगदा से विवाह करते हैं","ml":"മണിപ്പൂരിലെ ചിത്രാംഗദയെ അർജ്ജുനൻ വിവാഹം കഴിക്കുന്നു","te":"అర్జునుడు మణిపుర చిత్రాంగదను వివాహం చేసుకుంటాడు","ta":"அர்ஜுனன் மணிபூரத்தின் சித்ராங்கதையை மணக்கிறான்","kn":"ಅರ್ಜುನ ಮಣಿಪುರದ ಚಿತ್ರಾಂಗದೆಯನ್ನು ವಿವಾಹವಾಗುತ್ತಾನೆ"},"208":{"hi":"दक्षिणी घाटों के मगरमच्छ","ml":"തെക്കൻ കടവുകളിലെ മുതലകൾ","te":"దక్షిణ తీర్థాల మొసళ్లు","ta":"தென் துறைகளின் முதலைகள்","kn":"ದಕ್ಷಿಣದ ತೀರ್ಥಗಳ ಮೊಸಳೆಗಳು"},"209":{"hi":"अप्सराएँ मुक्त होती हैं; बभ्रुवाहन का जन्म","ml":"അപ്സരസ്സുകൾ മോചിതരാകുന്നു; ബഭ്രുവാഹനന്റെ ജനനം","te":"అప్సరసలకు విముక్తి, బభ్రువాహనుని జననం","ta":"அப்சரஸ்கள் விடுவிக்கப்படுதல், பப்ருவாஹனனின் பிறப்பு","kn":"ಅಪ್ಸರೆಯರ ಬಿಡುಗಡೆ; ಬಭ್ರುವಾಹನನ ಜನನ"},"210":{"hi":"प्रभास में अर्जुन कृष्ण से मिलते हैं","ml":"പ്രഭാസത്തിൽ അർജ്ജുനൻ കൃഷ്ണനെ കാണുന്നു","te":"ప్రభాసంలో అర్జునుడు కృష్ణుని కలుస్తాడు","ta":"பிரபாசத்தில் அர்ஜுனன் கிருஷ்ணரைச் சந்திக்கிறான்","kn":"ಪ್ರಭಾಸದಲ್ಲಿ ಅರ್ಜುನ ಕೃಷ್ಣನನ್ನು ಭೇಟಿಯಾಗುತ್ತಾನೆ"},"211":{"hi":"अर्जुन सुभद्रा पर मोहित होते हैं","ml":"അർജ്ജുനൻ സുഭദ്രയിൽ അനുരക്തനാകുന്നു","te":"అర్జునుడు సుభద్రతో ప్రేమలో పడతాడు","ta":"அர்ஜுனன் சுபத்திரையைக் காதலிக்கிறான்","kn":"ಅರ್ಜುನ ಸುಭದ್ರೆಯನ್ನು ಪ್ರೀತಿಸುತ್ತಾನೆ"},"212":{"hi":"सुभद्रा का हरण","ml":"സുഭദ്രയുടെ അപഹരണം","te":"సుభద్ర అపహరణ","ta":"சுபத்திரையின் கடத்தல்","kn":"ಸುಭದ್ರೆಯ ಅಪಹರಣ"},"213":{"hi":"वधू-उपहार और अभिमन्यु का जन्म","ml":"വധുവിനുള്ള സമ്മാനങ്ങളും അഭിമന്യുവിന്റെ ജനനവും","te":"వధువు కానుకలు, అభిమన్యుని జననం","ta":"மணக்கொடைகளும் அபிமன்யுவின் பிறப்பும்","kn":"ವಧೂ ಉಡುಗೊರೆಗಳು ಮತ್ತು ಅಭಿಮನ್ಯುವಿನ ಜನನ"},"214":{"hi":"अग्नि कृष्ण और अर्जुन के पास आते हैं","ml":"അഗ്നി കൃഷ്ണന്റെയും അർജ്ജുനന്റെയും അടുത്തെത്തുന്നു","te":"అగ్ని కృష్ణ, అర్జునుల వద్దకు వస్తాడు","ta":"அக்னி கிருஷ்ணரிடமும் அர்ஜுனனிடமும் வருகிறார்","kn":"ಅಗ್ನಿ ಕೃಷ್ಣ ಮತ್ತು ಅರ್ಜುನರ ಬಳಿ ಬರುತ್ತಾನೆ"},"215":{"hi":"अग्नि खांडव वन माँगते हैं","ml":"ഖാണ്ഡവവനം ആവശ്യപ്പെടുന്ന അഗ്നി","te":"ఖాండవ వనాన్ని ఇమ్మని అగ్ని కోరతాడు","ta":"காண்டவ வனத்தை அக்னி கேட்கிறார்","kn":"ಖಾಂಡವ ವನವನ್ನು ಅಗ್ನಿ ಕೇಳುತ್ತಾನೆ"},"216":{"hi":"गांडीव और सुदर्शन चक्र","ml":"ഗാണ്ഡീവവും സുദർശനചക്രവും","te":"గాండీవం, సుదర్శన చక్రం","ta":"காண்டீவமும் சக்கரமும்","kn":"ಗಾಂಡೀವ ಮತ್ತು ಚಕ್ರ"},"217":{"hi":"खांडव वन का दहन","ml":"ഖാണ്ഡവം കത്തിക്കുന്നു","te":"ఖాండవ వన దహనం","ta":"காண்டவ வனம் எரிதல்","kn":"ಖಾಂಡವ ದಹನ"},"218":{"hi":"इंद्र कृष्ण और अर्जुन से युद्ध करते हैं","ml":"ഇന്ദ്രൻ കൃഷ്ണനോടും അർജ്ജുനനോടും യുദ്ധം ചെയ്യുന്നു","te":"ఇంద్రుడు కృష్ణార్జునులతో పోరాడతాడు","ta":"இந்திரன் கிருஷ்ணருடனும் அர்ஜுனனுடனும் போரிடுகிறான்","kn":"ಇಂದ್ರ ಕೃಷ್ಣ ಮತ್ತು ಅರ್ಜುನರೊಡನೆ ಹೋರಾಡುತ್ತಾನೆ"},"219":{"hi":"इंद्र पीछे हटते हैं; मय को जीवनदान मिलता है","ml":"ഇന്ദ്രൻ പിൻവാങ്ങുന്നു; മയനെ വെറുതെ വിടുന്നു","te":"ఇంద్రుడు వెనుదిరుగుతాడు, మయుడికి ప్రాణదానం","ta":"இந்திரன் விலகுகிறான், மயன் காப்பாற்றப்படுகிறான்","kn":"ಇಂದ್ರ ಹಿಂದೆ ಸರಿಯುತ್ತಾನೆ; ಮಯನಿಗೆ ಅಭಯ"},"220":{"hi":"ऋषि मंदपाल और शार्ङ्गक पक्षी","ml":"മന്ദപാലൻ മുനിയും ശാരംഗക പക്ഷികളും","te":"మందపాలుడు మహర్షి, శార్ంగక పక్షులు","ta":"முனிவர் மந்தபாலரும் சாரங்கப் பறவைகளும்","kn":"ಋಷಿ ಮಂದಪಾಲ ಮತ್ತು ಶಾರಂಗಕ ಪಕ್ಷಿಗಳು"},"221":{"hi":"जरिता और उसके शावक अग्नि का सामना करते हैं","ml":"ജരിതയും അവളുടെ കുഞ്ഞുങ്ങളും തീയെ നേരിടുന്നു","te":"జరిత తన పిల్లలతో అగ్నిని ఎదుర్కొంటుంది","ta":"ஜரிதையும் அவள் குஞ்சுகளும் நெருப்பை எதிர்கொள்கின்றனர்","kn":"ಜರಿತೆ ಮತ್ತು ಅವಳ ಮರಿಗಳು ಬೆಂಕಿಯನ್ನು ಎದುರಿಸುತ್ತವೆ"},"222":{"hi":"शावक अग्नि की स्तुति करते हैं","ml":"കുഞ്ഞുങ്ങൾ അഗ്നിയെ സ്തുതിക്കുന്നു","te":"పక్షి పిల్లలు అగ్నిని స్తుతిస్తాయి","ta":"குஞ்சுகள் அக்னியைப் போற்றுகின்றன","kn":"ಮರಿಗಳು ಅಗ್ನಿಯನ್ನು ಸ್ತುತಿಸುತ್ತವೆ"},"223":{"hi":"चार पक्षियों का स्तोत्र","ml":"നാല് പക്ഷികളുടെ സ്തോത്രം","te":"నాలుగు పక్షుల స్తోత్రం","ta":"நான்கு பறவைகளின் துதி","kn":"ನಾಲ್ಕು ಪಕ್ಷಿಗಳ ಸ್ತೋತ್ರ"},"224":{"hi":"मंदपाल अपने परिवार के पास लौटते हैं","ml":"മന്ദപാലൻ കുടുംബത്തിലേക്ക് മടങ്ങുന്നു","te":"మందపాలుడు తన కుటుంబం వద్దకు తిరిగి వస్తాడు","ta":"மந்தபாலர் தம் குடும்பத்திற்குத் திரும்புகிறார்","kn":"ಮಂದಪಾಲ ತನ್ನ ಕುಟುಂಬಕ್ಕೆ ಹಿಂದಿರುಗುತ್ತಾನೆ"},"225":{"hi":"इंद्र के वरदान; खांडव वन का अंत","ml":"ഇന്ദ്രന്റെ വരങ്ങൾ; ഖാണ്ഡവത്തിന്റെ അന്ത്യം","te":"ఇంద్రుని వరాలు, ఖాండవ వన ముగింపు","ta":"இந்திரனின் வரங்கள், காண்டவத்தின் முடிவு","kn":"ಇಂದ್ರನ ವರಗಳು; ಖಾಂಡವ ವನದ ಅಂತ್ಯ"}}