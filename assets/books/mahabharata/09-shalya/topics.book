{"1":{"hi":"कर्ण के पतन के बाद कौरव","te":"కర్ణుడి పతనం తర్వాత కౌరవులు","ta":"கர்ணனின் வீழ்ச்சிக்குப் பிறகு கௌரவர்கள்","ml":"കർണ്ണന്റെ വീഴ്ചയ്ക്കു ശേഷമുള്ള കൗരവർ","kn":"ಕರ್ಣನ ಪತನದ ನಂತರ ಕೌರವರು"},"2":{"hi":"धृतराष्ट्र का विलाप","te":"ధృతరాష్ట్రుడి విలాపం","ta":"திருதராஷ்டிரனின் புலம்பல்","ml":"ധൃതരാഷ്ട്രരുടെ വിലാപം","kn":"ಧೃತರಾಷ್ಟ್ರನ ಶೋಕ"},"3":{"hi":"संजय कौरवों की हार का वर्णन करते हैं","te":"కురువుల ఓటమిని సంజయుడు వివరిస్తాడు","ta":"கௌரவர்களின் தோல்வியைச் சஞ்சயன் விவரிக்கிறான்","ml":"കുരുക്കളുടെ പരാജയം സഞ്ജയൻ വിവരിക്കുന്നു","kn":"ಕೌರವರ ಸೋಲಿನ ಸುದ್ದಿಯನ್ನು ಸಂಜಯ ಹೇಳುತ್ತಾನೆ"},"4":{"hi":"कृप शांति की सलाह देते हैं","te":"కృపుడు శాంతిని సూచిస్తాడు","ta":"சமாதானமே நல்லது என கிருபர் அறிவுரை கூறுகிறார்","ml":"കൃപർ സമാധാനം ഉപദേശിക്കുന്നു","kn":"ಶಾಂತಿಯನ್ನು ಕೃಪ ಸಲಹೆ ಮಾಡುತ್ತಾನೆ"},"5":{"hi":"अश्वत्थामा शल्य को सेनापति बनाने का प्रस्ताव रखते हैं","te":"శల్యుడిని సేనాపతిగా అశ్వత్థామ ప్రతిపాదిస్తాడు","ta":"சல்லியனைத் தளபதியாக்க அசுவத்தாமன் முன்மொழிகிறான்","ml":"ശല്യരെ സേനാനായകനാക്കാൻ അശ്വത്ഥാമാവ് നിർദ്ദേശിക്കുന്നു","kn":"ಶಲ್ಯನನ್ನು ಸೇನಾಪತಿಯನ್ನಾಗಿ ಅಶ್ವತ್ಥಾಮ ಪ್ರಸ್ತಾಪಿಸುತ್ತಾನೆ"},"6":{"hi":"शल्य सेनापति बनते हैं","te":"శల్యుడు సేనాధిపతిగా నియమించబడతాడు","ta":"சல்லியன் படைத்தலைவனாக்கப்படுகிறான்","ml":"ശല്യർ സേനാപതിയാകുന്നു","kn":"ಶಲ್ಯನನ್ನು ಸೇನಾಧಿಪತಿಯನ್ನಾಗಿ ನೇಮಿಸಲಾಗುತ್ತದೆ"},"7":{"hi":"अठारहवां दिन: सेनाएं एकत्र होती हैं","te":"పదునెనిమిదవ రోజు: సేనలు సమావేశమవుతాయి","ta":"பதினெட்டாம் நாள்: படைகள் ஒன்றுகூடுகின்றன","ml":"പതിനെട്ടാം ദിനം: സേനകൾ ഒരുമിച്ചുകൂടുന്നു","kn":"ಹದಿನೆಂಟನೆಯ ದಿನ: ಸೇನೆಗಳ ಸಮಾವೇಶ"},"8":{"hi":"शल्य का पहला दिन","te":"శల్యుని మొదటి రోజు","ta":"சல்லியனின் முதல் நாள்","ml":"ശല്യരുടെ ആദ്യദിനം","kn":"ಶಲ್ಯನ ಮೊದಲ ದಿನದ ಯುದ್ಧ"},"9":{"hi":"पांडवों के विरुद्ध शल्य","te":"పాండవులపై శల్యుడు","ta":"பாண்டவர்களுக்கு எதிராக சல்லியன்","ml":"പാണ്ഡവർക്കെതിരെ ശല്യർ","kn":"ಪಾಂಡವರ ವಿರುದ್ಧ ಶಲ್ಯ"},"10":{"hi":"शल्य की सेना पर भीम का पराक्रम","te":"శల్యుని పక్షంపై భీముడి పరాక్రమం","ta":"சல்லியனின் படைக்கு எதிராக பீமனின் வீரச்செயல்","ml":"ശല്യരുടെ പക്ഷത്തിനെതിരെ ഭീമന്റെ പരാക്രമം","kn":"ಶಲ್ಯನ ಪಕ್ಷದ ವಿರುದ್ಧ ಭೀಮನ ಪರಾಕ್ರಮ"},"11":{"hi":"शल्य की गदा युधिष्ठिर के विरुद्ध","te":"యుధిష్ఠిరుడిపై శల్యుడి గద","ta":"யுதிஷ்டிரனுக்கு எதிராக சல்லியனின் கதாயுதம்","ml":"യുധിഷ്ഠിരനെതിരെ ശല്യരുടെ ഗദ","kn":"ಯುಧಿಷ್ಠಿರನ ಮೇಲೆ ಶಲ್ಯನ ಗದಾ ಪ್ರಹಾರ"},"12":{"hi":"सात्यकि, भीम और जुड़वां भाई युधिष्ठिर को बचाते हैं","te":"సాత్యకి, భీముడు, కవల వీరులు యుధిష్ఠిరుడిని రక్షిస్తారు","ta":"சாத்யகியும் பீமனும் இரட்டையரும் யுதிஷ்டிரனைக் காக்கின்றனர்","ml":"സാത്യകി, ഭീമൻ, ഇരട്ടകൾ എന്നിവർ യുധിഷ്ഠിരനെ രക്ഷിക്കുന്നു","kn":"ಸಾತ್ಯಕಿ, ಭೀಮ ಮತ್ತು ಅವಳಿಗಳು ಯುಧಿಷ್ಠಿರನನ್ನು ರಕ್ಷಿಸುತ್ತಾರೆ"},"13":{"hi":"अर्जुन अश्वत्थामा के विरुद्ध","te":"అశ్వత్థామపై అర్జునుడు","ta":"அசுவத்தாமனுக்கு எதிராக அர்ஜுனன்","ml":"അശ്വത്ഥാമാവിനെതിരെ അർജ്ജുനൻ","kn":"ಅಶ್ವತ್ಥಾಮನ ವಿರುದ್ಧ ಅರ್ಜುನ"},"14":{"hi":"दुर्योधन और धृष्टद्युम्न का युद्ध","te":"దుర్యోధనుడు, ధృష్టద్యుమ్నుడు పోరాడతారు","ta":"துரியோதனனும் திருஷ்டத்துய்மனும் போரிடுகின்றனர்","ml":"ദുര്യോധനനും ധൃഷ്ടദ്യുമ്നനും ഏറ്റുമുട്ടുന്നു","kn":"ದುರ್ಯೋಧನ ಮತ್ತು ಧೃಷ್ಟದ್ಯುಮ್ನರ ಕಾಳಗ"},"15":{"hi":"अर्जुन और भीम सेना को भगा देते हैं","te":"అర్జునుడు, భీముడు సేనను ఓడిస్తారు","ta":"அர்ஜுனனும் பீமனும் படையைத் துரத்துகின்றனர்","ml":"അർജ്ജുനനും ഭീമനും സേനയെ തോൽപ്പിച്ചോടിക്കുന്നു","kn":"ಅರ್ಜುನ ಮತ್ತು ಭೀಮ ಸೇನೆಯನ್ನು ಚದುರಿಸುತ್ತಾರೆ"},"16":{"hi":"युधिष्ठिर शल्य का वध करते हैं","te":"శల్యుడిని యుధిష్ఠిరుడు చంపుతాడు","ta":"யுதிஷ்டிரன் சல்லியனைக் கொல்கிறான்","ml":"ശല്യരെ യുധിഷ്ഠിരൻ വധിക്കുന്നു","kn":"ಯುಧಿಷ್ಠಿರ ಶಲ್ಯನನ್ನು ಕೊಲ್ಲುತ್ತಾನೆ"},"17":{"hi":"मद्र वीरों का पतन","te":"మద్ర అనుచరులు మరణిస్తారు","ta":"மத்ர நாட்டு வீரர்கள் வீழ்கின்றனர்","ml":"മദ്രസേനാനികൾ വീഴുന്നു","kn":"ಮದ್ರ ಅನುಯಾಯಿಗಳ ಪತನ"},"18":{"hi":"कौरव सेना में अव्यवस्था","te":"కౌరవులు అస్తవ్యస్తమవుతారు","ta":"கௌரவப் படை குழப்பத்தில் வீழ்கிறது","ml":"കൗരവർ ചിതറിപ്പോകുന്നു","kn":"ಕೌರವ ಸೇನೆಯಲ್ಲಿ ಗೊಂದಲ"},"19":{"hi":"सात्यकि शाल्व का वध करते हैं","te":"శాల్వుడిని సాత్యకి చంపుతాడు","ta":"சால்வனைச் சாத்யகி கொல்கிறான்","ml":"ശാല്വനെ സാത്യകി വധിക്കുന്നു","kn":"ಶಾಲ್ವನನ್ನು ಸಾತ್ಯಕಿ ಕೊಲ್ಲುತ್ತಾನೆ"},"20":{"hi":"कृतवर्मा और सात्यकि","te":"కృతవర్మ, సాత్యకి","ta":"கிருதவர்மனும் சாத்யகியும்","ml":"കൃതവർമ്മാവും സാത്യകിയും","kn":"ಕೃತವರ್ಮ ಮತ್ತು ಸಾತ್ಯಕಿ"},"21":{"hi":"दुर्योधन का अंतिम संघर्ष","te":"దుర్యోధనుడి చివరి పోరాటం","ta":"துரியோதனனின் இறுதி எதிர்ப்பு","ml":"ദുര്യോധനന്റെ അവസാന ചെറുത്തുനിൽപ്പ്","kn":"ದುರ್ಯೋಧನನ ಕೊನೆಯ ಹೋರಾಟ"},"22":{"hi":"शकुनि की सेना और पांडव प्रमुख","te":"శకుని సేన, పాండవ ప్రధానులు","ta":"சகுனியின் படையும் பாண்டவத் தலைவர்களும்","ml":"ശകുനിയുടെ സേനയും പാണ്ഡവ നായകന്മാരും","kn":"ಶಕುನಿಯ ಸೇನೆ ಮತ್ತು ಪಾಂಡವ ಪ್ರಮುಖರು"},"23":{"hi":"अर्जुन और कृष्ण शकुनि के घोड़ों के विरुद्ध","te":"శకుని గుర్రంపై అర్జునుడు, కృష్ణుడు","ta":"சகுனியின் குதிரைக்கு எதிராக அர்ஜுனனும் கிருஷ்ணனும்","ml":"ശകുനിയുടെ കുതിരകൾക്കെതിരെ അർജ്ജുനനും കൃഷ്ണനും","kn":"ಶಕುನಿಯ ಕುದುರೆಯ ವಿರುದ್ಧ ಅರ್ಜುನ ಮತ್ತು ಕೃಷ್ಣ"},"24":{"hi":"धृष्टद्युम्न और बिखरी सेना","te":"ధృష్టద్యుమ్నుడు, చెదిరిన సేన","ta":"திருஷ்டத்துய்மனும் சிதறிய படையும்","ml":"ധൃഷ്ടദ്യുമ്നനും തകർന്ന സേനയും","kn":"ಧೃಷ್ಟದ್ಯುಮ್ನ ಮತ್ತು ಛಿದ್ರಗೊಂಡ ಸೇನೆ"},"25":{"hi":"भीम हाथियों का वध करता है","te":"భీముడు ఏనుగులను చంపుతాడు","ta":"பீமன் யானைகளைக் கொல்கிறான்","ml":"ഭീമൻ ആനകളെ കൊല്ലുന്നു","kn":"ಆನೆಗಳನ್ನು ಭೀಮ ಕೊಲ್ಲುತ್ತಾನೆ"},"26":{"hi":"दुर्योधन के भाई सुदर्शन का वध","te":"దుర్యోధనుడి సోదరుడు సుదర్శనుడు హతమవుతాడు","ta":"துரியோதனனின் தம்பி சுதர்சனன் கொல்லப்படுகிறான்","ml":"ദുര്യോധനന്റെ സഹോദരൻ സുദർശനൻ കൊല്ലപ്പെടുന്നു","kn":"ದುರ್ಯೋಧನನ ಸಹೋದರ ಸುದರ್ಶನನ ಹತ್ಯೆ"},"27":{"hi":"सहदेव शकुनि के अनुयायियों का वध करते हैं","te":"సహదేవుడు శకుని అనుచరులను చంపుతాడు","ta":"சகாதேவன் சகுனியின் ஆதரவாளர்களைக் கொல்கிறான்","ml":"ശകുനിയുടെ അനുയായികളെ സഹദേവൻ വധിക്കുന്നു","kn":"ಶಕುನಿಯ ಅನುಯಾಯಿಗಳನ್ನು ಸಹದೇವ ಕೊಲ್ಲುತ್ತಾನೆ"},"28":{"hi":"शेष बचे योद्धा और संजय का बंदी होना","te":"మిగిలిన కొద్దిమంది; సంజయుడి బంధనం","ta":"எஞ்சியவர்களும் சஞ்சயனின் சிறைப்பிடிப்பும்","ml":"ശേഷിച്ചവരും സഞ്ജയന്റെ പിടികൂടലും","kn":"ಉಳಿದವರು ಮತ್ತು ಸಂಜಯನ ಬಂಧನ"},"29":{"hi":"दुर्योधन सरोवर में छिपता है","te":"దుర్యోధనుడు సరస్సులో దాక్కుంటాడు","ta":"துரியோதனன் ஏரியில் ஒளிந்துகொள்கிறான்","ml":"ദുര്യോധനൻ തടാകത്തിൽ ഒളിക്കുന്നു","kn":"ಸರೋವರದಲ್ಲಿ ದುರ್ಯೋಧನ ಅಡಗಿಕೊಳ್ಳುತ್ತಾನೆ"},"30":{"hi":"पांडव सरोवर में दुर्योधन को पाते हैं","te":"సరస్సులో దుర్యోధనుడిని పాండవులు కనుగొంటారు","ta":"ஏரியில் துரியோதனனைப் பாண்டவர்கள் கண்டுபிடிக்கின்றனர்","ml":"തടാകത്തിൽ ദുര്യോധനനെ പാണ്ഡവർ കണ്ടെത്തുന്നു","kn":"ಸರೋವರದಲ್ಲಿ ದುರ್ಯೋಧನನನ್ನು ಪಾಂಡವರು ಕಂಡುಕೊಳ್ಳುತ್ತಾರೆ"},"31":{"hi":"दुर्योधन चुनौती स्वीकार करता है","te":"దుర్యోధనుడు సవాలును స్వీకరిస్తాడు","ta":"துரியோதனன் சவாலை ஏற்கிறான்","ml":"വെല്ലുവിളി ദുര്യോധനൻ സ്വീകരിക്കുന്നു","kn":"ದುರ್ಯೋಧನ ಸವಾಲನ್ನು ಸ್ವೀಕರಿಸುತ್ತಾನೆ"},"32":{"hi":"दुर्योधन और भीम युद्ध की तैयारी करते हैं","te":"దుర్యోధనుడు, భీముడు పోరుకు సిద్ధమవుతారు","ta":"துரியோதனனும் பீமனும் போருக்குத் தயாராகின்றனர்","ml":"ദുര്യോധനനും ഭീമനും യുദ്ധത്തിനൊരുങ്ങുന്നു","kn":"ದುರ್ಯೋಧನ ಮತ್ತು ಭೀಮ ಯುದ್ಧಕ್ಕೆ ಸಿದ್ಧರಾಗುತ್ತಾರೆ"},"33":{"hi":"बलराम का आगमन","te":"బలరాముడు వస్తాడు","ta":"பலராமன் வருகிறான்","ml":"ബലരാമൻ എത്തുന്നു","kn":"ಬಲರಾಮ ಆಗಮಿಸುತ್ತಾನೆ"},"34":{"hi":"बलराम की तीर्थयात्रा: प्रभास और सोम","te":"బలరాముడి తీర్థయాత్ర: ప్రభాసం, సోమతీర్థం","ta":"பலராமனின் புனிதப் பயணம்: பிரபாசமும் சோமனும்","ml":"ബലരാമന്റെ തീർത്ഥാടനം: പ്രഭാസവും സോമനും","kn":"ಬಲರಾಮನ ತೀರ್ಥಯಾತ್ರೆ: ಪ್ರಭಾಸ ಮತ್ತು ಸೋಮ"},"35":{"hi":"त्रित और उदपान के तीर्थ","te":"త్రిత, ఉదపాన తీర్థాలు","ta":"திரிதன், உதபானம் ஆகிய தீர்த்தங்கள்","ml":"ത്രിതന്റെയും ഉദപാനത്തിന്റെയും തീർത്ഥങ്ങൾ","kn":"ತ್ರಿತ ಮತ್ತು ಉದಪಾನ ತೀರ್ಥಗಳು"},"36":{"hi":"विनशन और सरस्वती के तीर्थ","te":"వినశన, సరస్వతి తీర్థాలు","ta":"விநாசனமும் சரஸ்வதியின் தீர்த்தங்களும்","ml":"വിനശനവും സരസ്വതീ തീർത്ഥങ്ങളും","kn":"ವಿನಶನ ಮತ್ತು ಸರಸ್ವತಿ ತೀರ್ಥಗಳು"},"37":{"hi":"मंकणक की कथा","te":"మంకణక కథ","ta":"மங்கணகரின் கதை","ml":"മങ്കണകന്റെ കഥ","kn":"ಮಂಕಣಕನ ಕಥೆ"},"38":{"hi":"कपालमोचन तीर्थ","te":"కపాలమోచన తీర్థం","ta":"கபாலமோசன தீர்த்தம்","ml":"കപാലമോചന തീർത്ഥം","kn":"ಕಪಾಲಮೋಚನ ತೀರ್ಥ"},"39":{"hi":"अर्शिषेण और विश्वामित्र","te":"అర్ష్టిషేణుడు, విశ్వామిత్రుడు","ta":"ஆர்ஷ்டிஷேணரும் விசுவாமித்திரரும்","ml":"ആർഷ്ടിഷേണനും വിശ്വാമിത്രനും","kn":"ಅರ್ಷ್ಟಿಷೇಣ ಮತ್ತು ವಿಶ್ವಾಮಿತ್ರ"},"40":{"hi":"बक दाल्भ्य और सरस्वती के तीर्थ","te":"బక దాల్భ్యుడు, సరస్వతీ తీర్థాలు","ta":"பக தால்ப்பியரும் சரஸ்வதியின் தீர்த்தங்களும்","ml":"ബക ദാല്ഭ്യനും സരസ്വതിയുടെ തീർത്ഥങ്ങളും","kn":"ಬಕ ದಾಲ್ಭ್ಯ ಮತ್ತು ಸರಸ್ವತಿಯ ತೀರ್ಥಗಳು"},"41":{"hi":"वसिष्ठ की बाढ़","te":"వసిష్ఠుడి వరద","ta":"வசிஷ்டரின் வெள்ளப்பெருக்கு","ml":"വസിഷ്ഠന്റെ പ്രളയം","kn":"ವಸಿಷ್ಠರ ಪ್ರವಾಹ"},"42":{"hi":"सरस्वती का शाप और स्कंद का अभिषेक","te":"సరస్వతి శాపం, స్కందుడి అభిషేకం","ta":"சரஸ்வதியின் சாபமும் ஸ்கந்தனின் அபிஷேகமும்","ml":"സരസ്വതിയുടെ ശാപവും സ്കന്ദന്റെ അഭിഷേകവും","kn":"ಸರಸ್ವತಿಯ ಶಾಪ ಮತ್ತು ಸ್ಕಂದನ ಅಭಿಷೇಕ"},"43":{"hi":"स्कंद का जन्म","te":"స్కందుడి జననం","ta":"ஸ்கந்தனின் பிறப்பு","ml":"സ്കന്ദന്റെ ജനനം","kn":"ಸ್ಕಂದನ ಜನನ"},"44":{"hi":"कुमार का अभिषेक","te":"కుమారుడి అభిషేకం","ta":"குமாரனின் அபிஷேகம்","ml":"കുമാരന്റെ അഭിഷേകം","kn":"ಕುಮಾರನ ಅಭಿಷೇಕ"},"45":{"hi":"स्कंद के साथी और तारक का वध","te":"స్కందుడి అనుచరులు; తారకుడి సంహారం","ta":"ஸ்கந்தனின் தோழர்களும் தாரகனின் வதமும்","ml":"സ്കന്ദന്റെ അനുചരന്മാരും താരകവധവും","kn":"ಸ್ಕಂದನ ಅನುಚರರು ಮತ್ತು ತಾರಕನ ವಧೆ"},"46":{"hi":"वरुण और ब्रह्मर्षि के तीर्थ","te":"వరుణ, బ్రహ్మర్షి తీర్థాలు","ta":"வருணனின் தீர்த்தமும் பிரம்மரிஷியின் தீர்த்தமும்","ml":"വരുണന്റെയും ബ്രഹ്മർഷിയുടെയും തീർത്ഥങ്ങൾ","kn":"ವರುಣ ಮತ್ತು ಬ್ರಹ್ಮರ್ಷಿ ತೀರ್ಥಗಳು"},"47":{"hi":"बदरपचन और ब्राह्मण स्त्री","te":"బదరపచన, ఒక బ్రాహ్మణ స్త్రీ","ta":"பதரபசனமும் பிராமணப் பெண்ணும்","ml":"ബദരപചനവും ബ്രാഹ്മണ സ്ത്രീയും","kn":"ಬದರಪಾಚನ ಮತ್ತು ಬ್ರಾಹ್ಮಣ ಸ್ತ್ರೀ"},"48":{"hi":"इंद्रतीर्थ और आदित्यतीर्थ","te":"ఇంద్ర తీర్థం, ఆదిత్య తీర్థం","ta":"இந்திர தீர்த்தமும் ஆதித்ய தீர்த்தமும்","ml":"ഇന്ദ്രതീർത്ഥവും ആദിത്യതീർത്ഥവും","kn":"ಇಂದ್ರತೀರ್ಥ ಮತ್ತು ಆದಿತ್ಯತೀರ್ಥ"},"49":{"hi":"असित देवल और सिद्ध","te":"అసిత దేవలుడు, సిద్ధులు","ta":"அசிதர் தேவலரும் சித்தர்களும்","ml":"അസിതദേവലനും സിദ്ധന്മാരും","kn":"ಅಸಿತ ದೇವಲ ಮತ್ತು ಸಿದ್ಧರು"},"50":{"hi":"सोम का राजसूय यज्ञ और वैष्णव तीर्थ","te":"సోముని రాజసూయం, వైష్ణవ తీర్థాలు","ta":"சோமனின் ராஜசூயமும் வைஷ்ணவ தீர்த்தங்களும்","ml":"സോമന്റെ രാജസൂയവും വൈഷ്ണവ തീർത്ഥങ്ങളും","kn":"ಸೋಮನ ರಾಜಸೂಯ ಮತ್ತು ವೈಷ್ಣವ ತೀರ್ಥಗಳು"},"51":{"hi":"कुनिगर्ग की पुत्री की कथा","te":"కునిగర్గుడి కుమార్తె కథ","ta":"குனிகர்கரின் மகளின் கதை","ml":"കുണിഗർഗ്ഗന്റെ മകളുടെ കഥ","kn":"ಕುನಿಗರ್ಗನ ಪುತ್ರಿಯ ಕಥೆ"},"52":{"hi":"कुरुक्षेत्र का महत्त्व","te":"కురుక్షేత్ర మహిమ","ta":"குருக்ஷேத்திரத்தின் பெருமை","ml":"കുരുക്ഷേത്രത്തിന്റെ മഹത്വം","kn":"ಕುರುಕ್ಷೇತ್ರದ ಮಹಿಮೆ"},"53":{"hi":"बलराम समंतपंचक पहुंचते हैं","te":"బలరాముడు సమంతపంచకానికి వస్తాడు","ta":"பலராமன் சமந்தபஞ்சகத்திற்கு வருகிறான்","ml":"ബലരാമൻ സമന്തപഞ്ചകത്തിലെത്തുന്നു","kn":"ಬಲರಾಮ ಸಮಂತಪಂಚಕಕ್ಕೆ ಬರುತ್ತಾನೆ"},"54":{"hi":"बलराम गदा युद्ध देखते हैं","te":"గదాయుద్ధాన్ని బలరాముడు చూస్తాడు","ta":"கதாயுதப் போரைப் பலராமன் பார்க்கிறான்","ml":"ഗദായുദ്ധം ബലരാമൻ കാണുന്നു","kn":"ಗದಾ ಯುದ್ಧವನ್ನು ಬಲರಾಮ ವೀಕ್ಷಿಸುತ್ತಾನೆ"},"55":{"hi":"वाद-विवाद और अपशकुन","te":"మాటల యుద్ధం, అపశకునాలు","ta":"வாக்குவாதமும் அபசகுனங்களும்","ml":"വാക്കുതർക്കവും ശകുനങ്ങളും","kn":"ವಾಗ್ವಾದ ಮತ್ತು ಅಪಶಕುನಗಳು"},"56":{"hi":"गदा युद्ध आरंभ होता है","te":"గదాయుద్ధం మొదలవుతుంది","ta":"கதாயுதப் போர் தொடங்குகிறது","ml":"ഗദായുദ്ധം ആരംഭിക്കുന്നു","kn":"ಗದಾ ಯುದ್ಧ ಆರಂಭ"},"57":{"hi":"अर्जुन को कृष्ण का परामर्श","te":"అర్జునుడికి కృష్ణుడి సలహా","ta":"அர்ஜுனனுக்குக் கிருஷ்ணனின் ஆலோசனை","ml":"അർജ്ജുനന് കൃഷ്ണന്റെ ഉപദേശം","kn":"ಅರ್ಜುನನಿಗೆ ಕೃಷ್ಣನ ಸಲಹೆ"},"58":{"hi":"भीम दुर्योधन की जांघ तोड़ता है","te":"దుర్యోధనుడి తొడను భీముడు విరుస్తాడు","ta":"துரியோதனனின் தொடையைப் பீமன் முறிக்கிறான்","ml":"ഭീമൻ ദുര്യോധനന്റെ തുട തകർക്കുന്നു","kn":"ದುರ್ಯೋಧನನ ತೊಡೆಯನ್ನು ಭೀಮ ಮುರಿಯುತ್ತಾನೆ"},"59":{"hi":"बलराम का क्रोध और कृष्ण का बचाव","te":"బలరాముడి కోపం, కృష్ణుడి సమర్థన","ta":"பலராமனின் கோபமும் கிருஷ்ணனின் பாதுகாப்பும்","ml":"ബലരാമന്റെ കോപവും കൃഷ്ണന്റെ പ്രതിരോധവും","kn":"ಬಲರಾಮನ ಕೋಪ ಮತ್ತು ಕೃಷ್ಣನ ಸಮರ್ಥನೆ"},"60":{"hi":"दुर्योधन का कृष्ण पर दोषारोपण","te":"కృష్ణుడిని దుర్యోధనుడు నిందిస్తాడు","ta":"கிருஷ்ணனைத் துரியோதனன் கடிந்துகொள்கிறான்","ml":"കൃഷ്ണനെ ദുര്യോധനൻ കുറ്റപ്പെടുത്തുന്നു","kn":"ಕೃಷ್ಣನನ್ನು ದುರ್ಯೋಧನ ನಿಂದಿಸುತ್ತಾನೆ"},"61":{"hi":"पांडव उत्सव मनाते हैं और कृष्ण लौट जाते हैं","te":"పాండవులు సంబరాలు చేసుకుంటారు; కృష్ణుడు వెళ్తాడు","ta":"பாண்டவர்கள் கொண்டாடுகின்றனர்; கிருஷ்ணன் விடைபெறுகிறான்","ml":"പാണ്ഡവർ ആഘോഷിക്കുന്നു, കൃഷ്ണൻ മടങ്ങുന്നു","kn":"ಪಾಂಡವರ ಸಂಭ್ರಮ ಮತ್ತು ಕೃಷ್ಣನ ನಿರ್ಗಮನ"},"62":{"hi":"कृष्ण गांधारी के पास जाते हैं","te":"కృష్ణుడు గాంధారి వద్దకు వెళ్తాడు","ta":"கிருஷ்ணன் காந்தாரியிடம் செல்கிறான்","ml":"കൃഷ്ണൻ ഗാന്ധാരിയുടെ അടുത്തേക്ക് പോകുന്നു","kn":"ಗಾಂಧಾರಿಯ ಬಳಿಗೆ ಕೃಷ್ಣ ಹೋಗುತ್ತಾನೆ"},"63":{"hi":"दुर्योधन का विलाप और तीन कौरव","te":"దుర్యోధనుడి విలాపం, ముగ్గురు కౌరవులు","ta":"துரியோதனனின் புலம்பலும் மூன்று கௌரவர்களும்","ml":"ദുര്യോധനന്റെ വിലാപവും മൂന്ന് കൗരവരും","kn":"ದುರ್ಯೋಧನನ ಶೋಕ ಮತ್ತು ಮೂವರು ಕೌರವರು"},"64":{"hi":"कौरव चले जाते हैं और उस दिन के युद्ध का अंत","te":"కౌరవులు వెళ్లిపోతారు; యుద్ధ దినం ముగుస్తుంది","ta":"கௌரவர்கள் புறப்படுகின்றனர்; அன்றைய போர் முடிவுக்கு வருகிறது","ml":"കൗരവർ പോകുന്നു, യുദ്ധദിനത്തിന്റെ അന്ത്യം","kn":"ಕೌರವರ ನಿರ್ಗಮನ ಮತ್ತು ಯುದ್ಧದ ದಿನದ ಅಂತ್ಯ"}}