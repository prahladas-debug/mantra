{"1":{"te":"రాముడిని మునులు దర్శిస్తారు","hi":"ऋषि राम से मिलने आते हैं","kn":"ಋಷಿಗಳು ರಾಮನನ್ನು ಭೇಟಿಯಾಗುತ್ತಾರೆ","ta":"முனிவர்கள் இராமனைச் சந்திக்க வருகின்றனர்","ml":"മുനിമാർ രാമനെ സന്ദർശിക്കുന്നു"},"2":{"te":"పులస్త్యుడు, విశ్రవసుడి జననం","hi":"पुलस्त्य और विश्रवा का जन्म","kn":"ಪುಲಸ್ತ್ಯರು ಮತ್ತು ವಿಶ್ರವಸ್ಸಿನ ಜನನ","ta":"புலஸ்தியரும் விஸ்ரவசின் பிறப்பும்","ml":"പുലസ്ത്യനും വിശ്രവസ്സിന്റെ ജനനവും"},"3":{"te":"ధనాధిపతి వైశ్రవణుడు","hi":"धन के स्वामी वैश्रवण","kn":"ಧನಾಧಿಪತಿ ವೈಶ್ರವಣ","ta":"செல்வத்தின் அதிபதி வைசிரவணன்","ml":"സമ്പത്തിന്റെ അധിപനായ വൈശ്രവണൻ"},"4":{"te":"రాక్షసుల ఉత్పత్తి","hi":"राक्षसों की उत्पत्ति","kn":"ರಾಕ್ಷಸರ ಉಗಮ","ta":"அரக்கர்களின் தோற்றம்","ml":"രാക്ഷസന്മാരുടെ ഉത്ഭവം"},"5":{"te":"మాల్యవంతుడు, సుమాలి, మాలి","hi":"माल्यवान, सुमाली और माली","kn":"ಮಾಲ್ಯವಂತ, ಸುಮಾಲಿ ಮತ್ತು ಮಾಲಿ","ta":"மால்யவான், சுமாலி, மாலி","ml":"മാല്യവാൻ, സുമാലി, മാലി"},"6":{"te":"విష్ణువు సహాయం దేవతలు కోరతారు","hi":"देवता विष्णु की सहायता माँगते हैं","kn":"ದೇವತೆಗಳು ವಿಷ್ಣುವಿನ ಸಹಾಯ ಕೋರುತ್ತಾರೆ","ta":"விஷ்ணுவின் உதவியை தேவர்கள் நாடுகின்றனர்","ml":"വിഷ്ണുവിന്റെ സഹായം ദേവന്മാർ തേടുന്നു"},"7":{"te":"మాలిని విష్ణువు సంహరిస్తాడు","hi":"विष्णु माली का वध करते हैं","kn":"ವಿಷ್ಣು ಮಾಲಿಯನ್ನು ಸಂಹರಿಸುತ್ತಾನೆ","ta":"விஷ்ணு மாலியைக் கொல்கிறார்","ml":"വിഷ്ണു മാലിയെ വധിക്കുന്നു"},"8":{"te":"రాక్షసులు పాతాళానికి పారిపోతారు","hi":"राक्षस पाताल भागते हैं","kn":"ರಾಕ್ಷಸರು ಪಾತಾಳಕ್ಕೆ ಪಲಾಯನ ಮಾಡುತ್ತಾರೆ","ta":"அரக்கர்கள் பாதாளத்திற்குத் தப்பியோடுகின்றனர்","ml":"രാക്ഷസന്മാർ പാതാളത്തിലേക്ക് ഓടിപ്പോകുന്നു"},"9":{"te":"రావణుడు, ఆయన సోదరుల జననం","hi":"रावण और उसके भाइयों का जन्म","kn":"ರಾವಣ ಮತ್ತು ಅವನ ಸಹೋದರರ ಜನನ","ta":"இராவணனும் அவன் சகோதரர்களின் பிறப்பும்","ml":"രാവണന്റെയും സഹോദരന്മാരുടെയും ജനനം"},"10":{"te":"సోదరుల తపస్సు, వరాలు","hi":"भाइयों की तपस्या और वरदान","kn":"ಸಹೋದರರ ತಪಸ್ಸು ಮತ್ತು ವರಗಳು","ta":"சகோதரர்களின் தவமும் வரங்களும்","ml":"സഹോദരന്മാരുടെ തപസ്സും വരങ്ങളും"},"11":{"te":"లంకను రావణుడు స్వాధీనం చేసుకుంటాడు","hi":"रावण लंका पर अधिकार करता है","kn":"ರಾವಣನು ಲಂಕೆಯನ್ನು ಸ್ವಾಧೀನಪಡಿಸಿಕೊಳ್ಳುತ್ತಾನೆ","ta":"இராவணன் இலங்கையைக் கைப்பற்றுகிறான்","ml":"രാവണൻ ലങ്ക കൈവശപ്പെടുത്തുന്നു"},"12":{"te":"రావణ కుటుంబ వివాహాలు","hi":"रावण के परिवार के विवाह","kn":"ರಾವಣನ ಕುಟುಂಬದವರ ವಿವಾಹಗಳು","ta":"இராவணன் குடும்பத்தின் திருமணங்கள்","ml":"രാവണകുടുംബത്തിലെ വിവാഹങ്ങൾ"},"13":{"te":"వైశ్రవణుడి హెచ్చరిక","hi":"वैश्रवण की चेतावनी","kn":"ವೈಶ್ರವಣನ ಎಚ್ಚರಿಕೆ","ta":"வைசிரவணனின் எச்சரிக்கை","ml":"വൈശ്രവണന്റെ മുന്നറിയിപ്പ്"},"14":{"te":"యక్షులపై రావణుడి దాడి","hi":"रावण यक्षों पर आक्रमण करता है","kn":"ರಾವಣನು ಯಕ್ಷರ ಮೇಲೆ ದಾಳಿ ಮಾಡುತ್ತಾನೆ","ta":"இராவணன் யட்சர்களைத் தாக்குகிறான்","ml":"രാവണൻ യക്ഷന്മാരെ ആക്രമിക്കുന്നു"},"15":{"te":"వైశ్రవణుడిని రావణుడు ఓడిస్తాడు","hi":"रावण वैश्रवण को पराजित करता है","kn":"ರಾವಣನು ವೈಶ್ರವಣನನ್ನು ಸೋಲಿಸುತ್ತಾನೆ","ta":"இராவணன் வைசிரவணனை வெல்கிறான்","ml":"രാവണൻ വൈശ്രവണനെ തോൽപ്പിക്കുന്നു"},"16":{"te":"కైలాస పర్వతాన్ని రావణుడు ఎత్తుతాడు","hi":"रावण कैलास पर्वत उठाता है","kn":"ರಾವಣನು ಕೈಲಾಸ ಪರ್ವತವನ್ನು ಎತ್ತುತ್ತಾನೆ","ta":"இராவணன் கைலாய மலையைத் தூக்குகிறான்","ml":"രാവണൻ കൈലാസപർവതം ഉയർത്തുന്നു"},"17":{"te":"వేదవతి శాపం","hi":"वेदवती का शाप","kn":"ವೇದವತಿಯ ಶಾಪ","ta":"வேதவதியின் சாபம்","ml":"വേദവതിയുടെ ശാപം"},"18":{"te":"మరుత్తుడి యాగం","hi":"मरुत्त का यज्ञ","kn":"ಮರುತ್ತನ ಯಜ್ಞ","ta":"மருத்தனின் யாகம்","ml":"മരുത്തന്റെ യാഗം"},"19":{"te":"అనరణ్యుడి శాపం","hi":"अनरण्य का शाप","kn":"ಅನರಣ್ಯನ ಶಾಪ","ta":"அனரண்யரின் சாபம்","ml":"അനരണ്യന്റെ ശാപം"},"20":{"te":"నారదుడు రావణుడిని యముడి వద్దకు పంపుతాడు","hi":"नारद रावण को यम के पास भेजते हैं","kn":"ನಾರದರು ರಾವಣನನ್ನು ಯಮನ ಬಳಿಗೆ ಕಳುಹಿಸುತ್ತಾರೆ","ta":"நாரதர் இராவணனை யமனிடம் அனுப்புகிறார்","ml":"നാരദൻ രാവണനെ യമന്റെ അടുത്തേക്ക് അയയ്ക്കുന്നു"},"21":{"te":"యముడి లోకంలో రావణుడు","hi":"यम के लोक में रावण","kn":"ಯಮಲೋಕದಲ್ಲಿ ರಾವಣ","ta":"யமலோகத்தில் இராவணன்","ml":"യമലോകത്ത് രാവണൻ"},"22":{"te":"యముడు, రావణుడు","hi":"यम और रावण","kn":"ಯಮ ಮತ್ತು ರಾವಣ","ta":"யமனும் இராவணனும்","ml":"യമനും രാവണനും"},"23":{"te":"పాతాళలోకంలో రావణుడు","hi":"पाताल में रावण","kn":"ಪಾತಾಳಲೋಕದಲ್ಲಿ ರಾವಣ","ta":"பாதாள உலகில் இராவணன்","ml":"പാതാളത്തിൽ രാവണൻ"},"24":{"te":"బందీ స్త్రీలు; శూర్పణఖ దుఃఖం","hi":"बंदी स्त्रियाँ और शूर्पणखा का शोक","kn":"ಬಂಧಿತ ಸ್ತ್ರೀಯರು ಮತ್ತು ಶೂರ್ಪನಖಿಯ ದುಃಖ","ta":"சிறைபிடிக்கப்பட்ட பெண்கள்; சூர்ப்பனகையின் துயரம்","ml":"ബന്ദികളായ സ്ത്രീകളും ശൂർപ്പണഖയുടെ ദുഃഖവും"},"25":{"te":"మేఘనాదుడి యాగాలు, మధువు","hi":"मेघनाद के यज्ञ और मधु","kn":"ಮೇಘನಾದನ ಯಜ್ಞಗಳು ಮತ್ತು ಮಧು","ta":"மேகநாதனின் யாகங்களும் மதுவும்","ml":"മേഘനാദന്റെ യാഗങ്ങളും മധുവും"},"26":{"te":"రంభ, నలకూబరుల శాపం","hi":"रंभा और नलकूबर का शाप","kn":"ರಂಭೆ ಮತ್ತು ನಳಕೂಬರನ ಶಾಪ","ta":"ரம்பையும் நளகூபரனின் சாபமும்","ml":"രംഭയ്ക്കും നളകൂബരനും ശാപം"},"27":{"te":"దేవతలతో యుద్ధం; సుమాలి నేలకూలుతాడు","hi":"देवताओं से युद्ध; सुमाली गिरता है","kn":"ದೇವತೆಗಳೊಡನೆ ಯುದ್ಧ; ಸುಮಾಲಿಯ ಪತನ","ta":"தேவர்களுடன் போர்; சுமாலி வீழ்கிறான்","ml":"ദേവന്മാരുമായുള്ള യുദ്ധം; സുമാലി വീഴുന്നു"},"28":{"te":"మేఘనాదుడు జయంతుడితో, ఇంద్రుడితో పోరాడతాడు","hi":"मेघनाद जयंत और इंद्र से लड़ता है","kn":"ಮೇಘನಾದನು ಜಯಂತ ಮತ್ತು ಇಂದ್ರರೊಡನೆ ಹೋರಾಡುತ್ತಾನೆ","ta":"மேகநாதன் ஜயந்தனுடனும் இந்திரனுடனும் போரிடுகிறான்","ml":"മേഘനാദൻ ജയന്തനോടും ഇന്ദ്രനോടും യുദ്ധം ചെയ്യുന്നു"},"29":{"te":"ఇంద్రుడు బంధింపబడతాడు","hi":"इंद्र बंदी बनाए जाते हैं","kn":"ಇಂದ್ರನು ಬಂಧಿತನಾಗುತ್ತಾನೆ","ta":"இந்திரன் சிறைபிடிக்கப்படுகிறான்","ml":"ഇന്ദ്രൻ ബന്ധനത്തിലാകുന്നു"},"30":{"te":"ఇంద్రజిత్తుకు వరం; అహల్య శాపం","hi":"इंद्रजीत का वरदान और अहल्या का शाप","kn":"ಇಂದ್ರಜಿತ್ತಿನ ವರ ಮತ್ತು ಅಹಲ್ಯೆಯ ಶಾಪ","ta":"இந்திரஜித்தின் வரமும் அகல்யையின் சாபமும்","ml":"ഇന്ദ്രജിത്തിന്റെ വരവും അഹല്യയുടെ ശാപവും"},"31":{"te":"నర్మదా నది వద్ద రావణుడు","hi":"नर्मदा तट पर रावण","kn":"ನರ್ಮದಾ ತೀರದಲ್ಲಿ ರಾವಣ","ta":"நர்மதை நதிக்கரையில் இராவணன்","ml":"നർമദാതീരത്ത് രാവണൻ"},"32":{"te":"అర్జునుడు రావణుడిని బంధిస్తాడు","hi":"अर्जुन रावण को बंदी बनाते हैं","kn":"ಅರ್ಜುನನು ರಾವಣನನ್ನು ಬಂಧಿಸುತ್ತಾನೆ","ta":"அர்ஜுனன் இராவணனைச் சிறைபிடிக்கிறான்","ml":"അർജുനൻ രാവണനെ ബന്ധിക്കുന്നു"},"33":{"te":"పులస్త్యుడు రావణుడికి విముక్తి కలిగిస్తాడు","hi":"पुलस्त्य रावण को मुक्त कराते हैं","kn":"ಪುಲಸ್ತ್ಯರು ರಾವಣನನ್ನು ಬಿಡಿಸುತ್ತಾರೆ","ta":"புலஸ்தியர் இராவணனை விடுவிக்கிறார்","ml":"പുലസ്ത്യൻ രാവണനെ മോചിപ്പിക്കുന്നു"},"34":{"te":"రావణుడు, వాలి","hi":"रावण और बाली","kn":"ರಾವಣ ಮತ್ತು ವಾಲಿ","ta":"இராவணனும் வாலியும்","ml":"രാവണനും വാലിയും"},"35":{"te":"హనుమంతుడి బాల్యం","hi":"हनुमान का बचपन","kn":"ಹನುಮಂತನ ಬಾಲ್ಯ","ta":"அனுமனின் சிறுவயது","ml":"ഹനുമാന്റെ ബാല്യം"},"36":{"te":"హనుమంతుడికి దేవతల వరాలు","hi":"हनुमान को देवताओं के वरदान","kn":"ಹನುಮಂತನಿಗೆ ದೇವತೆಗಳ ವರಗಳು","ta":"அனுமனுக்குத் தேவர்கள் அளித்த வரங்கள்","ml":"ഹനുമാന് ദേവന്മാരുടെ വരങ്ങൾ"},"37":{"te":"రాముడి సభలో ఒక ఉదయం","hi":"राम के दरबार में एक प्रभात","kn":"ರಾಮನ ಆಸ್ಥಾನದಲ್ಲಿ ಒಂದು ಬೆಳಗು","ta":"இராமனின் அவையில் ஒரு காலைப்பொழுது","ml":"രാമന്റെ സദസ്സിലെ ഒരു പ്രഭാതം"},"38":{"te":"రాజులు వీడ్కోలు తీసుకుంటారు","hi":"राजा विदा लेते हैं","kn":"ರಾಜರು ಬೀಳ್ಕೊಡುತ್ತಾರೆ","ta":"அரசர்கள் விடைபெறுகின்றனர்","ml":"രാജാക്കന്മാർ യാത്ര ചോദിക്കുന്നു"},"39":{"te":"మిత్రులకు కానుకలు","hi":"सहयोगियों को उपहार","kn":"ಮಿತ್ರರಿಗೆ ಉಡುಗೊರೆಗಳು","ta":"நட்பு நாட்டவர்களுக்குப் பரிசுகள்","ml":"സഖ്യകക്ഷികൾക്കുള്ള സമ്മാനങ്ങൾ"},"40":{"te":"వానరులకు, రాక్షసులకు వీడ్కోలు","hi":"वानरों और राक्षसों से विदाई","kn":"ವಾನರ ಮತ್ತು ರಾಕ್ಷಸರಿಗೆ ವಿದಾಯ","ta":"குரங்குகளுக்கும் அரக்கர்களுக்கும் விடைகொடுத்தல்","ml":"വാനരന്മാർക്കും രാക്ഷസന്മാർക്കും യാത്രാമൊഴി"},"41":{"te":"పుష్పక విమానం తిరిగి వెళ్తుంది","hi":"पुष्पक विमान लौटता है","kn":"ಪುಷ್ಪಕ ವಿಮಾನ ಹಿಂತಿರುಗುತ್ತದೆ","ta":"புஷ்பக விமானம் திரும்புகிறது","ml":"പുഷ്പകവിമാനം മടങ്ങുന്നു"},"42":{"te":"అశోకవనంలో రాముడు, సీత","hi":"अशोक वाटिका में राम और सीता","kn":"ಅಶೋಕವನದಲ್ಲಿ ರಾಮ ಮತ್ತು ಸೀತೆ","ta":"அசோகவனத்தில் இராமனும் சீதையும்","ml":"അശോകോദ്യാനത്തിൽ രാമനും സീതയും"},"43":{"te":"ప్రజల మాటలను భద్రుడు నివేదిస్తాడు","hi":"भद्र प्रजा की चर्चा का समाचार देते हैं","kn":"ಜನರ ಮಾತನ್ನು ಭದ್ರ ವರದಿ ಮಾಡುತ್ತಾನೆ","ta":"மக்களின் பேச்சை பத்ரன் தெரிவிக்கிறான்","ml":"ജനങ്ങളുടെ സംസാരം ഭദ്രൻ അറിയിക്കുന്നു"},"44":{"te":"సోదరులను రాముడు పిలిపిస్తాడు","hi":"राम भाइयों को बुलाते हैं","kn":"ರಾಮನು ತಮ್ಮಂದಿರನ್ನು ಕರೆಸುತ್ತಾನೆ","ta":"இராமன் தம்பியரை அழைக்கிறான்","ml":"സഹോദരന്മാരെ രാമൻ വിളിച്ചുവരുത്തുന്നു"},"45":{"te":"సీతను విడిచిపెట్టాలని రాముడు నిశ్చయిస్తాడు","hi":"राम सीता को त्यागने का निश्चय करते हैं","kn":"ಸೀತೆಯನ್ನು ತ್ಯಜಿಸಲು ರಾಮನ ನಿರ್ಧಾರ","ta":"சீதையைக் கைவிட இராமன் முடிவு செய்கிறான்","ml":"സീതയെ ഉപേക്ഷിക്കാൻ രാമൻ തീരുമാനിക്കുന്നു"},"46":{"te":"సీతను లక్ష్మణుడు తీసుకువెళ్తాడు","hi":"लक्ष्मण सीता को ले जाते हैं","kn":"ಲಕ್ಷ್ಮಣನು ಸೀತೆಯನ್ನು ಕರೆದೊಯ್ಯುತ್ತಾನೆ","ta":"இலக்குவன் சீதையை அழைத்துச் செல்கிறான்","ml":"ലക്ഷ്മണൻ സീതയെ കൂട്ടിക്കൊണ്ടുപോകുന്നു"},"47":{"te":"సీతకు లక్ష్మణుడు చెబుతాడు","hi":"लक्ष्मण सीता को बताते हैं","kn":"ಲಕ್ಷ್ಮಣನು ಸೀತೆಗೆ ಹೇಳುತ್ತಾನೆ","ta":"இலக்குவன் சீதையிடம் கூறுகிறான்","ml":"ലക്ഷ്മണൻ സീതയോട് പറയുന്നു"},"48":{"te":"రాముడికి సీత సందేశం","hi":"राम के लिए सीता का संदेश","kn":"ರಾಮನಿಗೆ ಸೀತೆಯ ಸಂದೇಶ","ta":"இராமனுக்குச் சீதையின் செய்தி","ml":"രാമന് സീതയുടെ സന്ദേശം"},"49":{"te":"సీతకు వాల్మీకి ఆశ్రయమిస్తాడు","hi":"वाल्मीकि सीता को आश्रय देते हैं","kn":"ವಾಲ್ಮೀಕಿಯು ಸೀತೆಗೆ ಆಶ್ರಯ ನೀಡುತ್ತಾನೆ","ta":"வால்மீகி சீதைக்கு அடைக்கலம் அளிக்கிறார்","ml":"വാൽമീകി സീതയ്ക്ക് അഭയം നൽകുന്നു"},"50":{"te":"సుమంత్రుడు ఒక భవిష్యవాణిని గుర్తుచేస్తాడు","hi":"सुमंत्र एक भविष्यवाणी का स्मरण कराते हैं","kn":"ಸುಮಂತ್ರನು ಭವಿಷ್ಯವಾಣಿಯನ್ನು ನೆನಪಿಸುತ್ತಾನೆ","ta":"சுமந்திரர் ஒரு தீர்க்கதரிசனத்தை நினைவுகூர்கிறார்","ml":"സുമന്ത്രൻ ഒരു പ്രവചനം ഓർമിക്കുന്നു"},"51":{"te":"దుర్వాసుడి భవిష్యవాణి","hi":"दुर्वासा की भविष्यवाणी","kn":"ದುರ್ವಾಸರ ಭವಿಷ್ಯವಾಣಿ","ta":"துர்வாசரின் தீர்க்கதரிசனம்","ml":"ദുർവാസാവിന്റെ പ്രവചനം"},"52":{"te":"రాముడిని లక్ష్మణుడు ఓదారుస్తాడు","hi":"लक्ष्मण राम को सांत्वना देते हैं","kn":"ಲಕ್ಷ್ಮಣನು ರಾಮನಿಗೆ ಸಾಂತ್ವನ ಹೇಳುತ್ತಾನೆ","ta":"இலக்குவன் இராமனை ஆறுதல்படுத்துகிறான்","ml":"ലക്ഷ്മണൻ രാമനെ ആശ്വസിപ്പിക്കുന്നു"},"53":{"te":"నృగుడి కథ","hi":"नृग की कथा","kn":"ನೃಗನ ಕಥೆ","ta":"நிருகனின் கதை","ml":"നൃഗന്റെ കഥ"},"54":{"te":"నృగుడు గొయ్యిలోకి ప్రవేశిస్తాడు","hi":"नृग कूप में प्रवेश करते हैं","kn":"ನೃಗನು ಬಾವಿಯೊಳಗೆ ಬೀಳುತ್ತಾನೆ","ta":"நிருகன் கிணற்றுக்குள் செல்கிறான்","ml":"നൃഗൻ കിണറ്റിൽ പ്രവേശിക്കുന്നു"},"55":{"te":"నిమి, వశిష్ఠుడు","hi":"निमि और वसिष्ठ","kn":"ನಿಮಿ ಮತ್ತು ವಸಿಷ್ಠರು","ta":"நிமியும் வசிட்டரும்","ml":"നിമിയും വസിഷ്ഠനും"},"56":{"te":"మిత్రుడు, వరుణుడు, ఊర్వశి","hi":"मित्र, वरुण और उर्वशी","kn":"ಮಿತ್ರ, ವರುಣ ಮತ್ತು ಊರ್ವಶಿ","ta":"மித்திரன், வருணன், ஊர்வசி","ml":"മിത്രനും വരുണനും ഉർവശിയും"},"57":{"te":"వశిష్ఠుడి పునర్జన్మ; కనురెప్పల్లో నిమి","hi":"वसिष्ठ का पुनर्जन्म; पलकों में निमि","kn":"ವಸಿಷ್ಠರ ಪುನರ್ಜನ್ಮ; ಕಣ್ಣುರೆಪ್ಪೆಗಳಲ್ಲಿ ನಿಮಿ","ta":"மீண்டும் பிறக்கும் வசிட்டர்; இமைகளில் நிமி","ml":"വസിഷ്ഠന്റെ പുനർജന്മം; നിമി കണ്പീലികളിൽ"},"58":{"te":"యయాతికి శుక్రుడి శాపం","hi":"ययाति और शुक्र का शाप","kn":"ಯಯಾತಿ ಮತ್ತು ಶುಕ್ರಾಚಾರ್ಯರ ಶಾಪ","ta":"யயாதியும் சுக்கிரனின் சாபமும்","ml":"യയാതിയും ശുക്രന്റെ ശാപവും"},"59":{"te":"తండ్రి వృద్ధాప్యాన్ని పూరుడు స్వీకరిస్తాడు","hi":"पुरु पिता का बुढ़ापा लेते हैं","kn":"ತಂದೆಯ ವೃದ್ಧಾಪ್ಯವನ್ನು ಪುರು ಸ್ವೀಕರಿಸುತ್ತಾನೆ","ta":"தந்தையின் முதுமையை புரு ஏற்கிறான்","ml":"പിതാവിന്റെ വാർധക്യം പൂരു ഏറ്റെടുക്കുന്നു"},"60":{"te":"యమునా తీరానికి మునులు వస్తారు","hi":"यमुना तट के ऋषि आते हैं","kn":"ಯಮುನಾ ತೀರದ ಋಷಿಗಳ ಆಗಮನ","ta":"யமுனைக் கரை முனிவர்கள் வருகின்றனர்","ml":"യമുനാതീരത്തെ മുനിമാർ എത്തുന്നു"},"61":{"te":"మధువు శూలం, లవణుడు","hi":"मधु का त्रिशूल और लवण","kn":"ಮಧುವಿನ ಶೂಲ ಮತ್ತು ಲವಣ","ta":"மதுவின் வேலும் லவணனும்","ml":"മധുവിന്റെ ശൂലവും ലവണനും"},"62":{"te":"శత్రుఘ్నుడు ఎంపికవుతాడు","hi":"शत्रुघ्न चुने जाते हैं","kn":"ಶತ್ರುಘ್ನನು ಆಯ್ಕೆಯಾಗುತ್ತಾನೆ","ta":"சத்ருக்கனன் தேர்ந்தெடுக்கப்படுகிறான்","ml":"ശത്രുഘ്നനെ തിരഞ്ഞെടുക്കുന്നു"},"63":{"te":"శత్రుఘ్నుడికి పట్టాభిషేకం","hi":"शत्रुघ्न का अभिषेक","kn":"ಶತ್ರುಘ್ನನ ಪಟ್ಟಾಭಿಷೇಕ","ta":"சத்ருக்கனனுக்குப் பட்டாபிஷேகம்","ml":"ശത്രുഘ്നന്റെ അഭിഷേകം"},"64":{"te":"శత్రుఘ్నుడు బయలుదేరతాడు","hi":"शत्रुघ्न प्रस्थान करते हैं","kn":"ಶತ್ರುಘ್ನನು ಹೊರಡುತ್ತಾನೆ","ta":"சத்ருக்கனன் புறப்படுகிறான்","ml":"ശത്രുഘ്നൻ യാത്ര തിരിക്കുന്നു"},"65":{"te":"వాల్మీకి ఆశ్రమంలో సౌదాసుడి కథ","hi":"वाल्मीकि के आश्रम में: सौदास की कथा","kn":"ವಾಲ್ಮೀಕಿ ಆಶ್ರಮದಲ್ಲಿ: ಸೌದಾಸನ ಕಥೆ","ta":"வால்மீகியின் ஆசிரமத்தில்: சௌதாசனின் கதை","ml":"വാൽമീകിയുടെ ആശ്രമത്തിൽ; സൗദാസന്റെ കഥ"},"66":{"te":"లవకుశుల జననం","hi":"लव और कुश का जन्म","kn":"ಲವ ಮತ್ತು ಕುಶರ ಜನನ","ta":"லவனும் குசனும் பிறக்கின்றனர்","ml":"ലവന്റെയും കുശന്റെയും ജനനം"},"67":{"te":"మాంధాతను గురించి చ్యవనుడు చెబుతాడు","hi":"च्यवन मांधाता की कथा सुनाते हैं","kn":"ಮಾಂಧಾತನ ಕುರಿತು ಚ್ಯವನರ ಹೇಳಿಕೆ","ta":"மாந்தாதாவைப் பற்றி சியவனர் கூறுகிறார்","ml":"മാന്ധാതാവിനെക്കുറിച്ച് ച്യവനൻ പറയുന്നു"},"68":{"te":"లవణుడిని శత్రుఘ్నుడు సవాలు చేస్తాడు","hi":"शत्रुघ्न लवण को ललकारते हैं","kn":"ಶತ್ರುಘ್ನನು ಲವಣನಿಗೆ ಸವಾಲು ಹಾಕುತ್ತಾನೆ","ta":"சத்ருக்கனன் லவணனுக்கு சவால் விடுகிறான்","ml":"ലവണനെ ശത്രുഘ്നൻ വെല്ലുവിളിക്കുന്നു"},"69":{"te":"లవణుడి మరణం","hi":"लवण का वध","kn":"ಲವಣನ ಮರಣ","ta":"லவணனின் மரணம்","ml":"ലവണന്റെ മരണം"},"70":{"te":"మధుర స్థాపన","hi":"मथुरा की स्थापना","kn":"ಮಧುರಾ ನಗರದ ಸ್ಥಾಪನೆ","ta":"மதுரை நகரம் நிறுவப்படுகிறது","ml":"മഥുരയുടെ സ്ഥാപനം"},"71":{"te":"శత్రుఘ్నుడు రామాయణం వింటాడు","hi":"शत्रुघ्न रामायण सुनते हैं","kn":"ಶತ್ರುಘ್ನನು ರಾಮಾಯಣವನ್ನು ಕೇಳುತ್ತಾನೆ","ta":"சத்ருக்கனன் இராமாயணம் கேட்கிறான்","ml":"ശത്രുഘ്നൻ രാമായണം കേൾക്കുന്നു"},"72":{"te":"అయోధ్యను శత్రుఘ్నుడు దర్శిస్తాడు","hi":"शत्रुघ्न अयोध्या आते हैं","kn":"ಶತ್ರುಘ್ನನು ಅಯೋಧ್ಯೆಗೆ ಭೇಟಿ ನೀಡುತ್ತಾನೆ","ta":"சத்ருக்கனன் அயோத்திக்கு வருகை தருகிறான்","ml":"ശത്രുഘ്നൻ അയോധ്യ സന്ദർശിക്കുന്നു"},"73":{"te":"బ్రాహ్మణుడి మృతపుత్రుడు","hi":"ब्राह्मण का मृत पुत्र","kn":"ಬ್ರಾಹ್ಮಣನ ಮೃತ ಮಗ","ta":"பிராமணரின் இறந்த மகன்","ml":"ബ്രാഹ്മണന്റെ മരിച്ച പുത്രൻ"},"74":{"te":"కారణాన్ని నారదుడు వివరిస్తాడు","hi":"नारद कारण बताते हैं","kn":"ನಾರದರು ಕಾರಣವನ್ನು ವಿವರಿಸುತ್ತಾರೆ","ta":"காரணத்தை நாரதர் விளக்குகிறார்","ml":"കാരണം നാരദൻ വിശദീകരിക്കുന്നു"},"75":{"te":"రాజ్యమంతటా రాముడు అన్వేషిస్తాడు","hi":"राम राज्य में खोज करते हैं","kn":"ರಾಮನು ರಾಜ್ಯವನ್ನು ಶೋಧಿಸುತ್ತಾನೆ","ta":"இராமன் நாடு முழுவதும் தேடுகிறான்","ml":"രാജ്യമാകെ രാമൻ അന്വേഷിക്കുന്നു"},"76":{"te":"శంబూకుడు; అగస్త్యుడి కానుక","hi":"शंबूक; अगस्त्य का उपहार","kn":"ಶಂಬೂಕ; ಅಗಸ್ತ್ಯರ ಉಡುಗೊರೆ","ta":"சம்புகன்; அகத்தியரின் கொடை","ml":"ശംബുകൻ; അഗസ്ത്യന്റെ സമ്മാനം"},"77":{"te":"శూన్య అరణ్యంలో దేవతా పురుషుడు","hi":"सूने वन में दिव्य पुरुष","kn":"ನಿರ್ಜನ ಅರಣ್ಯದಲ್ಲಿ ದಿವ್ಯ ಪುರುಷ","ta":"வெறிச்சோடிய காட்டில் தேவன்","ml":"ശൂന്യവനത്തിലെ ദേവൻ"},"78":{"te":"శ్వేతుడి కథ","hi":"श्वेत की कथा","kn":"ಶ್ವೇತನ ಕಥೆ","ta":"சுவேதனின் கதை","ml":"ശ്വേതന്റെ കഥ"},"79":{"te":"ఇక్ష్వాకు కుమారుడు దండుడు","hi":"इक्ष्वाकु पुत्र दंड","kn":"ಇಕ್ಷ್ವಾಕುವಿನ ಮಗ ದಂಡ","ta":"இட்சுவாகுவின் மகன் தண்டன்","ml":"ഇക്ഷ്വാകുപുത്രനായ ദണ്ഡൻ"},"80":{"te":"దండుడు, అరజుడు","hi":"दंड और अरजा","kn":"ದಂಡ ಮತ್ತು ಅರಜ","ta":"தண்டனும் அரஜனும்","ml":"ദണ്ഡനും അരജനും"},"81":{"te":"శుక్రుడి శాపం; దండకారణ్యం","hi":"शुक्र का शाप; दंडक वन","kn":"ಶುಕ್ರಾಚಾರ್ಯರ ಶಾಪ; ದಂಡಕಾರಣ್ಯ","ta":"சுக்கிரனின் சாபமும் தண்டகாரண்யமும்","ml":"ശുക്രന്റെ ശാപം; ദണ്ഡകാരണ്യം"},"82":{"te":"అయోధ్యకు రాముడు తిరిగి వస్తాడు","hi":"राम अयोध्या लौटते हैं","kn":"ರಾಮನು ಅಯೋಧ್ಯೆಗೆ ಹಿಂತಿರುಗುತ್ತಾನೆ","ta":"இராமன் அயோத்திக்குத் திரும்புகிறான்","ml":"രാമൻ അയോധ്യയിലേക്ക് മടങ്ങുന്നു"},"83":{"te":"రాజసూయ యాగాన్ని వద్దని భరతుడు సూచిస్తాడు","hi":"भरत राजसूय यज्ञ से मना करते हैं","kn":"ರಾಜಸೂಯಕ್ಕೆ ಭರತನ ವಿರೋಧ","ta":"இராஜசூய யாகம் வேண்டாம் என்று பரதன் அறிவுறுத்துகிறான்","ml":"രാജസൂയയാഗത്തിനെതിരെ ഭരതൻ ഉപദേശിക്കുന്നു"},"84":{"te":"అశ్వమేధ యాగాన్ని లక్ష్మణుడు ప్రతిపాదిస్తాడు; వృత్రుడు","hi":"लक्ष्मण अश्वमेध का प्रस्ताव रखते हैं; वृत्र","kn":"ಲಕ್ಷ್ಮಣನು ಅಶ್ವಮೇಧವನ್ನು ಪ್ರಸ್ತಾಪಿಸುತ್ತಾನೆ; ವೃತ್ರ","ta":"அசுவமேத யாகத்தை இலக்குவன் முன்மொழிகிறான்; விருத்திரன்","ml":"അശ്വമേധം ലക്ഷ്മണൻ നിർദേശിക്കുന്നു; വൃത്രൻ"},"85":{"te":"వృత్రుడిని ఇంద్రుడు సంహరిస్తాడు","hi":"इंद्र वृत्र का वध करते हैं","kn":"ಇಂದ್ರನು ವೃತ್ರನನ್ನು ಸಂಹರಿಸುತ್ತಾನೆ","ta":"விருத்திரனை இந்திரன் கொல்கிறான்","ml":"ഇന്ദ്രൻ വൃത്രനെ വധിക്കുന്നു"},"86":{"te":"అశ్వమేధంతో ఇంద్రుడికి విముక్తి","hi":"अश्वमेध इंद्र को मुक्त कराता है","kn":"ಅಶ್ವಮೇಧದಿಂದ ಇಂದ್ರನ ವಿಮೋಚನೆ","ta":"அசுவமேதம் இந்திரனை விடுவிக்கிறது","ml":"അശ്വമേധം ഇന്ദ്രനെ മോചിപ്പിക്കുന്നു"},"87":{"te":"ఇల స్త్రీగా మారుతుంది","hi":"इला स्त्री बनती है","kn":"ಇಳಾ ಸ್ತ್ರೀಯಾಗುತ್ತಾಳೆ","ta":"இளா பெண்ணாக மாறுகிறான்","ml":"ഇളൻ സ്ത്രീയാകുന്നു"},"88":{"te":"ఇల, బుధుడు","hi":"इला और बुध","kn":"ಇಳಾ ಮತ್ತು ಬುಧ","ta":"இளாவும் புதனும்","ml":"ഇളനും ബുധനും"},"89":{"te":"పురూరవుడి జననం","hi":"पुरूरवा का जन्म","kn":"ಪುರೂರವನ ಜನನ","ta":"புரூரவஸின் பிறப்பு","ml":"പുരൂരവസ്സിന്റെ ജനനം"},"90":{"te":"అశ్వమేధంతో ఇలకు పూర్వరూపం","hi":"अश्वमेध से इला का पुनः पुरुष रूप","kn":"ಅಶ್ವಮೇಧದಿಂದ ಇಳಾ ಪುನಃ ಪುರುಷನಾಗುತ್ತಾನೆ","ta":"அசுவமேத யாகத்தால் இளா மீண்டும் ஆணாகிறான்","ml":"അശ്വമേധത്താൽ ഇളൻ പുരുഷനാകുന്നു"},"91":{"te":"అశ్వమేధ యాగ సన్నాహాలు","hi":"अश्वमेध यज्ञ की तैयारी","kn":"ಅಶ್ವಮೇಧ ಯಾಗದ ಸಿದ್ಧತೆಗಳು","ta":"குதிரை யாகத்திற்கான ஏற்பாடுகள்","ml":"അശ്വമേധയാഗത്തിനുള്ള ഒരുക്കങ്ങൾ"},"92":{"te":"అశ్వమేధ యాగం","hi":"अश्वमेध यज्ञ","kn":"ಅಶ್ವಮೇಧ ಯಾಗ","ta":"குதிரை யாகம்","ml":"അശ്വമേധയാഗം"},"93":{"te":"పాడమని లవకుశులను వాల్మీకి పంపుతాడు","hi":"वाल्मीकि लव और कुश को गाने भेजते हैं","kn":"ಹಾಡಲು ವಾಲ್ಮೀಕಿಯು ಲವ ಮತ್ತು ಕುಶರನ್ನು ಕಳುಹಿಸುತ್ತಾನೆ","ta":"பாடுவதற்கு லவனையும் குசனையும் வால்மீகி அனுப்புகிறார்","ml":"ആലപിക്കാൻ ലവനെയും കുശനെയും വാൽമീകി അയയ്ക്കുന്നു"},"94":{"te":"రాముడు ఆ గానాన్ని వింటాడు","hi":"राम गान सुनते हैं","kn":"ರಾಮನು ಹಾಡನ್ನು ಕೇಳುತ್ತಾನೆ","ta":"இராமன் பாடலைக் கேட்கிறான்","ml":"രാമൻ ഗാനം കേൾക്കുന്നു"},"95":{"te":"సీత ప్రమాణాన్ని రాముడు కోరతాడు","hi":"राम सीता की शपथ माँगते हैं","kn":"ಸೀತೆಯ ಪ್ರತಿಜ್ಞೆಯನ್ನು ರಾಮ ಕೋರುತ್ತಾನೆ","ta":"சீதையின் சத்தியத்தை இராமன் கேட்கிறான்","ml":"സീതയുടെ സത്യപ്രതിജ്ഞ രാമൻ ആവശ്യപ്പെടുന്നു"},"96":{"te":"సీతను వాల్మీకి సమర్పిస్తాడు","hi":"वाल्मीकि सीता को प्रस्तुत करते हैं","kn":"ವಾಲ್ಮೀಕಿಯು ಸೀತೆಯನ್ನು ಮುಂದಿರಿಸುತ್ತಾನೆ","ta":"வால்மீகி சீதையை முன்னிறுத்துகிறார்","ml":"വാൽമീകി സീതയെ ഹാജരാക്കുന്നു"},"97":{"te":"సీత భూమిలోకి తిరిగి వెళ్తుంది","hi":"सीता धरती में समाती हैं","kn":"ಸೀತೆ ಭೂಮಿಗೆ ಮರಳುತ್ತಾಳೆ","ta":"சீதை பூமிக்குள் செல்கிறாள்","ml":"സീത ഭൂമിയിലേക്ക് മടങ്ങുന്നു"},"98":{"te":"రాముడి దుఃఖం; బ్రహ్మ ఓదార్పు","hi":"राम का शोक और ब्रह्मा की सांत्वना","kn":"ರಾಮನ ದುಃಖ ಮತ್ತು ಬ್ರಹ್ಮರ ಸಾಂತ್ವನ","ta":"இராமனின் துயரமும் பிரம்மாவின் ஆறுதலும்","ml":"രാമന്റെ ദുഃഖവും ബ്രഹ്മാവിന്റെ ആശ്വാസവും"},"99":{"te":"రాముడి పాలన సంవత్సరాలు","hi":"राम के शासन के वर्ष","kn":"ರಾಮನ ಆಳ್ವಿಕೆಯ ವರ್ಷಗಳು","ta":"இராமனின் ஆட்சியின் ஆண்டுகள்","ml":"രാമന്റെ ഭരണകാലം"},"100":{"te":"యుధాజిత్తు సందేశం","hi":"युधाजित का संदेश","kn":"ಯುಧಾಜಿತನ ಸಂದೇಶ","ta":"யுதாஜித்தின் செய்தி","ml":"യുധാജിത്തിന്റെ സന്ദേശം"},"101":{"te":"గంధర్వులను భరతుడు జయిస్తాడు","hi":"भरत गंधर्वों पर विजय पाते हैं","kn":"ಭರತನು ಗಂಧರ್ವರನ್ನು ಜಯಿಸುತ್ತಾನೆ","ta":"கந்தர்வர்களை பரதன் வெல்கிறான்","ml":"ഗന്ധർവന്മാരെ ഭരതൻ കീഴടക്കുന്നു"},"102":{"te":"లక్ష్మణుడి కుమారులకు రాజ్యాలు","hi":"लक्ष्मण के पुत्रों के लिए राज्य","kn":"ಲಕ್ಷ್ಮಣನ ಪುತ್ರರಿಗೆ ರಾಜ್ಯಗಳು","ta":"இலக்குவனின் மகன்களுக்கு நாடுகள்","ml":"ലക്ഷ്മണന്റെ പുത്രന്മാർക്ക് രാജ്യങ്ങൾ"},"103":{"te":"యతిరూపంలో కాలం వస్తుంది","hi":"काल तपस्वी के रूप में आता है","kn":"ಕಾಲನು ತಪಸ್ವಿಯ ರೂಪದಲ್ಲಿ ಬರುತ್ತಾನೆ","ta":"துறவியாக வரும் காலம்","ml":"കാലപുരുഷൻ സന്യാസിയായി എത്തുന്നു"},"104":{"te":"బ్రహ్మ సందేశం","hi":"ब्रह्मा का संदेश","kn":"ಬ್ರಹ್ಮರ ಸಂದೇಶ","ta":"பிரம்மாவின் செய்தி","ml":"ബ്രഹ്മാവിന്റെ സന്ദേശം"},"105":{"te":"ద్వారం వద్ద దుర్వాసుడు","hi":"द्वार पर दुर्वासा","kn":"ದ್ವಾರದಲ್ಲಿ ದುರ್ವಾಸರು","ta":"வாயிலில் துர்வாசர்","ml":"വാതിൽക്കൽ ദുർവാസാവ്"},"106":{"te":"లక్ష్మణుడి నిష్క్రమణ","hi":"लक्ष्मण का प्रस्थान","kn":"ಲಕ್ಷ್ಮಣನ ನಿರ್ಗಮನ","ta":"இலக்குவனின் புறப்பாடு","ml":"ലക്ഷ്മണന്റെ വിടവാങ്ങൽ"},"107":{"te":"కుశలవులకు పట్టాభిషేకం","hi":"कुश और लव का राज्याभिषेक","kn":"ಕುಶ ಮತ್ತು ಲವರ ಪಟ್ಟಾಭಿಷೇಕ","ta":"குசனுக்கும் லவனுக்கும் முடிசூட்டு","ml":"കുശനും ലവനും കിരീടധാരണം ചെയ്യുന്നു"},"108":{"te":"మిత్రులు సమావేశమవుతారు","hi":"सहयोगी एकत्र होते हैं","kn":"ಮಿತ್ರರ ಸಮಾಗಮ","ta":"நட்பு நாட்டவர்கள் கூடுகின்றனர்","ml":"സഖ്യകക്ഷികൾ ഒരുമിച്ചുകൂടുന്നു"},"109":{"te":"మహా ప్రస్థానం","hi":"महाप्रस्थान","kn":"ಮಹಾ ಪ್ರಸ್ಥಾನ","ta":"பெரும் புறப்பாடு","ml":"മഹാപ്രസ്ഥാനം"},"110":{"te":"విష్ణువు వద్దకు రాముడు తిరిగి వెళ్తాడు","hi":"राम विष्णु में लीन होते हैं","kn":"ರಾಮನು ವಿಷ್ಣುವಿನಲ್ಲಿ ಲೀನವಾಗುತ್ತಾನೆ","ta":"இராமன் விஷ்ணுவிடம் திரும்புகிறான்","ml":"രാമൻ വിഷ്ണുവിലേക്ക് മടങ്ങുന്നു"},"111":{"te":"రామాయణ పుణ్యఫలం","hi":"रामायण का पुण्य","kn":"ರಾಮಾಯಣದ ಪುಣ್ಯ","ta":"இராமாயணம் அளிக்கும் புண்ணியம்","ml":"രാമായണത്തിന്റെ പുണ്യം"}}