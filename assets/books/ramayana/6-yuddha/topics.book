{"1":{"hi":"राम हनुमान की प्रशंसा करते हैं","te":"హనుమంతుడిని రాముడు ప్రశంసిస్తాడు","kn":"ರಾಮನು ಹನುಮಂತನನ್ನು ಹೊಗಳುತ್ತಾನೆ","ta":"அனுமனை இராமன் புகழ்கிறான்","ml":"ഹനുമാനെ രാമൻ പ്രശംസിക്കുന്നു"},"2":{"hi":"सुग्रीव राम को जगाते हैं","te":"రాముడిని సుగ్రీవుడు మేల్కొలుపుతాడు","kn":"ಸುಗ್ರೀವ ರಾಮನನ್ನು ಎಚ್ಚರಿಸುತ್ತಾನೆ","ta":"சுக்ரீவன் இராமனை எழுப்புகிறான்","ml":"സുഗ്രീവൻ രാമനെ ഉണർത്തുന്നു"},"3":{"hi":"लंका की सुरक्षा","te":"లంక రక్షణ వ్యవస్థ","kn":"ಲಂಕೆಯ ರಕ್ಷಣಾ ವ್ಯವಸ್ಥೆ","ta":"இலங்கையின் காவல் அரண்கள்","ml":"ലങ്കയുടെ പ്രതിരോധം"},"4":{"hi":"समुद्र तट की ओर कूच","te":"సముద్రం వైపు కవాతు","kn":"ಸಮುದ್ರದ ಕಡೆಗೆ ಸೇನೆಯ ಕವಾಯತು","ta":"கடலை நோக்கிய படையெடுப்பு","ml":"കടൽത്തീരത്തേക്കുള്ള യാത്ര"},"5":{"hi":"समुद्र तट पर राम की व्याकुलता","te":"సముద్ర తీరంలో రాముడి ఆవేదన","kn":"ಸಮುದ್ರ ತೀರದಲ್ಲಿ ರಾಮನ ವಿರಹ","ta":"கடற்கரையில் இராமனின் ஏக்கம்","ml":"കടൽത്തീരത്ത് രാമന്റെ വ്യഥ"},"6":{"hi":"रावण मंत्रणा करता है","te":"రావణుడు మంత్రాంగం చేస్తాడు","kn":"ರಾವಣನ ಮಂತ್ರಾಲೋಚನೆ","ta":"இராவணன் ஆலோசனை கேட்கிறான்","ml":"രാവണൻ ആലോചന നടത്തുന്നു"},"7":{"hi":"राक्षसों की डींगें","te":"రాక్షసుల ప్రగల్భాలు","kn":"ರಾಕ್ಷಸರ ಜಂಭದ ಮಾತುಗಳು","ta":"அரக்கர்களின் பெருமை பேச்சு","ml":"രാക്ഷസന്മാരുടെ വീമ്പുപറച്ചിൽ"},"8":{"hi":"सेनापति राम के वध की प्रतिज्ञा करते हैं","te":"రాముడిని చంపుతామని సేనాపతులు ప్రతిజ్ఞ చేస్తారు","kn":"ರಾಮನನ್ನು ಕೊಲ್ಲುವ ಪ್ರತಿಜ್ಞೆ ಮಾಡುವ ಸೇನಾಧಿಪತಿಗಳು","ta":"இராமனைக் கொல்வதாகத் தளபதிகள் சபதம் ஏற்கின்றனர்","ml":"രാമനെ വധിക്കുമെന്ന് സേനാനായകന്മാർ പ്രതിജ്ഞയെടുക്കുന്നു"},"9":{"hi":"विभीषण का पहला परामर्श","te":"విభీషణుడి తొలి హితవు","kn":"ವಿಭೀಷಣನ ಮೊದಲ ಸಲಹೆ","ta":"விபீடணனின் முதல் அறிவுரை","ml":"വിഭീഷണന്റെ ആദ്യ ഉപദേശം"},"10":{"hi":"विभीषण अशुभ लक्षणों की चेतावनी देते हैं","te":"అశుభ శకునాలపై విభీషణుడి హెచ్చరిక","kn":"ವಿಭೀಷಣನ ಅಶುಭ ಶಕುನಗಳ ಎಚ್ಚರಿಕೆ","ta":"விபீடணன் தீய சகுனங்கள் குறித்து எச்சரிக்கிறான்","ml":"ദുശ്ശകുനങ്ങളെക്കുറിച്ച് വിഭീഷണൻ മുന്നറിയിപ്പ് നൽകുന്നു"},"11":{"hi":"महासभा","te":"మహా సభ","kn":"ಮಹಾ ಸಭೆ","ta":"பெரிய ஆலோசனைக் கூட்டம்","ml":"മഹാസഭ"},"12":{"hi":"कुंभकर्ण का परामर्श","te":"కుంభకర్ణుడి హితవు","kn":"ಕುಂಭಕರ್ಣನ ಸಲಹೆ","ta":"கும்பகர்ணனின் ஆலோசனை","ml":"കുംഭകർണന്റെ ഉപദേശം"},"13":{"hi":"महापार्श्व की सलाह; ब्रह्मा का शाप","te":"మహాపార్శ్వుడి సలహా; బ్రహ్మ శాపం","kn":"ಮಹಾಪಾರ್ಶ್ವನ ಸಲಹೆ; ಬ್ರಹ್ಮನ ಶಾಪ","ta":"மகாபார்சுவனின் யோசனை; பிரம்மனின் சாபம்","ml":"മഹാപാർശ്വന്റെ നിർദേശം; ബ്രഹ്മശാപം"},"14":{"hi":"विभीषण की विनती","te":"విభీషణుడి విజ్ఞప్తి","kn":"ವಿಭೀಷಣನ ಮನವಿ","ta":"விபீடணனின் வேண்டுகோள்","ml":"വിഭീഷണന്റെ അപേക്ഷ"},"15":{"hi":"इंद्रजीत विभीषण का उपहास करता है","te":"విభీషణుడిని ఇంద్రజిత్తు ఎగతాళి చేస్తాడు","kn":"ವಿಭೀಷಣನನ್ನು ಇಂದ್ರಜಿತು ಅಪಹಾಸ್ಯ ಮಾಡುತ್ತಾನೆ","ta":"விபீடணனை இந்திரஜித் ஏளனம் செய்கிறான்","ml":"ഇന്ദ്രജിത്ത് വിഭീഷണനെ പരിഹസിക്കുന്നു"},"16":{"hi":"विभीषण रावण को छोड़ते हैं","te":"రావణుడిని విభీషణుడు వీడతాడు","kn":"ವಿಭೀಷಣ ರಾವಣನನ್ನು ತೊರೆಯುತ್ತಾನೆ","ta":"விபீடணன் இராவணனை விட்டு விலகுகிறான்","ml":"വിഭീഷണൻ രാവണനെ വിട്ടുപോകുന്നു"},"17":{"hi":"विभीषण राम के पास आते हैं","te":"రాముడి వద్దకు విభీషణుడు వస్తాడు","kn":"ವಿಭೀಷಣ ರಾಮನ ಬಳಿಗೆ ಬರುತ್ತಾನೆ","ta":"விபீடணன் இராமனிடம் வருகிறான்","ml":"വിഭീഷണൻ രാമന്റെ അടുത്തെത്തുന്നു"},"18":{"hi":"राम की शरणागति की प्रतिज्ञा","te":"శరణాగతికి రాముడి ప్రతిజ్ఞ","kn":"ಶರಣಾಗತರಕ್ಷಣೆಯ ರಾಮನ ಪ್ರತಿಜ್ಞೆ","ta":"அடைக்கலம் அளிப்பதாக இராமனின் சபதம்","ml":"ശരണാഗതിക്ക് രാമന്റെ വാഗ്ദാനം"},"19":{"hi":"विभीषण शरण लेते हैं","te":"విభీషణుడు శరణు పొందుతాడు","kn":"ವಿಭೀಷಣನಿಗೆ ಆಶ್ರಯ","ta":"விபீடணன் அடைக்கலம் புகுகிறான்","ml":"വിഭീഷണൻ രാമനെ ശരണം പ്രാപിക്കുന്നു"},"20":{"hi":"रावण का दूत शुक","te":"రావణుడి దూత శుకుడు","kn":"ರಾವಣನ ದೂತ ಶುಕ","ta":"இராவணனின் தூதன் சுகன்","ml":"രാവണന്റെ ദൂതൻ ശുകൻ"},"21":{"hi":"समुद्र पर राम का क्रोध","te":"సముద్రంపై రాముడి ఆగ్రహం","kn":"ಸಮುದ್ರದ ಮೇಲೆ ರಾಮನ ಕೋಪ","ta":"கடலின் மீது இராமனின் சினம்","ml":"സമുദ്രത്തോട് രാമന്റെ കോപം"},"22":{"hi":"लंका तक सेतु","te":"లంకకు సేతువు","kn":"ಲಂಕೆಗೆ ಸೇತುವೆ","ta":"இலங்கைக்குப் பாலம்","ml":"ലങ്കയിലേക്കുള്ള പാലം"},"23":{"hi":"संहार के लक्षण","te":"మారణ శకునాలు","kn":"ಸಂಹಾರದ ಅಶುಭ ಶಕುನಗಳು","ta":"படுகொலையின் சகுனங்கள்","ml":"കൂട്ടക്കൊലയുടെ ശകുനങ്ങൾ"},"24":{"hi":"लंका के सामने सेना; शुक को छोड़ा जाता है","te":"లంక ముందు సైన్యం; శుకుడికి విముక్తి","kn":"ಲಂಕೆಯ ಮುಂದೆ ಸೇನೆ; ಶುಕನ ಬಿಡುಗಡೆ","ta":"இலங்கைக்கு முன் படை; சுகன் விடுவிக்கப்படுகிறான்","ml":"ലങ്കയ്ക്കു മുന്നിൽ സൈന്യം; ശുകനെ വിട്ടയയ്ക്കുന്നു"},"25":{"hi":"शुक और सारण सेना का भेद लेते हैं","te":"సైన్యాన్ని శుకుడు, సారణుడు గూఢచర్యం చేస్తారు","kn":"ಶುಕ ಮತ್ತು ಸಾರಣರು ಸೇನೆಯನ್ನು ಗೂಢಚರ್ಯೆ ಮಾಡುತ್ತಾರೆ","ta":"சுகனும் சாரணனும் படையை உளவு பார்க்கின்றனர்","ml":"ശുകനും സാരണനും സൈന്യത്തെ ഒറ്റുനോക്കുന്നു"},"26":{"hi":"रावण सेना का निरीक्षण करता है","te":"సైన్యాన్ని రావణుడు పరిశీలిస్తాడు","kn":"ರಾವಣ ಸೇನೆಯನ್ನು ಪರಿಶೀಲಿಸುತ್ತಾನೆ","ta":"இராவணன் படையைப் பார்வையிடுகிறான்","ml":"രാവണൻ സൈന്യത്തെ വീക്ഷിക്കുന്നു"},"27":{"hi":"सारण और वीरों का वर्णन करते हैं","te":"మరికొందరు వీరులను సారణుడు వివరిస్తాడు","kn":"ಸಾರಣನು ಇನ್ನಷ್ಟು ವೀರರನ್ನು ವರ್ಣಿಸುತ್ತಾನೆ","ta":"சாரணன் மேலும் வீரர்களை வர்ணிக்கிறான்","ml":"കൂടുതൽ വീരന്മാരെ സാരണൻ വിവരിക്കുന്നു"},"28":{"hi":"शुक राम और उनके सहयोगियों का वर्णन करते हैं","te":"రాముడిని, ఆయన మిత్రులను శుకుడు వివరిస్తాడు","kn":"ಶುಕನು ರಾಮ ಮತ್ತು ಅವನ ಮಿತ್ರರನ್ನು ವರ್ಣಿಸುತ್ತಾನೆ","ta":"சுகன் இராமனையும் அவன் நண்பர்களையும் விவரிக்கிறான்","ml":"രാമനെയും സഖ്യകക്ഷികളെയും ശുകൻ വിവരിക്കുന്നു"},"29":{"hi":"रावण के नए गुप्तचर","te":"రావణుడి కొత్త గూఢచారులు","kn":"ರಾವಣನ ಹೊಸ ಗೂಢಚರರು","ta":"இராவணனின் புதிய ஒற்றர்கள்","ml":"രാവണന്റെ പുതിയ ചാരന്മാർ"},"30":{"hi":"शार्दूल का समाचार","te":"శార్దూలుడి నివేదిక","kn":"ಶಾರ್ದೂಲನ ವರದಿ","ta":"சார்த்தூலனின் அறிக்கை","ml":"ശാർദൂലന്റെ റിപ്പോർട്ട്"},"31":{"hi":"राम का नकली सिर","te":"రాముడి నకిలీ శిరస్సు","kn":"ರಾಮನ ನಕಲಿ ತಲೆ","ta":"இராமனின் போலித் தலை","ml":"രാമന്റെ വ്യാജത്തല"},"32":{"hi":"सिर देखकर सीता का विलाप","te":"శిరస్సు చూసి సీత విలాపం","kn":"ತಲೆಯ ಮುಂದೆ ಸೀತೆಯ ವಿಲಾಪ","ta":"தலையைக் கண்டு சீதையின் புலம்பல்","ml":"വ്യാജത്തലയ്ക്കരികെ സീതയുടെ വിലാപം"},"33":{"hi":"सरमा सीता को सांत्वना देती है","te":"సీతను సరమ ఓదారుస్తుంది","kn":"ಸರಮೆ ಸೀತೆಗೆ ಸಾಂತ್ವನ ಹೇಳುತ್ತಾಳೆ","ta":"சரமா சீதையை ஆறுதல்படுத்துகிறாள்","ml":"സരമ സീതയെ ആശ്വസിപ്പിക്കുന്നു"},"34":{"hi":"सरमा रावण का इरादा जानती है","te":"రావణుడి ఉద్దేశాన్ని సరమ తెలుసుకుంటుంది","kn":"ರಾವಣನ ಉದ್ದೇಶವನ್ನು ಸರಮೆ ತಿಳಿಯುತ್ತಾಳೆ","ta":"இராவணனின் நோக்கத்தை சரமா அறிகிறாள்","ml":"രാവണന്റെ ഉദ്ദേശ്യം സരമ മനസ്സിലാക്കുന്നു"},"35":{"hi":"माल्यवान की सलाह","te":"మాల్యవంతుడి సలహా","kn":"ಮಾಲ್ಯವಂತನ ಸಲಹೆ","ta":"மால்யவானின் அறிவுரை","ml":"മാല്യവാന്റെ ഉപദേശം"},"36":{"hi":"रावण सेनापतियों को तैनात करता है","te":"సేనాపతులను రావణుడు నియమిస్తాడు","kn":"ರಾವಣ ತನ್ನ ಸೇನಾಧಿಪತಿಗಳನ್ನು ನಿಯೋಜಿಸುತ್ತಾನೆ","ta":"இராவணன் தன் தளபதிகளை நிறுத்துகிறான்","ml":"രാവണൻ സേനാനായകന്മാരെ നിയോഗിക്കുന്നു"},"37":{"hi":"आक्रमण की योजना","te":"దాడి ప్రణాళిక","kn":"ಆಕ್ರಮಣದ ಯೋಜನೆ","ta":"தாக்குதல் திட்டம்","ml":"ആക്രമണപദ്ധതി"},"38":{"hi":"राम सुवेल पर चढ़ते हैं","te":"సువేల పర్వతం ఎక్కుతాడు రాముడు","kn":"ರಾಮ ಸುವೇಲ ಪರ್ವತವನ್ನು ಏರುತ್ತಾನೆ","ta":"இராமன் சுவேல மலை ஏறுகிறான்","ml":"രാമൻ സുവേലപർവതത്തിൽ കയറുന്നു"},"39":{"hi":"सुवेल से लंका का दृश्य","te":"సువేల నుంచి లంక దర్శనం","kn":"ಸುವೇಲದಿಂದ ಕಾಣುವ ಲಂಕೆ","ta":"சுவேல மலையிலிருந்து தெரியும் இலங்கை","ml":"സുവേലത്തിൽനിന്ന് ലങ്ക കാണുന്നു"},"40":{"hi":"सुग्रीव रावण पर आक्रमण करते हैं","te":"రావణుడిపై సుగ్రీవుడు దాడి చేస్తాడు","kn":"ಸುಗ್ರೀವ ರಾವಣನ ಮೇಲೆ ಆಕ್ರಮಣ ಮಾಡುತ್ತಾನೆ","ta":"சுக்ரீவன் இராவணனைத் தாக்குகிறான்","ml":"സുഗ്രീവൻ രാവണനെ ആക്രമിക്കുന്നു"},"41":{"hi":"अंगद का दूत-कार्य","te":"అంగదుడి రాయబారం","kn":"ಅಂಗದನ ಕಾರ್ಯಾಚರಣೆ","ta":"அங்கதனின் பணி","ml":"അംഗദന്റെ ദൗത്യം"},"42":{"hi":"युद्ध आरंभ","te":"యుద్ధం ప్రారంభం","kn":"ಯುದ್ಧ ಆರಂಭ","ta":"போர் தொடங்குகிறது","ml":"യുദ്ധം ആരംഭിക്കുന്നു"},"43":{"hi":"द्वंद्व युद्ध","te":"ఒకరితో ఒకరు యుద్ధాలు","kn":"ಏಕಾಂಗ ಯುದ್ಧಗಳು","ta":"ஒருவருக்கு ஒருவர் போர்","ml":"ഏകാങ്കയുദ്ധങ്ങൾ"},"44":{"hi":"इंद्रजीत के नाग बाण","te":"ఇంద్రజిత్తు నాగాస్త్రాలు","kn":"ಇಂದ್ರಜಿತುವಿನ ನಾಗಾಸ್ತ್ರಗಳು","ta":"இந்திரஜித்தின் பாம்பு அம்புகள்","ml":"ഇന്ദ്രജിത്തിന്റെ സർപ്പാസ്ത്രങ്ങൾ"},"45":{"hi":"दोनों भाई बंधे पड़े हैं","te":"సోదరులు బంధింపబడి పడి ఉంటారు","kn":"ಸಹೋದರರು ಬಂಧಿತರಾಗಿ ಬಿದ್ದಿರುವುದು","ta":"சகோதரர்கள் கட்டுண்டு கிடக்கின்றனர்","ml":"സഹോദരന്മാർ ബന്ധിതരായി കിടക്കുന്നു"},"46":{"hi":"इंद्रजीत की विजय","te":"ఇంద్రజిత్తు విజయోత్సవం","kn":"ಇಂದ್ರಜಿತುವಿನ ವಿಜಯ","ta":"இந்திரஜித்தின் வெற்றி","ml":"ഇന്ദ്രജിത്തിന്റെ വിജയഘോഷം"},"47":{"hi":"सीता को गिरे हुए राजकुमार दिखाए जाते हैं","te":"నేలకూలిన రాకుమారులను సీతకు చూపుతారు","kn":"ಬಿದ್ದ ರಾಜಕುಮಾರರನ್ನು ಸೀತೆಗೆ ತೋರಿಸುವುದು","ta":"வீழ்ந்த இளவரசர்களைச் சீதைக்குக் காட்டுதல்","ml":"വീണുകിടക്കുന്ന രാജകുമാരന്മാരെ സീതയ്ക്ക് കാണിക്കുന്നു"},"48":{"hi":"त्रिजटा सीता को सांत्वना देती है","te":"సీతను త్రిజట ఓదారుస్తుంది","kn":"ತ್ರಿಜಟೆ ಸೀತೆಗೆ ಸಾಂತ್ವನ ಹೇಳುತ್ತಾಳೆ","ta":"த்ரிஜடை சீதையை ஆறுதல்படுத்துகிறாள்","ml":"ത്രിജട സീതയെ ആശ്വസിപ്പിക്കുന്നു"},"49":{"hi":"लक्ष्मण के लिए राम का विलाप","te":"లక్ష్మణుడి కోసం రాముడి విలాపం","kn":"ಲಕ್ಷ್ಮಣನಿಗಾಗಿ ರಾಮನ ವಿಲಾಪ","ta":"இலக்குவனுக்காக இராமனின் புலம்பல்","ml":"ലക്ഷ്മണനെയോർത്ത് രാമന്റെ വിലാപം"},"50":{"hi":"गरुड़ राजकुमारों को मुक्त करते हैं","te":"రాకుమారులకు గరుత్మంతుడు విముక్తి కలిగిస్తాడు","kn":"ಗರುಡನು ರಾಜಕುಮಾರರನ್ನು ಬಿಡಿಸುತ್ತಾನೆ","ta":"கருடன் இளவரசர்களை விடுவிக்கிறான்","ml":"ഗരുഡൻ രാജകുമാരന്മാരെ മോചിപ്പിക്കുന്നു"},"51":{"hi":"धूम्राक्ष युद्ध में जाता है","te":"ధూమ్రాక్షుడు యుద్ధానికి వెళ్తాడు","kn":"ಧೂಮ್ರಾಕ್ಷ ಯುದ್ಧಕ್ಕೆ ಹೋಗುತ್ತಾನೆ","ta":"தூம்ராட்சன் போருக்குச் செல்கிறான்","ml":"ധൂമ്രാക്ഷൻ യുദ്ധത്തിന് പോകുന്നു"},"52":{"hi":"हनुमान धूम्राक्ष का वध करते हैं","te":"ధూమ్రాక్షుడిని హనుమంతుడు సంహరిస్తాడు","kn":"ಹನುಮಂತ ಧೂಮ್ರಾಕ್ಷನನ್ನು ಸಂಹರಿಸುತ್ತಾನೆ","ta":"அனுமன் தூம்ராட்சனைக் கொல்கிறான்","ml":"ഹനുമാൻ ധൂമ്രാക്ഷനെ വധിക്കുന്നു"},"53":{"hi":"वज्रदंष्ट्र का आक्रमण","te":"వజ్రదంష్ట్రుడి దాడి","kn":"ವಜ್ರದಂಷ್ಟ್ರನ ಆಕ್ರಮಣ","ta":"வஜ்ரதம்ஷ்டிரனின் தாக்குதல்","ml":"വജ്രദംഷ്ട്രന്റെ പുറപ്പാട്"},"54":{"hi":"अंगद वज्रदंष्ट्र का वध करते हैं","te":"వజ్రదంష్ట్రుడిని అంగదుడు సంహరిస్తాడు","kn":"ಅಂಗದ ವಜ್ರದಂಷ್ಟ್ರನನ್ನು ಸಂಹರಿಸುತ್ತಾನೆ","ta":"அங்கதன் வஜ்ரதம்ஷ்டிரனைக் கொல்கிறான்","ml":"അംഗദൻ വജ്രദംഷ്ട്രനെ വധിക്കുന്നു"},"55":{"hi":"अकंपन युद्ध में जाता है","te":"అకంపనుడు యుద్ధానికి వెళ్తాడు","kn":"ಅಕಂಪನನು ಯುದ್ಧಕ್ಕೆ ಹೋಗುತ್ತಾನೆ","ta":"அகம்பனன் போருக்குச் செல்கிறான்","ml":"അകമ്പനൻ യുദ്ധത്തിന് പോകുന്നു"},"56":{"hi":"हनुमान अकंपन का वध करते हैं","te":"అకంపనుడిని హనుమంతుడు సంహరిస్తాడు","kn":"ಹನುಮಂತ ಅಕಂಪನನನ್ನು ಸಂಹರಿಸುತ್ತಾನೆ","ta":"அனுமன் அகம்பனனைக் கொல்கிறான்","ml":"ഹനുമാൻ അകമ്പനനെ വധിക്കുന്നു"},"57":{"hi":"प्रहस्त रणभूमि में उतरता है","te":"ప్రహస్తుడు రణరంగంలోకి దిగుతాడు","kn":"ಪ್ರಹಸ್ತ ರಣರಂಗಕ್ಕೆ ಇಳಿಯುತ್ತಾನೆ","ta":"பிரகஸ்தன் களத்தில் இறங்குகிறான்","ml":"പ്രഹസ്തൻ രംഗത്തിറങ്ങുന്നു"},"58":{"hi":"नील प्रहस्त का वध करते हैं","te":"ప్రహస్తుడిని నీలుడు సంహరిస్తాడు","kn":"ನೀಲ ಪ್ರಹಸ್ತನನ್ನು ಸಂಹರಿಸುತ್ತಾನೆ","ta":"நீலன் பிரகஸ்தனைக் கொல்கிறான்","ml":"നീലൻ പ്രഹസ്തനെ വധിക്കുന്നു"},"59":{"hi":"रावण रणभूमि में उतरता है","te":"రావణుడు రణరంగంలోకి దిగుతాడు","kn":"ರಾವಣ ರಣರಂಗಕ್ಕೆ ಇಳಿಯುತ್ತಾನೆ","ta":"இராவணன் களத்தில் இறங்குகிறான்","ml":"രാവണൻ രംഗത്തിറങ്ങുന്നു"},"60":{"hi":"कुंभकर्ण को जगाया जाता है","te":"కుంభకర్ణుడిని మేల్కొలుపుతారు","kn":"ಕುಂಭಕರ್ಣನನ್ನು ಎಬ್ಬಿಸಲಾಗುತ್ತದೆ","ta":"கும்பகர்ணன் எழுப்பப்படுகிறான்","ml":"കുംഭകർണനെ ഉണർത്തുന്നു"},"61":{"hi":"विभीषण कुंभकर्ण की कथा सुनाते हैं","te":"కుంభకర్ణుడి గురించి విభీషణుడు చెబుతాడు","kn":"ಕುಂಭಕರ್ಣನ ಕುರಿತು ವಿಭೀಷಣನ ಮಾತು","ta":"கும்பகர்ணனைப் பற்றி விபீடணன் கூறுகிறான்","ml":"കുംഭകർണനെക്കുറിച്ച് വിഭീഷണൻ പറയുന്നു"},"62":{"hi":"रावण कुंभकर्ण से गुहार लगाता है","te":"కుంభకర్ణుడిని రావణుడు వేడుకుంటాడు","kn":"ರಾವಣ ಕುಂಭಕರ್ಣನಿಗೆ ಮನವಿ ಮಾಡುತ್ತಾನೆ","ta":"கும்பகர்ணனிடம் இராவணன் முறையிடுகிறான்","ml":"കുംഭകർണനോട് രാവണൻ അഭ്യർഥിക്കുന്നു"},"63":{"hi":"कुंभकर्ण रावण को फटकारता है","te":"రావణుడిని కుంభకర్ణుడు మందలిస్తాడు","kn":"ಕುಂಭಕರ್ಣ ರಾವಣನನ್ನು ಖಂಡಿಸುತ್ತಾನೆ","ta":"இராவணனைக் கும்பகர்ணன் கடிந்துகொள்கிறான்","ml":"കുംഭകർണൻ രാവണനെ ശാസിക്കുന്നു"},"64":{"hi":"महोदर की युक्ति","te":"మహోదరుడి పన్నాగం","kn":"ಮಹೋದರನ ತಂತ್ರ","ta":"மகோதரனின் சூழ்ச்சி","ml":"മഹോദരന്റെ തന്ത്രം"},"65":{"hi":"कुंभकर्ण युद्ध के लिए निकलता है","te":"కుంభకర్ణుడు యుద్ధానికి బయలుదేరతాడు","kn":"ಕುಂಭಕರ್ಣ ಯುದ್ಧಕ್ಕೆ ಹೊರಡುತ್ತಾನೆ","ta":"கும்பகர்ணன் படையுடன் புறப்படுகிறான்","ml":"കുംഭകർണൻ യുദ്ധത്തിന് പുറപ്പെടുന്നു"},"66":{"hi":"अंगद सेना का मनोबल बढ़ाते हैं","te":"అంగదుడు సైన్యాన్ని ఉత్తేజపరుస్తాడు","kn":"ಅಂಗದ ಸೇನೆಯನ್ನು ಪುನಃ ಒಗ್ಗೂಡಿಸುತ್ತಾನೆ","ta":"அங்கதன் படையைத் திரட்டுகிறான்","ml":"അംഗദൻ സൈന്യത്തെ അണിനിരത്തുന്നു"},"67":{"hi":"कुंभकर्ण का वध","te":"కుంభకర్ణుడి మరణం","kn":"ಕುಂಭಕರ್ಣನ ವಧೆ","ta":"கும்பகர்ணனின் மரணம்","ml":"കുംഭകർണന്റെ മരണം"},"68":{"hi":"रावण कुंभकर्ण का शोक करता है","te":"కుంభకర్ణుడి కోసం రావణుడి విలాపం","kn":"ಕುಂಭಕರ್ಣನಿಗಾಗಿ ರಾವಣನ ಶೋಕ","ta":"கும்பகர்ணனுக்காக இராவணனின் துக்கம்","ml":"കുംഭകർണനെയോർത്ത് രാവണൻ വിലപിക്കുന്നു"},"69":{"hi":"रावण के पुत्र युद्ध में जाते हैं; नरांतक गिरता है","te":"రావణుడి కుమారులు యుద్ధానికి వెళ్తారు; నరాంతకుడు నేలకూలుతాడు","kn":"ರಾವಣನ ಪುತ್ರರು ಯುದ್ಧಕ್ಕೆ ಹೋಗುತ್ತಾರೆ; ನರಾಂತಕನ ಪತನ","ta":"இராவணனின் மகன்கள் போருக்குச் செல்கின்றனர்; நராந்தகன் வீழ்கிறான்","ml":"രാവണപുത്രന്മാർ യുദ്ധത്തിന്; നരാന്തകൻ വീഴുന്നു"},"70":{"hi":"देवांतक, त्रिशिरा, महोदर और महापार्श्व गिरते हैं","te":"దేవాంతకుడు, త్రిశిరుడు, మహోదరుడు, మహాపార్శ్వుడు నేలకూలుతారు","kn":"ದೇವಾಂತಕ, ತ್ರಿಶಿರ, ಮಹೋದರ ಮತ್ತು ಮಹಾಪಾರ್ಶ್ವರ ಪತನ","ta":"தேவாந்தகன், திரிசிரஸ், மகோதரன், மகாபார்சுவன் வீழ்கின்றனர்","ml":"ദേവാന്തകനും ത്രിശിരസ്സും മഹോദരനും മഹാപാർശ്വനും വീഴുന്നു"},"71":{"hi":"लक्ष्मण अतिकाय का वध करते हैं","te":"అతికాయుడిని లక్ష్మణుడు సంహరిస్తాడు","kn":"ಲಕ್ಷ್ಮಣ ಅತಿಕಾಯನನ್ನು ಸಂಹರಿಸುತ್ತಾನೆ","ta":"இலக்குவன் அதிகாயனைக் கொல்கிறான்","ml":"ലക്ഷ്മണൻ അതികായനെ വധിക്കുന്നു"},"72":{"hi":"रावण की चिंता","te":"రావణుడి ఆందోళన","kn":"ರಾವಣನ ಆತಂಕ","ta":"இராவணனின் பதற்றம்","ml":"രാവണന്റെ ഭീതി"},"73":{"hi":"इंद्रजीत का ब्रह्मास्त्र","te":"ఇంద్రజిత్తు బ్రహ్మాస్త్రం","kn":"ಇಂದ್ರಜಿತುವಿನ ಬ್ರಹ್ಮಾಸ್ತ್ರ","ta":"இந்திரஜித்தின் பிரம்மாஸ்திரம்","ml":"ഇന്ദ്രജിത്തിന്റെ ബ്രഹ്മാസ്ത്രം"},"74":{"hi":"हनुमान संजीवनी पर्वत लाते हैं","te":"ఓషధి పర్వతాన్ని హనుమంతుడు తీసుకువస్తాడు","kn":"ಹನುಮಂತ ಔಷಧಿಯ ಪರ್ವತವನ್ನು ತರುತ್ತಾನೆ","ta":"அனுமன் மூலிகை மலையைக் கொண்டு வருகிறான்","ml":"സഞ്ജീവനി പർവതം ഹനുമാൻ കൊണ്ടുവരുന്നു"},"75":{"hi":"लंका में आग लगाई जाती है","te":"లంక దహనం","kn":"ಲಂಕೆಗೆ ಬೆಂಕಿ","ta":"இலங்கை தீக்கிரையாகிறது","ml":"ലങ്ക അഗ്നിക്കിരയാകുന്നു"},"76":{"hi":"कुंभ और अन्य वीर गिरते हैं","te":"కుంభుడు, ఇతర వీరులు నేలకూలుతారు","kn":"ಕುಂಭ ಮತ್ತು ಇತರ ವೀರರ ಪತನ","ta":"கும்பன் உள்ளிட்ட வீரர்கள் வீழ்கின்றனர்","ml":"കുംഭനും മറ്റു വീരന്മാരും വീഴുന്നു"},"77":{"hi":"हनुमान निकुंभ का वध करते हैं","te":"నికుంభుడిని హనుమంతుడు సంహరిస్తాడు","kn":"ಹನುಮಂತ ನಿಕುಂಭನನ್ನು ಸಂಹರಿಸುತ್ತಾನೆ","ta":"அனுமன் நிகும்பனைக் கொல்கிறான்","ml":"ഹനുമാൻ നികുംഭനെ വധിക്കുന്നു"},"78":{"hi":"मकराक्ष निकलता है","te":"మకరాక్షుడు బయలుదేరతాడు","kn":"ಮಕರಾಕ್ಷ ಯುದ್ಧಕ್ಕೆ ಹೊರಡುತ್ತಾನೆ","ta":"மகரக்ஷன் புறப்படுகிறான்","ml":"മകരാക്ഷൻ പുറപ്പെടുന്നു"},"79":{"hi":"राम मकराक्ष का वध करते हैं","te":"మకరాక్షుడిని రాముడు సంహరిస్తాడు","kn":"ರಾಮ ಮಕರಾಕ್ಷನನ್ನು ಸಂಹರಿಸುತ್ತಾನೆ","ta":"இராமன் மகரக்ஷனைக் கொல்கிறான்","ml":"രാമൻ മകരാക്ഷനെ വധിക്കുന്നു"},"80":{"hi":"इंद्रजीत अदृश्य होकर युद्ध करता है","te":"ఇంద్రజిత్తు కనిపించకుండా పోరాడతాడు","kn":"ಇಂದ್ರಜಿತು ಅದೃಶ್ಯನಾಗಿ ಹೋರಾಡುತ್ತಾನೆ","ta":"இந்திரஜித் கண்ணுக்குத் தெரியாமல் போரிடுகிறான்","ml":"ഇന്ദ്രജിത്ത് അദൃശ്യനായി യുദ്ധം ചെയ്യുന്നു"},"81":{"hi":"माया की सीता","te":"మాయా సీత","kn":"ಮಾಯಾ ಸೀತೆ","ta":"மாயச் சீதை","ml":"മായാസീത"},"82":{"hi":"हनुमान वानरों को एकत्र करते हैं","te":"వానరులను హనుమంతుడు ఉత్తేజపరుస్తాడు","kn":"ಹನುಮಂತ ವಾನರರನ್ನು ಒಗ್ಗೂಡಿಸುತ್ತಾನೆ","ta":"அனுமன் குரங்குகளைத் திரட்டுகிறான்","ml":"ഹനുമാൻ വാനരന്മാരെ അണിനിരത്തുന്നു"},"83":{"hi":"राम का शोक","te":"రాముడి దుఃఖం","kn":"ರಾಮನ ಶೋಕ","ta":"இராமனின் துயரம்","ml":"രാമന്റെ ദുഃഖം"},"84":{"hi":"विभीषण छल का भेद खोलते हैं","te":"మాయను విభీషణుడు బయటపెడతాడు","kn":"ವಿಭೀಷಣ ಮೋಸವನ್ನು ಬಯಲಿಗೆಳೆಯುತ್ತಾನೆ","ta":"விபீடணன் சூழ்ச்சியை வெளிப்படுத்துகிறான்","ml":"വിഭീഷണൻ തന്ത്രം വെളിപ്പെടുത്തുന്നു"},"85":{"hi":"लक्ष्मण निकुंभिला के लिए निकलते हैं","te":"నికుంభిలకు లక్ష్మణుడు బయలుదేరతాడు","kn":"ಲಕ್ಷ್ಮಣ ನಿಕುಂಭಿಲೆಗೆ ಹೊರಡುತ್ತಾನೆ","ta":"நிகும்பிலைக்கு இலக்குவன் புறப்படுகிறான்","ml":"നികുംഭിലയിലേക്ക് ലക്ഷ്മണൻ പുറപ്പെടുന്നു"},"86":{"hi":"इंद्रजीत यज्ञ छोड़ता है","te":"యాగాన్ని ఇంద్రజిత్తు వీడతాడు","kn":"ಇಂದ್ರಜಿತು ತನ್ನ ಯಜ್ಞವನ್ನು ತೊರೆಯುತ್ತಾನೆ","ta":"இந்திரஜித் தன் யாகத்தை விட்டு வருகிறான்","ml":"യാഗം ഉപേക്ഷിച്ച് ഇന്ദ്രജിത്ത് പോകുന്നു"},"87":{"hi":"विभीषण यज्ञ-वाटिका दिखाते हैं","te":"యజ్ఞవాటికను విభీషణుడు చూపిస్తాడు","kn":"ವಿಭೀಷಣ ಯಜ್ಞವನದ ತಾಣವನ್ನು ತೋರಿಸುತ್ತಾನೆ","ta":"யாகச் சோலையை விபீடணன் காட்டுகிறான்","ml":"യാഗവനം വിഭീഷണൻ കാണിച്ചുകൊടുക്കുന്നു"},"88":{"hi":"लक्ष्मण और इंद्रजीत का युद्ध","te":"లక్ష్మణుడు, ఇంద్రజిత్తు యుద్ధం","kn":"ಲಕ್ಷ್ಮಣ ಮತ್ತು ಇಂದ್ರಜಿತುವಿನ ಕಾಳಗ","ta":"இலக்குவனும் இந்திரஜித்தும் போரில்","ml":"ലക്ഷ്മണനും ഇന്ദ്രജിത്തും തമ്മിൽ യുദ്ധം"},"89":{"hi":"इंद्रजीत के सारथी का वध","te":"ఇంద్రజిత్తు సారథి హతమవుతాడు","kn":"ಇಂದ್ರಜಿತುವಿನ ಸಾರಥಿಯ ವಧೆ","ta":"இந்திரஜித்தின் தேரோட்டி கொல்லப்படுகிறான்","ml":"ഇന്ദ്രജിത്തിന്റെ സാരഥി വധിക്കപ്പെടുന്നു"},"90":{"hi":"इंद्रजीत का वध","te":"ఇంద్రజిత్తు మరణం","kn":"ಇಂದ್ರಜಿತುವಿನ ವಧೆ","ta":"இந்திரஜித்தின் மரணம்","ml":"ഇന്ദ്രജിത്തിന്റെ മരണം"},"91":{"hi":"राम लक्ष्मण का सम्मान करते हैं","te":"లక్ష్మణుడిని రాముడు గౌరవిస్తాడు","kn":"ರಾಮ ಲಕ್ಷ್ಮಣನನ್ನು ಗೌರವಿಸುತ್ತಾನೆ","ta":"இலக்குவனை இராமன் கௌரவிக்கிறான்","ml":"ലക്ഷ്മണനെ രാമൻ ആദരിക്കുന്നു"},"92":{"hi":"रावण सीता को मारने का निश्चय करता है","te":"సీతను చంపాలని రావణుడు సంకల్పిస్తాడు","kn":"ಸೀತೆಯನ್ನು ಕೊಲ್ಲಲು ರಾವಣನ ನಿರ್ಧಾರ","ta":"சீதையைக் கொல்ல இராவணன் முடிவு செய்கிறான்","ml":"സീതയെ വധിക്കാൻ രാവണൻ തീരുമാനിക്കുന്നു"},"93":{"hi":"राम राक्षस सेना का संहार करते हैं","te":"రాక్షస సేనను రాముడు నాశనం చేస్తాడు","kn":"ರಾಮ ರಾಕ್ಷಸ ಸೇನೆಯನ್ನು ನಾಶಮಾಡುತ್ತಾನೆ","ta":"இராமன் அரக்கர் படையை அழிக்கிறான்","ml":"രാക്ഷസസൈന്യത്തെ രാമൻ നശിപ്പിക്കുന്നു"},"94":{"hi":"राक्षस स्त्रियों का विलाप","te":"రాక్షస స్త్రీల విలాపం","kn":"ರಾಕ್ಷಸ ಸ್ತ್ರೀಯರ ವಿಲಾಪ","ta":"அரக்கப் பெண்களின் புலம்பல்","ml":"രാക്ഷസസ്ത്രീകളുടെ വിലാപം"},"95":{"hi":"रावण युद्ध के लिए निकलता है","te":"యుద్ధానికి రావణుడు బయలుదేరతాడు","kn":"ರಾವಣ ಯುದ್ಧಕ್ಕೆ ಹೊರಡುತ್ತಾನೆ","ta":"இராவணன் போருக்குப் புறப்படுகிறான்","ml":"രാവണൻ യുദ്ധത്തിന് പുറപ്പെടുന്നു"},"96":{"hi":"सुग्रीव विरूपाक्ष का वध करते हैं","te":"విరూపాక్షుడిని సుగ్రీవుడు సంహరిస్తాడు","kn":"ಸುಗ್ರೀವ ವಿರೂಪಾಕ್ಷನನ್ನು ಸಂಹರಿಸುತ್ತಾನೆ","ta":"சுக்ரீவன் விரூபாட்சனைக் கொல்கிறான்","ml":"സുഗ്രീവൻ വിരൂപാക്ഷനെ വധിക്കുന്നു"},"97":{"hi":"सुग्रीव महोदर का वध करते हैं","te":"మహోదరుడిని సుగ్రీవుడు సంహరిస్తాడు","kn":"ಸುಗ್ರೀವ ಮಹೋದರನನ್ನು ಸಂಹರಿಸುತ್ತಾನೆ","ta":"சுக்ரீவன் மகோதரனைக் கொல்கிறான்","ml":"സുഗ്രീവൻ മഹോദരനെ വധിക്കുന്നു"},"98":{"hi":"अंगद महापार्श्व का वध करते हैं","te":"మహాపార్శ్వుడిని అంగదుడు సంహరిస్తాడు","kn":"ಅಂಗದ ಮಹಾಪಾರ್ಶ್ವನನ್ನು ಸಂಹರಿಸುತ್ತಾನೆ","ta":"அங்கதன் மகாபார்சுவனைக் கொல்கிறான்","ml":"അംഗദൻ മഹാപാർശ്വനെ വധിക്കുന്നു"},"99":{"hi":"राम और रावण आमने-सामने","te":"రాముడు, రావణుడు ఎదురెదురుగా నిలుస్తారు","kn":"ರಾಮ ಮತ್ತು ರಾವಣ ಮುಖಾಮುಖಿ","ta":"இராமனும் இராவணனும் நேருக்கு நேர்","ml":"രാമനും രാവണനും നേർക്കുനേർ"},"100":{"hi":"रावण की शक्ति से लक्ष्मण मूर्छित होते हैं","te":"రావణుడి శూలంతో లక్ష్మణుడు నేలకూలుతాడు","kn":"ರಾವಣನ ಈಟಿಯಿಂದ ಲಕ್ಷ್ಮಣನಿಗೆ ಪೆಟ್ಟು","ta":"இராவணனின் வேலால் இலக்குவன் வீழ்த்தப்படுகிறான்","ml":"രാവണന്റെ വേലേറ്റ് ലക്ഷ്മണൻ വീഴുന്നു"},"101":{"hi":"लक्ष्मण पुनर्जीवित होते हैं","te":"లక్ష్మణుడు తిరిగి ప్రాణం పొందుతాడు","kn":"ಲಕ್ಷ್ಮಣನ ಪುನರುಜ್ಜೀವನ","ta":"இலக்குவன் உயிர்பெறுகிறான்","ml":"ലക്ഷ്മണന് ജീവൻ തിരിച്ചുകിട്ടുന്നു"},"102":{"hi":"इंद्र का रथ","te":"ఇంద్రుడి రథం","kn":"ಇಂದ್ರನ ರಥ","ta":"இந்திரனின் தேர்","ml":"ഇന്ദ്രന്റെ രഥം"},"103":{"hi":"रावण का सारथी रणभूमि से भागता है","te":"రావణుడి సారథి రణరంగం నుంచి పారిపోతాడు","kn":"ರಾವಣನ ಸಾರಥಿ ರಣರಂಗದಿಂದ ಪಲಾಯನ","ta":"இராவணனின் தேரோட்டி களத்தை விட்டு ஓடுகிறான்","ml":"രാവണന്റെ സാരഥി യുദ്ധക്കളം വിടുന്നു"},"104":{"hi":"रावण फिर युद्ध में लौटता है","te":"రావణుడు తిరిగి యుద్ధానికి వస్తాడు","kn":"ರಾವಣ ಮತ್ತೆ ಕಾಳಗಕ್ಕೆ ಮರಳುತ್ತಾನೆ","ta":"இராவணன் மீண்டும் போருக்குத் திரும்புகிறான்","ml":"രാവണൻ യുദ്ധത്തിലേക്ക് മടങ്ങുന്നു"},"105":{"hi":"आदित्य हृदय","te":"ఆదిత్య హృదయం","kn":"ಆದಿತ್ಯ ಹೃದಯ","ta":"ஆதித்ய ஹிருதயம்","ml":"ആദിത്യഹൃദയം"},"106":{"hi":"रावण के पतन के लक्षण","te":"రావణ పతనానికి సూచనలు","kn":"ರಾವಣನ ಪತನದ ಶಕುನಗಳು","ta":"இராவணனின் வீழ்ச்சியின் சகுனங்கள்","ml":"രാവണന്റെ പതനത്തിന്റെ ശകുനങ്ങൾ"},"107":{"hi":"फिर उगने वाले सिर","te":"మళ్లీ మొలిచే తలలు","kn":"ಮತ್ತೆ ಬೆಳೆಯುವ ತಲೆಗಳು","ta":"மீண்டும் முளைக்கும் தலைகள்","ml":"വീണ്ടും മുളയ്ക്കുന്ന തലകൾ"},"108":{"hi":"रावण का वध","te":"రావణుడి మరణం","kn":"ರಾವಣನ ವಧೆ","ta":"இராவணனின் மரணம்","ml":"രാവണന്റെ മരണം"},"109":{"hi":"विभीषण भाई का शोक करते हैं","te":"సోదరుడి కోసం విభీషణుడి విలాపం","kn":"ವಿಭೀಷಣನ ಸಹೋದರ ಶೋಕ","ta":"சகோதரனுக்காக விபீடணனின் துக்கம்","ml":"സഹോദരനെയോർത്ത് വിഭീഷണൻ വിലപിക്കുന്നു"},"110":{"hi":"रावण की पत्नियों का विलाप","te":"రావణ భార్యల విలాపం","kn":"ರಾವಣನ ಪತ್ನಿಯರ ವಿಲಾಪ","ta":"இராவணனின் மனைவியரின் புலம்பல்","ml":"രാവണന്റെ ഭാര്യമാരുടെ വിലാപം"},"111":{"hi":"मंदोदरी का विलाप और रावण का अंतिम संस्कार","te":"మండోదరి విలాపం; రావణుడి అంత్యక్రియలు","kn":"ಮಂಡೋದರಿಯ ವಿಲಾಪ ಮತ್ತು ರಾವಣನ ಅಂತ್ಯಕ್ರಿಯೆ","ta":"மண்டோதரியின் புலம்பலும் இராவணனின் இறுதிச் சடங்கும்","ml":"മണ്ഡോദരിയുടെ വിലാപവും രാവണന്റെ സംസ്കാരവും"},"112":{"hi":"विभीषण का राज्याभिषेक","te":"విభీషణుడికి పట్టాభిషేకం","kn":"ವಿಭೀಷಣನ ಪಟ್ಟಾಭಿಷೇಕ","ta":"விபீடணனுக்கு முடிசூட்டு","ml":"വിഭീഷണന്റെ കിരീടധാരണം"},"113":{"hi":"हनुमान सीता को समाचार देते हैं","te":"సీతకు వార్త తెస్తాడు హనుమంతుడు","kn":"ಹನುಮಂತ ಸೀತೆಗೆ ಸುದ್ದಿ ತಿಳಿಸುತ್ತಾನೆ","ta":"அனுமன் சீதைக்குச் செய்தி கொண்டு வருகிறான்","ml":"ഹനുമാൻ സീതയ്ക്ക് വാർത്ത എത്തിക്കുന്നു"},"114":{"hi":"सीता राम के सामने लाई जाती हैं","te":"సీతను రాముడి ఎదుట నిలబెడతారు","kn":"ಸೀತೆಯನ್ನು ರಾಮನ ಮುಂದೆ ಕರೆತರಲಾಗುತ್ತದೆ","ta":"சீதை இராமன் முன் கொண்டு வரப்படுகிறாள்","ml":"സീതയെ രാമന്റെ മുന്നിൽ എത്തിക്കുന്നു"},"115":{"hi":"राम के कठोर वचन","te":"రాముడి కఠిన మాటలు","kn":"ರಾಮನ ಕಟುವಾದ ಮಾತುಗಳು","ta":"இராமனின் கடுஞ்சொற்கள்","ml":"രാമന്റെ കടുത്ത വാക്കുകൾ"},"116":{"hi":"सीता की अग्नि-परीक्षा","te":"సీత అగ్నిపరీక్ష","kn":"ಸೀತೆಯ ಅಗ್ನಿಪರೀಕ್ಷೆ","ta":"சீதையின் அக்னிப் பரீட்சை","ml":"സീതയുടെ അഗ്നിപരീക്ഷ"},"117":{"hi":"ब्रह्मा का राम की स्तुति करना","te":"రాముడికి బ్రహ్మ స్తుతి","kn":"ರಾಮನನ್ನು ಕುರಿತು ಬ್ರಹ್ಮನ ಸ್ತುತಿ","ta":"இராமனைப் புகழ்ந்து பிரம்மாவின் துதி","ml":"രാമനെ സ്തുതിച്ച് ബ്രഹ്മാവ്"},"118":{"hi":"अग्नि सीता को लौटाते हैं","te":"అగ్ని సీతను తిరిగి అప్పగిస్తాడు","kn":"ಅಗ್ನಿ ಸೀತೆಯನ್ನು ಮರಳಿ ನೀಡುತ್ತಾನೆ","ta":"அக்னி சீதையை ஒப்படைக்கிறான்","ml":"അഗ്നി സീതയെ തിരികെ നൽകുന്നു"},"119":{"hi":"दशरथ प्रकट होते हैं","te":"దశరథుడు ప్రత్యక్షమవుతాడు","kn":"ದಶರಥ ಪ್ರತ್ಯಕ್ಷನಾಗುತ್ತಾನೆ","ta":"தசரதன் தோன்றுகிறான்","ml":"ദശരഥൻ പ്രത്യക്ഷപ്പെടുന്നു"},"120":{"hi":"इंद्र गिरे हुए वीरों को पुनर्जीवित करते हैं","te":"ఇంద్రుడు మృతులకు ప్రాణం పోస్తాడు","kn":"ಇಂದ್ರನು ಮಡಿದವರನ್ನು ಬದುಕಿಸುತ್ತಾನೆ","ta":"இந்திரன் வீழ்ந்தவர்களை உயிர்ப்பிக்கிறான்","ml":"ഇന്ദ്രൻ വീണവരെ ജീവിപ്പിക്കുന്നു"},"121":{"hi":"राम पुष्पक विमान माँगते हैं","te":"పుష్పక విమానం కోరతాడు రాముడు","kn":"ರಾಮ ಪುಷ್ಪಕ ವಿಮಾನವನ್ನು ಕೇಳುತ್ತಾನೆ","ta":"இராமன் புஷ்பக விமானத்தைக் கேட்கிறான்","ml":"പുഷ്പകവിമാനം രാമൻ ആവശ്യപ്പെടുന്നു"},"122":{"hi":"अयोध्या के लिए प्रस्थान","te":"అయోధ్యకు ప్రయాణం","kn":"ಅಯೋಧ್ಯೆಗೆ ಪ್ರಯಾಣ ಆರಂಭ","ta":"அயோத்திக்குப் புறப்படுதல்","ml":"അയോധ്യയിലേക്കുള്ള യാത്ര"},"123":{"hi":"आकाश मार्ग की यात्रा","te":"ఆకాశ మార్గంలో ప్రయాణం","kn":"ಆಕಾಶ ಮಾರ್ಗದ ಪ್ರಯಾಣ","ta":"வானில் பயணம்","ml":"ആകാശമാർഗമുള്ള യാത്ര"},"124":{"hi":"भरद्वाज के आश्रम में","te":"భరద్వాజ ఆశ్రమంలో","kn":"ಭಾರದ್ವಾಜರ ಆಶ್ರಮದಲ್ಲಿ","ta":"பரத்வாஜரின் ஆசிரமத்தில்","ml":"ഭരദ്വാജാശ്രമത്തിൽ"},"125":{"hi":"हनुमान आगे जाकर भरत को सूचना देते हैं","te":"భరతుడి వద్దకు హనుమంతుడు ముందుగా వెళ్తాడు","kn":"ಹನುಮಂತ ಭರತನ ಬಳಿಗೆ ಮುಂದೆ ಹೋಗುತ್ತಾನೆ","ta":"அனுமன் பரதனிடம் முன்னதாகச் செல்கிறான்","ml":"ഭരതനെ കാണാൻ ഹനുമാൻ മുന്നോടിയായി പോകുന്നു"},"126":{"hi":"हनुमान पूरी कथा सुनाते हैं","te":"మొత్తం కథను హనుమంతుడు చెబుతాడు","kn":"ಹನುಮಂತ ಇಡೀ ಕಥೆಯನ್ನು ಹೇಳುತ್ತಾನೆ","ta":"அனுமன் முழுக் கதையையும் கூறுகிறான்","ml":"ഹനുമാൻ മുഴുവൻ കഥയും വിവരിക്കുന്നു"},"127":{"hi":"भरत राम से मिलने जाते हैं","te":"రాముడిని కలవడానికి భరతుడు వెళ్తాడు","kn":"ಭರತ ರಾಮನನ್ನು ಭೇಟಿಯಾಗಲು ಹೋಗುತ್ತಾನೆ","ta":"இராமனைச் சந்திக்க பரதன் செல்கிறான்","ml":"രാമനെ കാണാൻ ഭരതൻ പോകുന്നു"},"128":{"hi":"राम का राज्याभिषेक","te":"రాముడి పట్టాభిషేకం","kn":"ರಾಮನ ಪಟ್ಟಾಭಿಷೇಕ","ta":"இராமனின் முடிசூட்டு விழா","ml":"രാമന്റെ പട്ടാഭിഷേകം"}}