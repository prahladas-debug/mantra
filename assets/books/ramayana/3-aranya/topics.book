{"1":{"hi":"दंडक वन के ऋषि राम का स्वागत करते हैं","te":"దండకారణ్య మునులు రాముడికి స్వాగతం పలుకుతారు","kn":"ದಂಡಕಾರಣ್ಯದ ಋಷಿಗಳು ರಾಮನನ್ನು ಸ್ವಾಗತಿಸುತ್ತಾರೆ","ta":"தண்டகாரண்ய முனிவர்கள் இராமனை வரவேற்கின்றனர்","ml":"ദണ്ഡകവനത്തിലെ മുനിമാർ രാമനെ സ്വാഗതം ചെയ്യുന്നു"},"2":{"hi":"विराध सीता को पकड़ता है","te":"విరాధుడు సీతను పట్టుకుంటాడు","kn":"ವಿರಾಧನು ಸೀತೆಯನ್ನು ಅಪಹರಿಸುತ್ತಾನೆ","ta":"விராதன் சீதையைப் பிடிக்கிறான்","ml":"വിരാധൻ സീതയെ പിടികൂടുന്നു"},"3":{"hi":"विराध से युद्ध","te":"విరాధుడితో యుద్ధం","kn":"ವಿರಾಧನೊಂದಿಗೆ ಯುದ್ಧ","ta":"விராதனுடன் போர்","ml":"വിരാധനുമായുള്ള യുദ്ധം"},"4":{"hi":"विराध का वध","te":"విరాధుడి మరణం","kn":"ವಿರಾಧನ ವಧೆ","ta":"விராதனின் மரணம்","ml":"വിരാധന്റെ മരണം"},"5":{"hi":"शरभंग स्वर्ग को जाते हैं","te":"శరభంగుడు స్వర్గానికి వెళ్తాడు","kn":"ಶರಭಂಗರ ಸ್ವರ್ಗಾರೋಹಣ","ta":"சரபங்கர் சொர்க்கம் ஏகுகிறார்","ml":"ശരഭംഗൻ സ്വർഗത്തിലേക്ക് പോകുന്നു"},"6":{"hi":"राम ऋषियों की रक्षा का वचन देते हैं","te":"మునులను రక్షిస్తానని రాముడు మాట ఇస్తాడు","kn":"ಋಷಿಗಳನ್ನು ರಕ್ಷಿಸುವ ರಾಮನ ಭರವಸೆ","ta":"முனிவர்களைக் காப்பதாக இராமன் வாக்களிக்கிறான்","ml":"മുനിമാരെ സംരക്ഷിക്കാമെന്ന് രാമൻ വാക്ക് നൽകുന്നു"},"7":{"hi":"सुतीक्ष्ण का आश्रम","te":"సుతీక్ష్ణుడి ఆశ్రమం","kn":"ಸುತೀಕ್ಷ್ಣರ ಆಶ್ರಮ","ta":"சுதீட்சணரின் ஆசிரமம்","ml":"സുതീക്ഷ്ണന്റെ ആശ്രമം"},"8":{"hi":"सुतीक्ष्ण से विदा","te":"సుతీక్ష్ణుడిని వీడటం","kn":"ಸುತೀಕ್ಷ್ಣರ ಆಶ್ರಮದಿಂದ ನಿರ್ಗಮನ","ta":"சுதீட்சணரை விட்டுப் புறப்படுதல்","ml":"സുതീക്ഷ്ണനെ വിട്ട് യാത്ര"},"9":{"hi":"सीता हिंसा के विरुद्ध परामर्श देती हैं","te":"హింసకు వ్యతిరేకంగా సీత హితవు","kn":"ಹಿಂಸೆಯ ವಿರುದ್ಧ ಸೀತೆಯ ಸಲಹೆ","ta":"வன்முறைக்கு எதிராக சீதையின் அறிவுரை","ml":"അക്രമത്തിനെതിരെ സീതയുടെ ഉപദേശം"},"10":{"hi":"सीता को राम का उत्तर","te":"సీతకు రాముడి సమాధానం","kn":"ಸೀತೆಗೆ ರಾಮನ ಉತ್ತರ","ta":"சீதைக்கு இராமனின் பதில்","ml":"സീതയ്ക്ക് രാമന്റെ മറുപടി"},"11":{"hi":"आश्रमों में दस वर्ष; अगस्त्य के भाई","te":"ఆశ్రమాల్లో పది సంవత్సరాలు; అగస్త్యుడి సోదరుడు","kn":"ಆಶ್ರಮಗಳಲ್ಲಿ ಹತ್ತು ವರ್ಷಗಳು; ಅಗಸ್ತ್ಯರ ಸಹೋದರ","ta":"ஆசிரமங்களில் பத்து ஆண்டுகள்; அகத்தியரின் சகோதரர்","ml":"ആശ്രമങ്ങളിൽ പത്ത് വർഷം; അഗസ്ത്യന്റെ സഹോദരൻ"},"12":{"hi":"अगस्त्य राम को दिव्य धनुष देते हैं","te":"అగస్త్యుడు రాముడికి దివ్య ధనుస్సును ఇస్తాడు","kn":"ಅಗಸ್ತ್ಯರು ರಾಮನಿಗೆ ದಿವ್ಯ ಧನುಸ್ಸನ್ನು ನೀಡುತ್ತಾರೆ","ta":"அகத்தியர் இராமனுக்கு தெய்வீக வில்லை அளிக்கிறார்","ml":"അഗസ്ത്യൻ രാമന് ദിവ്യധനുസ്സ് നൽകുന്നു"},"13":{"hi":"अगस्त्य राम को पंचवटी का मार्ग बताते हैं","te":"పంచవటికి వెళ్లమని అగస్త్యుడు రాముడికి సూచిస్తాడు","kn":"ಪಂಚವಟಿಗೆ ದಾರಿ ತೋರಿಸುವ ಅಗಸ್ತ್ಯರು","ta":"பஞ்சவடிக்குச் செல்ல அகத்தியர் வழி காட்டுகிறார்","ml":"പഞ്ചവടിയിലേക്ക് അഗസ്ത്യൻ രാമനെ നയിക്കുന്നു"},"14":{"hi":"राम जटायु से मिलते हैं","te":"జటాయువును రాముడు కలుస్తాడు","kn":"ರಾಮ ಜಟಾಯುವನ್ನು ಭೇಟಿಯಾಗುತ್ತಾನೆ","ta":"இராமன் ஜடாயுவைச் சந்திக்கிறான்","ml":"രാമൻ ജടായുവിനെ കാണുന്നു"},"15":{"hi":"पंचवटी में निवास","te":"పంచవటిలో నివాసం","kn":"ಪಂಚವಟಿಯಲ್ಲಿ ನೆಲೆ","ta":"பஞ்சவடியில் குடியேறுதல்","ml":"പഞ്ചവടിയിൽ വാസമുറപ്പിക്കുന്നു"},"16":{"hi":"पंचवटी में शीत ऋतु","te":"పంచవటిలో శీతకాలం","kn":"ಪಂಚವಟಿಯಲ್ಲಿ ಚಳಿಗಾಲ","ta":"பஞ்சவடியில் குளிர்காலம்","ml":"പഞ്ചവടിയിലെ ശിശിരകാലം"},"17":{"hi":"शूर्पणखा राम से मिलती है","te":"శూర్పణఖ రాముడిని కలుస్తుంది","kn":"ಶೂರ್ಪನಖಿ ರಾಮನನ್ನು ಭೇಟಿಯಾಗುತ್ತಾಳೆ","ta":"சூர்ப்பனகை இராமனைச் சந்திக்கிறாள்","ml":"ശൂർപ്പണഖ രാമനെ കാണുന്നു"},"18":{"hi":"शूर्पणखा विरूप होती है","te":"శూర్పణఖ అంగవికలమవుతుంది","kn":"ಶೂರ್ಪನಖಿಯ ಅಂಗವಿಕಲತೆ","ta":"சூர்ப்பனகையின் உருவம் சிதைக்கப்படுகிறது","ml":"ശൂർപ്പണഖയുടെ അംഗഭംഗം"},"19":{"hi":"खर चौदह राक्षस भेजता है","te":"ఖరుడు పద్నాలుగు మంది రాక్షసులను పంపుతాడు","kn":"ಖರನು ಹದಿನಾಲ್ಕು ರಾಕ್ಷಸರನ್ನು ಕಳುಹಿಸುತ್ತಾನೆ","ta":"கரன் பதினான்கு அரக்கர்களை அனுப்புகிறான்","ml":"പതിന്നാല് രാക്ഷസന്മാരെ ഖരൻ അയയ്ക്കുന്നു"},"20":{"hi":"चौदह राक्षसों का वध","te":"పద్నాలుగు మంది హతమవుతారు","kn":"ಹದಿನಾಲ್ಕು ರಾಕ್ಷಸರ ವಧೆ","ta":"பதினான்கு அரக்கர்கள் கொல்லப்படுகின்றனர்","ml":"പതിന്നാല് രാക്ഷസന്മാരുടെ വധം"},"21":{"hi":"शूर्पणखा खर को उकसाती है","te":"ఖరుడిని శూర్పణఖ రెచ్చగొడుతుంది","kn":"ಶೂರ್ಪನಖಿ ಖರನನ್ನು ಪ್ರಚೋದಿಸುತ್ತಾಳೆ","ta":"சூர்ப்பனகை கரனைத் தூண்டுகிறாள்","ml":"ഖരനെ ശൂർപ്പണഖ പ്രേരിപ്പിക്കുന്നു"},"22":{"hi":"खर चौदह हज़ार सैनिकों के साथ चढ़ाई करता है","te":"పద్నాలుగు వేల మందితో ఖరుడు కదులుతాడు","kn":"ಖರನು ಹದಿನಾಲ್ಕು ಸಾವಿರ ಸೈನಿಕರೊಂದಿಗೆ ನಡೆಯುತ್ತಾನೆ","ta":"கரன் பதினான்காயிரம் வீரர்களுடன் படையெடுக்கிறான்","ml":"പതിനാലായിരം സൈന്യവുമായി ഖരൻ പുറപ്പെടുന്നു"},"23":{"hi":"अशुभ लक्षण","te":"అశుభ శకునాలు","kn":"ಅಪಶಕುನಗಳು","ta":"தீய சகுனங்கள்","ml":"ദുശ്ശകുനങ്ങൾ"},"24":{"hi":"राम युद्ध की तैयारी करते हैं","te":"యుద్ధానికి రాముడు సన్నద్ధమవుతాడు","kn":"ರಾಮ ಯುದ್ಧಕ್ಕೆ ಸಿದ್ಧನಾಗುತ್ತಾನೆ","ta":"இராமன் போருக்குத் தயாராகிறான்","ml":"യുദ്ധത്തിന് രാമൻ ഒരുങ്ങുന്നു"},"25":{"hi":"राम राक्षस सेना को भगाते हैं","te":"రాక్షస సైన్యాన్ని రాముడు ఓడిస్తాడు","kn":"ರಾಮ ರಾಕ್ಷಸ ಸೇನೆಯನ್ನು ಚದುರಿಸುತ್ತಾನೆ","ta":"இராமன் அரக்கர் படையை விரட்டுகிறான்","ml":"രാക്ഷസസൈന്യത്തെ രാമൻ തോൽപ്പിക്കുന്നു"},"26":{"hi":"दूषण का वध","te":"దూషణుడి మరణం","kn":"ದೂಷಣನ ವಧೆ","ta":"தூடணனின் மரணம்","ml":"ദൂഷണന്റെ മരണം"},"27":{"hi":"त्रिशिरा का वध","te":"త్రిశిరుడి మరణం","kn":"ತ್ರಿಶಿರನ ವಧೆ","ta":"திரிசிரஸின் மரணம்","ml":"ത്രിശിരസ്സിന്റെ മരണം"},"28":{"hi":"राम और खर","te":"రాముడు, ఖరుడు","kn":"ರಾಮ ಮತ್ತು ಖರ","ta":"இராமனும் கரனும்","ml":"രാമനും ഖരനും"},"29":{"hi":"राम खर को फटकारते हैं","te":"ఖరుడిని రాముడు మందలిస్తాడు","kn":"ರಾಮ ಖರನನ್ನು ಖಂಡಿಸುತ್ತಾನೆ","ta":"இராமன் கரனைக் கடிந்துகொள்கிறான்","ml":"ഖരനെ രാമൻ ശാസിക്കുന്നു"},"30":{"hi":"खर का वध","te":"ఖరుడి మరణం","kn":"ಖರನ ವಧೆ","ta":"கரனின் மரணம்","ml":"ഖരന്റെ മരണം"},"31":{"hi":"अकंपन रावण को बताता है; मारीच की पहली चेतावनी","te":"అకంపనుడు రావణుడికి తెలియజేస్తాడు; మారీచుడి తొలి హెచ్చరిక","kn":"ಅಕಂಪನನು ರಾವಣನಿಗೆ ತಿಳಿಸುತ್ತಾನೆ; ಮಾರೀಚನ ಮೊದಲ ಎಚ್ಚರಿಕೆ","ta":"அகம்பனன் இராவணனிடம் கூறுகிறான்; மாரீசனின் முதல் எச்சரிக்கை","ml":"അകമ്പനൻ രാവണനോട് പറയുന്നു; മാരീചന്റെ ആദ്യ മുന്നറിയിപ്പ്"},"32":{"hi":"शूर्पणखा रावण के पास आती है","te":"రావణుడి వద్దకు శూర్పణఖ వస్తుంది","kn":"ಶೂರ್ಪನಖಿ ರಾವಣನ ಬಳಿಗೆ ಬರುತ್ತಾಳೆ","ta":"சூர்ப்பனகை இராவணனிடம் வருகிறாள்","ml":"ശൂർപ്പണഖ രാവണന്റെ അടുത്തെത്തുന്നു"},"33":{"hi":"शूर्पणखा रावण को फटकारती है","te":"రావణుడిని శూర్పణఖ నిందిస్తుంది","kn":"ಶೂರ್ಪನಖಿ ರಾವಣನನ್ನು ಖಂಡಿಸುತ್ತಾಳೆ","ta":"சூர்ப்பனகை இராவணனைக் கடிந்துகொள்கிறாள்","ml":"ശൂർപ്പണഖ രാവണനെ ശാസിക്കുന്നു"},"34":{"hi":"शूर्पणखा सीता का वर्णन करती है","te":"సీత గురించి శూర్పణఖ వర్ణిస్తుంది","kn":"ಶೂರ್ಪನಖಿ ಸೀತೆಯನ್ನು ವರ್ಣಿಸುತ್ತಾಳೆ","ta":"சூர்ப்பனகை சீதையை வர்ணிக்கிறாள்","ml":"സീതയെക്കുറിച്ച് ശൂർപ്പണഖ വിവരിക്കുന്നു"},"35":{"hi":"रावण मारीच के पास जाता है","te":"మారీచుడి వద్దకు రావణుడు వెళ్తాడు","kn":"ರಾವಣ ಮಾರೀಚನ ಬಳಿಗೆ ಹೋಗುತ್ತಾನೆ","ta":"இராவணன் மாரீசனிடம் செல்கிறான்","ml":"രാവണൻ മാരീചന്റെ അടുത്തേക്ക് പോകുന്നു"},"36":{"hi":"रावण मारीच से सहायता माँगता है","te":"మారీచుడి సహాయం రావణుడు కోరతాడు","kn":"ರಾವಣ ಮಾರೀಚನ ಸಹಾಯ ಕೇಳುತ್ತಾನೆ","ta":"இராவணன் மாரீசனின் உதவியைக் கேட்கிறான்","ml":"മാരീചന്റെ സഹായം രാവണൻ ആവശ്യപ്പെടുന്നു"},"37":{"hi":"मारीच की चेतावनी","te":"మారీచుడి హెచ్చరిక","kn":"ಮಾರೀಚನ ಎಚ್ಚರಿಕೆ","ta":"மாரீசனின் எச்சரிக்கை","ml":"മാരീചന്റെ മുന്നറിയിപ്പ്"},"38":{"hi":"राम से मारीच की अपनी मुठभेड़","te":"రాముడితో మారీచుడికి గతంలో ఎదురైన అనుభవం","kn":"ರಾಮನೊಂದಿಗೆ ಮಾರೀಚನ ಹಿಂದಿನ ಮುಖಾಮುಖಿ","ta":"இராமனுடன் மாரீசனின் சந்திப்பு","ml":"രാമനുമായുള്ള മാരീചന്റെ സ്വന്തം ഏറ്റുമുട്ടൽ"},"39":{"hi":"मारीच का दूसरी बार बचना","te":"మారీచుడి రెండవ పలాయనం","kn":"ಮಾರೀಚನ ಎರಡನೇ ಪಲಾಯನ","ta":"மாரீசனின் இரண்டாவது தப்பித்தல்","ml":"മാരീചന്റെ രണ്ടാമത്തെ രക്ഷപ്പെടൽ"},"40":{"hi":"रावण मारीच को धमकाता है","te":"మారీచుడిని రావణుడు బెదిరిస్తాడు","kn":"ರಾವಣನು ಮಾರೀಚನನ್ನು ಬೆದರಿಸುತ್ತಾನೆ","ta":"இராவணன் மாரீசனை மிரட்டுகிறான்","ml":"രാവണൻ മാരീചനെ ഭീഷണിപ്പെടുത്തുന്നു"},"41":{"hi":"मारीच मान जाता है","te":"మారీచుడు అంగీకరిస్తాడు","kn":"ಮಾರೀಚ ಒಪ್ಪಿಕೊಳ್ಳುತ್ತಾನೆ","ta":"மாரீசன் பணிகிறான்","ml":"മാരീചൻ വഴങ്ങുന്നു"},"42":{"hi":"स्वर्ण मृग","te":"బంగారు జింక","kn":"ಚಿನ್ನದ ಜಿಂಕೆ","ta":"பொன்மான்","ml":"സ്വർണമാൻ"},"43":{"hi":"राम मृग के पीछे जाते हैं","te":"జింకను వెంబడిస్తాడు రాముడు","kn":"ರಾಮ ಜಿಂಕೆಯ ಹಿಂದೆ ಹೋಗುತ್ತಾನೆ","ta":"இராமன் மானைத் துரத்திச் செல்கிறான்","ml":"മാനിനെ പിന്തുടർന്ന് രാമൻ പോകുന്നു"},"44":{"hi":"मारीच का वध","te":"మారీచుడి మరణం","kn":"ಮಾರೀಚನ ವಧೆ","ta":"மாரீசனின் மரணம்","ml":"മാരീചന്റെ മരണം"},"45":{"hi":"सीता के लक्ष्मण से कठोर वचन","te":"లక్ష్మణుడితో సీత కఠిన మాటలు","kn":"ಲಕ್ಷ್ಮಣನಿಗೆ ಸೀತೆಯ ಕಟುವಾದ ಮಾತುಗಳು","ta":"இலக்குவனிடம் சீதையின் கடுஞ்சொற்கள்","ml":"ലക്ഷ്മണനോട് സീതയുടെ കടുത്ത വാക്കുകൾ"},"46":{"hi":"रावण भिक्षु के वेश में आता है","te":"యాచకుడి రూపంలో రావణుడు వస్తాడు","kn":"ರಾವಣ ಭಿಕ್ಷುಕನ ವೇಷದಲ್ಲಿ ಬರುತ್ತಾನೆ","ta":"இராவணன் துறவி வேடத்தில் வருகிறான்","ml":"സന്യാസി വേഷത്തിൽ രാവണൻ എത്തുന്നു"},"47":{"hi":"रावण अपना रूप प्रकट करता है","te":"రావణుడు తన నిజరూపాన్ని చూపుతాడు","kn":"ರಾವಣ ತನ್ನ ನಿಜ ರೂಪವನ್ನು ಬಹಿರಂಗಪಡಿಸುತ್ತಾನೆ","ta":"இராவணன் தன் உண்மை உருவைக் காட்டுகிறான்","ml":"രാവണൻ സ്വരൂപം വെളിപ്പെടുത്തുന്നു"},"48":{"hi":"रावण अपने बल की डींग हाँकता है","te":"తన శక్తిని రావణుడు గొప్పగా చెప్పుకుంటాడు","kn":"ರಾವಣ ತನ್ನ ಶಕ್ತಿಯ ಕುರಿತು ಕೊಚ್ಚಿಕೊಳ್ಳುತ್ತಾನೆ","ta":"இராவணன் தன் வலிமையைப் பெருமையாகக் கூறுகிறான்","ml":"രാവണൻ തന്റെ ശക്തി പ്രശംസിക്കുന്നു"},"49":{"hi":"सीता हरण","te":"సీతాపహరణం","kn":"ಅಪಹರಣ","ta":"சீதை கடத்தப்படுகிறாள்","ml":"സീതാപഹരണം"},"50":{"hi":"जटायु रावण को ललकारते हैं","te":"రావణుడిని జటాయువు ఎదిరిస్తాడు","kn":"ಜಟಾಯು ರಾವಣನಿಗೆ ಸವಾಲು ಹಾಕುತ್ತಾನೆ","ta":"ஜடாயு இராவணனுடன் போரிடுகிறார்","ml":"ജടായു രാവണനെ വെല്ലുവിളിക്കുന്നു"},"51":{"hi":"जटायु गिरते हैं","te":"జటాయువు పడిపోతాడు","kn":"ಜಟಾಯು ಬೀಳುತ್ತಾನೆ","ta":"ஜடாயு வீழ்கிறார்","ml":"ജടായു വീഴുന്നു"},"52":{"hi":"सीता आकाश मार्ग से ले जाई जाती हैं","te":"ఆకాశ మార్గంలో సీతను మోసుకుపోతాడు రావణుడు","kn":"ಆಕಾಶ ಮಾರ್ಗದಲ್ಲಿ ಸೀತೆಯ ಅಪಹರಣ","ta":"வானில் சீதை கொண்டு செல்லப்படுகிறாள்","ml":"ആകാശമാർഗം സീതയെ കൊണ്ടുപോകുന്നു"},"53":{"hi":"सीता का प्रतिरोध","te":"సీత ధిక్కారం","kn":"ಸೀತೆಯ ಪ್ರತಿರೋಧ","ta":"சீதையின் எதிர்ப்பு","ml":"സീതയുടെ ചെറുത്തുനിൽപ്പ്"},"54":{"hi":"वानरों के बीच आभूषण गिराए जाते हैं","te":"సీత ఆభరణాలను వానరుల మధ్య జారవిడుస్తుంది","kn":"ವಾನರರ ನಡುವೆ ಬಿದ್ದ ಆಭರಣಗಳು","ta":"குரங்குகளின் நடுவே விழுந்த நகைகள்","ml":"വാനരന്മാർക്കിടയിൽ ആഭരണങ്ങൾ വീഴ്ത്തുന്നു"},"55":{"hi":"रावण सीता को लुभाता है","te":"రావణుడు సీతను ప్రలోభపెడతాడు","kn":"ರಾವಣ ಸೀತೆಯನ್ನು ಆಮಿಷಕ್ಕೊಳಪಡಿಸುತ್ತಾನೆ","ta":"இராவணன் சீதையை ஆசை காட்டி மயக்க முயல்கிறான்","ml":"രാവണൻ സീതയെ പ്രലോഭിപ്പിക്കുന്നു"},"56":{"hi":"अशोक वाटिका में सीता","te":"అశోకవనంలో సీత","kn":"ಅಶೋಕವನದಲ್ಲಿ ಸೀತೆ","ta":"அசோகவனத்தில் சீதை","ml":"അശോകവനത്തിൽ സീത"},"57":{"hi":"लौटते समय राम लक्ष्मण से मिलते हैं","te":"తిరిగి వస్తూ లక్ష్మణుడిని రాముడు కలుస్తాడు","kn":"ಹಿಂತಿರುಗುವ ದಾರಿಯಲ್ಲಿ ರಾಮ ಲಕ್ಷ್ಮಣನನ್ನು ಭೇಟಿಯಾಗುತ್ತಾನೆ","ta":"திரும்பும் வழியில் இலக்குவனைச் சந்திக்கிறான் இராமன்","ml":"മടങ്ങിവരുമ്പോൾ രാമൻ ലക്ഷ്മണനെ കാണുന്നു"},"58":{"hi":"सूनी कुटिया","te":"ఖాళీ పర్ణశాల","kn":"ಖಾಲಿ ಕುಟೀರ","ta":"வெறிச்சோடிய குடில்","ml":"ശൂന്യമായ പർണശാല"},"59":{"hi":"लक्ष्मण बताते हैं","te":"లక్ష్మణుడు వివరిస్తాడు","kn":"ಲಕ್ಷ್ಮಣ ವಿವರಿಸುತ್ತಾನೆ","ta":"இலக்குவன் விளக்குகிறான்","ml":"ലക്ഷ്മണൻ വിശദീകരിക്കുന്നു"},"60":{"hi":"राम वृक्षों से सीता का पता पूछते हैं","te":"సీత గురించి చెట్లను రాముడు అడుగుతాడు","kn":"ರಾಮ ಸೀತೆಯ ಕುರಿತು ಮರಗಳನ್ನು ಪ್ರಶ್ನಿಸುತ್ತಾನೆ","ta":"சீதையைப் பற்றி மரங்களிடம் இராமன் கேட்கிறான்","ml":"മരങ്ങളോട് സീതയെക്കുറിച്ച് രാമൻ ചോദിക്കുന്നു"},"61":{"hi":"खोज जारी रहती है","te":"అన్వేషణ కొనసాగుతుంది","kn":"ಹುಡುಕಾಟ ಮುಂದುವರಿಯುತ್ತದೆ","ta":"தேடல் தொடர்கிறது","ml":"അന്വേഷണം തുടരുന്നു"},"62":{"hi":"राम की विह्वलता","te":"రాముడి ఉన్మాదం","kn":"ರಾಮನ ಉನ್ಮಾದ","ta":"இராமனின் மனக்கலக்கம்","ml":"രാമന്റെ ഉന്മാദം"},"63":{"hi":"राम का विलाप","te":"రాముడి విలాపం","kn":"ರಾಮನ ಶೋಕ","ta":"இராமனின் புலம்பல்","ml":"രാമന്റെ വിലാപം"},"64":{"hi":"संघर्ष के चिह्न; राम का क्रोध","te":"పోరాట ఆనవాళ్లు; రాముడి ఆగ్రహం","kn":"ಹೋರಾಟದ ಗುರುತುಗಳು; ರಾಮನ ಕ್ರೋಧ","ta":"போராட்டத்தின் அடையாளங்கள்; இராமனின் சினம்","ml":"പോരാട്ടത്തിന്റെ അടയാളങ്ങൾ; രാമന്റെ കോപം"},"65":{"hi":"लक्ष्मण राम को शांत करते हैं","te":"లక్ష్మణుడు రాముడిని శాంతపరుస్తాడు","kn":"ಲಕ್ಷ್ಮಣ ರಾಮನನ್ನು ಸಮಾಧಾನಪಡಿಸುತ್ತಾನೆ","ta":"இலக்குவன் இராமனை அமைதிப்படுத்துகிறான்","ml":"ലക്ഷ്മണൻ രാമനെ ശാന്തനാക്കുന്നു"},"66":{"hi":"लक्ष्मण का परामर्श","te":"లక్ష్మణుడి హితవు","kn":"ಲಕ್ಷ್ಮಣನ ಸಲಹೆ","ta":"இலக்குவனின் அறிவுரை","ml":"ലക്ഷ്മണന്റെ ഉപദേശം"},"67":{"hi":"मृत्यु शय्या पर जटायु","te":"మరణశయ్యపై జటాయువు","kn":"ಸಾಯುತ್ತಿರುವ ಜಟಾಯು","ta":"இறக்கும் நிலையில் ஜடாயு","ml":"മരണാസന്നനായ ജടായു"},"68":{"hi":"जटायु की मृत्यु और अंतिम संस्कार","te":"జటాయువు మరణం, అంత్యక్రియలు","kn":"ಜಟಾಯುವಿನ ಮರಣ ಮತ್ತು ಅಂತ್ಯಕ್ರಿಯೆ","ta":"ஜடாயுவின் மரணமும் இறுதிச் சடங்கும்","ml":"ജടായുവിന്റെ മരണവും സംസ്കാരവും"},"69":{"hi":"अयोमुखी और कबंध","te":"అయోముఖి, కబంధుడు","kn":"ಅಯೋಮುಖಿ ಮತ್ತು ಕಬಂಧ","ta":"அயோமுகியும் கபந்தனும்","ml":"അയോമുഖിയും കബന്ധനും"},"70":{"hi":"कबंध की भुजाएँ काटी जाती हैं","te":"కబంధుడి చేతులు ఛేదించబడతాయి","kn":"ಕಬಂಧನ ತೋಳುಗಳ ಛೇದನ","ta":"கபந்தனின் கைகள் வெட்டப்படுகின்றன","ml":"കബന്ധന്റെ കൈകൾ മുറിക്കപ്പെടുന്നു"},"71":{"hi":"कबंध की कथा","te":"కబంధుడి కథ","kn":"ಕಬಂಧನ ಕಥೆ","ta":"கபந்தனின் கதை","ml":"കബന്ധന്റെ കഥ"},"72":{"hi":"कबंध सुग्रीव से मित्रता की सलाह देता है","te":"సుగ్రీవుడితో స్నేహం చేయమని కబంధుడు సూచిస్తాడు","kn":"ಸುಗ್ರೀವನೊಂದಿಗೆ ಸ್ನೇಹಕ್ಕೆ ಕಬಂಧನ ಸಲಹೆ","ta":"சுக்ரீவனுடன் நட்புகொள்ளுமாறு கபந்தன் அறிவுறுத்துகிறான்","ml":"സുഗ്രീവനുമായി സഖ്യം ചെയ്യാൻ കബന്ധൻ ഉപദേശിക്കുന്നു"},"73":{"hi":"पंपा का मार्ग","te":"పంపా సరస్సుకు దారి","kn":"ಪಂಪಾ ಸರೋವರದ ದಾರಿ","ta":"பம்பை வழிப்பாதை","ml":"പമ്പയിലേക്കുള്ള വഴി"},"74":{"hi":"शबरी","te":"శబరి","kn":"ಶಬರಿ","ta":"சபரி","ml":"ശബരി"},"75":{"hi":"पंपा सरोवर पर","te":"పంపా సరస్సు వద్ద","kn":"ಪಂಪಾ ಸರೋವರದಲ್ಲಿ","ta":"பம்பை ஏரிக்கரையில்","ml":"പമ്പാ തടാകത്തിൽ"}}