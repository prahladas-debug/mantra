{"1":{"hi":"नारद वाल्मीकि को राम की कथा सुनाते हैं","te":"నారదుడు వాల్మీకికి రామకథ చెబుతాడు","kn":"ನಾರದರು ವಾಲ್ಮೀಕಿಗೆ ರಾಮನ ಕಥೆಯನ್ನು ಹೇಳುತ್ತಾರೆ","ta":"நாரதர் வால்மீகிக்கு இராமனின் கதையைச் சொல்கிறார்","ml":"നാരദൻ വാൽമീകിക്ക് രാമകഥ പറഞ്ഞുകൊടുക്കുന്നു"},"2":{"hi":"शिकारी को शाप और श्लोक का जन्म","te":"వేటగాడికి శాపం, శ్లోకం జననం","kn":"ಬೇಡನಿಗೆ ಶಾಪ ಮತ್ತು ಶ್ಲೋಕದ ಜನನ","ta":"வேடனுக்கு சாபம்; சுலோகம் பிறந்த கதை","ml":"വേടന് ശാപം; ശ്ലോകത്തിന്റെ ജനനം"},"3":{"hi":"वाल्मीकि ध्यान में पूरी कथा देखते हैं","te":"వాల్మీకి ధ్యానంలో మొత్తం కథను దర్శిస్తాడు","kn":"ವಾಲ್ಮೀಕಿಗೆ ಧ್ಯಾನದಲ್ಲಿ ಇಡೀ ಕಥೆಯ ದರ್ಶನ","ta":"தியானத்தில் முழுக் கதையையும் காணும் வால்மீகி","ml":"ധ്യാനത്തിൽ കഥ മുഴുവൻ വാൽമീകി ദർശിക്കുന്നു"},"4":{"hi":"कुश और लव राम के सामने रामायण गाते हैं","te":"రాముడి ఎదుట కుశలవులు రామాయణం గానం చేస్తారు","kn":"ಕುಶ ಮತ್ತು ಲವರು ರಾಮನ ಮುಂದೆ ರಾಮಾಯಣ ಹಾಡುತ್ತಾರೆ","ta":"இராமன் முன்னிலையில் குசனும் லவனும் இராமாயணம் பாடுகின்றனர்","ml":"രാമന്റെ മുന്നിൽ കുശലവർ രാമായണം ആലപിക്കുന്നു"},"5":{"hi":"अयोध्या नगरी","te":"అయోధ్య నగరం","kn":"ಅಯೋಧ್ಯಾ ನಗರ","ta":"அயோத்தி நகரம்","ml":"അയോധ്യാ നഗരം"},"6":{"hi":"दशरथ का शासन और प्रजा का सुख","te":"దశరథుడి పాలన, ప్రజల సుఖసంతోషాలు","kn":"ದಶರಥನ ಆಳ್ವಿಕೆ ಮತ್ತು ಪ್ರಜೆಗಳ ಸಂತೋಷ","ta":"தசரதனின் ஆட்சியும் மக்களின் மகிழ்ச்சியும்","ml":"ദശരഥന്റെ ഭരണവും ജനങ്ങളുടെ സന്തോഷവും"},"7":{"hi":"दशरथ के मंत्री","te":"దశరథుడి మంత్రులు","kn":"ದಶರಥನ ಮಂತ್ರಿಗಳು","ta":"தசரதனின் அமைச்சர்கள்","ml":"ദശരഥന്റെ മന്ത്രിമാർ"},"8":{"hi":"दशरथ अश्वमेध यज्ञ का संकल्प लेते हैं","te":"అశ్వమేధ యాగం చేయాలని దశరథుడు సంకల్పిస్తాడు","kn":"ಅಶ್ವಮೇಧ ಯಾಗ ಮಾಡಲು ದಶರಥನ ಸಂಕಲ್ಪ","ta":"அசுவமேதயாகம் செய்ய தசரதன் முடிவெடுக்கிறான்","ml":"അശ്വമേധയാഗം നടത്താൻ ദശരഥൻ തീരുമാനിക്കുന്നു"},"9":{"hi":"सुमंत्र ऋषि ऋष्यशृंग की कथा सुनाते हैं","te":"ఋష్యశృంగుడి గురించి సుమంత్రుడు చెబుతాడు","kn":"ಸುಮಂತ್ರರು ಋಷ್ಯಶೃಂಗರ ಕಥೆಯನ್ನು ಹೇಳುತ್ತಾರೆ","ta":"ரிஷ்யசிருங்கரைப் பற்றி சுமந்திரர் கூறுகிறார்","ml":"ഋഷ്യശൃംഗമുനിയെക്കുറിച്ച് സുമന്ത്രൻ പറയുന്നു"},"10":{"hi":"ऋष्यशृंग को अंग देश लाया जाता है और वे शांता से विवाह करते हैं","te":"ఋష్యశృంగుని అంగ దేశ ప్రయాణం, శాంతతో వివాహం","kn":"ಋಷ್ಯಶೃಂಗರನ್ನು ಅಂಗದೇಶಕ್ಕೆ ಕರೆತಂದು ಶಾಂತೆಯನ್ನು ವಿವಾಹವಾಗುತ್ತಾರೆ","ta":"ரிஷ்யசிருங்கர் அங்கதேசம் சென்று சாந்தாவை மணக்கிறார்","ml":"ഋഷ്യശൃംഗൻ അംഗരാജ്യത്തിലെത്തി ശാന്തയെ വിവാഹം ചെയ്യുന്നു"},"11":{"hi":"दशरथ ऋष्यशृंग को अयोध्या लाते हैं","te":"దశరథుడు ఋష్యశృంగుడిని అయోధ్యకు తీసుకువస్తాడు","kn":"ದಶರಥನು ಋಷ್ಯಶೃಂಗರನ್ನು ಅಯೋಧ್ಯೆಗೆ ಕರೆತರುತ್ತಾನೆ","ta":"தசரதன் ரிஷ்யசிருங்கரை அயோத்திக்கு அழைத்து வருகிறான்","ml":"ദശരഥൻ ഋഷ്യശൃംഗനെ അയോധ്യയിലേക്ക് കൊണ്ടുവരുന്നു"},"12":{"hi":"यज्ञ की तैयारी","te":"యాగ సన్నాహాలు","kn":"ಯಾಗದ ಸಿದ್ಧತೆಗಳು","ta":"யாகத்திற்கான ஏற்பாடுகள்","ml":"യാഗത്തിനുള്ള ഒരുക്കങ്ങൾ"},"13":{"hi":"यज्ञ आरंभ और राजाओं को निमंत्रण","te":"యాగం ప్రారంభం; రాజులకు ఆహ్వానం","kn":"ಯಾಗ ಆರಂಭ ಮತ್ತು ರಾಜರಿಗೆ ಆಹ್ವಾನ","ta":"யாகம் தொடங்குகிறது; அரசர்கள் அழைக்கப்படுகின்றனர்","ml":"യാഗം ആരംഭിക്കുന്നു; രാജാക്കന്മാർക്ക് ക്ഷണം"},"14":{"hi":"सरयू तट पर अश्वमेध यज्ञ","te":"సరయూ నది తీరంలో అశ్వమేధ యాగం","kn":"ಸರಯೂ ನದಿ ತೀರದಲ್ಲಿ ಅಶ್ವಮೇಧ ಯಾಗ","ta":"சரயு நதிக்கரையில் அசுவமேத யாகம்","ml":"സരയൂ നദീതീരത്തെ അശ്വമേധയാഗം"},"15":{"hi":"देवता रावण के वध का उपाय खोजते हैं","te":"రావణుడిని వధించే మార్గాన్ని దేవతలు అన్వేషిస్తారు","kn":"ರಾವಣನನ್ನು ಸಂಹರಿಸಲು ದೇವತೆಗಳ ಉಪಾಯ ಹುಡುಕಾಟ","ta":"இராவணனைக் கொல்ல வழி தேடும் தேவர்கள்","ml":"രാവണനെ വധിക്കാൻ ദേവന്മാർ വഴി തേടുന്നു"},"16":{"hi":"दिव्य पायस","te":"దివ్య పాయసం","kn":"ದಿವ್ಯ ಪಾಯಸ","ta":"தெய்வீகப் பாயசம்","ml":"ദിവ്യപായസം"},"17":{"hi":"देवता वानर वीरों को जन्म देते हैं","te":"దేవతల అంశతో వానర వీరుల జననం","kn":"ದೇವತೆಗಳಿಂದ ವಾನರ ವೀರರ ಜನನ","ta":"தேவர்களுக்குப் பிறக்கும் குரங்கு வீரர்கள்","ml":"ദേവന്മാർ വാനരവീരന്മാർക്ക് ജന്മം നൽകുന്നു"},"18":{"hi":"चारों राजकुमारों का जन्म; विश्वामित्र का आगमन","te":"నలుగురు రాకుమారుల జననం; విశ్వామిత్రుడి రాక","kn":"ನಾಲ್ವರು ರಾಜಕುಮಾರರ ಜನನ; ವಿಶ್ವಾಮಿತ್ರರ ಆಗಮನ","ta":"நான்கு இளவரசர்களின் பிறப்பு; விசுவாமித்திரர் வருகை","ml":"നാല് രാജകുമാരന്മാരുടെ ജനനം; വിശ്വാമിത്രൻ എത്തുന്നു"},"19":{"hi":"विश्वामित्र राम को माँगते हैं","te":"విశ్వామిత్రుడు రాముడిని కోరతాడు","kn":"ವಿಶ್ವಾಮಿತ್ರರು ರಾಮನನ್ನು ಕೇಳುತ್ತಾರೆ","ta":"விசுவாமித்திரர் இராமனைக் கேட்கிறார்","ml":"രാമനെ ആവശ്യപ്പെടുന്ന വിശ്വാമിത്രൻ"},"20":{"hi":"दशरथ मना करते हैं","te":"దశరథుడు నిరాకరిస్తాడు","kn":"ದಶರಥನ ನಿರಾಕರಣೆ","ta":"தசரதன் மறுக்கிறான்","ml":"ദശരഥൻ വിസമ്മതിക്കുന്നു"},"21":{"hi":"वसिष्ठ दशरथ को समझाते हैं","te":"వశిష్ఠుడు దశరథుడిని ఒప్పిస్తాడు","kn":"ವಸಿಷ್ಠರು ದಶರಥನನ್ನು ಒಪ್ಪಿಸುತ್ತಾರೆ","ta":"வசிட்டர் தசரதனைச் சம்மதிக்க வைக்கிறார்","ml":"വസിഷ്ഠൻ ദശരഥനെ അനുനയിപ്പിക്കുന്നു"},"22":{"hi":"राम और लक्ष्मण विश्वामित्र के साथ निकलते हैं","te":"విశ్వామిత్రునితో కలిసి రామలక్ష్మణులు బయలుదేరతారు","kn":"ರಾಮ ಲಕ್ಷ್ಮಣರು ವಿಶ್ವಾಮಿತ್ರರೊಂದಿಗೆ ಹೊರಡುತ್ತಾರೆ","ta":"இராமனும் இலக்குவனும் விசுவாமித்திரருடன் புறப்படுகின்றனர்","ml":"വിശ്വാമിത്രനോടൊപ്പം രാമലക്ഷ്മണന്മാർ യാത്ര തിരിക്കുന്നു"},"23":{"hi":"कामाश्रम","te":"కామాశ్రమం","kn":"ಕಾಮಾಶ್ರಮ","ta":"காமனின் ஆசிரமம்","ml":"കാമാശ്രമം"},"24":{"hi":"गंगा पार; ताटका वन","te":"గంగను దాటడం; తాటకా వనం","kn":"ಗಂಗಾ ನದಿ ದಾಟುವಿಕೆ; ತಾಟಕಾ ವನ","ta":"கங்கையைக் கடத்தல்; தாடகை வனம்","ml":"ഗംഗ കടക്കുന്നു; താടകാവനം"},"25":{"hi":"ताटका की कथा","te":"తాటక కథ","kn":"ತಾಟಕೆಯ ಕಥೆ","ta":"தாடகையின் கதை","ml":"താടകയുടെ കഥ"},"26":{"hi":"राम ताटका का वध करते हैं","te":"రాముడు తాటకను సంహరిస్తాడు","kn":"ರಾಮನು ತಾಟಕೆಯನ್ನು ಸಂಹರಿಸುತ್ತಾನೆ","ta":"இராமன் தாடகையைக் கொல்கிறான்","ml":"രാമൻ താടകയെ വധിക്കുന്നു"},"27":{"hi":"विश्वामित्र राम को दिव्य अस्त्र देते हैं","te":"విశ్వామిత్రుడు రాముడికి దివ్యాస్త్రాలు ఇస్తాడు","kn":"ವಿಶ್ವಾಮಿತ್ರರು ರಾಮನಿಗೆ ದಿವ್ಯಾಸ್ತ್ರಗಳನ್ನು ನೀಡುತ್ತಾರೆ","ta":"விசுவாமித்திரர் இராமனுக்கு தெய்வீக ஆயுதங்களை அளிக்கிறார்","ml":"വിശ്വാമിത്രൻ രാമന് ദിവ്യാസ്ത്രങ്ങൾ നൽകുന്നു"},"28":{"hi":"उपसंहार अस्त्र","te":"ఉపసంహార అస్త్రాలు","kn":"ಉಪಸಂಹಾರ ಅಸ್ತ್ರಗಳು","ta":"திரும்பப் பெறும் ஆயுதங்கள்","ml":"ഉപസംഹാര അസ്ത്രങ്ങൾ"},"29":{"hi":"सिद्धाश्रम, वामन का आश्रम","te":"సిద్ధాశ్రమం, వామనుడి ఆశ్రమం","kn":"ವಾಮನನ ಆಶ್ರಮವಾದ ಸಿದ್ಧಾಶ್ರಮ","ta":"வாமனரின் ஆசிரமமான சித்தாசிரமம்","ml":"വാമനന്റെ ആശ്രമമായ സിദ്ധാശ്രമം"},"30":{"hi":"राम यज्ञ की रक्षा करते हैं","te":"యాగాన్ని రక్షిస్తాడు రాముడు","kn":"ರಾಮನು ಯಾಗವನ್ನು ರಕ್ಷಿಸುತ್ತಾನೆ","ta":"இராமன் யாகத்தைக் காக்கிறான்","ml":"രാമൻ യാഗത്തെ സംരക്ഷിക്കുന്നു"},"31":{"hi":"मिथिला की यात्रा","te":"మిథిలకు ప్రయాణం","kn":"ಮಿಥಿಲೆಗೆ ಪ್ರಯಾಣ","ta":"மிதிலைக்குப் பயணம்","ml":"മിഥിലയിലേക്കുള്ള യാത്ര"},"32":{"hi":"कुशनाभ की सौ पुत्रियाँ","te":"కుశనాభుడి నూరుగురు కుమార్తెలు","kn":"ಕುಶನಾಭನ ನೂರು ಪುತ್ರಿಯರು","ta":"குசநாபரின் நூறு மகள்கள்","ml":"കുശനാഭന്റെ നൂറ് പുത്രിമാർ"},"33":{"hi":"पुत्रियाँ ब्रह्मदत्त से विवाह करती हैं","te":"కుమార్తెలు బ్రహ్మదత్తుడిని వివాహమాడతారు","kn":"ಪುತ್ರಿಯರು ಬ್ರಹ್ಮದತ್ತನನ್ನು ವಿವಾಹವಾಗುತ್ತಾರೆ","ta":"மகள்கள் பிரம்மதத்தனை மணக்கின்றனர்","ml":"പുത്രിമാർ ബ്രഹ്മദത്തനെ വിവാഹം ചെയ്യുന്നു"},"34":{"hi":"गाधि और कौशिकी नदी","te":"గాధి, కౌశికీ నది","kn":"ಗಾಧಿ ಮತ್ತು ಕೌಶಿಕಿ ನದಿ","ta":"காதி மற்றும் கௌசிகி நதி","ml":"ഗാധിയും കൗശികീനദിയും"},"35":{"hi":"गंगा की कथा आरंभ","te":"గంగా కథ ప్రారంభం","kn":"ಗಂಗೆಯ ಕಥೆಯ ಆರಂಭ","ta":"கங்கையின் கதை தொடங்குகிறது","ml":"ഗംഗയുടെ കഥ ആരംഭിക്കുന്നു"},"36":{"hi":"उमा का देवताओं को शाप","te":"దేవతలపై ఉమాదేవి శాపం","kn":"ಉಮಾದೇವಿಯ ದೇವತೆಗಳ ಶಾಪ","ta":"உமையின் தேவர்களுக்கான சாபம்","ml":"ദേവന്മാർക്ക് ഉമയുടെ ശാപം"},"37":{"hi":"कुमार का जन्म","te":"కుమారస్వామి జననం","kn":"ಕುಮಾರನ ಜನನ","ta":"குமாரனின் பிறப்பு","ml":"കുമാരന്റെ ജനനം"},"38":{"hi":"राजा सगर और उनके पुत्र","te":"సగర మహారాజు, ఆయన కుమారులు","kn":"ರಾಜ ಸಗರ ಮತ್ತು ಅವನ ಪುತ್ರರು","ta":"சகர மன்னனும் அவன் மகன்களும்","ml":"സഗരരാജാവും പുത്രന്മാരും"},"39":{"hi":"इंद्र सगर का घोड़ा चुराते हैं","te":"సగరుడి అశ్వాన్ని ఇంద్రుడు అపహరిస్తాడు","kn":"ಇಂದ್ರನು ಸಗರನ ಅಶ್ವವನ್ನು ಕದಿಯುತ್ತಾನೆ","ta":"இந்திரன் சகரனின் குதிரையைத் திருடுகிறான்","ml":"ഇന്ദ്രൻ സഗരന്റെ കുതിരയെ മോഷ്ടിക്കുന്നു"},"40":{"hi":"कपिल द्वारा सगर के पुत्र भस्म होते हैं","te":"కపిలుడి ఆగ్రహంతో సగరపుత్రులు భస్మమవుతారు","kn":"ಕಪಿಲರ ಕೋಪದಿಂದ ಸಗರನ ಪುತ್ರರು ಭಸ್ಮ","ta":"கபிலரால் சகரனின் மகன்கள் எரிக்கப்படுகின்றனர்","ml":"സഗരപുത്രന്മാരെ കപിലൻ ചുട്ടെരിക്കുന്നു"},"41":{"hi":"अंशुमान घोड़ा वापस लाते हैं","te":"అంశుమంతుడు అశ్వాన్ని తిరిగి తెస్తాడు","kn":"ಅಂಶುಮಂತನು ಅಶ್ವವನ್ನು ಮರಳಿ ಪಡೆಯುತ್ತಾನೆ","ta":"அம்சுமான் குதிரையை மீட்கிறார்","ml":"അംശുമാൻ കുതിരയെ വീണ്ടെടുക്കുന്നു"},"42":{"hi":"भगीरथ की तपस्या","te":"భగీరథుడి తపస్సు","kn":"ಭಗೀರಥನ ತಪಸ್ಸು","ta":"பகீரதனின் தவம்","ml":"ഭഗീരഥന്റെ തപസ്സ്"},"43":{"hi":"गंगा का अवतरण","te":"గంగావతరణం","kn":"ಗಂಗೆಯ ಅವತರಣ","ta":"கங்கையின் வருகை","ml":"ഗംഗാവതരണം"},"44":{"hi":"भगीरथ संस्कार पूर्ण करते हैं","te":"భగీరథుడు ఉత్తర క్రియలు పూర్తి చేస్తాడు","kn":"ಭಗೀರಥನು ಉತ್ತರಕ್ರಿಯೆಗಳನ್ನು ಪೂರೈಸುತ್ತಾನೆ","ta":"பகீரதன் சடங்குகளை நிறைவேற்றுகிறான்","ml":"ഭഗീരഥൻ ക്രിയകൾ പൂർത്തിയാക്കുന്നു"},"45":{"hi":"समुद्र मंथन","te":"సముద్ర మథనం","kn":"ಸಮುದ್ರ ಮಂಥನ","ta":"பாற்கடல் கடைதல்","ml":"സമുദ്രമഥനം"},"46":{"hi":"दिति का व्रत और इंद्र का कृत्य","te":"దితి వ్రతం, ఇంద్రుడి చర్య","kn":"ದಿತಿಯ ವ್ರತ ಮತ್ತು ಇಂದ್ರನ ಕೃತ್ಯ","ta":"திதியின் நோன்பும் இந்திரனின் செயலும்","ml":"ദിതിയുടെ വ്രതവും ഇന്ദ്രന്റെ പ്രവൃത്തിയും"},"47":{"hi":"मरुद्गण और राजा सुमति","te":"మరుద్గణాలు, రాజు సుమతి","kn":"ಮರುದ್ಗಣಗಳು ಮತ್ತು ರಾಜ ಸುಮತಿ","ta":"மருத்துகளும் மன்னன் சுமதியும்","ml":"മരുത്തുക്കളും സുമതി രാജാവും"},"48":{"hi":"अहल्या और गौतम का शाप","te":"అహల్య, గౌతముడి శాపం","kn":"ಅಹಲ್ಯೆ ಮತ್ತು ಗೌತಮರ ಶಾಪ","ta":"அகல்யையும் கௌதமரின் சாபமும்","ml":"അഹല്യയും ഗൗതമന്റെ ശാപവും"},"49":{"hi":"राम अहल्या का उद्धार करते हैं","te":"రాముడు అహల్యకు విముక్తి ప్రసాదిస్తాడు","kn":"ರಾಮನು ಅಹಲ್ಯೆಗೆ ಶಾಪ ವಿಮೋಚನೆ ನೀಡುತ್ತಾನೆ","ta":"இராமன் அகல்யைக்கு விமோசனம் அளிக்கிறான்","ml":"രാമൻ അഹല്യയെ മോചിപ്പിക്കുന്നു"},"50":{"hi":"जनक के यज्ञ में आगमन","te":"జనక యజ్ఞ స్థలానికి చేరుకోవడం","kn":"ಜನಕನ ಯಜ್ಞಕ್ಕೆ ಆಗಮನ","ta":"ஜனகரின் யாகத்திற்கு வருகை","ml":"ജനകന്റെ യാഗശാലയിൽ എത്തുന്നു"},"51":{"hi":"शतानंद विश्वामित्र की कथा आरंभ करते हैं","te":"విశ్వామిత్రుడి కథను శతానందుడు ప్రారంభిస్తాడు","kn":"ಶತಾನಂದರು ವಿಶ್ವಾಮಿತ್ರರ ಕಥೆಯನ್ನು ಆರಂಭಿಸುತ್ತಾರೆ","ta":"சதானந்தர் விசுவாமித்திரரின் கதையைத் தொடங்குகிறார்","ml":"വിശ്വാമിത്രന്റെ കഥ ശതാനന്ദൻ പറഞ്ഞുതുടങ്ങുന്നു"},"52":{"hi":"वसिष्ठ का आतिथ्य","te":"వశిష్ఠుడి ఆతిథ్యం","kn":"ವಸಿಷ್ಠರ ಆತಿಥ್ಯ","ta":"வசிட்டரின் விருந்தோம்பல்","ml":"വസിഷ്ഠന്റെ ആതിഥ്യം"},"53":{"hi":"विश्वामित्र गाय माँगते हैं","te":"విశ్వామిత్రుడు ఆవును కోరతాడు","kn":"ವಿಶ್ವಾಮಿತ್ರರು ಹಸುವನ್ನು ಕೇಳುತ್ತಾರೆ","ta":"விசுவாமித்திரர் பசுவைக் கேட்கிறார்","ml":"വിശ്വാമിത്രൻ പശുവിനെ ആവശ്യപ്പെടുന്നു"},"54":{"hi":"शबला के योद्धा","te":"శబల సైనికులు","kn":"ಶಬಲೆಯ ಯೋಧರು","ta":"சபலையின் வீரர்கள்","ml":"ശബലയുടെ യോദ്ധാക്കൾ"},"55":{"hi":"विश्वामित्र शिव से अस्त्र प्राप्त करते हैं","te":"విశ్వామిత్రుడు శివుడి నుంచి అస్త్రాలు పొందుతాడు","kn":"ವಿಶ್ವಾಮಿತ್ರರು ಶಿವನಿಂದ ಅಸ್ತ್ರಗಳನ್ನು ಪಡೆಯುತ್ತಾರೆ","ta":"சிவனிடமிருந்து விசுவாமித்திரர் ஆயுதங்கள் பெறுகிறார்","ml":"ശിവനിൽനിന്ന് വിശ്വാമിത്രൻ അസ്ത്രങ്ങൾ നേടുന്നു"},"56":{"hi":"ब्रह्मदंड की शक्ति","te":"బ్రాహ్మణ దండం శక్తి","kn":"ಬ್ರಾಹ್ಮಣ ದಂಡದ ಶಕ್ತಿ","ta":"பிராமணரின் தண்டத்தின் சக்தி","ml":"ബ്രാഹ്മണ ദണ്ഡിന്റെ ശക്തി"},"57":{"hi":"त्रिशंकु की इच्छा","te":"త్రిశంకుడి కోరిక","kn":"ತ್ರಿಶಂಕುವಿನ ಆಸೆ","ta":"திரிசங்குவின் விருப்பம்","ml":"ത്രിശങ്കുവിന്റെ ആഗ്രഹം"},"58":{"hi":"त्रिशंकु शापित होकर विश्वामित्र की शरण में जाते हैं","te":"త్రిశంకుడికి శాపం; విశ్వామిత్రుడిని ఆశ్రయిస్తాడు","kn":"ತ್ರಿಶಂಕುವಿಗೆ ಶಾಪ; ವಿಶ್ವಾಮಿತ್ರರ ಮೊರೆ","ta":"திரிசங்குவுக்குச் சாபம்; விசுவாமித்திரரிடம் அடைக்கலம்","ml":"ത്രിശങ്കുവിന് ശാപം; അദ്ദേഹം വിശ്വാമിത്രനെ ശരണം പ്രാപിക്കുന്നു"},"59":{"hi":"विश्वामित्र ऋषियों को यज्ञ में बुलाते हैं","te":"యాగానికి ఋషులను విశ్వామిత్రుడు ఆహ్వానిస్తాడు","kn":"ವಿಶ್ವಾಮಿತ್ರರು ಋಷಿಗಳನ್ನು ಯಾಗಕ್ಕೆ ಆಹ್ವಾನಿಸುತ್ತಾರೆ","ta":"யாகத்திற்கு முனிவர்களை விசுவாமித்திரர் அழைக்கிறார்","ml":"വിശ്വാമിത്രൻ മുനിമാരെ യാഗത്തിന് വിളിക്കുന്നു"},"60":{"hi":"त्रिशंकु का स्वर्ग","te":"త్రిశంకు స్వర్గం","kn":"ತ್ರಿಶಂಕುವಿನ ಸ್ವರ್ಗ","ta":"திரிசங்குவின் சொர்க்கம்","ml":"ത്രിശങ്കുവിന്റെ സ്വർഗം"},"61":{"hi":"यज्ञ के लिए शुनःशेप बेचा जाता है","te":"యాగం కోసం శునఃశేపుడు అమ్మివేయబడతాడు","kn":"ಯಾಗಕ್ಕಾಗಿ ಶುನಃಶೇಪನ ಮಾರಾಟ","ta":"யாகத்திற்காக சுனஷேபன் விற்கப்படுகிறான்","ml":"യാഗത്തിനായി ശുനഃശേഫനെ വിൽക്കുന്നു"},"62":{"hi":"विश्वामित्र शुनःशेप को बचाते हैं","te":"విశ్వామిత్రుడు శునఃశేపుడిని రక్షిస్తాడు","kn":"ವಿಶ್ವಾಮಿತ್ರರು ಶುನಃಶೇಪನನ್ನು ರಕ್ಷಿಸುತ್ತಾರೆ","ta":"விசுவாமித்திரர் சுனஷேபனைக் காக்கிறார்","ml":"വിശ്വാമിത്രൻ ശുനഃശേഫനെ രക്ഷിക്കുന്നു"},"63":{"hi":"विश्वामित्र महर्षि बनते हैं; मेनका","te":"విశ్వామిత్రుడు మహర్షి అవుతాడు; మేనక","kn":"ವಿಶ್ವಾಮಿತ್ರರು ಮಹರ್ಷಿಯಾಗುತ್ತಾರೆ; ಮೇನಕೆ","ta":"விசுவாமித்திரர் மகரிஷி ஆகிறார்; மேனகை","ml":"വിശ്വാമിത്രൻ മഹർഷിയാകുന്നു; മേനക"},"64":{"hi":"विश्वामित्र रंभा को शाप देते हैं","te":"రంభకు విశ్వామిత్రుడు శాపమిస్తాడు","kn":"ವಿಶ್ವಾಮಿತ್ರರು ರಂಭೆಗೆ ಶಾಪ ನೀಡುತ್ತಾರೆ","ta":"விசுவாமித்திரர் ரம்பைக்குச் சாபம் அளிக்கிறார்","ml":"വിശ്വാമിത്രൻ രംഭയ്ക്ക് ശാപം നൽകുന്നു"},"65":{"hi":"विश्वामित्र ब्रह्मर्षि बनते हैं","te":"విశ్వామిత్రుడు బ్రహ్మర్షి అవుతాడు","kn":"ವಿಶ್ವಾಮಿತ್ರರು ಬ್ರಹ್ಮರ್ಷಿಯಾಗುತ್ತಾರೆ","ta":"விசுவாமித்திரர் பிரம்மரிஷி ஆகிறார்","ml":"വിശ്വാമിത്രൻ ബ്രഹ്മർഷിയാകുന്നു"},"66":{"hi":"जनक शिव के धनुष की कथा सुनाते हैं","te":"శివ ధనుస్సు గురించి జనకుడు చెబుతాడు","kn":"ಶಿವಧನುಸ್ಸಿನ ಕುರಿತು ಜನಕನ ಮಾತು","ta":"சிவதனுசு பற்றி ஜனகர் கூறுகிறார்","ml":"ശിവധനുസ്സിനെക്കുറിച്ച് ജനകൻ പറയുന്നു"},"67":{"hi":"राम धनुष तोड़ते हैं","te":"రాముడు ధనుస్సును విరుస్తాడు","kn":"ರಾಮನು ಧನುಸ್ಸನ್ನು ಮುರಿಯುತ್ತಾನೆ","ta":"இராமன் வில்லை முறிக்கிறான்","ml":"രാമൻ ധനുസ്സ് ഒടിക്കുന്നു"},"68":{"hi":"अयोध्या में संदेश पहुँचता है","te":"అయోధ్యకు వార్త చేరుతుంది","kn":"ಅಯೋಧ್ಯೆಗೆ ಸುದ್ದಿ ತಲುಪುತ್ತದೆ","ta":"அயோத்திக்குச் செய்தி எட்டுகிறது","ml":"അയോധ്യയിൽ സന്ദേശം എത്തുന്നു"},"69":{"hi":"दशरथ मिथिला पहुँचते हैं","te":"మిథిలకు దశరథుడు చేరుకుంటాడు","kn":"ದಶರಥನು ಮಿಥಿಲೆಗೆ ಆಗಮಿಸುತ್ತಾನೆ","ta":"தசரதன் மிதிலைக்கு வருகிறான்","ml":"ദശരഥൻ മിഥിലയിലെത്തുന്നു"},"70":{"hi":"वसिष्ठ इक्ष्वाकु वंश का वर्णन करते हैं","te":"వశిష్ఠుడు ఇక్ష్వాకు వంశావళిని వివరిస్తాడు","kn":"ವಸಿಷ್ಠರು ಇಕ್ಷ್ವಾಕು ವಂಶಾವಳಿಯನ್ನು ಹೇಳುತ್ತಾರೆ","ta":"வசிட்டர் இட்சுவாகு வம்சத்தை எடுத்துரைக்கிறார்","ml":"വസിഷ്ഠൻ ഇക്ഷ്വാകുവംശം വിവരിക്കുന്നു"},"71":{"hi":"जनक का वंश","te":"జనకుడి వంశావళి","kn":"ಜನಕನ ವಂಶಾವಳಿ","ta":"ஜனகரின் வம்சம்","ml":"ജനകവംശം"},"72":{"hi":"चार भाइयों के लिए चार वधुएँ","te":"నలుగురు సోదరులకు నలుగురు వధువులు","kn":"ನಾಲ್ವರು ಸಹೋದರರಿಗೆ ನಾಲ್ವರು ವಧುಗಳು","ta":"நான்கு சகோதரர்களுக்கு நான்கு மணப்பெண்கள்","ml":"നാല് സഹോദരന്മാർക്ക് നാല് വധുക്കൾ"},"73":{"hi":"विवाह","te":"వివాహం","kn":"ವಿವಾಹ","ta":"திருமணம்","ml":"വിവാഹം"},"74":{"hi":"परशुराम प्रकट होते हैं","te":"పరశురాముడు ప్రత్యక్షమవుతాడు","kn":"ಪರಶುರಾಮರ ಆಗಮನ","ta":"பரசுராமர் தோன்றுகிறார்","ml":"പരശുരാമൻ പ്രത്യക്ഷപ്പെടുന്നു"},"75":{"hi":"परशुराम की चुनौती","te":"పరశురాముడి సవాలు","kn":"ಪರಶುರಾಮರ ಸವಾಲು","ta":"பரசுராமரின் சவால்","ml":"പരശുരാമന്റെ വെല്ലുവിളി"},"76":{"hi":"परशुराम का गर्व टूटता है","te":"పరశురాముడి గర్వభంగం","kn":"ಪರಶುರಾಮರ ಗರ್ವಭಂಗ","ta":"பரசுராமர் அடங்குகிறார்","ml":"പരശുരാമന്റെ അഹങ്കാരഭംഗം"},"77":{"hi":"अयोध्या वापसी","te":"అయోధ్యకు తిరుగు ప్రయాణం","kn":"ಅಯೋಧ್ಯೆಗೆ ಮರಳುವಿಕೆ","ta":"அயோத்திக்குத் திரும்புதல்","ml":"അയോധ്യയിലേക്കുള്ള മടക്കം"}}