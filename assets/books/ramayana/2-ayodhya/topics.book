{"1":{"hi":"दशरथ राम को युवराज बनाने का निश्चय करते हैं","te":"రాముడిని యువరాజుగా చేయాలని దశరథుడు సంకల్పిస్తాడు","kn":"ರಾಮನನ್ನು ಯುವರಾಜನನ್ನಾಗಿಸಲು ದಶರಥನ ಸಂಕಲ್ಪ","ta":"இராமனை அரசனாக்க தசரதன் முடிவு செய்கிறான்","ml":"രാമനെ യുവരാജാവാക്കാൻ ദശരഥൻ തീരുമാനിക്കുന്നു"},"2":{"hi":"सभा की स्वीकृति","te":"సభ ఆమోదం తెలుపుతుంది","kn":"ಸಭೆಯ ಅನುಮೋದನೆ","ta":"அவையின் ஒப்புதல்","ml":"സഭ അംഗീകരിക്കുന്നു"},"3":{"hi":"राज्याभिषेक की तैयारी","te":"పట్టాభిషేక సన్నాహాలు","kn":"ಪಟ್ಟಾಭಿಷೇಕದ ಸಿದ್ಧತೆಗಳು","ta":"முடிசூட்டு விழாவுக்கான ஏற்பாடுகள்","ml":"പട്ടാഭിഷേകത്തിനുള്ള ഒരുക്കങ്ങൾ"},"4":{"hi":"राम कौसल्या को बताते हैं","te":"కౌసల్యకు రాముడు తెలియజేస్తాడు","kn":"ರಾಮನು ಕೌಸಲ್ಯೆಗೆ ತಿಳಿಸುತ್ತಾನೆ","ta":"இராமன் கௌசல்யையிடம் கூறுகிறான்","ml":"രാമൻ കൗസല്യയോട് പറയുന്നു"},"5":{"hi":"वसिष्ठ उपवास का विधान बताते हैं","te":"వశిష్ఠుడు ఉపవాస వ్రతాన్ని నియమిస్తాడు","kn":"ವಸಿಷ್ಠರು ಉಪವಾಸವನ್ನು ವಿಧಿಸುತ್ತಾರೆ","ta":"வசிட்டர் விரதத்தை விதிக்கிறார்","ml":"വസിഷ്ഠൻ വ്രതം നിർദേശിക്കുന്നു"},"6":{"hi":"अयोध्या में आनंद","te":"అయోధ్య ఆనందోత్సాహాలతో నిండుతుంది","kn":"ಅಯೋಧ್ಯೆಯಲ್ಲಿ ಸಂಭ್ರಮ","ta":"அயோத்தி மகிழ்ச்சியில் திளைக்கிறது","ml":"അയോധ്യ ആഹ്ലാദത്തിലാകുന്നു"},"7":{"hi":"मंथरा कैकेयी को यह समाचार देती है","te":"మంథర కైకేయికి వార్త చేరవేస్తుంది","kn":"ಮಂಥರೆ ಕೈಕೇಯಿಗೆ ಸುದ್ದಿ ಮುಟ್ಟಿಸುತ್ತಾಳೆ","ta":"மந்தரை கைகேயிக்குச் செய்தி கொண்டு செல்கிறாள்","ml":"മന്ഥര കൈകേയിയെ വിവരമറിയിക്കുന്നു"},"8":{"hi":"मंथरा कैकेयी का मन विषैला करती है","te":"మంథర కైకేయి మనసును విషపూరితం చేస్తుంది","kn":"ಮಂಥರೆ ಕೈಕೇಯಿಯ ಮನಸ್ಸಿಗೆ ವಿಷ ತುಂಬುತ್ತಾಳೆ","ta":"மந்தரை கைகேயியின் மனதில் நஞ்சைக் கலக்கிறாள்","ml":"മന്ഥര കൈകേയിയുടെ മനസ്സ് വിഷലിപ്തമാക്കുന്നു"},"9":{"hi":"दो वरदान; कैकेयी कोपभवन में जाती है","te":"రెండు వరాలు; కోపగృహంలోకి కైకేయి ప్రవేశం","kn":"ಎರಡು ವರಗಳು; ಕೈಕೇಯಿ ಕೋಪಗೃಹ ಪ್ರವೇಶ","ta":"இரு வரங்கள்; கோபகிருகத்தில் கைகேயி","ml":"രണ്ട് വരങ്ങൾ; കൈകേയി കോപഗൃഹത്തിൽ പ്രവേശിക്കുന്നു"},"10":{"hi":"दशरथ कोपभवन में कैकेयी को पाते हैं","te":"కోపగృహంలో కైకేయిని దశరథుడు చూస్తాడు","kn":"ದಶರಥನಿಗೆ ಕೋಪಗೃಹದಲ್ಲಿ ಕೈಕೇಯಿಯ ದರ್ಶನ","ta":"கோபகிருகத்தில் கைகேயியைக் காணும் தசரதன்","ml":"കോപഗൃഹത്തിൽ കൈകേയിയെ ദശരഥൻ കാണുന്നു"},"11":{"hi":"कैकेयी अपने वरदान माँगती है","te":"కైకేయి తన వరాలను కోరుతుంది","kn":"ಕೈಕೇಯಿ ತನ್ನ ವರಗಳನ್ನು ಕೇಳುತ್ತಾಳೆ","ta":"கைகேயி தன் வரங்களைக் கேட்கிறாள்","ml":"കൈകേയി വരങ്ങൾ ആവശ്യപ്പെടുന്നു"},"12":{"hi":"दशरथ का विलाप","te":"దశరథుడి విలాపం","kn":"ದಶರಥನ ಶೋಕ","ta":"தசரதனின் புலம்பல்","ml":"ദശരഥന്റെ വിലാപം"},"13":{"hi":"राजा की शोक भरी रात","te":"రాజు దుఃఖభరిత రాత్రి","kn":"ರಾಜನ ದುಃಖದ ರಾತ್ರಿ","ta":"மன்னனின் துயர இரவு","ml":"രാജാവിന്റെ ദുഃഖരാത്രി"},"14":{"hi":"कैकेयी राम को बुलवाती है","te":"రాముడిని పిలిపిస్తుంది కైకేయి","kn":"ಕೈಕೇಯಿ ರಾಮನನ್ನು ಕರೆಸುತ್ತಾಳೆ","ta":"கைகேயி இராமனை அழைக்கிறாள்","ml":"കൈകേയി രാമനെ വിളിപ്പിക്കുന്നു"},"15":{"hi":"राज्याभिषेक की तैयारी; सुमंत्र राम के पास जाते हैं","te":"పట్టాభిషేక సన్నాహాలు; రాముడి వద్దకు సుమంత్రుడు వెళ్తాడు","kn":"ಪಟ್ಟಾಭಿಷೇಕದ ಸಿದ್ಧತೆ; ಸುಮಂತ್ರರು ರಾಮನ ಬಳಿಗೆ ಹೋಗುತ್ತಾರೆ","ta":"முடிசூட்டு ஏற்பாடுகள்; இராமனிடம் சுமந்திரர் செல்கிறார்","ml":"പട്ടാഭിഷേകത്തിന്റെ ഒരുക്കങ്ങൾ; സുമന്ത്രൻ രാമന്റെ അടുത്തേക്ക് പോകുന്നു"},"16":{"hi":"राम पिता के पास जाते हैं","te":"తండ్రి వద్దకు రాముడు వెళ్తాడు","kn":"ರಾಮ ತಂದೆಯ ಬಳಿಗೆ ಹೋಗುತ್ತಾನೆ","ta":"இராமன் தந்தையிடம் செல்கிறான்","ml":"രാമൻ പിതാവിന്റെ അടുത്തേക്ക് പോകുന്നു"},"17":{"hi":"राम महल में प्रवेश करते हैं","te":"రాముడు రాజభవనంలో ప్రవేశిస్తాడు","kn":"ರಾಮ ಅರಮನೆಯನ್ನು ಪ್ರವೇಶಿಸುತ್ತಾನೆ","ta":"இராமன் அரண்மனைக்குள் நுழைகிறான்","ml":"രാമൻ കൊട്ടാരത്തിൽ പ്രവേശിക്കുന്നു"},"18":{"hi":"कैकेयी राम को वरदान की बात बताती है","te":"వరాల గురించి కైకేయి రాముడికి చెబుతుంది","kn":"ಕೈಕೇಯಿ ರಾಮನಿಗೆ ವರಗಳ ವಿಷಯ ತಿಳಿಸುತ್ತಾಳೆ","ta":"கைகேயி இராமனிடம் வரங்களைக் கூறுகிறாள்","ml":"വരങ്ങളെക്കുറിച്ച് കൈകേയി രാമനോട് പറയുന്നു"},"19":{"hi":"राम वनवास स्वीकार करते हैं","te":"వనవాసాన్ని రాముడు అంగీకరిస్తాడు","kn":"ರಾಮ ವನವಾಸವನ್ನು ಸ್ವೀಕರಿಸುತ್ತಾನೆ","ta":"இராமன் வனவாசத்தை ஏற்கிறான்","ml":"വനവാസം രാമൻ സ്വീകരിക്കുന്നു"},"20":{"hi":"कौसल्या का शोक","te":"కౌసల్య దుఃఖం","kn":"ಕೌಸಲ್ಯೆಯ ದುಃಖ","ta":"கௌசல்யையின் துயரம்","ml":"കൗസല്യയുടെ ദുഃഖം"},"21":{"hi":"लक्ष्मण का क्रोध","te":"లక్ష్మణుడి ఆగ్రహం","kn":"ಲಕ್ಷ್ಮಣನ ಕೋಪ","ta":"இலக்குவனின் கோபம்","ml":"ലക്ഷ്മണന്റെ കോപം"},"22":{"hi":"राम भाग्य की शक्ति पर कहते हैं","te":"విధి శక్తిపై రాముడి మాటలు","kn":"ವಿಧಿಯ ಶಕ್ತಿಯ ಕುರಿತು ರಾಮನ ಮಾತು","ta":"விதியின் வலிமை பற்றி இராமன்","ml":"വിധിയുടെ ശക്തിയെക്കുറിച്ച് രാമൻ"},"23":{"hi":"लक्ष्मण भाग्य को चुनौती देते हैं","te":"విధిని ఎదిరిస్తాడు లక్ష్మణుడు","kn":"ಲಕ್ಷ್ಮಣನು ವಿಧಿಯನ್ನು ಧಿಕ್ಕರಿಸುತ್ತಾನೆ","ta":"இலக்குவன் விதியை எதிர்க்கிறான்","ml":"വിധിയെ ലക്ഷ്മണൻ വെല്ലുവിളിക്കുന്നു"},"24":{"hi":"कौसल्या राम को जाने देती हैं","te":"రాముడిని వెళ్లనిస్తుంది కౌసల్య","kn":"ಕೌಸಲ್ಯೆ ರಾಮನನ್ನು ಕಳುಹಿಸುತ್ತಾಳೆ","ta":"கௌசல்யை இராமனை அனுப்புகிறாள்","ml":"കൗസല്യ രാമനെ യാത്രയാക്കുന്നു"},"25":{"hi":"कौसल्या का आशीर्वाद","te":"కౌసల్య ఆశీర్వాదం","kn":"ಕೌಸಲ್ಯೆಯ ಆಶೀರ್ವಾದ","ta":"கௌசல்யையின் ஆசி","ml":"കൗസല്യയുടെ അനുഗ്രഹം"},"26":{"hi":"राम सीता को बताते हैं","te":"సీతకు రాముడు తెలియజేస్తాడు","kn":"ರಾಮ ಸೀತೆಗೆ ತಿಳಿಸುತ್ತಾನೆ","ta":"இராமன் சீதையிடம் கூறுகிறான்","ml":"രാമൻ സീതയോട് പറയുന്നു"},"27":{"hi":"सीता साथ जाने का हठ करती हैं","te":"తానూ వస్తానని సీత పట్టుపడుతుంది","kn":"ಸೀತೆ ತಾನೂ ಬರುವೆನೆಂದು ಹಠ ಹಿಡಿಯುತ್ತಾಳೆ","ta":"தானும் வருவேன் என்று சீதை வற்புறுத்துகிறாள்","ml":"സീത കൂടെ പോകണമെന്ന് വാശിപിടിക്കുന്നു"},"28":{"hi":"राम वन के कष्टों का वर्णन करते हैं","te":"అడవిలోని కష్టాలను రాముడు వివరిస్తాడు","kn":"ಕಾಡಿನ ಕಷ್ಟಗಳನ್ನು ರಾಮ ವಿವರಿಸುತ್ತಾನೆ","ta":"காட்டின் இன்னல்களை இராமன் விவரிக்கிறான்","ml":"വനത്തിലെ ക്ലേശങ്ങളെക്കുറിച്ച് രാമൻ വിവരിക്കുന്നു"},"29":{"hi":"सीता का संकल्प","te":"సీత సంకల్పం","kn":"ಸೀತೆಯ ದೃಢ ನಿರ್ಧಾರ","ta":"சீதையின் உறுதி","ml":"സീതയുടെ ദൃഢനിശ്ചയം"},"30":{"hi":"राम सीता को साथ ले जाने को मान जाते हैं","te":"సీతను వెంట తీసుకువెళ్లేందుకు రాముడు అంగీకరిస్తాడు","kn":"ಸೀತೆಯನ್ನು ಕರೆದೊಯ್ಯಲು ರಾಮನ ಒಪ್ಪಿಗೆ","ta":"சீதையை அழைத்துச் செல்ல இராமன் ஒப்புகிறான்","ml":"സീതയെ കൂടെ കൊണ്ടുപോകാൻ രാമൻ സമ്മതിക്കുന്നു"},"31":{"hi":"लक्ष्मण भी साथ चलेंगे","te":"లక్ష్మణుడూ వస్తాడు","kn":"ಲಕ್ಷ್ಮಣನೂ ಬರುತ್ತಾನೆ","ta":"இலக்குவனும் வருகிறான்","ml":"ലക്ഷ്മണനും കൂടെ പോകുന്നു"},"32":{"hi":"राम अपना धन दान करते हैं","te":"రాముడు తన ధనాన్ని దానం చేస్తాడు","kn":"ರಾಮ ತನ್ನ ಸಂಪತ್ತನ್ನು ದಾನ ಮಾಡುತ್ತಾನೆ","ta":"இராமன் தன் செல்வத்தை தானம் செய்கிறான்","ml":"രാമൻ സമ്പത്ത് ദാനം ചെയ്യുന്നു"},"33":{"hi":"तीनों के महल की ओर बढ़ने पर प्रजा का शोक","te":"ముగ్గురూ రాజభవనానికి నడుస్తుండగా ప్రజల దుఃఖం","kn":"ಮೂವರು ಅರಮನೆಗೆ ನಡೆದು ಹೋಗುವಾಗ ಜನರ ದುಃಖ","ta":"மூவரும் அரண்மனை நோக்கி நடக்க மக்களின் துயரம்","ml":"മൂവരും കൊട്ടാരത്തിലേക്ക് നടക്കുമ്പോൾ ജനങ്ങളുടെ വിലാപം"},"34":{"hi":"दशरथ से विदा","te":"దశరథుడికి వీడ్కోలు","kn":"ದಶರಥನಿಗೆ ಬೀಳ್ಕೊಡುಗೆ","ta":"தசரதனுக்கு விடைகொடுத்தல்","ml":"ദശരഥനോടുള്ള യാത്രാമൊഴി"},"35":{"hi":"सुमंत्र कैकेयी को फटकारते हैं","te":"కైకేయిని సుమంత్రుడు మందలిస్తాడు","kn":"ಸುಮಂತ್ರರು ಕೈಕೇಯಿಯನ್ನು ಖಂಡಿಸುತ್ತಾರೆ","ta":"சுமந்திரர் கைகேயியைக் கடிந்துகொள்கிறார்","ml":"സുമന്ത്രൻ കൈകേയിയെ ശാസിക്കുന്നു"},"36":{"hi":"राम के साथ सेना जाने पर कैकेयी की आपत्ति","te":"రాముడితో సైన్యం వెళ్లడాన్ని కైకేయి వ్యతిరేకిస్తుంది","kn":"ರಾಮನೊಂದಿಗೆ ಸೇನೆ ಹೋಗುವುದಕ್ಕೆ ಕೈಕೇಯಿಯ ಆಕ್ಷೇಪ","ta":"இராமனுடன் படை செல்வதை கைகேயி எதிர்க்கிறாள்","ml":"രാമനോടൊപ്പം സേന പോകുന്നതിനെ കൈകേയി എതിർക്കുന്നു"},"37":{"hi":"राम वल्कल वस्त्र धारण करते हैं","te":"రాముడు నారచీరలు ధరిస్తాడు","kn":"ರಾಮ ನಾರುಡೆಯನ್ನು ಧರಿಸುತ್ತಾನೆ","ta":"இராமன் மரவுரி அணிகிறான்","ml":"രാമൻ വൽക്കലവസ്ത്രം ധരിക്കുന്നു"},"38":{"hi":"राम माता को पिता की देखभाल में सौंपते हैं","te":"తల్లిని తండ్రి సంరక్షణలో ఉంచమని రాముడు కోరతాడు","kn":"ರಾಮ ತಾಯಿಯನ್ನು ತಂದೆಯ ಆರೈಕೆಗೆ ಒಪ್ಪಿಸುತ್ತಾನೆ","ta":"இராமன் தன் தாயைத் தந்தையிடம் ஒப்படைக்கிறான்","ml":"അമ്മയെ പിതാവിന്റെ പരിചരണത്തിൽ രാമൻ ഏൽപ്പിക്കുന്നു"},"39":{"hi":"कौसल्या सीता को उपदेश देती हैं","te":"సీతకు కౌసల్య హితవు చెబుతుంది","kn":"ಕೌಸಲ್ಯೆ ಸೀತೆಗೆ ಬುದ್ಧಿವಾದ ಹೇಳುತ್ತಾಳೆ","ta":"கௌசல்யை சீதைக்கு அறிவுரை கூறுகிறாள்","ml":"കൗസല്യ സീതയെ ഉപദേശിക്കുന്നു"},"40":{"hi":"प्रस्थान","te":"ప్రయాణం","kn":"ಪ್ರಯಾಣ","ta":"புறப்பாடு","ml":"യാത്രാരംഭം"},"41":{"hi":"अयोध्या शोक में डूबती है","te":"అయోధ్య శోకంలో మునుగుతుంది","kn":"ಅಯೋಧ್ಯೆಯ ಶೋಕ","ta":"அயோத்தி துயருறுகிறது","ml":"അയോധ്യ ദുഃഖിക്കുന്നു"},"42":{"hi":"दशरथ कैकेयी से नाता तोड़ते हैं","te":"కైకేయిని దశరథుడు త్యజిస్తాడు","kn":"ದಶರಥನು ಕೈಕೇಯಿಯನ್ನು ತ್ಯಜಿಸುತ್ತಾನೆ","ta":"தசரதன் கைகேயியைக் கைவிடுகிறான்","ml":"കൈകേയിയെ ദശരഥൻ തള്ളിപ്പറയുന്നു"},"43":{"hi":"कौसल्या का विलाप","te":"కౌసల్య విలాపం","kn":"ಕೌಸಲ್ಯೆಯ ಗೋಳು","ta":"கௌசல்யையின் புலம்பல்","ml":"കൗസല്യയുടെ വിലാപം"},"44":{"hi":"सुमित्रा कौसल्या को सांत्वना देती हैं","te":"కౌసల్యను సుమిత్ర ఓదారుస్తుంది","kn":"ಸುಮಿತ್ರೆ ಕೌಸಲ್ಯೆಗೆ ಸಾಂತ್ವನ ಹೇಳುತ್ತಾಳೆ","ta":"சுமித்திரை கௌசல்யையை ஆறுதல்படுத்துகிறாள்","ml":"സുമിത്ര കൗസല്യയെ ആശ്വസിപ്പിക്കുന്നു"},"45":{"hi":"नगरवासी राम के पीछे तमसा तक जाते हैं","te":"రాముడిని తమసా నది వరకు ప్రజలు అనుసరిస్తారు","kn":"ನಾಗರಿಕರು ರಾಮನನ್ನು ತಮಸಾ ನದಿಯವರೆಗೆ ಹಿಂಬಾಲಿಸುತ್ತಾರೆ","ta":"மக்கள் இராமனைத் தமசா நதி வரை பின்தொடர்கின்றனர்","ml":"തമസാനദി വരെ ജനങ്ങൾ രാമനെ അനുഗമിക്കുന്നു"},"46":{"hi":"राम नगरवासियों को सोता छोड़ जाते हैं","te":"ప్రజలు నిద్రిస్తుండగా రాముడు వెళ్తాడు","kn":"ರಾಮ ನಾಗರಿಕರನ್ನು ನಿದ್ರೆಯಲ್ಲಿರುವಾಗ ಬಿಟ್ಟು ಹೋಗುತ್ತಾನೆ","ta":"மக்கள் உறங்கும்போது இராமன் புறப்படுகிறான்","ml":"ജനങ്ങൾ ഉറങ്ങുമ്പോൾ രാമൻ യാത്ര തുടരുന്നു"},"47":{"hi":"नगरवासी लौटते हैं","te":"ప్రజలు తిరిగి వెళ్తారు","kn":"ನಾಗರಿಕರ ಹಿಂದಿರುಗುವಿಕೆ","ta":"மக்கள் திரும்புகின்றனர்","ml":"ജനങ്ങൾ മടങ്ങുന്നു"},"48":{"hi":"अयोध्या की स्त्रियाँ विलाप करती हैं","te":"అయోధ్య స్త్రీలు విలపిస్తారు","kn":"ಅಯೋಧ್ಯೆಯ ಮಹಿಳೆಯರ ಗೋಳು","ta":"அயோத்திப் பெண்களின் புலம்பல்","ml":"അയോധ്യയിലെ സ്ത്രീകളുടെ വിലാപം"},"49":{"hi":"कोसल राज्य को छोड़ना","te":"కోసల రాజ్యాన్ని విడిచిపెట్టడం","kn":"ಕೋಸಲ ದೇಶವನ್ನು ತೊರೆಯುವುದು","ta":"கோசலத்தை விட்டுப் புறப்படுதல்","ml":"കോസലം വിടുന്നു"},"50":{"hi":"गुह शृंगवेरपुर में राम का स्वागत करते हैं","te":"శృంగిబేరపురంలో గుహుడు రాముడికి స్వాగతం పలుకుతాడు","kn":"ಶೃಂಗೇರಪುರದಲ್ಲಿ ಗುಹನಿಂದ ರಾಮನಿಗೆ ಸ್ವಾಗತ","ta":"சிருங்கிவேரபுரத்தில் குகன் இராமனை வரவேற்கிறான்","ml":"ശൃംഗിബേരപുരത്തിൽ ഗുഹൻ രാമനെ സ്വീകരിക്കുന്നു"},"51":{"hi":"लक्ष्मण पहरा देते हैं","te":"లక్ష్మణుడు కాపలా కాస్తాడు","kn":"ಲಕ್ಷ್ಮಣನ ಕಾವಲು","ta":"இலக்குவன் காவல் காக்கிறான்","ml":"ലക്ഷ്മണൻ കാവലിരിക്കുന്നു"},"52":{"hi":"गंगा पार; सुमंत्र लौटाए जाते हैं","te":"గంగను దాటడం; సుమంత్రుడిని వెనక్కి పంపడం","kn":"ಗಂಗಾ ನದಿ ದಾಟುವಿಕೆ; ಸುಮಂತ್ರರ ಹಿಂತಿರುಗುವಿಕೆ","ta":"கங்கையைக் கடத்தல்; சுமந்திரர் திருப்பி அனுப்பப்படுகிறார்","ml":"ഗംഗ കടക്കുന്നു; സുമന്ത്രനെ മടക്കി അയയ്ക്കുന്നു"},"53":{"hi":"राम की संशय भरी रात","te":"రాముడి సందేహ రాత్రి","kn":"ರಾಮನ ಸಂದೇಹದ ರಾತ್ರಿ","ta":"இராமனின் ஐயம் நிறைந்த இரவு","ml":"രാമന്റെ സന്ദേഹരാത്രി"},"54":{"hi":"भरद्वाज का आश्रम","te":"భరద్వాజ ఆశ్రమం","kn":"ಭಾರದ್ವಾಜರ ಆಶ್ರಮ","ta":"பரத்வாஜரின் ஆசிரமம்","ml":"ഭരദ്വാജാശ്രമം"},"55":{"hi":"यमुना पार","te":"యమునను దాటడం","kn":"ಯಮುನಾ ನದಿ ದಾಟುವಿಕೆ","ta":"யமுனையைக் கடத்தல்","ml":"യമുന കടക്കുന്നു"},"56":{"hi":"चित्रकूट में निवास","te":"చిత్రకూటంలో నివాసం","kn":"ಚಿತ್ರಕೂಟದಲ್ಲಿ ನೆಲೆ","ta":"சித்திரகூடத்தில் குடியேறுதல்","ml":"ചിത്രകൂടത്തിൽ വാസമുറപ്പിക്കുന്നു"},"57":{"hi":"सुमंत्र अयोध्या लौटते हैं","te":"అయోధ్యకు సుమంత్రుడు తిరిగి వెళ్తాడు","kn":"ಸುಮಂತ್ರರು ಅಯೋಧ್ಯೆಗೆ ಹಿಂದಿರುಗುತ್ತಾರೆ","ta":"சுமந்திரர் அயோத்திக்குத் திரும்புகிறார்","ml":"സുമന്ത്രൻ അയോധ്യയിലേക്ക് മടങ്ങുന്നു"},"58":{"hi":"राम के संदेश","te":"రాముడి సందేశాలు","kn":"ರಾಮನ ಸಂದೇಶಗಳು","ta":"இராமனின் செய்திகள்","ml":"രാമന്റെ സന്ദേശങ്ങൾ"},"59":{"hi":"अयोध्या का दुःख; दशरथ की व्यथा","te":"అయోధ్య దుఃఖం; దశరథుడి వేదన","kn":"ಅಯೋಧ್ಯೆಯ ದುಃಖ; ದಶರಥನ ವೇದನೆ","ta":"அயோத்தியின் சோகம்; தசரதனின் வேதனை","ml":"അയോധ്യയുടെ ദുഃഖം; ദശരഥന്റെ വേദന"},"60":{"hi":"सुमंत्र कौसल्या को सांत्वना देते हैं","te":"కౌసల్యను సుమంత్రుడు ఓదారుస్తాడు","kn":"ಸುಮಂತ್ರರು ಕೌಸಲ್ಯೆಗೆ ಸಾಂತ್ವನ ಹೇಳುತ್ತಾರೆ","ta":"சுமந்திரர் கௌசல்யையை ஆறுதல்படுத்துகிறார்","ml":"സുമന്ത്രൻ കൗസല്യയെ ആശ്വസിപ്പിക്കുന്നു"},"61":{"hi":"कौसल्या राजा को उलाहना देती हैं","te":"రాజును కౌసల్య నిందిస్తుంది","kn":"ಕೌಸಲ್ಯೆ ರಾಜನನ್ನು ದೂಷಿಸುತ್ತಾಳೆ","ta":"கௌசல்யை மன்னனைக் கடிந்துகொள்கிறாள்","ml":"കൗസല്യ രാജാവിനെ ശാസിക്കുന്നു"},"62":{"hi":"दशरथ अपना पाप स्मरण करते हैं","te":"తన పాపాన్ని దశరథుడు గుర్తుచేసుకుంటాడు","kn":"ದಶರಥನು ತನ್ನ ಪಾಪವನ್ನು ಸ್ಮರಿಸುತ್ತಾನೆ","ta":"தசரதன் தன் பாவத்தை நினைவுகூர்கிறான்","ml":"ദശരഥൻ തന്റെ പാപം ഓർക്കുന്നു"},"63":{"hi":"तपस्वी बालक","te":"ముని బాలకుడు","kn":"ಆಶ್ರಮದ ಬಾಲಕ","ta":"முனிவர் சிறுவன்","ml":"മുനികുമാരന്റെ കഥ"},"64":{"hi":"शाप और दशरथ की मृत्यु","te":"శాపం, దశరథుడి మరణం","kn":"ಶಾಪ ಮತ್ತು ದಶರಥನ ಮರಣ","ta":"சாபமும் தசரதனின் மரணமும்","ml":"ശാപവും ദശരഥന്റെ മരണവും"},"65":{"hi":"राजा की मृत्यु का समाचार पाकर महल जाग उठता है","te":"రాజభవనంలో రాజు మరణ వార్త","kn":"ರಾಜನ ಮರಣದಿಂದ ಅರಮನೆಯಲ್ಲಿ ಎಚ್ಚರ","ta":"மன்னனின் மரணத்தால் அரண்மனை விழித்தெழுகிறது","ml":"രാജാവിന്റെ മരണവാർത്തയിൽ കൊട്ടാരം ഉണരുന്നു"},"66":{"hi":"शव सुरक्षित रखा जाता है","te":"శరీరాన్ని భద్రపరుస్తారు","kn":"ದೇಹದ ಸಂರಕ್ಷಣೆ","ta":"உடல் பாதுகாக்கப்படுகிறது","ml":"ശരീരം സംരക്ഷിക്കപ്പെടുന്നു"},"67":{"hi":"बिना राजा के राज्य के संकट","te":"రాజు లేని రాజ్యంలో ఆపదలు","kn":"ರಾಜರಹಿತ ನಾಡಿನ ಅಪಾಯಗಳು","ta":"அரசனற்ற நாட்டின் ஆபத்துகள்","ml":"രാജാവില്ലാത്ത നാടിന്റെ അപകടങ്ങൾ"},"68":{"hi":"भरत को बुलाने दूत भेजे जाते हैं","te":"భరతుడిని పిలిచేందుకు దూతలు పంపబడతారు","kn":"ಭರತನಿಗಾಗಿ ದೂತರನ್ನು ಕಳುಹಿಸುವುದು","ta":"பரதனை அழைக்க தூதர்கள் அனுப்பப்படுகின்றனர்","ml":"ഭരതനെ വിളിച്ചുവരുത്താൻ ദൂതന്മാരെ അയയ്ക്കുന്നു"},"69":{"hi":"भरत का स्वप्न","te":"భరతుడి కల","kn":"ಭರತನ ಕನಸು","ta":"பரதனின் கனவு","ml":"ഭരതന്റെ സ്വപ്നം"},"70":{"hi":"भरत अयोध्या के लिए निकलते हैं","te":"అయోధ్యకు భరతుడు బయలుదేరతాడు","kn":"ಭರತ ಅಯೋಧ್ಯೆಗೆ ಹೊರಡುತ್ತಾನೆ","ta":"பரதன் அயோத்திக்குப் புறப்படுகிறான்","ml":"ഭരതൻ അയോധ്യയിലേക്ക് യാത്ര തിരിക്കുന്നു"},"71":{"hi":"भरत सूनी अयोध्या में प्रवेश करते हैं","te":"నిర్జీవమైన అయోధ్యలోకి భరతుడు ప్రవేశిస్తాడు","kn":"ಭರತ ಬರಿದಾದ ಅಯೋಧ್ಯೆಯನ್ನು ಪ್ರವೇಶಿಸುತ್ತಾನೆ","ta":"வெறிச்சோடிய அயோத்திக்குள் பரதன் நுழைகிறான்","ml":"വിജനമായ അയോധ്യയിൽ ഭരതൻ പ്രവേശിക്കുന്നു"},"72":{"hi":"कैकेयी भरत को बताती है","te":"భరతుడికి కైకేయి చెబుతుంది","kn":"ಕೈಕೇಯಿ ಭರತನಿಗೆ ತಿಳಿಸುತ್ತಾಳೆ","ta":"கைகேயி பரதனிடம் கூறுகிறாள்","ml":"കൈകേയി ഭരതനോട് പറയുന്നു"},"73":{"hi":"भरत माता की निंदा करते हैं","te":"తల్లిని భరతుడు ఖండిస్తాడు","kn":"ಭರತ ತಾಯಿಯನ್ನು ಖಂಡಿಸುತ್ತಾನೆ","ta":"பரதன் தன் தாயைக் கண்டிக்கிறான்","ml":"അമ്മയെ ഭരതൻ അപലപിക്കുന്നു"},"74":{"hi":"भरत की प्रतिज्ञा","te":"భరతుడి ప్రతిజ్ఞ","kn":"ಭರತನ ಪ್ರತಿಜ್ಞೆ","ta":"பரதனின் சபதம்","ml":"ഭരതന്റെ പ്രതിജ്ഞ"},"75":{"hi":"कौसल्या के सामने भरत की शपथ","te":"కౌసల్య ఎదుట భరతుడి ప్రమాణం","kn":"ಕೌಸಲ್ಯೆಯ ಮುಂದೆ ಭರತನ ಆಣೆ","ta":"கௌசல்யையின் முன் பரதனின் சத்தியம்","ml":"കൗസല്യയുടെ മുന്നിൽ ഭരതന്റെ സത്യപ്രതിജ്ഞ"},"76":{"hi":"दशरथ का अंतिम संस्कार","te":"దశరథుడి అంత్యక్రియలు","kn":"ದಶರಥನ ಅಂತ್ಯಕ್ರಿಯೆ","ta":"தசரதனின் இறுதிச் சடங்கு","ml":"ദശരഥന്റെ സംസ്കാരം"},"77":{"hi":"अस्थि-संचय","te":"అస్థికలు సేకరించడం","kn":"ಅಸ್ಥಿ ಸಂಗ್ರಹ","ta":"எலும்புகளைச் சேகரித்தல்","ml":"അസ്ഥിസമാഹരണം"},"78":{"hi":"शत्रुघ्न और मंथरा","te":"శత్రుఘ్నుడు, మంథర","kn":"ಶತ್ರುಘ್ನ ಮತ್ತು ಮಂಥರೆ","ta":"சத்ருக்கனனும் மந்தரையும்","ml":"ശത്രുഘ്നനും മന്ഥരയും"},"79":{"hi":"भरत राजसिंहासन ठुकराते हैं","te":"సింహాసనాన్ని భరతుడు తిరస్కరిస్తాడు","kn":"ಭರತ ಸಿಂಹಾಸನವನ್ನು ನಿರಾಕರಿಸುತ್ತಾನೆ","ta":"பரதன் அரியணையை மறுக்கிறான்","ml":"രാജ്യഭാരം ഭരതൻ നിരസിക്കുന്നു"},"80":{"hi":"वन का मार्ग","te":"అడవికి దారి","kn":"ಕಾಡಿನ ದಾರಿಯಲ್ಲಿ","ta":"காட்டுக்குச் செல்லும் பாதை","ml":"വനത്തിലേക്കുള്ള പാത"},"81":{"hi":"सभा बुलाई जाती है","te":"సభను పిలుస్తారు","kn":"ಸಭೆಯನ್ನು ಕರೆಯಲಾಗುತ್ತದೆ","ta":"அவை கூட்டப்படுகிறது","ml":"സഭ വിളിച്ചുചേർക്കുന്നു"},"82":{"hi":"सभा के सामने भरत राज्य लेने से इनकार करते हैं","te":"సభ ఎదుట సింహాసనాన్ని భరతుడు వద్దంటాడు","kn":"ಸಭೆಯ ಮುಂದೆ ಭರತ ಸಿಂಹಾಸನವನ್ನು ನಿರಾಕರಿಸುತ್ತಾನೆ","ta":"அவையின் முன் பரதன் அரியணையை மறுக்கிறான்","ml":"സഭയ്ക്കുമുന്നിൽ ഭരതൻ രാജ്യം നിരസിക്കുന്നു"},"83":{"hi":"विशाल यात्रा निकलती है","te":"మహా ఊరేగింపు బయలుదేరుతుంది","kn":"ಮಹಾ ಮೆರವಣಿಗೆ ಹೊರಡುತ್ತದೆ","ta":"பெரும் ஊர்வலம் புறப்படுகிறது","ml":"മഹാഘോഷയാത്ര പുറപ്പെടുന്നു"},"84":{"hi":"गुह का संदेह","te":"గుహుడి అనుమానం","kn":"ಗುಹನ ಸಂಶಯ","ta":"குகனின் ஐயம்","ml":"ഗുഹന്റെ സംശയം"},"85":{"hi":"भरत मार्ग पूछते हैं","te":"దారి అడుగుతాడు భరతుడు","kn":"ಭರತ ದಾರಿ ಕೇಳುತ್ತಾನೆ","ta":"பரதன் வழி கேட்கிறான்","ml":"ഭരതൻ വഴി ചോദിക്കുന്നു"},"86":{"hi":"गुह लक्ष्मण के जागरण की कथा सुनाते हैं","te":"లక్ష్మణుడి జాగారం గురించి గుహుడు చెబుతాడు","kn":"ಲಕ್ಷ್ಮಣನ ಕಾವಲಿನ ಕುರಿತು ಗುಹನ ಮಾತು","ta":"இலக்குவனின் காவல் பற்றி குகன் கூறுகிறான்","ml":"ലക്ഷ്മണന്റെ കാവലിനെക്കുറിച്ച് ഗുഹൻ പറയുന്നു"},"87":{"hi":"जहाँ राम ने विश्राम किया","te":"రాముడు నిద్రించిన చోటు","kn":"ರಾಮ ಮಲಗಿದ್ದ ಸ್ಥಳ","ta":"இராமன் உறங்கிய இடம்","ml":"രാമൻ ഉറങ്ങിയ സ്ഥലം"},"88":{"hi":"राम की घास की शय्या देखकर भरत शोक करते हैं","te":"రాముడి గడ్డి పరుపు వద్ద భరతుడి దుఃఖం","kn":"ರಾಮನ ಹುಲ್ಲಿನ ಹಾಸಿಗೆಯ ಬಳಿ ಭರತನ ಶೋಕ","ta":"இராமனின் புல் படுக்கையைக் கண்டு பரதன் வருந்துகிறான்","ml":"രാമന്റെ പുൽമെത്തയ്ക്കരികെ ഭരതൻ ദുഃഖിക്കുന്നു"},"89":{"hi":"गंगा पार","te":"గంగను దాటడం","kn":"ಗಂಗಾ ನದಿ ದಾಟುವಿಕೆ","ta":"கங்கையைக் கடத்தல்","ml":"ഗംഗ കടക്കുന്നു"},"90":{"hi":"भरद्वाज भरत से प्रश्न करते हैं","te":"భరతుడిని భరద్వాజుడు ప్రశ్నిస్తాడు","kn":"ಭಾರದ್ವಾಜರು ಭರತನನ್ನು ಪ್ರಶ್ನಿಸುತ್ತಾರೆ","ta":"பரத்வாஜர் பரதனை விசாரிக்கிறார்","ml":"ഭരതനോട് ഭരദ്വാജൻ ചോദിക്കുന്നു"},"91":{"hi":"भरद्वाज का आतिथ्य","te":"భరద్వాజుడి విందు","kn":"ಭಾರದ್ವಾಜರ ಭೋಜನ","ta":"பரத்வாஜரின் விருந்து","ml":"ഭരദ്വാജന്റെ വിരുന്ന്"},"92":{"hi":"भरत भरद्वाज से विदा लेते हैं","te":"భరద్వాజుడి వద్ద భరతుడు వీడ్కోలు తీసుకుంటాడు","kn":"ಭರತ ಭಾರದ್ವಾಜರಿಗೆ ವಿದಾಯ ಹೇಳುತ್ತಾನೆ","ta":"பரத்வாஜரிடம் பரதன் விடைபெறுகிறான்","ml":"ഭരദ്വാജനോട് ഭരതൻ യാത്ര ചോദിക്കുന്നു"},"93":{"hi":"चित्रकूट में धुआँ","te":"చిత్రకూటంపై పొగ","kn":"ಚಿತ್ರಕೂಟದಲ್ಲಿ ಹೊಗೆ","ta":"சித்திரகூடத்தில் புகை","ml":"ചിത്രകൂടത്തിലെ പുക"},"94":{"hi":"राम सीता को चित्रकूट की सुंदरता दिखाते हैं","te":"చిత్రకూట సౌందర్యాన్ని సీతకు రాముడు చూపిస్తాడు","kn":"ರಾಮ ಸೀತೆಗೆ ಚಿತ್ರಕೂಟದ ಸೌಂದರ್ಯವನ್ನು ತೋರಿಸುತ್ತಾನೆ","ta":"சித்திரகூடத்தின் அழகை இராமன் சீதைக்குக் காட்டுகிறான்","ml":"ചിത്രകൂടത്തിന്റെ സൗന്ദര്യം രാമൻ സീതയ്ക്ക് കാണിക്കുന്നു"},"95":{"hi":"मंदाकिनी नदी","te":"మందాకినీ నది","kn":"ಮಂದಾಕಿನಿ ನದಿ","ta":"மந்தாகினி நதி","ml":"മന്ദാകിനി നദി"},"96":{"hi":"लक्ष्मण भरत की सेना देखते हैं","te":"భరతుడి సైన్యాన్ని లక్ష్మణుడు చూస్తాడు","kn":"ಲಕ್ಷ್ಮಣ ಭರತನ ಸೇನೆಯನ್ನು ನೋಡುತ್ತಾನೆ","ta":"பரதனின் படையை இலக்குவன் காண்கிறான்","ml":"ഭരതന്റെ സേനയെ ലക്ഷ്മണൻ കാണുന്നു"},"97":{"hi":"राम लक्ष्मण को शांत करते हैं","te":"లక్ష్మణుడిని రాముడు శాంతపరుస్తాడు","kn":"ರಾಮ ಲಕ್ಷ್ಮಣನನ್ನು ಸಮಾಧಾನಪಡಿಸುತ್ತಾನೆ","ta":"இராமன் இலக்குவனை அமைதிப்படுத்துகிறான்","ml":"ലക്ഷ്മണനെ രാമൻ ശാന്തനാക്കുന്നു"},"98":{"hi":"भरत आश्रम पाते हैं","te":"ఆశ్రమాన్ని భరతుడు కనుగొంటాడు","kn":"ಭರತ ಆಶ್ರಮವನ್ನು ಕಂಡುಕೊಳ್ಳುತ್ತಾನೆ","ta":"பரதன் ஆசிரமத்தைக் கண்டடைகிறான்","ml":"ഭരതൻ ആശ്രമം കണ്ടെത്തുന്നു"},"99":{"hi":"भरत राम से मिलते हैं","te":"రాముడిని భరతుడు కలుస్తాడు","kn":"ಭರತ ರಾಮನನ್ನು ಭೇಟಿಯಾಗುತ್ತಾನೆ","ta":"பரதன் இராமனைச் சந்திக்கிறான்","ml":"ഭരതൻ രാമനെ കാണുന്നു"},"100":{"hi":"राम राजधर्म पर प्रश्न करते हैं","te":"రాజ్య పాలనపై రాముడి ప్రశ్నలు","kn":"ರಾಜ್ಯಭಾರದ ಕುರಿತು ರಾಮನ ಪ್ರಶ್ನೆಗಳು","ta":"அரசாட்சி பற்றிய இராமனின் கேள்விகள்","ml":"രാജധർമത്തെക്കുറിച്ച് രാമന്റെ ചോദ്യങ്ങൾ"},"101":{"hi":"भरत राजा की मृत्यु का समाचार देते हैं","te":"రాజు మరణం గురించి భరతుడు చెబుతాడు","kn":"ರಾಜನ ಮರಣದ ಸುದ್ದಿಯನ್ನು ಭರತ ತಿಳಿಸುತ್ತಾನೆ","ta":"மன்னனின் மரணத்தை பரதன் கூறுகிறான்","ml":"രാജാവിന്റെ മരണവിവരം ഭരതൻ അറിയിക്കുന്നു"},"102":{"hi":"राम का शोक और जलांजलि","te":"రాముడి దుఃఖం; తర్పణం","kn":"ರಾಮನ ಶೋಕ ಮತ್ತು ತರ್ಪಣ","ta":"இராமனின் துயரமும் நீர்க்கடன் அளித்தலும்","ml":"രാമന്റെ ദുഃഖവും ജലതർപ്പണവും"},"103":{"hi":"माताएँ पहुँचती हैं","te":"తల్లులు వస్తారు","kn":"ತಾಯಂದಿರ ಆಗಮನ","ta":"தாய்மார்கள் வந்து சேர்கின்றனர்","ml":"അമ്മമാർ എത്തുന്നു"},"104":{"hi":"भरत की विनती और राम का उत्तर","te":"భరతుడి విజ్ఞప్తి; రాముడి సమాధానం","kn":"ಭರತನ ಮನವಿ ಮತ್ತು ರಾಮನ ಉತ್ತರ","ta":"பரதனின் வேண்டுகோளும் இராமனின் பதிலும்","ml":"ഭരതന്റെ അപേക്ഷയും രാമന്റെ മറുപടിയും"},"105":{"hi":"राम जीवन की क्षणभंगुरता पर कहते हैं","te":"జీవిత అనిత్యత గురించి రాముడు","kn":"ಜೀವನದ ಅಶಾಶ್ವತತೆಯ ಕುರಿತು ರಾಮನ ಮಾತು","ta":"வாழ்வின் நிலையாமை பற்றி இராமன்","ml":"ജീവിതത്തിന്റെ നശ്വരതയെക്കുറിച്ച് രാമൻ"},"106":{"hi":"भरत के तर्क","te":"భరతుడి వాదనలు","kn":"ಭರತನ ವಾದಗಳು","ta":"பரதனின் வாதங்கள்","ml":"ഭരതന്റെ വാദങ്ങൾ"},"107":{"hi":"राम भरत को लौटने को कहते हैं","te":"తిరిగి వెళ్లమని భరతుడికి రాముడు చెబుతాడు","kn":"ಹಿಂದಿರುಗುವಂತೆ ರಾಮ ಭರತನಿಗೆ ಹೇಳುತ್ತಾನೆ","ta":"திரும்பிச் செல்லுமாறு இராமன் பரதனுக்குக் கூறுகிறான்","ml":"മടങ്ങിപ്പോകാൻ രാമൻ ഭരതനോട് പറയുന്നു"},"108":{"hi":"जाबालि का तर्क","te":"జాబాలి వాదన","kn":"ಜಾಬಾಲಿಯ ವಾದ","ta":"ஜாபாலியின் வாதம்","ml":"ജാബാലിയുടെ വാദം"},"109":{"hi":"सत्य की रक्षा पर राम का मत","te":"సత్యంపై రాముడి సమర్థన","kn":"ಸತ್ಯದ ರಕ್ಷಣೆಯ ಕುರಿತು ರಾಮನ ಸಮರ್ಥನೆ","ta":"உண்மையைக் காக்கும் இராமனின் விளக்கம்","ml":"സത്യത്തിനുവേണ്ടി രാമന്റെ നിലപാട്"},"110":{"hi":"वसिष्ठ इक्ष्वाकु वंश का वर्णन करते हैं","te":"ఇక్ష్వాకు వంశాన్ని వశిష్ఠుడు వివరిస్తాడు","kn":"ವಸಿಷ್ಠರು ಇಕ್ಷ್ವಾಕು ವಂಶವನ್ನು ವಿವರಿಸುತ್ತಾರೆ","ta":"இட்சுவாகு வம்சத்தை வசிட்டர் விவரிக்கிறார்","ml":"വസിഷ്ഠൻ ഇക്ഷ്വാകുവംശം വിവരിക്കുന്നു"},"111":{"hi":"राम का अंतिम इनकार","te":"రాముడి చివరి తిరస్కారం","kn":"ರಾಮನ ಅಂತಿಮ ನಿರಾಕರಣೆ","ta":"இராமனின் இறுதி மறுப்பு","ml":"രാമന്റെ അന്തിമ നിരാകരണം"},"112":{"hi":"खड़ाऊँ","te":"పాదుకలు","kn":"ಪಾದುಕೆಗಳು","ta":"பாதுகைகள்","ml":"പാദുകങ്ങൾ"},"113":{"hi":"भरत खड़ाऊँ लेकर लौटते हैं","te":"పాదుకలతో భరతుడు తిరిగి వెళ్తాడు","kn":"ಪಾದುಕೆಗಳೊಂದಿಗೆ ಭರತನ ಹಿಂತಿರುಗುವಿಕೆ","ta":"பாதுகைகளுடன் பரதன் திரும்புகிறான்","ml":"പാദുകങ്ങളുമായി ഭരതൻ മടങ്ങുന്നു"},"114":{"hi":"राम के बिना अयोध्या","te":"రాముడు లేని అయోధ్య","kn":"ರಾಮನಿಲ್ಲದ ಅಯೋಧ್ಯೆ","ta":"இராமனின்றி அயோத்தி","ml":"രാമനില്ലാത്ത അയോധ്യ"},"115":{"hi":"नंदिग्राम में भरत","te":"నందిగ్రామంలో భరతుడు","kn":"ನಂದಿಗ್ರಾಮದಲ್ಲಿ ಭರತ","ta":"நந்திகிராமத்தில் பரதன்","ml":"നന്ദിഗ്രാമത്തിൽ ഭരതൻ"},"116":{"hi":"तपस्वी चित्रकूट छोड़ते हैं","te":"చిత్రకూటాన్ని మునులు వీడతారు","kn":"ಋಷಿಗಳು ಚಿತ್ರಕೂಟವನ್ನು ತೊರೆಯುತ್ತಾರೆ","ta":"முனிவர்கள் சித்திரகூடத்தை விட்டுச் செல்கின்றனர்","ml":"മുനിമാർ ചിത്രകൂടം വിടുന്നു"},"117":{"hi":"अत्रि और अनसूया","te":"అత్రి, అనసూయ","kn":"ಅತ್ರಿ ಮತ್ತು ಅನಸೂಯೆ","ta":"அத்ரியும் அனசூயையும்","ml":"അത്രിയും അനസൂയയും"},"118":{"hi":"अनसूया और सीता","te":"అనసూయ, సీత","kn":"ಅನಸೂಯೆ ಮತ್ತು ಸೀತೆ","ta":"அனசூயையும் சீதையும்","ml":"അനസൂയയും സീതയും"},"119":{"hi":"दंडक वन में प्रवेश","te":"దండకారణ్యంలోకి ప్రవేశం","kn":"ದಂಡಕಾರಣ್ಯಕ್ಕೆ ಪ್ರವೇಶ","ta":"தண்டகாரண்யத்துக்குள் நுழைதல்","ml":"ദണ്ഡകാരണ്യത്തിലേക്ക്"}}