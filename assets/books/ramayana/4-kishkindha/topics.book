{"1":{"hi":"पंपा पर राम का विलाप","te":"పంపా తీరంలో రాముడి విలాపం","kn":"ಪಂಪಾ ಸರೋವರದಲ್ಲಿ ರಾಮನ ಶೋಕ","ta":"பம்பை ஏரிக்கரையில் இராமனின் புலம்பல்","ml":"പമ്പയിൽ രാമന്റെ വിലാപം"},"2":{"hi":"सुग्रीव हनुमान को भेजते हैं","te":"సుగ్రీవుడు హనుమంతుడిని పంపుతాడు","kn":"ಸುಗ್ರೀವನು ಹನುಮಂತನನ್ನು ಕಳುಹಿಸುತ್ತಾನೆ","ta":"சுக்ரீவன் அனுமனை அனுப்புகிறான்","ml":"സുഗ്രീവൻ ഹനുമാനെ അയയ്ക്കുന്നു"},"3":{"hi":"हनुमान राम से मिलते हैं","te":"రాముడిని హనుమంతుడు కలుస్తాడు","kn":"ಹನುಮಂತ ರಾಮನನ್ನು ಭೇಟಿಯಾಗುತ್ತಾನೆ","ta":"அனுமன் இராமனைச் சந்திக்கிறான்","ml":"ഹനുമാൻ രാമനെ കാണുന്നു"},"4":{"hi":"हनुमान दोनों भाइयों को सुग्रीव के पास ले जाते हैं","te":"సోదరులను సుగ్రీవుడి వద్దకు హనుమంతుడు మోసుకువెళ్తాడు","kn":"ಹನುಮಂತ ಸಹೋದರರನ್ನು ಸುಗ್ರೀವನ ಬಳಿಗೆ ಹೊತ್ತೊಯ್ಯುತ್ತಾನೆ","ta":"அனுமன் சகோதரர்களைச் சுக்ரீவனிடம் சுமந்து செல்கிறான்","ml":"സഹോദരന്മാരെ ഹനുമാൻ സുഗ്രീവന്റെ അടുത്ത് എത്തിക്കുന്നു"},"5":{"hi":"राम और सुग्रीव की मित्रता","te":"రాముడు, సుగ్రీవుల మైత్రి","kn":"ರಾಮ ಮತ್ತು ಸುಗ್ರೀವರ ಮೈತ್ರಿ","ta":"இராமன் சுக்ரீவன் கூட்டணி","ml":"രാമ-സുഗ്രീവ സഖ്യം"},"6":{"hi":"सीता के आभूषण","te":"సీత ఆభరణాలు","kn":"ಸೀತೆಯ ಆಭರಣಗಳು","ta":"சீதையின் நகைகள்","ml":"സീതയുടെ ആഭരണങ്ങൾ"},"7":{"hi":"सुग्रीव राम को सांत्वना देते हैं","te":"రాముడిని సుగ్రీవుడు ఓదారుస్తాడు","kn":"ಸುಗ್ರೀವನು ರಾಮನಿಗೆ ಸಾಂತ್ವನ ಹೇಳುತ್ತಾನೆ","ta":"சுக்ரீவன் இராமனை ஆறுதல்படுத்துகிறான்","ml":"സുഗ്രീവൻ രാമനെ ആശ്വസിപ്പിക്കുന്നു"},"8":{"hi":"सुग्रीव बाली से रक्षा माँगते हैं","te":"వాలి నుంచి రక్షణ కోరతాడు సుగ్రీవుడు","kn":"ವಾಲಿಯಿಂದ ರಕ್ಷಣೆ ಕೋರುವ ಸುಗ್ರೀವ","ta":"வாலியிடமிருந்து பாதுகாப்பு கேட்கிறான் சுக்ரீவன்","ml":"വാലിയിൽനിന്ന് സംരക്ഷണം സുഗ്രീവൻ ആവശ്യപ്പെടുന്നു"},"9":{"hi":"बाली और मायावी","te":"వాలి, మాయావి","kn":"ವಾಲಿ ಮತ್ತು ಮಾಯಾವಿ","ta":"வாலியும் மாயாவியும்","ml":"വാലിയും മായാവിയും"},"10":{"hi":"सुग्रीव का निर्वासन","te":"సుగ్రీవుడి బహిష్కారం","kn":"ಸುಗ್ರೀವನ ಗಡಿಪಾರು","ta":"சுக்ரீவனின் நாடுகடத்தல்","ml":"സുഗ്രീവന്റെ പ്രവാസം"},"11":{"hi":"बाली का बल; दुंदुभि; साल वृक्ष","te":"వాలి పరాక్రమం; దుందుభి; సాల వృక్షాలు","kn":"ವಾಲಿಯ ಬಲ; ದುಂದುಭಿ; ಸಾಲ ವೃಕ್ಷಗಳು","ta":"வாலியின் வலிமை; துந்துபி; சால மரங்கள்","ml":"വാലിയുടെ ശക്തി; ദുന്ദുഭി; സാലവൃക്ഷങ്ങൾ"},"12":{"hi":"बाली से पहला युद्ध","te":"వాలితో మొదటి యుద్ధం","kn":"ವಾಲಿಯೊಂದಿಗೆ ಮೊದಲ ಯುದ್ಧ","ta":"வாலியுடன் முதல் போர்","ml":"വാലിയുമായുള്ള ആദ്യ യുദ്ധം"},"13":{"hi":"किष्किंधा के मार्ग पर","te":"కిష్కింధ దారిలో","kn":"ಕಿಷ್ಕಿಂಧೆಯ ದಾರಿಯಲ್ಲಿ","ta":"கிட்கிந்தைக்குச் செல்லும் வழியில்","ml":"കിഷ്കിന്ധയിലേക്കുള്ള വഴിയിൽ"},"14":{"hi":"सुग्रीव की दूसरी चुनौती","te":"సుగ్రీవుడి రెండవ సవాలు","kn":"ಸುಗ್ರೀವನ ಎರಡನೇ ಸವಾಲು","ta":"சுக்ரீவனின் இரண்டாவது சவால்","ml":"സുഗ്രീവന്റെ രണ്ടാം വെല്ലുവിളി"},"15":{"hi":"तारा की चेतावनी","te":"తార హెచ్చరిక","kn":"ತಾರೆಯ ಎಚ್ಚರಿಕೆ","ta":"தாரையின் எச்சரிக்கை","ml":"താരയുടെ മുന്നറിയിപ്പ്"},"16":{"hi":"राम का बाण बाली को लगता है","te":"రాముడి బాణంతో వాలి గాయపడతాడు","kn":"ರಾಮನ ಬಾಣದಿಂದ ವಾಲಿಗೆ ಪೆಟ್ಟು","ta":"இராமனின் அம்பால் வாலி தாக்கப்படுகிறான்","ml":"രാമന്റെ അമ്പേറ്റ് വാലി വീഴുന്നു"},"17":{"hi":"बाली राम को दोष देते हैं","te":"రాముడిని వాలి నిందిస్తాడు","kn":"ವಾಲಿ ರಾಮನನ್ನು ಖಂಡಿಸುತ್ತಾನೆ","ta":"வாலி இராமனைக் கடிந்துகொள்கிறான்","ml":"വാലി രാമനെ ശാസിക്കുന്നു"},"18":{"hi":"बाली को राम का उत्तर","te":"వాలికి రాముడి సమాధానం","kn":"ವಾಲಿಗೆ ರಾಮನ ಉತ್ತರ","ta":"வாலிக்கு இராமனின் பதில்","ml":"വാലിക്ക് രാമന്റെ മറുപടി"},"19":{"hi":"तारा बाली के पास दौड़ती है","te":"వాలి వద్దకు తార త్వరగా వెళ్తుంది","kn":"ತಾರೆ ವಾಲಿಯ ಬಳಿಗೆ ಧಾವಿಸುತ್ತಾಳೆ","ta":"தாரை வாலியிடம் விரைகிறாள்","ml":"താര വാലിയുടെ അടുത്തേക്ക് ഓടിയെത്തുന്നു"},"20":{"hi":"तारा का विलाप","te":"తార విలాపం","kn":"ತಾರೆಯ ವಿಲಾಪ","ta":"தாரையின் புலம்பல்","ml":"താരയുടെ വിലാപം"},"21":{"hi":"हनुमान तारा को सांत्वना देते हैं","te":"తారను హనుమంతుడు ఓదారుస్తాడు","kn":"ಹನುಮಂತ ತಾರೆಗೆ ಸಾಂತ್ವನ ಹೇಳುತ್ತಾನೆ","ta":"அனுமன் தாரையை ஆறுதல்படுத்துகிறான்","ml":"ഹനുമാൻ താരയെ ആശ്വസിപ്പിക്കുന്നു"},"22":{"hi":"बाली के अंतिम वचन","te":"వాలి చివరి మాటలు","kn":"ವಾಲಿಯ ಅಂತಿಮ ಮಾತುಗಳು","ta":"வாலியின் இறுதி வார்த்தைகள்","ml":"വാലിയുടെ അന്ത്യവാക്കുകൾ"},"23":{"hi":"तारा बाली का शोक करती है","te":"వాలి కోసం తార శోకిస్తుంది","kn":"ವಾಲಿಗಾಗಿ ತಾರೆಯ ಶೋಕ","ta":"வாலிக்காக தாரை துக்கம் அனுசரிக்கிறாள்","ml":"വാലിയെയോർത്ത് താര വിലപിക്കുന്നു"},"24":{"hi":"सुग्रीव का पश्चाताप और तारा की विनती","te":"సుగ్రీవుడి పశ్చాత్తాపం; తార విజ్ఞప్తి","kn":"ಸುಗ್ರೀವನ ಪಶ್ಚಾತ್ತಾಪ ಮತ್ತು ತಾರೆಯ ಬೇಡಿಕೆ","ta":"சுக்ரீவனின் மனவருத்தமும் தாரையின் வேண்டுகோளும்","ml":"സുഗ്രീവന്റെ പശ്ചാത്താപവും താരയുടെ അപേക്ഷയും"},"25":{"hi":"बाली का अंतिम संस्कार","te":"వాలి అంత్యక్రియలు","kn":"ವಾಲಿಯ ಅಂತ್ಯಕ್ರಿಯೆ","ta":"வாலியின் இறுதிச் சடங்கு","ml":"വാലിയുടെ സംസ്കാരം"},"26":{"hi":"सुग्रीव का राज्याभिषेक","te":"సుగ్రీవుడికి పట్టాభిషేకం","kn":"ಸುಗ್ರೀವನ ಪಟ್ಟಾಭಿಷೇಕ","ta":"சுக்ரீவனுக்கு முடிசூட்டு","ml":"സുഗ്രീവന്റെ കിരീടധാരണം"},"27":{"hi":"प्रस्रवण पर्वत की गुफा","te":"ప్రస్రవణ పర్వతంపై గుహ","kn":"ಪ್ರಸ್ರವಣ ಪರ್ವತದ ಗುಹೆ","ta":"பிரசரணம் மலைக் குகை","ml":"പ്രസ്രവണപർവതത്തിലെ ഗുഹ"},"28":{"hi":"वर्षा ऋतु","te":"వర్షాకాలం","kn":"ಮಳೆಗಾಲ","ta":"மழைக்காலம்","ml":"വർഷകാലം"},"29":{"hi":"हनुमान सुग्रीव को जगाते हैं","te":"సుగ్రీవుడిని హనుమంతుడు మేల్కొలుపుతాడు","kn":"ಹನುಮಂತ ಸುಗ್ರೀವನನ್ನು ಎಚ್ಚರಿಸುತ್ತಾನೆ","ta":"அனுமன் சுக்ரீவனை எழுப்புகிறான்","ml":"ഹനുമാൻ സുഗ്രീവനെ ഉണർത്തുന്നു"},"30":{"hi":"शरद ऋतु और राम का क्रोध","te":"శరదృతువు; రాముడి ఆగ్రహం","kn":"ಶರತ್ಕಾಲ ಮತ್ತು ರಾಮನ ಕೋಪ","ta":"இலையுதிர் காலமும் இராமனின் சினமும்","ml":"ശരത്കാലവും രാമന്റെ കോപവും"},"31":{"hi":"लक्ष्मण किष्किंधा पहुँचते हैं","te":"కిష్కింధకు లక్ష్మణుడు చేరుకుంటాడు","kn":"ಲಕ್ಷ್ಮಣ ಕಿಷ್ಕಿಂಧೆಗೆ ಆಗಮಿಸುತ್ತಾನೆ","ta":"இலக்குவன் கிட்கிந்தையை அடைகிறான்","ml":"ലക്ഷ്മണൻ കിഷ്കിന്ധയിൽ എത്തുന്നു"},"32":{"hi":"हनुमान का परामर्श","te":"హనుమంతుడి హితవు","kn":"ಹನುಮಂತನ ಸಲಹೆ","ta":"அனுமனின் அறிவுரை","ml":"ഹനുമാന്റെ ഉപദേശം"},"33":{"hi":"लक्ष्मण महल में प्रवेश करते हैं","te":"లక్ష్మణుడు రాజభవనంలో ప్రవేశిస్తాడు","kn":"ಲಕ್ಷ್ಮಣ ಅರಮನೆಯನ್ನು ಪ್ರವೇಶಿಸುತ್ತಾನೆ","ta":"இலக்குவன் அரண்மனைக்குள் நுழைகிறான்","ml":"ലക്ഷ്മണൻ കൊട്ടാരത്തിൽ പ്രവേശിക്കുന്നു"},"34":{"hi":"लक्ष्मण सुग्रीव को फटकारते हैं","te":"సుగ్రీవుడిని లక్ష్మణుడు మందలిస్తాడు","kn":"ಲಕ್ಷ್ಮಣ ಸುಗ್ರೀವನನ್ನು ಖಂಡಿಸುತ್ತಾನೆ","ta":"இலக்குவன் சுக்ரீவனைக் கடிந்துகொள்கிறான்","ml":"ലക്ഷ്മണൻ സുഗ്രീവനെ ശാസിക്കുന്നു"},"35":{"hi":"तारा लक्ष्मण को शांत करती है","te":"లక్ష్మణుడిని తార శాంతపరుస్తుంది","kn":"ತಾರೆ ಲಕ್ಷ್ಮಣನನ್ನು ಶಾಂತಗೊಳಿಸುತ್ತಾಳೆ","ta":"தாரை இலக்குவனை சமாதானப்படுத்துகிறாள்","ml":"താര ലക്ഷ്മണനെ ശാന്തനാക്കുന്നു"},"36":{"hi":"सुग्रीव और लक्ष्मण का मेल","te":"సుగ్రీవుడు, లక్ష్మణుడు రాజీపడతారు","kn":"ಸುಗ್ರೀವ ಮತ್ತು ಲಕ್ಷ್ಮಣರ ಸಮಾಧಾನ","ta":"சுக்ரீவனும் இலக்குவனும் சமாதானமாகின்றனர்","ml":"സുഗ്രീവനും ലക്ഷ്മണനും അനുരഞ്ജനത്തിലാകുന്നു"},"37":{"hi":"वानर सेनाएँ एकत्र होती हैं","te":"వానర సేనలు సమావేశమవుతాయి","kn":"ವಾನರ ಸೇನೆಯ ಸಮಾವೇಶ","ta":"குரங்குப் படைத் தலைவர்கள் கூடுகின்றனர்","ml":"വാനരസൈന്യം ഒരുമിച്ചുകൂടുന്നു"},"38":{"hi":"सुग्रीव राम के पास आते हैं","te":"రాముడి వద్దకు సుగ్రీవుడు వస్తాడు","kn":"ಸುಗ್ರೀವ ರಾಮನ ಬಳಿಗೆ ಬರುತ್ತಾನೆ","ta":"சுக்ரீவன் இராமனிடம் வருகிறான்","ml":"സുഗ്രീവൻ രാമന്റെ അടുത്തെത്തുന്നു"},"39":{"hi":"विशाल वानर सेना","te":"విశాల వానర సైన్యం","kn":"ಅಪಾರ ಸೇನೆ","ta":"பெரும் படை","ml":"വിപുലമായ സൈന്യം"},"40":{"hi":"पूर्व दिशा की खोज टोली","te":"తూర్పు దిక్కుకు శోధన బృందం","kn":"ಪೂರ್ವ ದಿಕ್ಕಿನ ಹುಡುಕಾಟ ತಂಡ","ta":"கிழக்குத் திசை தேடல் குழு","ml":"കിഴക്ക് അന്വേഷണസംഘം"},"41":{"hi":"दक्षिण दिशा की खोज टोली","te":"దక్షిణ దిక్కుకు శోధన బృందం","kn":"ದಕ್ಷಿಣ ದಿಕ್ಕಿನ ಹುಡುಕಾಟ ತಂಡ","ta":"தெற்குத் திசை தேடல் குழு","ml":"തെക്ക് അന്വേഷണസംഘം"},"42":{"hi":"पश्चिम दिशा की खोज टोली","te":"పశ్చిమ దిక్కుకు శోధన బృందం","kn":"ಪಶ್ಚಿಮ ದಿಕ್ಕಿನ ಹುಡುಕಾಟ ತಂಡ","ta":"மேற்குத் திசை தேடல் குழு","ml":"പടിഞ്ഞാറ് അന്വേഷണസംഘം"},"43":{"hi":"उत्तर दिशा की खोज टोली","te":"ఉత్తర దిక్కుకు శోధన బృందం","kn":"ಉತ್ತರ ದಿಕ್ಕಿನ ಹುಡುಕಾಟ ತಂಡ","ta":"வடக்குத் திசை தேடல் குழு","ml":"വടക്ക് അന്വേഷണസംഘം"},"44":{"hi":"हनुमान के लिए राम की मुद्रिका","te":"హనుమంతుడికి రాముడి ఉంగరం","kn":"ಹನುಮಂತನಿಗೆ ರಾಮನ ಮುದ್ರಿಕೆ","ta":"அனுமனுக்கு இராமனின் மோதிரம்","ml":"ഹനുമാന് രാമന്റെ മോതിരം"},"45":{"hi":"खोज टोलियाँ प्रस्थान करती हैं","te":"శోధన బృందాలు బయలుదేరతాయి","kn":"ಹುಡುಕಾಟ ತಂಡಗಳ ಪ್ರಯಾಣ","ta":"தேடல் குழுக்கள் புறப்படுகின்றன","ml":"അന്വേഷണസംഘങ്ങൾ പുറപ്പെടുന്നു"},"46":{"hi":"सुग्रीव संसार को कैसे जानते हैं","te":"ప్రపంచం గురించి సుగ్రీవుడికి తెలిసిన విధానం","kn":"ಸುಗ್ರೀವನಿಗೆ ಜಗತ್ತಿನ ಪರಿಚಯ ಹೇಗೆ","ta":"உலகை சுக்ரீவன் அறியும் விதம்","ml":"ലോകവിവരം സുഗ്രീവന് എങ്ങനെ"},"47":{"hi":"अन्य टोलियाँ लौटती हैं","te":"మిగిలిన బృందాలు తిరిగి వస్తాయి","kn":"ಇತರ ತಂಡಗಳ ಹಿಂತಿರುಗುವಿಕೆ","ta":"மற்ற குழுக்கள் திரும்புகின்றன","ml":"മറ്റു സംഘങ്ങൾ മടങ്ങിയെത്തുന്നു"},"48":{"hi":"विंध्य में दक्षिणी टोली","te":"వింధ్య పర్వతాల్లో దక్షిణ బృందం","kn":"ವಿಂಧ್ಯ ಪರ್ವತದಲ್ಲಿ ದಕ್ಷಿಣ ತಂಡ","ta":"விந்திய மலையில் தெற்குக் குழு","ml":"വിന്ധ്യാപർവതത്തിൽ തെക്കൻ സംഘം"},"49":{"hi":"अंगद खोज के लिए उत्साह देते हैं","te":"శోధనకు అంగదుడు ఉత్సాహమిస్తాడు","kn":"ಅಂಗದನು ಹುಡುಕಾಟಕ್ಕೆ ಪ್ರೋತ್ಸಾಹಿಸುತ್ತಾನೆ","ta":"தேடலுக்கு அங்கதன் ஊக்கமளிக்கிறான்","ml":"അന്വേഷണത്തിന് അംഗദൻ ഉത്സാഹം പകരുന്നു"},"50":{"hi":"ऋक्षबिल की गुफा","te":"ఋక్షబిలం గుహ","kn":"ಋಕ್ಷಬಿಲದ ಗುಹೆ","ta":"ரிக்ஷபிலா குகை","ml":"ഋക്ഷബിലഗുഹ"},"51":{"hi":"स्वयंप्रभा की कथा","te":"స్వయంప్రభ కథ","kn":"ಸ್ವಯಂಪ್ರಭೆಯ ಕಥೆ","ta":"சுயம்பிரபையின் கதை","ml":"സ്വയംപ്രഭയുടെ കഥ"},"52":{"hi":"हनुमान अपने उद्देश्य की बात बताते हैं","te":"తమ లక్ష్యాన్ని హనుమంతుడు వివరిస్తాడు","kn":"ಹನುಮಂತ ತಮ್ಮ ಧ್ಯೇಯವನ್ನು ವಿವರಿಸುತ್ತಾನೆ","ta":"அனுமன் தங்கள் பணியை விளக்குகிறான்","ml":"തങ്ങളുടെ ദൗത്യം ഹനുമാൻ വിവരിക്കുന്നു"},"53":{"hi":"गुफा से बाहर; अंगद निराश होते हैं","te":"గుహ నుంచి బయటకు; అంగదుడి నిరాశ","kn":"ಗುಹೆಯಿಂದ ಹೊರಗೆ; ಅಂಗದನ ನಿರಾಶೆ","ta":"குகையிலிருந்து வெளியே; அங்கதன் நம்பிக்கை இழக்கிறான்","ml":"ഗുഹയിൽനിന്ന് പുറത്തേക്ക്; അംഗദൻ നിരാശനാകുന്നു"},"54":{"hi":"हनुमान अंगद को समझाने का प्रयास करते हैं","te":"అంగదుడిని హనుమంతుడు వారిస్తాడు","kn":"ಅಂಗದನನ್ನು ತಡೆಯಲು ಹನುಮಂತನ ಪ್ರಯತ್ನ","ta":"அங்கதனைத் தடுக்க அனுமன் முயல்கிறான்","ml":"അംഗദനെ പിന്തിരിപ്പിക്കാൻ ഹനുമാൻ ശ്രമിക്കുന്നു"},"55":{"hi":"वानर प्राण-त्याग के लिए अनशन करते हैं","te":"వానరులు మరణం వరకు ఉపవాస దీక్ష చేస్తారు","kn":"ವಾನರರ ಆಮರಣಾಂತ ಉಪವಾಸ","ta":"குரங்குகள் உயிர்துறக்கும் வரை உண்ணாநோன்பு","ml":"വാനരന്മാർ മരണംവരെ ഉപവസിക്കുന്നു"},"56":{"hi":"संपाति प्रकट होते हैं","te":"సంపాతి ప్రత్యక్షమవుతాడు","kn":"ಸಂಪಾತಿಯ ಆಗಮನ","ta":"சம்பாதி தோன்றுகிறார்","ml":"സമ്പാതി പ്രത്യക്ഷപ്പെടുന്നു"},"57":{"hi":"अंगद जटायु की कथा सुनाते हैं","te":"జటాయువు గురించి అంగదుడు చెబుతాడు","kn":"ಅಂಗದನು ಜಟಾಯುವಿನ ಕುರಿತು ಹೇಳುತ್ತಾನೆ","ta":"ஜடாயுவைப் பற்றி அங்கதன் கூறுகிறான்","ml":"ജടായുവിനെക്കുറിച്ച് അംഗദൻ പറയുന്നു"},"58":{"hi":"संपाति लंका में सीता को देखते हैं","te":"లంకలో సీతను సంపాతి చూస్తాడు","kn":"ಲಂಕೆಯಲ್ಲಿ ಸೀತೆಯನ್ನು ಸಂಪಾತಿ ಕಾಣುತ್ತಾನೆ","ta":"இலங்கையில் சீதையை சம்பாதி காண்கிறார்","ml":"ലങ്കയിൽ സീതയെ സമ്പാതി കാണുന്നു"},"59":{"hi":"सुपार्श्व का समाचार","te":"సుపార్శ్వుడి నివేదిక","kn":"ಸುಪಾರ್ಶ್ವನ ವರದಿ","ta":"சுபார்சுவனின் அறிக்கை","ml":"സുപാർശ്വന്റെ വിവരണം"},"60":{"hi":"संपाति का अतीत","te":"సంపాతి గతం","kn":"ಸಂಪಾತಿಯ ಹಿಂದಿನ ಕಥೆ","ta":"சம்பாதியின் கடந்த காலம்","ml":"സമ്പാതിയുടെ പൂർവകഥ"},"61":{"hi":"संपाति निशाकर को अपने पंखों की बात बताते हैं","te":"తన రెక్కల గురించి నిశాకరుడికి సంపాతి చెబుతాడు","kn":"ಸಂಪಾತಿ ನಿಶಾಕರನಿಗೆ ತನ್ನ ರೆಕ್ಕೆಗಳ ಬಗ್ಗೆ ಹೇಳುತ್ತಾನೆ","ta":"சம்பாதி தன் சிறகுகளைப் பற்றி நிசாகரனிடம் கூறுகிறார்","ml":"ചിറകുകളെക്കുറിച്ച് നിശാകരനോട് സമ്പാതി പറയുന്നു"},"62":{"hi":"निशाकर की भविष्यवाणी","te":"నిశాకరుడి భవిష్యవాణి","kn":"ನಿಶಾಕರನ ಭವಿಷ್ಯವಾಣಿ","ta":"நிசாகரனின் தீர்க்கதரிசனம்","ml":"നിശാകരന്റെ പ്രവചനം"},"63":{"hi":"संपाति के पंख फिर उगते हैं","te":"సంపాతి రెక్కలు మళ్లీ మొలుస్తాయి","kn":"ಸಂಪಾತಿಯ ರೆಕ್ಕೆಗಳು ಮತ್ತೆ ಬೆಳೆಯುತ್ತವೆ","ta":"சம்பாதியின் சிறகுகள் மீண்டும் வளர்கின்றன","ml":"സമ്പാതിയുടെ ചിറകുകൾ വീണ്ടും വളരുന്നു"},"64":{"hi":"समुद्र कैसे पार करें","te":"సముద్రాన్ని ఎలా దాటాలి","kn":"ಸಮುದ್ರವನ್ನು ದಾಟುವ ಬಗೆ","ta":"கடலைக் கடக்கும் வழி","ml":"സമുദ്രം കടക്കുന്നത് എങ്ങനെ"},"65":{"hi":"जाम्बवान हनुमान को चुनते हैं","te":"హనుమంతుడిని జాంబవంతుడు ఎంచుకుంటాడు","kn":"ಜಾಂಬವಂತ ಹನುಮಂತನನ್ನು ಆರಿಸುತ್ತಾನೆ","ta":"ஜாம்பவான் அனுமனைத் தேர்ந்தெடுக்கிறார்","ml":"ഹനുമാനെ ജാംബവാൻ തിരഞ്ഞെടുക്കുന്നു"},"66":{"hi":"जाम्बवान हनुमान को उनकी शक्ति याद दिलाते हैं","te":"హనుమంతుడికి తన శక్తిని జాంబవంతుడు గుర్తుచేస్తాడు","kn":"ಜಾಂಬವಂತ ಹನುಮಂತನಿಗೆ ಅವನ ಶಕ್ತಿಯನ್ನು ನೆನಪಿಸುತ್ತಾನೆ","ta":"தம் ஆற்றலை அனுமனுக்கு ஜாம்பவான் நினைவூட்டுகிறார்","ml":"ഹനുമാന്റെ ശക്തി ജാംബവാൻ ഓർമിപ്പിക്കുന്നു"},"67":{"hi":"हनुमान छलांग की तैयारी करते हैं","te":"దూకడానికి హనుమంతుడు సిద్ధమవుతాడు","kn":"ಹನುಮಂತ ಜಿಗಿಯಲು ಸಿದ್ಧನಾಗುತ್ತಾನೆ","ta":"அனுமன் தாவுவதற்குத் தயாராகிறான்","ml":"ചാടാൻ ഹനുമാൻ ഒരുങ്ങുന്നു"}}