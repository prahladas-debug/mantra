{
  "expo": {
    "name": "Mantra Sangraha",
    "slug": "mantra-sangraha",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mantrasangraha.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#B23A12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mantrasangraha.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "static",
      "name": "Mantra Sangraha"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FFF9F0",
          "dark": {
            "backgroundColor": "#14100C"
          }
        }
      ]
    ],
    "scheme": "mantrasangraha",
    "description": "Vedic mantras, suktas, stotras and sahasranamas in Devanagari, Kannada, Telugu, Tamil, Malayalam and more.",
    "experiments": {
      "typedRoutes": false
    }
  }
}
