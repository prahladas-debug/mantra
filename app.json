{
  "expo": {
    "name": "Nandadeepa",
    "slug": "mantra-sangraha",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mantrasangraha.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#A8340F",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mantrasangraha.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "static",
      "name": "Nandadeepa"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FAF7F0",
          "dark": {
            "backgroundColor": "#171410"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      "expo-asset",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ]
    ],
    "scheme": "mantrasangraha",
    "description": "Nandadeepa: mantras, stotras, parayana texts, devotional songs, puja and rites, and a panchanga, in Kannada, Devanagari, Telugu, Tamil, Malayalam and more.",
    "experiments": {
      "typedRoutes": false
    }
  }
}
